# Release signing (distribution, notarization)
# Copy to scripts/.env.release and fill in your values.

# Developer ID certificate (for distribution outside App Store)
# You can use either the Keychain display name OR the 40-hex SHA1 identity.
# SHA1 is often more reliable when you have multiple teams/certs installed.
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Apple Developer Team ID
DEVELOPMENT_TEAM="ABCDEF1234"

# Dext provisioning profile (Developer ID)
PROVISIONING_PROFILE_SPECIFIER="OpenJoystickDriver VirtualHIDDevice DevID"

# App and daemon provisioning profiles (Developer ID)
GUI_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriver_DevID.provisionprofile"
DAEMON_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriverDaemon_DevID.provisionprofile"

# Preferred notarization credentials: App Store Connect API key
NOTARIZE_KEY_ID=""             # App Store Connect API key ID
NOTARIZE_ISSUER_ID=""          # App Store Connect issuer ID
NOTARIZE_API_KEY_PATH=""       # path to AuthKey_<key-id>.p8

# CI alternative to NOTARIZE_API_KEY_PATH
NOTARIZE_API_KEY_BASE64=""     # base64-encoded AuthKey_<key-id>.p8

# Legacy notarization credentials: Apple ID app-specific password
NOTARIZE_APPLE_ID=""           # your Apple ID email
NOTARIZE_PASSWORD=""           # app-specific password (xxxx-xxxx-xxxx-xxxx)
