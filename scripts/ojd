#!/usr/bin/env bash
# OpenJoystickDriver developer entrypoint.
#
# Provides one command for common tasks and clear errors.
#
# Use this instead of running individual scripts.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<'USAGE'
OpenJoystickDriver dev helper

Usage:
  ./scripts/ojd <command> [args]

Commands:
  build dev                   Build + sign app bundle into `.build/` (no dext)
  build release               Build + sign app bundle for release (no dext)
  build dext                  Build DriverKit `.dext` and embed into `.build/` app
  build install dev|release   Full rebuild and install (alias: rebuild)
  build install-fast dev      App-only rebuild and install (alias: rebuild-fast)
  driverkit generate [path]   Generate a fresh SwifterKit DriverKit project
  release bump-version <version>
                              Update release version references
  release package [version]  Build, notarize, staple, and package a release DMG
  release install-local [version]
                              Package and install the release app locally
  release notarize <command> Run release notarization operations

  env audit                   Validate the single-file env contract without printing values
  docs export-external-issues Refresh archived GitHub issue and pull-request evidence
  signing install-profiles    Copy profiles from ~/Documents/Profiles into MobileDevice
  signing configure            Generate .env.dev + .env.release from Keychain + profiles
  signing doctor               Diagnose common cert/profile mismatch errors (safe output)
  signing audit [paths...]     Audit profiles without leaking identifiers
  signing cert-info <cer>      Show safe-ish .cer info (Team ID = Subject OU)
  signing profile-info <pp>    Show safe-ish profile embedded cert info
  signing import-embedded <pp> Import embedded cert from a profile into Keychain
  signing ci-release-setup     Import GitHub Actions release secrets (CI only)
  signing export-github-secrets
                               Write/import GitHub Actions release secrets

  diagnose dext               Run dext diagnostics (activation, codesign, IORegistry, application service connection)
  diagnose record <json>     Validate/probe a raw-USB record without app signing
  diagnose sdl3 [--seconds N] Run SDL3 probe against the virtual device
  diagnose sdl3-gamecontroller [--seconds N]
                              Run SDL3 through GameController/MFI and test rumble
  diagnose sdl3-hidapi-x360 [--seconds N]
                              Run SDL3 through Xbox 360 HIDAPI and test rumble
  diagnose gamecontroller     Run GameController.framework probe
  diagnose catalina [app]     Check a macOS 10.15 test app bundle
  diagnose backends           Run current backend acceptance loop
  repair stale-dext           Kill stale DriverKit process copies after upgrade
  repair swiftpm-module-cache Clean SwiftPM build products after toolchain/target changes
  catalog regenerate --check Verify the runtime catalog against pinned sources and overrides
  catalog regenerate --write Rebuild the runtime catalog from pinned sources and overrides
  catalog xpad [options]      Generate review-only records from a pinned Linux xpad.c
  check profiles              Check canonical controller records
  check scripts               Check script ownership, paths, modes, and syntax
  check swift-structure       Check Swift file sizes and ownership layout
  check driverkit             Verify generated DriverKit reproducibility and build
  test parsers-macos14        Run focused parser regressions without Swift Testing
  test scripts                Run deterministic script unit tests
  launch sdl-gamecontroller <app>
                              Launch an SDL app through GameController/MFI rumble route

  lint                        Run SwiftLint (requires swiftlint)

Compatibility aliases:
  rebuild dev|release         Alias for build install dev|release
  rebuild-fast dev            Alias for build install-fast dev
  bump-version <version>      Alias for release bump-version
  package release [version]  Alias for release package
  notarize <command>         Alias for release notarize

Examples:
  ./scripts/ojd signing install-profiles
  ./scripts/ojd signing configure
  ./scripts/ojd diagnose record /tmp/controller.json --validate-only
  ./scripts/ojd catalog xpad --github-ref master --output-dir /tmp/ojd-xpad
  ./scripts/ojd build install-fast dev
  ./scripts/ojd release bump-version 0.1.0-rc.2

Notes:
  - Most commands expect the app to be installed to /Applications.
  - DriverKit upgrades can require a reboot; use build install-fast while streaming.
USAGE
}

die() { echo "ERROR: $*" >&2; exit 2; }

require_no_args() {
  local command_name="$1"
  shift
  [[ $# -eq 0 ]] || die "$command_name does not accept arguments"
}

require_one_arg() {
  local command_name="$1"
  shift
  [[ $# -eq 1 ]] || die "$command_name requires exactly one argument"
}

require_at_most_one_arg() {
  local command_name="$1"
  shift
  [[ $# -le 1 ]] || die "$command_name accepts at most one argument"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;

  build)
    sub="${1:-}"; shift || true
    case "$sub" in
      ""|-h|--help|help)
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" help
        ;;
      dev)
        require_no_args "build dev" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" build dev
        ;;
      dext)
        require_no_args "build dext" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" build dext
        ;;
      release)
        require_no_args "build release" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" build release
        ;;
      install)
        configuration="${1:-}"; shift || true
        case "$configuration" in
          dev)
            require_no_args "build install dev" "$@"
            exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" rebuild dev
            ;;
          release)
            require_no_args "build install release" "$@"
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" rebuild release
            ;;
          *) die "Unknown: build install $configuration (expected: dev | release)" ;;
        esac
        ;;
      install-fast)
        configuration="${1:-}"; shift || true
        case "$configuration" in
          dev)
            require_no_args "build install-fast dev" "$@"
            exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" rebuild-fast dev
            ;;
          *) die "Unknown: build install-fast $configuration (expected: dev)" ;;
        esac
        ;;
      *)
        die "Unknown: build $sub (expected: dev | dext | release | install | install-fast)"
        ;;
    esac
    ;;

  rebuild)
    sub="${1:-}"; shift || true
    case "$sub" in
      dev)
        require_no_args "rebuild dev" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" rebuild dev
        ;;
      release)
        require_no_args "rebuild release" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" rebuild release
        ;;
      *)
        die "Unknown: rebuild $sub (expected: dev | release)"
        ;;
    esac
    ;;

  rebuild-fast)
    sub="${1:-}"; shift || true
    case "$sub" in
      dev)
        require_no_args "rebuild-fast dev" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" rebuild-fast dev
        ;;
      *)
        die "Unknown: rebuild-fast $sub (expected: dev)"
        ;;
    esac
    ;;

  bump-version)
    require_one_arg "bump-version" "$@"
    exec /usr/bin/env bash "$SCRIPT_DIR/release/bump-version.sh" "$@"
    ;;

  driverkit)
    sub="${1:-}"; shift || true
    case "$sub" in
      generate)
        require_at_most_one_arg "driverkit generate" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/driverkit.sh" generate "$@"
        ;;
      *) die "Unknown: driverkit $sub (expected: generate)" ;;
    esac
    ;;

  env)
    sub="${1:-}"
    shift || true
    case "$sub" in
      audit)
        require_no_args "env audit" "$@"
        exec python3 "$SCRIPT_DIR/quality/env-audit.py"
        ;;
      *) die "Unknown: env $sub (expected: audit)" ;;
    esac
    ;;

  docs)
    sub="${1:-}"
    shift || true
    case "$sub" in
      export-external-issues)
        require_no_args "docs export-external-issues" "$@"
        exec /usr/bin/env python3 "$SCRIPT_DIR/docs/issues/export.py"
        ;;
      *)
        die "Unknown: docs $sub (expected: export-external-issues)"
        ;;
    esac
    ;;
  signing)
    sub="${1:-}"; shift || true
    case "$sub" in
      ""|-h|--help|help)
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" help
        ;;
      install-profiles)
        require_at_most_one_arg "signing install-profiles" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" install-profiles "${1:-}"
        ;;
      configure)
        require_no_args "signing configure" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" configure
        ;;
      doctor)
        require_no_args "signing doctor" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" doctor
        ;;
      audit)
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" audit "$@"
        ;;
      cert-info)
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" cert-info "$@"
        ;;
      profile-info)
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" profile-info "$@"
        ;;
      import-embedded)
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" import-embedded "$@"
        ;;
      ci-release-setup)
        require_no_args "signing ci-release-setup" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/signing.sh" ci-release-setup
        ;;
      export-github-secrets)
        exec /usr/bin/env bash "$SCRIPT_DIR/signing/export-github-secrets.sh" "$@"
        ;;
      *)
        die "Unknown: signing $sub (expected: install-profiles | configure | doctor | audit | cert-info | profile-info | import-embedded | ci-release-setup | export-github-secrets)"
        ;;
    esac
    ;;

  catalog)
    sub="${1:-}"; shift || true
    case "$sub" in
      regenerate)
        exec /usr/bin/env python3 "$SCRIPT_DIR/catalog/generate-controller-catalog.py" "$@"
        ;;
      xpad)
        exec /usr/bin/env python3 "$SCRIPT_DIR/catalog/generate-xpad-records.py" "$@"
        ;;
      *)
        die "Unknown: catalog $sub (expected: regenerate | xpad)"
        ;;
    esac
    ;;

  diagnose)
    sub="${1:-}"; shift || true
    case "$sub" in
      ""|-h|--help|help)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" help
        ;;
      record)
        record_path="${1:-}"
        [[ -n "$record_path" ]] || die "diagnose record requires a canonical controller JSON path"
        shift
        if [[ "$record_path" != /* ]]; then
          record_path="$PWD/$record_path"
        fi
        source "$SCRIPT_DIR/platform/environment.sh"
        setup_libusb_pkgconfig
        cd "$PROJECT_DIR"
        exec env OJD_USE_LOCAL_SWIFTUSB=1 "$SWIFT_BIN" run \
          OpenJoystickDriverHIDTool --record-probe "$record_path" "$@"
        ;;
      dext)
        require_no_args "diagnose dext" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" dext
        ;;
      sdl3)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" sdl3 "$@"
        ;;
      sdl3-gamecontroller)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" sdl3-gamecontroller "$@"
        ;;
      sdl3-hidapi-x360)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" sdl3-hidapi-x360 "$@"
        ;;
      gamecontroller)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" gamecontroller "$@"
        ;;
      catalina)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/catalina-smoke.sh" "$@"
        ;;
      backends)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/diagnose.sh" backends "$@"
        ;;
      *)
        die "Unknown: diagnose $sub (expected: record | dext | sdl3 | sdl3-gamecontroller | sdl3-hidapi-x360 | gamecontroller | catalina | backends)"
        ;;
    esac
    ;;

  check)
    sub="${1:-}"; shift || true
    case "$sub" in
      profiles)
        require_no_args "check profiles" "$@"
        exec /usr/bin/env python3 "$SCRIPT_DIR/catalog/validate-profiles.py"
        ;;
      scripts)
        require_no_args "check scripts" "$@"
        exec /usr/bin/env python3 "$SCRIPT_DIR/quality/validate-scripts.py"
        ;;
      swift-structure)
        require_no_args "check swift-structure" "$@"
        exec /usr/bin/env python3 "$SCRIPT_DIR/quality/validate-swift-structure.py"
        ;;
      driverkit)
        require_no_args "check driverkit" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/driverkit.sh" validate
        ;;
      *)
        die "Unknown: check $sub (expected: profiles | scripts | swift-structure | driverkit)"
        ;;
    esac
    ;;

  test)
    sub="${1:-}"; shift || true
    case "$sub" in
      parsers-macos14)
        require_no_args "test parsers-macos14" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/quality/test-parsers-macos14.sh"
        ;;
      scripts)
        require_no_args "test scripts" "$@"
        (
          cd "$PROJECT_DIR"
          exec /usr/bin/env python3 -m unittest discover \
            -s Tests/Scripts -p 'test_*.py' -v
        )
        ;;
      *)
        die "Unknown: test $sub (expected: parsers-macos14 | scripts)"
        ;;
    esac
    ;;

  repair)
    sub="${1:-}"; shift || true
    case "$sub" in
      stale-dext)
        require_no_args "repair stale-dext" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/dext/repair.sh"
        ;;
      swiftpm-module-cache)
        require_no_args "repair swiftpm-module-cache" "$@"
        (
          cd "$PROJECT_DIR"
          if [[ ! -d ".build" ]]; then
            echo "No .build directory; nothing to clean."
            exit 0
          fi

          swift_package="${SWIFT_PACKAGE_BIN:-}"
          if [[ -z "$swift_package" ]]; then
            swift_package="$(xcrun --find swift-package 2>/dev/null || command -v swift-package)"
          fi
          "$swift_package" clean
          echo "Cleaned SwiftPM build products."
        )
        ;;
      *)
        die "Unknown: repair $sub (expected: stale-dext | swiftpm-module-cache)"
        ;;
    esac
    ;;

  launch)
    sub="${1:-}"; shift || true
    case "$sub" in
      sdl-gamecontroller)
        exec /usr/bin/env bash "$SCRIPT_DIR/diagnostics/sdl/gamecontroller.sh" "$@"
        ;;
      *)
        die "Unknown: launch $sub (expected: sdl-gamecontroller)"
        ;;
    esac
    ;;

  lint)
    require_no_args "lint" "$@"
    exec /usr/bin/env bash "$SCRIPT_DIR/build-tools/build.sh" lint
    ;;

  release)
    sub="${1:-}"; shift || true
    case "$sub" in
      ""|help|-h|--help)
        usage
        ;;
      bump-version)
        require_one_arg "release bump-version" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/release/bump-version.sh" "$@"
        ;;
      package)
        require_at_most_one_arg "release package" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/package.sh" release "$@"
        ;;
      install-local)
        require_at_most_one_arg "release install-local" "$@"
        exec /usr/bin/env bash "$SCRIPT_DIR/release/install-local.sh" "$@"
        ;;
      notarize)
        action="${1:-}"; shift || true
        case "$action" in
          submit|"")
            require_no_args "release notarize submit" "$@"
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" submit
            ;;
          help|-h|--help)
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" help
            ;;
          status)
            require_at_most_one_arg "release notarize status" "$@"
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" status "$@"
            ;;
          history)
            require_no_args "release notarize history" "$@"
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" history
            ;;
          log)
            require_one_arg "release notarize log" "$@"
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" log "$@"
            ;;
          store-credentials)
            require_at_most_one_arg "release notarize store-credentials" "$@"
            exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" store-credentials "$@"
            ;;
          *)
            die "Unknown: release notarize $action (expected: submit | status | history | log | store-credentials)"
            ;;
        esac
        ;;
      *) die "Unknown: release $sub (expected: bump-version | package | install-local | notarize)" ;;
    esac
    ;;

  notarize)
    sub="${1:-}"; shift || true
    case "$sub" in
      submit|"")
        require_no_args "notarize submit" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" submit
        ;;
      help|-h|--help)
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" help
        ;;
      status)
        require_at_most_one_arg "notarize status" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" status "$@"
        ;;
      history)
        require_no_args "notarize history" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" history
        ;;
      log)
        require_one_arg "notarize log" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" log "$@"
        ;;
      store-credentials)
        require_at_most_one_arg "notarize store-credentials" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/notarize.sh" store-credentials "$@"
        ;;
      *)
        die "Unknown: notarize $sub (expected: submit | status | history | log | store-credentials)"
        ;;
    esac
    ;;

  package)
    sub="${1:-}"; shift || true
    case "$sub" in
      ""|-h|--help|help)
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/package.sh" help
        ;;
      release)
        require_at_most_one_arg "package release" "$@"
        exec env OJD_ENV=release /usr/bin/env bash "$SCRIPT_DIR/release/package.sh" release "$@"
        ;;
      *)
        die "Unknown: package $sub (expected: release)"
        ;;
    esac
    ;;

  *)
    die "Unknown command: $cmd (run: ./scripts/ojd --help)"
    ;;
esac
