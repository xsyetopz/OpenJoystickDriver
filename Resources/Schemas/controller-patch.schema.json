{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/controller-patch.schema.json",
  "description": "A merge patch for controller records, with the key paths to remove first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "selector"],
  "anyOf": [{"required": ["patch"]}, {"required": ["remove"]}],
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "ControllerPatch"
    },
    "selector": {
      "description": "The records the patch applies to.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendorID", "productID"],
          "properties": {
            "vendorID": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "productID": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": {
              "description": "The model id of the records.",
              "type": "string",
              "pattern": "^[0-9a-f]{4}-[0-9a-f]{4}$"
            }
          }
        }
      ]
    },
    "remove": {
      "description": "Dotted key paths removed from the record before the patch applies.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(modes|usb|bluetoothLE|server|route|input|tuning)(\\.[A-Za-z0-9]+)*$"
      }
    },
    "patch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "modes": {
          "$ref": "controller.schema.json#/$defs/modes"
        },
        "usb": {
          "type": "object"
        },
        "bluetoothLE": {
          "type": "object"
        },
        "route": {
          "$ref": "controller.schema.json#/$defs/route"
        },
        "output": {
          "type": "object"
        },
        "input": {
          "type": "object"
        },
        "tuning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stickDeadzone": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/stickDeadzone"
            },
            "inputLivenessTimeoutMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/inputLivenessTimeoutMs"
            },
            "hidStartupIntervalMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/hidStartupIntervalMs"
            },
            "minimumHIDOutputIntervalMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/minimumHIDOutputIntervalMs"
            },
            "hidStartupRecoveryIntervalMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/hidStartupRecoveryIntervalMs"
            },
            "hidStartupRecoveryRounds": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/hidStartupRecoveryRounds"
            },
            "lizardResendTicks": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/lizardResendTicks"
            },
            "usbCommandTimeoutMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/usbCommandTimeoutMs"
            },
            "presenceResendReports": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/presenceResendReports"
            },
            "adapterDisconnectDelayMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/adapterDisconnectDelayMs"
            },
            "usbStartupIntervalMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/usbStartupIntervalMs"
            },
            "usbStartupRetryDelayMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/usbStartupRetryDelayMs"
            },
            "usbTransferTimeoutMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/usbTransferTimeoutMs"
            },
            "irWriteIntervalMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/irWriteIntervalMs"
            },
            "speakerMaxSeconds": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/speakerMaxSeconds"
            },
            "replyTimeoutMs": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/replyTimeoutMs"
            },
            "frameQueueCapacity": {
              "$ref": "controller.schema.json#/$defs/tuning/properties/frameQueueCapacity"
            }
          }
        },
        "server": {
          "$ref": "controller.schema.json#/$defs/server"
        }
      }
    }
  },
  "if": {
    "properties": {
      "selector": {
        "required": ["all"]
      }
    }
  },
  "then": {
    "properties": {
      "patch": {
        "required": ["tuning"],
        "propertyNames": {
          "const": "tuning"
        }
      },
      "remove": {
        "items": {
          "pattern": "^tuning\\.[A-Za-z0-9]+$"
        }
      }
    }
  }
}
