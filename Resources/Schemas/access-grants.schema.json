{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/access-grants.schema.json",
  "title": "OpenJoystickDriver endpoint access grants",
  "description": "The endpoint access grants file.",
  "type": "object",
  "required": ["apiVersion", "kind", "enabled", "grants", "tokens", "web"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "AccessGrants"
    },
    "enabled": {
      "description": "Whether the endpoint socket exists.",
      "type": "boolean"
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grant"
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "web": {
      "description": "The WebSocket and overlay pages on 127.0.0.1.",
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["port"]
      },
      "properties": {
        "enabled": {
          "description": "Whether the service listens on the port.",
          "type": "boolean"
        },
        "port": {
          "description": "The TCP port of the web listener.",
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "description": "A permission level: 'Read' receives controller events, 'Control' drives a virtual gamepad.",
      "enum": ["Read", "Control"]
    },
    "token": {
      "description": "A named token that lets a client use the endpoint without a signature check.",
      "type": "object",
      "required": ["name", "tokenSHA256", "origins", "scopes", "grantedAt"],
      "$ref": "#/$defs/controlIsMarked",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "controlGrantedAt": {
          "description": "When 'Control' was granted.",
          "type": "string",
          "format": "date-time"
        },
        "tokenSHA256": {
          "description": "The SHA-256 of the token, in lowercase hex.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origins": {
          "description": "The web origins whose pages may use the token on the WebSocket.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://[^/?#@A-Z]+$"
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "grantedAt": {
          "description": "When the token was granted.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "grant": {
      "description": "A client the user allowed, matched by its code signature.",
      "type": "object",
      "required": ["publisher", "identifier", "scopes", "grantedAt", "path"],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "description": "Who published the client: a certificate publisher or the platform vendor.",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["Signed", "Platform"]
            },
            "id": {
              "description": "The publisher's identifier.",
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "Signed"
              }
            }
          },
          "then": {
            "required": ["id"]
          }
        },
        "identifier": {
          "description": "The code signing identifier.",
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "grantedAt": {
          "description": "When the grant was last made.",
          "type": "string",
          "format": "date-time"
        },
        "controlGrantedAt": {
          "description": "When 'Control' was granted.",
          "type": "string",
          "format": "date-time"
        },
        "path": {
          "description": "Where the client was when it was granted.",
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/controlIsMarked"
        }
      ]
    },
    "controlIsMarked": {
      "if": {
        "properties": {
          "scopes": {
            "items": {
              "const": "Read"
            }
          }
        },
        "required": ["scopes"]
      },
      "else": {
        "required": ["controlGrantedAt"]
      }
    }
  }
}
