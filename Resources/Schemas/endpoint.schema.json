{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/endpoint.schema.json",
  "title": "OpenJoystickDriver endpoint protocol",
  "description": "One line of the endpoint protocol.",
  "oneOf": [
    {
      "$ref": "#/$defs/clientLine"
    },
    {
      "$ref": "#/$defs/serviceLine"
    }
  ],
  "$defs": {
    "clientLine": {
      "oneOf": [
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/subscription"
        },
        {
          "$ref": "#/$defs/feedRequest"
        },
        {
          "$ref": "#/$defs/profileRequest"
        },
        {
          "$ref": "#/$defs/modListRequest"
        },
        {
          "$ref": "#/$defs/outputRequest"
        },
        {
          "$ref": "#/$defs/frame"
        },
        {
          "$ref": "#/$defs/keepAlive"
        },
        {
          "$ref": "#/$defs/drain"
        }
      ]
    },
    "serviceLine": {
      "oneOf": [
        {
          "$ref": "#/$defs/challenge"
        },
        {
          "$ref": "#/$defs/welcome"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/requestFailure"
        },
        {
          "$ref": "#/$defs/profileResult"
        },
        {
          "$ref": "#/$defs/mods"
        },
        {
          "$ref": "#/$defs/profiles"
        },
        {
          "$ref": "#/$defs/outputResult"
        },
        {
          "$ref": "cli-output.schema.json#/$defs/sharedControllerWatchEvent"
        },
        {
          "$ref": "#/$defs/feedSession"
        },
        {
          "$ref": "#/$defs/drained"
        },
        {
          "$ref": "cli-output.schema.json#/$defs/sharedVirtualFeedLine"
        }
      ]
    },
    "apiVersion": {
      "$ref": "cli-output.schema.json#/$defs/sharedAPIVersion"
    },
    "hello": {
      "type": "object",
      "required": ["apiVersion", "kind", "scopes"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Hello"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "access-grants.schema.json#/$defs/scope"
          },
          "description": "The scopes the client needs."
        },
        "tokenName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "description": "The name of the token that the client presents."
        },
        "proof": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The lowercase hex HMAC-SHA256 proof of the token, keyed with the SHA-256 of the token."
        }
      },
      "if": {
        "required": ["tokenName"]
      },
      "then": {
        "required": ["proof"]
      }
    },
    "challenge": {
      "type": "object",
      "required": ["apiVersion", "kind", "nonce"],
      "additionalProperties": false,
      "description": "The first line on every connection.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Challenge"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Random bytes in unpadded base64url, new for each connection."
        }
      }
    },
    "welcome": {
      "type": "object",
      "required": ["apiVersion", "kind", "scopes", "version"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Welcome"
        },
        "version": {
          "type": "string",
          "description": "The OpenJoystickDriver version."
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "access-grants.schema.json#/$defs/scope"
          }
        }
      }
    },
    "subscription": {
      "type": "object",
      "required": ["apiVersion", "kind", "stream"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Subscription"
        },
        "stream": {
          "enum": ["Controllers", "Profiles", "Mods"]
        },
        "output": {
          "type": "boolean",
          "description": "Whether the watch lines add the virtual gamepad's values."
        }
      },
      "if": {
        "properties": {
          "stream": {
            "const": "Controllers"
          }
        }
      },
      "else": {
        "not": {
          "required": ["output"]
        }
      }
    },
    "feedRequest": {
      "type": "object",
      "required": ["apiVersion", "as", "kind"],
      "additionalProperties": false,
      "description": "A request to publish a virtual gamepad that the connection drives.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "FeedRequest"
        },
        "as": {
          "$ref": "#/$defs/persona"
        }
      }
    },
    "modListRequest": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "additionalProperties": false,
      "description": "A request, with the read scope, for the installed mod packages.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "ModList"
        }
      }
    },
    "outputRequest": {
      "type": "object",
      "required": ["action", "apiVersion", "controller", "kind"],
      "additionalProperties": false,
      "description": "A request, with the control scope, to rumble, set the player indicator, or set the light of a controller.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "OutputRequest"
        },
        "controller": {
          "type": "string",
          "minLength": 1,
          "description": "The port key, the session token, or the vendor and product ID of one connected controller."
        },
        "action": {
          "enum": ["Rumble", "Player", "Light"]
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The intensity of the left main motor."
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The intensity of the right main motor."
        },
        "leftTrigger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The intensity of the left trigger motor."
        },
        "rightTrigger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The intensity of the right trigger motor."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "description": "The seconds that the motors run; 0.45 when absent."
        },
        "player": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "The player number from 1 to 4, or 0 for none."
        },
        "color": {
          "type": "string",
          "pattern": "^#?[0-9A-Fa-f]{6}$",
          "description": "The lightbar color as six hexadecimal digits."
        },
        "brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "The LED brightness."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "Rumble"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["player"]
                },
                {
                  "required": ["color"]
                },
                {
                  "required": ["brightness"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "Player"
              }
            }
          },
          "then": {
            "required": ["player"],
            "not": {
              "anyOf": [
                {
                  "required": ["left"]
                },
                {
                  "required": ["right"]
                },
                {
                  "required": ["leftTrigger"]
                },
                {
                  "required": ["rightTrigger"]
                },
                {
                  "required": ["duration"]
                },
                {
                  "required": ["color"]
                },
                {
                  "required": ["brightness"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "Light"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": ["color"]
              },
              {
                "required": ["brightness"]
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": ["left"]
                },
                {
                  "required": ["right"]
                },
                {
                  "required": ["leftTrigger"]
                },
                {
                  "required": ["rightTrigger"]
                },
                {
                  "required": ["duration"]
                },
                {
                  "required": ["player"]
                }
              ]
            }
          }
        }
      ]
    },
    "outputResult": {
      "description": "The answer to an output request: what the controller did with each command.",
      "allOf": [
        {
          "$ref": "cli-output.schema.json#/$defs/sharedControllerOutput"
        },
        {
          "required": ["apiVersion", "kind"],
          "properties": {
            "kind": {
              "const": "OutputResult"
            }
          }
        }
      ]
    },
    "mods": {
      "type": "object",
      "required": ["apiVersion", "kind", "mods"],
      "additionalProperties": false,
      "description": "Every installed package in name order, sent as an answer or after a change.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Mods"
        },
        "mods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["files", "name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "problem": {
                "type": "string",
                "description": "Why the package is not used; absent when it is used."
              }
            }
          }
        }
      }
    },
    "profileRequest": {
      "type": "object",
      "required": ["action", "apiVersion", "kind", "profile"],
      "additionalProperties": false,
      "description": "A request, with the control scope, to activate, deactivate, or change one value of a remapping profile.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "ProfileRequest"
        },
        "action": {
          "enum": ["Activate", "Deactivate", "Set"]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "The UUID or the name of the profile."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "The dotted key of the profile value to set."
        },
        "value": {
          "description": "The value to set; null removes a member."
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "Set"
          }
        }
      },
      "then": {
        "required": ["key", "value"]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": ["key"]
            },
            {
              "required": ["value"]
            }
          ]
        }
      }
    },
    "profileResult": {
      "type": "object",
      "required": ["apiVersion", "kind", "profile"],
      "additionalProperties": false,
      "description": "The answer to ProfileRequest: the profile as the service reports it afterward.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "ProfileResult"
        },
        "profile": {
          "type": "object",
          "required": ["id", "isActive", "model", "name"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "model": {
              "type": "string",
              "description": "VVVV:PPPP of the controller model."
            },
            "isActive": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": ["apiVersion", "kind", "profiles"],
      "additionalProperties": false,
      "description": "Every saved profile, sent at once and again after each change.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Profiles"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileResult/properties/profile"
          }
        }
      }
    },
    "requestFailure": {
      "type": "object",
      "required": ["apiVersion", "code", "kind", "message", "status"],
      "additionalProperties": false,
      "description": "A Status line that refuses one request and leaves the connection open.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Status"
        },
        "status": {
          "const": "Failure"
        },
        "code": {
          "type": "string",
          "pattern": "^E[0-9]{4}$",
          "not": {
            "$ref": "#/$defs/error/properties/code"
          }
        },
        "message": {
          "type": "string",
          "description": "English text for logs; clients branch on code."
        }
      }
    },
    "feedSession": {
      "type": "object",
      "required": ["apiVersion", "as", "kind"],
      "additionalProperties": false,
      "description": "The answer to FeedRequest: the virtual gamepad exists and takes Frame lines.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "FeedSession"
        },
        "as": {
          "$ref": "#/$defs/persona"
        }
      }
    },
    "persona": {
      "enum": ["Generic", "SDLCompatible", "GameControllerCompatible"],
      "description": "The persona id of the virtual gamepad."
    },
    "frame": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "additionalProperties": false,
      "description": "One input frame for the virtual gamepad.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Frame"
        },
        "buttons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/control"
          }
        },
        "dpad": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "vocabulary.schema.json#/$defs/dpadControl"
          }
        },
        "axes": {
          "type": "object",
          "propertyNames": {
            "$ref": "vocabulary.schema.json#/$defs/gamepadAxis"
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "The axis values: sticks from -1 to 1 and triggers from 0 to 1."
        },
        "holdMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "description": "How long the frame shows at least; without it, the frame shows until the next one."
        }
      }
    },
    "keepAlive": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "additionalProperties": false,
      "description": "A line that keeps a feed from going idle.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "KeepAlive"
        }
      }
    },
    "drain": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "additionalProperties": false,
      "description": "A request for an answer once every frame sent before it has played.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Drain"
        }
      }
    },
    "drained": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "additionalProperties": false,
      "description": "The answer to a drain: every frame sent before it has played.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Drained"
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["apiVersion", "code", "kind", "message", "status"],
      "additionalProperties": false,
      "description": "A Status line: the failure that ends the connection.",
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "const": "Status"
        },
        "status": {
          "const": "Failure"
        },
        "code": {
          "description": "A stable endpoint error code.",
          "enum": [
            "E1001",
            "E1002",
            "E1003",
            "E1004",
            "E1005",
            "E1006",
            "E1007",
            "E1008",
            "E1009",
            "E1010",
            "E1011"
          ]
        },
        "message": {
          "type": "string",
          "description": "English text for logs; clients branch on code."
        },
        "details": {
          "type": "object",
          "required": ["supportedAPIVersions"],
          "additionalProperties": false,
          "properties": {
            "supportedAPIVersions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/apiVersion"
              },
              "description": "The API versions the service speaks."
            }
          }
        }
      },
      "if": {
        "properties": {
          "code": {
            "enum": ["E1009", "E1010", "E1011"]
          }
        }
      },
      "then": {
        "required": ["details"]
      },
      "else": {
        "not": {
          "required": ["details"]
        }
      }
    }
  }
}
