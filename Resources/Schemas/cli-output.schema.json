{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/cli-output.schema.json",
	"title": "ojd --json output",
	"description": "The --json output of each ojd command. Each command's entry in $defs is its command path in lowerCamelCase, such as controllerShow for 'ojd controller show'. Entries that start with 'shared' are shapes that several commands use. A command that streams prints one document per line, and each line matches the entry.",
	"$defs": {
		"bindingClear": {
			"type": "object",
			"required": [
				"all",
				"dryRun",
				"profile",
				"removed"
			],
			"additionalProperties": false,
			"properties": {
				"all": {
					"type": "boolean"
				},
				"dryRun": {
					"type": "boolean"
				},
				"profile": {
					"$ref": "#/$defs/sharedProfileSummary"
				},
				"removed": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"bindingList": {
			"type": "object",
			"required": [
				"bindings",
				"profile"
			],
			"additionalProperties": false,
			"properties": {
				"bindings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/sharedBindingSummary"
					}
				},
				"profile": {
					"$ref": "#/$defs/sharedProfileSummary"
				}
			}
		},
		"bindingSet": {
			"type": "object",
			"required": [
				"binding",
				"profile",
				"replaced"
			],
			"additionalProperties": false,
			"properties": {
				"binding": {
					"$ref": "#/$defs/sharedBindingSummary"
				},
				"profile": {
					"$ref": "#/$defs/sharedProfileSummary"
				},
				"replaced": {
					"type": "boolean"
				}
			}
		},
		"controllerCalibrate": {
			"type": "object",
			"required": [
				"calibrated",
				"collecting",
				"controller",
				"offsetDegreesPerSecond"
			],
			"additionalProperties": false,
			"properties": {
				"calibrated": {
					"type": "boolean"
				},
				"collecting": {
					"type": "boolean"
				},
				"controller": {
					"type": "string"
				},
				"offsetDegreesPerSecond": {
					"type": "object",
					"required": [
						"x",
						"y",
						"z"
					],
					"additionalProperties": false,
					"properties": {
						"x": {
							"type": "number"
						},
						"y": {
							"type": "number"
						},
						"z": {
							"type": "number"
						}
					}
				}
			}
		},
		"controllerCapture": {
			"type": "object",
			"required": [
				"direction",
				"hex",
				"length",
				"timestamp"
			],
			"additionalProperties": false,
			"properties": {
				"direction": {
					"enum": [
						"rx",
						"tx"
					]
				},
				"hex": {
					"type": "string",
					"pattern": "^[0-9A-Fa-f ]*$"
				},
				"length": {
					"type": "integer",
					"minimum": 0
				},
				"timestamp": {
					"type": "number"
				}
			}
		},
		"controllerDisconnect": {
			"$ref": "#/$defs/sharedControllerSession"
		},
		"controllerLight": {
			"$ref": "#/$defs/sharedControllerOutput"
		},
		"controllerList": {
			"type": "object",
			"required": [
				"controllers"
			],
			"additionalProperties": false,
			"properties": {
				"controllers": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"connection",
							"hasSerialNumber",
							"id",
							"name",
							"productID",
							"protocol",
							"session",
							"vendorID"
						],
						"additionalProperties": false,
						"properties": {
							"connection": {
								"type": "string"
							},
							"hasSerialNumber": {
								"type": "boolean"
							},
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"productID": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"protocol": {
								"$ref": "report.schema.json#/$defs/controller/properties/protocolBinding"
							},
							"session": {
								"enum": [
									"active",
									"suspended"
								]
							},
							"unit": {
								"type": "string",
								"pattern": "^U-[A-Za-z0-9_-]{16}$",
								"description": "The persistent unit ID: stays the same while the controller uses the same port. Absent without a location ID."
							},
							"vendorID": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			}
		},
		"controllerPair": {
			"$ref": "#/$defs/sharedJoyConPair"
		},
		"controllerPlayer": {
			"$ref": "#/$defs/sharedControllerOutput"
		},
		"controllerResume": {
			"$ref": "#/$defs/sharedControllerSession"
		},
		"controllerRumble": {
			"$ref": "#/$defs/sharedControllerOutput"
		},
		"controllerShow": {
			"type": "object",
			"required": [
				"controller"
			],
			"additionalProperties": false,
			"properties": {
				"controller": {
					"type": "object",
					"required": [
						"capabilities",
						"connection",
						"hasSerialNumber",
						"id",
						"inputHealth",
						"name",
						"outputChecks",
						"ownership",
						"productID",
						"protocol",
						"quirks",
						"session",
						"vendorID"
					],
					"additionalProperties": false,
					"properties": {
						"capabilities": {
							"type": "object",
							"required": [
								"adaptiveTriggers",
								"binaryRumbleMotors",
								"controls",
								"lightingFeatures",
								"motion",
								"rumbleMotors",
								"touchContactCount"
							],
							"additionalProperties": false,
							"properties": {
								"adaptiveTriggers": {
									"$ref": "report.schema.json#/$defs/physicalOutputCapabilities/properties/adaptiveTriggers"
								},
								"binaryRumbleMotors": {
									"type": "array",
									"items": {
										"$ref": "report.schema.json#/$defs/rumbleMotor"
									}
								},
								"controls": {
									"type": "array",
									"items": {
										"$ref": "controller.schema.json#/$defs/controlID"
									}
								},
								"lightingFeatures": {
									"$ref": "report.schema.json#/$defs/physicalOutputCapabilities/properties/lightingFeatures"
								},
								"motion": {
									"type": "boolean"
								},
								"rumbleMotors": {
									"type": "array",
									"items": {
										"$ref": "report.schema.json#/$defs/rumbleMotor"
									}
								},
								"touchContactCount": {
									"type": "integer",
									"minimum": 0
								}
							}
						},
						"connection": {
							"type": "string"
						},
						"hasSerialNumber": {
							"type": "boolean"
						},
						"id": {
							"type": "string"
						},
						"inputHealth": {
							"type": "object",
							"required": [
								"recoveryCount",
								"state"
							],
							"additionalProperties": false,
							"properties": {
								"failureReason": {
									"$ref": "report.schema.json#/$defs/controllerInputHealth/properties/failureReason"
								},
								"recoveryCount": {
									"type": "integer",
									"minimum": 0
								},
								"reportFormat": {
									"type": "string"
								},
								"state": {
									"$ref": "report.schema.json#/$defs/controllerInputHealth/properties/state"
								}
							}
						},
						"interfaceNumber": {
							"type": "integer",
							"minimum": 0
						},
						"name": {
							"type": "string"
						},
						"outputChecks": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"command",
									"expected",
									"id"
								],
								"additionalProperties": false,
								"properties": {
									"command": {
										"type": "string"
									},
									"expected": {
										"type": "string"
									},
									"id": {
										"type": "string"
									}
								}
							}
						},
						"ownership": {
							"type": "object",
							"required": [
								"discoverySource",
								"duplicateExposureRisk",
								"hidInput",
								"physical"
							],
							"additionalProperties": false,
							"properties": {
								"discoverySource": {
									"enum": [
										"hid",
										"raw-usb"
									]
								},
								"duplicateExposureRisk": {
									"enum": [
										"none",
										"nativeHIDVisible",
										"upstreamVirtualDevice",
										"unknownOwnership"
									]
								},
								"hidInput": {
									"enum": [
										"unknown",
										"exclusive",
										"shared",
										"accessDenied",
										"ownedByAnotherClient",
										"acquisitionFailed"
									]
								},
								"physical": {
									"enum": [
										"exclusiveHID",
										"exclusiveRawUSB",
										"driverKitOwnedUSB",
										"nativeHIDVisible",
										"nativeGamepad",
										"upstreamVirtualDevice",
										"unknown"
									]
								}
							}
						},
						"productID": {
							"type": "integer",
							"minimum": 0,
							"maximum": 65535
						},
						"protocol": {
							"$ref": "report.schema.json#/$defs/controller/properties/protocolBinding"
						},
						"publication": {
							"description": "Whether a virtual device publishes the controller.",
							"type": "object",
							"required": [
								"state"
							],
							"additionalProperties": false,
							"properties": {
								"lastAttemptedNanoseconds": {
									"description": "System uptime of the last send to the virtual device.",
									"type": "integer",
									"minimum": 0
								},
								"lastCompletedNanoseconds": {
									"description": "System uptime of the last send the virtual device accepted.",
									"type": "integer",
									"minimum": 0
								},
								"reason": {
									"type": "string"
								},
								"state": {
									"enum": [
										"published",
										"not-published",
										"failed"
									]
								},
								"target": {
									"enum": [
										"hid-xbox-one-s-bt",
										"hid-generic"
									]
								}
							}
						},
						"quirks": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"record": {
							"description": "The effective record for the controller's model. Absent when no record matches.",
							"type": "object",
							"required": [
								"layer"
							],
							"additionalProperties": false,
							"properties": {
								"file": {
									"type": "string"
								},
								"layer": {
									"enum": [
										"bundled",
										"user"
									]
								}
							}
						},
						"session": {
							"enum": [
								"active",
								"suspended"
							]
						},
						"startupCommandStatus": {
							"type": "string"
						},
						"unit": {
							"type": "string",
							"pattern": "^U-[A-Za-z0-9_-]{16}$",
							"description": "The persistent unit ID: stays the same while the controller uses the same port. Absent without a location ID."
						},
						"vendorID": {
							"type": "integer",
							"minimum": 0,
							"maximum": 65535
						},
						"virtual": {
							"type": "object",
							"required": [
								"unavailable"
							],
							"additionalProperties": false,
							"properties": {
								"override": {
									"enum": [
										"hid-xbox-one-s-bt",
										"hid-generic"
									]
								},
								"overrideScope": {
									"enum": [
										"unit",
										"model"
									],
									"description": "Whether override is the controller's own choice or its model's."
								},
								"profile": {
									"enum": [
										"hid-xbox-one-s-bt",
										"hid-generic"
									]
								},
								"source": {
									"type": "string"
								},
								"unavailable": {
									"type": "boolean"
								}
							}
						}
					}
				}
			}
		},
		"controllerSuspend": {
			"$ref": "#/$defs/sharedControllerSession"
		},
		"controllerUnpair": {
			"$ref": "#/$defs/sharedJoyConPair"
		},
		"controllerWatch": {
			"description": "With --first-press, the first control pressed; with --output, one controller state and the virtual gamepad's values per line; otherwise one controller state per line.",
			"oneOf": [
				{
					"type": "object",
					"required": [
						"control"
					],
					"additionalProperties": false,
					"properties": {
						"control": {
							"$ref": "controller.schema.json#/$defs/controlID"
						},
						"direction": {
							"enum": [
								"north",
								"north-east",
								"east",
								"south-east",
								"south",
								"south-west",
								"west",
								"north-west"
							]
						}
					}
				},
				{
					"$ref": "#/$defs/sharedControllerState"
				},
				{
					"type": "object",
					"required": [
						"input"
					],
					"additionalProperties": false,
					"properties": {
						"input": {
							"$ref": "#/$defs/sharedControllerState"
						},
						"output": {
							"description": "Absent when the controller is not published.",
							"$ref": "#/$defs/sharedVirtualOutput"
						}
					}
				}
			]
		},
		"diagnose": {
			"type": "object",
			"required": [
				"checks"
			],
			"additionalProperties": false,
			"properties": {
				"bundle": {
					"type": "string"
				},
				"checks": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"detail",
							"id",
							"status"
						],
						"additionalProperties": false,
						"properties": {
							"detail": {
								"type": "string"
							},
							"id": {
								"type": "string"
							},
							"status": {
								"enum": [
									"pass",
									"warn",
									"fail",
									"skip"
								]
							}
						}
					}
				}
			}
		},
		"extensionActivate": {
			"$ref": "#/$defs/sharedExtensionState"
		},
		"extensionDeactivate": {
			"$ref": "#/$defs/sharedExtensionState"
		},
		"extensionStatus": {
			"type": "object",
			"required": [
				"bundle",
				"registration"
			],
			"additionalProperties": false,
			"properties": {
				"bundle": {
					"enum": [
						"present",
						"missing",
						"invalid"
					]
				},
				"detail": {
					"type": "string"
				},
				"registration": {
					"enum": [
						"active",
						"inactive",
						"absent",
						"unavailable"
					]
				}
			}
		},
		"logExport": {
			"type": "object",
			"required": [
				"lines",
				"path"
			],
			"additionalProperties": false,
			"properties": {
				"lines": {
					"description": "The number of log lines written.",
					"type": "integer",
					"minimum": 0
				},
				"path": {
					"type": "string"
				}
			}
		},
		"logPath": {
			"type": "object",
			"required": [
				"path"
			],
			"additionalProperties": false,
			"properties": {
				"path": {
					"type": "string"
				}
			}
		},
		"logShow": {
			"description": "A snapshot of each log, or with -f one line per log line.",
			"oneOf": [
				{
					"type": "object",
					"required": [
						"logs"
					],
					"additionalProperties": false,
					"properties": {
						"logs": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"exists",
									"fileSizeBytes",
									"lines",
									"path",
									"stream",
									"truncated"
								],
								"additionalProperties": false,
								"properties": {
									"exists": {
										"type": "boolean"
									},
									"fileSizeBytes": {
										"type": "integer",
										"minimum": 0
									},
									"lines": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"path": {
										"type": "string"
									},
									"stream": {
										"enum": [
											"standardOutput",
											"standardError"
										]
									},
									"truncated": {
										"type": "boolean"
									}
								}
							}
						}
					}
				},
				{
					"type": "object",
					"required": [
						"line",
						"stream"
					],
					"additionalProperties": false,
					"properties": {
						"line": {
							"type": "string"
						},
						"stream": {
							"enum": [
								"standardOutput",
								"standardError"
							]
						}
					}
				}
			]
		},
		"permissionList": {
			"$ref": "#/$defs/sharedPermissions"
		},
		"permissionRequest": {
			"$ref": "#/$defs/sharedPermissions"
		},
		"profileActivate": {
			"$ref": "#/$defs/sharedProfileResult"
		},
		"profileCreate": {
			"$ref": "#/$defs/sharedProfileResult"
		},
		"profileDeactivate": {
			"$ref": "#/$defs/sharedProfileResult"
		},
		"profileDelete": {
			"type": "object",
			"required": [
				"deleted",
				"dryRun"
			],
			"additionalProperties": false,
			"properties": {
				"deleted": {
					"$ref": "#/$defs/sharedProfileSummary"
				},
				"dryRun": {
					"type": "boolean"
				}
			}
		},
		"profileDuplicate": {
			"$ref": "#/$defs/sharedProfileResult"
		},
		"profileGet": {
			"type": "object",
			"required": [
				"key",
				"value"
			],
			"additionalProperties": false,
			"properties": {
				"key": {
					"type": "string",
					"minLength": 1
				},
				"value": {
					"description": "The value at key in the profile file, which profile.schema.json describes.",
					"type": [
						"array",
						"boolean",
						"number",
						"object",
						"string"
					]
				}
			}
		},
		"profileImport": {
			"type": "object",
			"required": [
				"profile",
				"replaced"
			],
			"additionalProperties": false,
			"properties": {
				"profile": {
					"$ref": "#/$defs/sharedProfileSummary"
				},
				"replaced": {
					"type": "boolean"
				}
			}
		},
		"profileList": {
			"type": "object",
			"required": [
				"issues",
				"profiles"
			],
			"additionalProperties": false,
			"properties": {
				"issues": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/sharedProfileIssue"
					}
				},
				"profiles": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/sharedProfileSummary"
					}
				}
			}
		},
		"profileRecover": {
			"type": "object",
			"required": [
				"dryRun",
				"recovered"
			],
			"additionalProperties": false,
			"properties": {
				"dryRun": {
					"type": "boolean"
				},
				"recovered": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/sharedProfileIssue"
					}
				}
			}
		},
		"profileRename": {
			"$ref": "#/$defs/sharedProfileResult"
		},
		"profileSet": {
			"$ref": "#/$defs/sharedProfileResult"
		},
		"profileShow": {
			"type": "object",
			"required": [
				"document",
				"profile"
			],
			"additionalProperties": false,
			"properties": {
				"document": {
					"$ref": "profile.schema.json"
				},
				"profile": {
					"$ref": "#/$defs/sharedProfileSummary"
				}
			}
		},
		"profileValidate": {
			"type": "object",
			"required": [
				"valid"
			],
			"additionalProperties": false,
			"description": "A valid profile has every property except problem. An invalid profile has only valid and problem.",
			"properties": {
				"controller": {
					"type": "string",
					"pattern": "^[0-9A-F]{4}:[0-9A-F]{4}$"
				},
				"id": {
					"type": "string",
					"pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
				},
				"name": {
					"type": "string"
				},
				"problem": {
					"type": "string",
					"minLength": 1
				},
				"scope": {
					"type": "string",
					"pattern": "^(global|app:.+)$"
				},
				"valid": {
					"type": "boolean"
				}
			},
			"oneOf": [
				{
