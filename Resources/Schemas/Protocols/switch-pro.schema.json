{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/Protocols/switch-pro.schema.json",
  "title": "OpenJoystickDriver Switch Pro Protocol Profile",
  "description": "Protocol-specific metadata for Nintendo Switch Pro controllers.",
  "type": "object",
  "required": [
    "driver",
    "variant"
  ],
  "additionalProperties": false,
  "properties": {
    "driver": {
      "const": "SwitchPro"
    },
    "variant": {
      "type": "string",
      "enum": [
        "switchPro",
        "unknown"
      ]
    },
    "mapping_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "usbHandshake",
          "calibration",
          "imu",
          "rumble",
          "experimental",
          "needsHardwareTest"
        ]
      },
      "default": []
    }
  }
}
