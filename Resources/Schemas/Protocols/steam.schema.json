{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/Protocols/steam.schema.json",
  "title": "OpenJoystickDriver Steam Controller Protocol Profile",
  "description": "Protocol-specific metadata for Valve Steam Controller devices.",
  "type": "object",
  "required": [
    "driver",
    "variant"
  ],
  "additionalProperties": false,
  "properties": {
    "driver": {
      "const": "SteamController"
    },
    "variant": {
      "type": "string",
      "enum": [
        "steamController",
        "unknown"
      ]
    },
    "mapping_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "lizardMode",
          "trackpads",
          "gyro",
          "battery",
          "wirelessReceiver",
          "experimental",
          "needsHardwareTest"
        ]
      },
      "default": []
    }
  }
}
