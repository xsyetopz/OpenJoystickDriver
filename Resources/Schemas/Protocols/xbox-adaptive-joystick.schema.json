{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/Protocols/xbox-adaptive-joystick.schema.json",
  "title": "OpenJoystickDriver Xbox Adaptive Joystick Protocol Profile",
  "description": "Protocol-specific metadata for standalone Xbox Adaptive Joystick devices.",
  "type": "object",
  "required": [
    "driver",
    "variant"
  ],
  "additionalProperties": false,
  "properties": {
    "driver": {
      "const": "XboxAdaptiveJoystick"
    },
    "variant": {
      "type": "string",
      "enum": [
        "xboxAdaptiveJoystick",
        "unknown"
      ]
    },
    "mapping_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "rawUSBPackets",
          "genericHIDPackets",
          "experimental",
          "needsHardwareTest"
        ]
      },
      "default": []
    }
  }
}
