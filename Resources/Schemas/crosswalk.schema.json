{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha2/crosswalk.schema.json",
  "title": "OpenJoystickDriver control crosswalk",
  "description": "The authored table Resources/Vocabulary/crosswalk.json. It maps each control id to the name the W3C Gamepad, SDL3, Linux evdev, HID and Apple GameController documents give the same control, and records the source of each column. It is documentation: no schema accepts or maps any name in it.",
  "type": "object",
  "required": ["apiVersion", "kind", "sources", "controls"],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha2"
    },
    "kind": {
      "const": "Crosswalk"
    },
    "sources": {
      "type": "object",
      "required": ["w3c", "sdl", "evdev", "hid", "apple"],
      "additionalProperties": false,
      "properties": {
        "w3c": { "$ref": "#/$defs/source" },
        "sdl": { "$ref": "#/$defs/source" },
        "evdev": { "$ref": "#/$defs/source" },
        "hid": {
          "allOf": [{ "$ref": "#/$defs/source" }, { "required": ["pages"] }]
        },
        "apple": { "$ref": "#/$defs/source" }
      }
    },
    "controls": {
      "type": "object",
      "propertyNames": {
        "$ref": "vocabulary.schema.json#/$defs/control"
      },
      "additionalProperties": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "source": {
      "description": "The document one column is checked against. pages gives the number of each HID usage page the hid column names.",
      "type": "object",
      "required": ["document", "version", "url", "checkedOn"],
      "additionalProperties": false,
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "url": { "type": "string", "pattern": "^https://" },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checkedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "pages": {
          "type": "object",
          "required": [
            "GenericDesktop",
            "Simulation",
            "Button",
            "Telephony",
            "Consumer"
          ],
          "additionalProperties": false,
          "properties": {
            "GenericDesktop": { "type": "integer", "minimum": 1 },
            "Simulation": { "type": "integer", "minimum": 1 },
            "Button": { "type": "integer", "minimum": 1 },
            "Telephony": { "type": "integer", "minimum": 1 },
            "Consumer": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "row": {
      "description": "One control. A null column means the system has no such name.",
      "type": "object",
      "required": ["w3cButton", "w3cAxis", "sdl", "evdev", "hid", "apple"],
      "additionalProperties": false,
      "properties": {
        "w3cButton": { "type": ["integer", "null"], "minimum": 0 },
        "w3cAxis": { "type": ["integer", "null"], "minimum": 0 },
        "sdl": { "type": ["string", "null"], "minLength": 1 },
        "evdev": { "type": ["string", "null"], "minLength": 1 },
        "apple": { "type": ["string", "null"], "minLength": 1 },
        "hid": {
          "type": "array",
          "items": { "$ref": "#/$defs/hidUsage" }
        },
        "notes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "w3c": { "type": "string", "minLength": 1 },
            "sdl": { "type": "string", "minLength": 1 },
            "evdev": { "type": "string", "minLength": 1 },
            "hid": { "type": "string", "minLength": 1 },
            "apple": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "hidUsage": {
      "description": "A usage on a page. A null usage is the one the device's report descriptor assigns.",
      "type": "object",
      "required": ["page", "usage"],
      "additionalProperties": false,
      "properties": {
        "page": {
          "enum": [
            "GenericDesktop",
            "Simulation",
            "Button",
            "Telephony",
            "Consumer"
          ]
        },
        "usage": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
