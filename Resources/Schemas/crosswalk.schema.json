{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/crosswalk.schema.json",
  "title": "OpenJoystickDriver control crosswalk",
  "description": "The name each other system gives each control id, with the source of each column.",
  "type": "object",
  "required": ["apiVersion", "kind", "sources", "controls"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "Crosswalk"
    },
    "sources": {
      "type": "object",
      "required": ["w3c", "sdl", "evdev", "hid", "apple"],
      "additionalProperties": false,
      "properties": {
        "w3c": { "$ref": "#/$defs/source" },
        "sdl": { "$ref": "#/$defs/source" },
        "evdev": { "$ref": "#/$defs/source" },
        "hid": {
          "allOf": [{ "$ref": "#/$defs/source" }, { "required": ["pages"] }]
        },
        "apple": { "$ref": "#/$defs/source" }
      }
    },
    "controls": {
      "type": "object",
      "propertyNames": {
        "$ref": "vocabulary.schema.json#/$defs/control"
      },
      "additionalProperties": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "source": {
      "description": "The document one column is checked against.",
      "type": "object",
      "required": ["document", "version", "url", "checkedOn"],
      "additionalProperties": false,
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "url": { "type": "string", "pattern": "^https://" },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checkedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "pages": {
          "type": "object",
          "required": [
            "GenericDesktop",
            "Simulation",
            "Button",
            "Telephony",
            "Consumer"
          ],
          "additionalProperties": false,
          "properties": {
            "GenericDesktop": { "type": "integer", "minimum": 1 },
            "Simulation": { "type": "integer", "minimum": 1 },
            "Button": { "type": "integer", "minimum": 1 },
            "Telephony": { "type": "integer", "minimum": 1 },
            "Consumer": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "row": {
      "description": "One control and its name in each system.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "w3cButton": { "type": "integer", "minimum": 0 },
        "w3cAxis": { "type": "integer", "minimum": 0 },
        "sdl": { "type": "string", "minLength": 1 },
        "evdev": { "type": "string", "minLength": 1 },
        "apple": { "type": "string", "minLength": 1 },
        "hid": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hidUsage" }
        },
        "notes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "w3c": { "type": "string", "minLength": 1 },
            "sdl": { "type": "string", "minLength": 1 },
            "evdev": { "type": "string", "minLength": 1 },
            "hid": { "type": "string", "minLength": 1 },
            "apple": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "hidUsage": {
      "description": "A usage on a HID usage page.",
      "type": "object",
      "required": ["page"],
      "additionalProperties": false,
      "properties": {
        "page": {
          "enum": [
            "GenericDesktop",
            "Simulation",
            "Button",
            "Telephony",
            "Consumer"
          ]
        },
        "usage": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
