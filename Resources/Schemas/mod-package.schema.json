{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/mod-package.schema.json",
  "title": "OpenJoystickDriver mod package manifest",
  "description": "The mod.plist of a package folder. The folder holds Controllers/, Profiles/, and VirtualDevices/; each list names the files of one document kind in the subfolder that holds it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "version", "author", "requires"],
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "ModPackage"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase letters, digits, and hyphens. The installed folder has this name."
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum"],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/semver",
          "description": "The lowest OpenJoystickDriver version that runs the package."
        },
        "below": {
          "$ref": "#/$defs/semver",
          "description": "The lowest version that does not run the package."
        }
      }
    },
    "controllers": {
      "description": "Controller files in Controllers/, named vvvv-pppp.plist after the model they describe.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^[0-9a-f]{4}-[0-9a-f]{4}\\.plist$"
      }
    },
    "patches": {
      "description": "ControllerPatch files in Controllers/, named vvvv-pppp.patch.plist, model-vvvv-pppp.patch.plist, or all.patch.plist after the selector they carry.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^((model-)?[0-9a-f]{4}-[0-9a-f]{4}\\.patch\\.plist|all\\.patch\\.plist)$"
      }
    },
    "profiles": {
      "description": "Files in Profiles/.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.plist$"
      }
    },
    "virtualDevices": {
      "description": "VirtualDevice files in VirtualDevices/, named vvvv-pppp.plist or vvvv-pppp-U-<unit>.plist after the match they cover.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^[0-9a-f]{4}-[0-9a-f]{4}(-U-[A-Za-z0-9_-]{16})?\\.plist$"
      }
    }
  },
  "anyOf": [
    {
      "required": ["controllers"]
    },
    {
      "required": ["patches"]
    },
    {
      "required": ["profiles"]
    },
    {
      "required": ["virtualDevices"]
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
