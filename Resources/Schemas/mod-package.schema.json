{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/mod-package.schema.json",
  "title": "OpenJoystickDriver mod package manifest",
  "description": "The manifest of a mod package.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "version", "author", "requires"],
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "ModPackage"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The package name, which names the installed folder."
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum"],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/semver",
          "description": "The lowest OpenJoystickDriver version that runs the package."
        },
        "below": {
          "$ref": "#/$defs/semver",
          "description": "The lowest version that does not run the package."
        }
      }
    },
    "controllers": {
      "description": "The controller files of the package, one per model.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^[0-9a-f]{4}-[0-9a-f]{4}\\.plist$"
      }
    },
    "patches": {
      "description": "The controller patch files of the package, one per selector.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^((model-)?[0-9a-f]{4}-[0-9a-f]{4}\\.patch\\.plist|all\\.patch\\.plist)$"
      }
    },
    "profiles": {
      "description": "The profile files of the package.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.plist$"
      }
    },
    "virtualDevices": {
      "description": "The virtual device files of the package, one per match.",
      "$ref": "#/$defs/files",
      "items": {
        "pattern": "^[0-9a-f]{4}-[0-9a-f]{4}(-U-[A-Za-z0-9_-]{16})?\\.plist$"
      }
    }
  },
  "anyOf": [
    {
      "required": ["controllers"]
    },
    {
      "required": ["patches"]
    },
    {
      "required": ["profiles"]
    },
    {
      "required": ["virtualDevices"]
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
