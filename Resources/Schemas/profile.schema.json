{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha2/profile.schema.json",
  "title": "OpenJoystickDriver profile",
  "description": "A remapping profile, as 'ojd profile export' writes it and 'ojd profile import' reads it. The schema checks the shape and the range of each field. 'ojd profile validate' also checks the rules that span fields, such as duplicate sources and IDs.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "applicationScope",
    "bindings",
    "device",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha2"
    },
    "kind": {
      "const": "Profile"
    },
    "applicationScope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "Global"
            }
          }
        },
        {
          "type": "object",
          "required": ["appID", "type"],
          "additionalProperties": false,
          "properties": {
            "appID": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$"
            },
            "type": {
              "const": "Application"
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chord"
      }
    },
    "macros": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/macro"
      }
    },
    "device": {
      "type": "object",
      "description": "The controller model the profile applies to, and optionally one unit of it.",
      "required": ["productID", "vendorID"],
      "additionalProperties": false,
      "properties": {
        "productID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "vendorID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "unit": {
          "type": "string",
          "pattern": "^U-[A-Za-z0-9_-]{16}$",
          "description": "A unit ID from `ojd controller list`. The profile applies only to that unit; other units of the model ignore it."
        }
      }
    },
    "gyroOutput": {
      "$ref": "#/$defs/gyroOutput"
    },
    "pointerSpeed": {
      "$ref": "#/$defs/pointerSpeed"
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "joyConPair": {
      "type": "object",
      "required": ["gyroSelection"],
      "additionalProperties": false,
      "properties": {
        "gyroSelection": {
          "enum": ["Disabled", "Left", "Right"]
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "motionTuning": {
      "$ref": "#/$defs/motionTuning"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "description": "At most 80 characters, with no space at either end and no control characters."
    },
    "outputPolicy": {
      "type": "object",
      "required": ["physicalInput", "virtualGamepad"],
      "additionalProperties": false,
      "properties": {
        "physicalInput": {
          "enum": ["Shared", "Exclusive"]
        },
        "virtualGamepad": {
          "enum": ["Disabled", "Mapped", "Passthrough"]
        }
      }
    },
    "physicalColor": {
      "$ref": "#/$defs/color"
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "stickMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stickMapping"
      }
    },
    "touchMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/touchMapping"
      }
    },
    "triggerMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/triggerMapping"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "description": "An extra action of a binding, run from the same source.",
      "required": ["destination", "id"],
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "enum": [
            "Hold",
            "Toggle",
            "TapOnPress",
            "TapOnRelease",
            "Pulse",
            "Press",
            "Release"
          ],
          "default": "Hold"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "longHold": {
          "$ref": "#/$defs/longHold"
        },
        "multiTap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multiTap"
          }
        },
        "pulseDurationMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000,
          "default": 100,
          "description": "Only a pulse binding sets a value other than 100."
        },
        "turbo": {
          "$ref": "#/$defs/turbo"
        }
      }
    },
    "adaptiveTriggerEffect": {
      "type": "object",
      "description": "An off effect has startPosition and strength 0.",
      "required": ["kind", "startPosition", "strength"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["Off", "Resistance"]
        },
        "startPosition": {
          "$ref": "#/$defs/unitInterval"
        },
        "strength": {
          "$ref": "#/$defs/unitInterval"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "Off"
          }
        }
      },
      "then": {
        "properties": {
          "startPosition": {
            "const": 0
          },
          "strength": {
            "const": 0
          }
        }
      }
    },
    "axis": {
      "$ref": "vocabulary.schema.json#/$defs/axis"
    },
    "axisOutput": {
      "$ref": "vocabulary.schema.json#/$defs/horizontalStickAxis"
    },
    "axisTuning": {
      "type": "object",
      "required": [
        "deadzone",
        "digitalActivationThreshold",
        "gain",
        "inverted",
        "responseCurve"
      ],
      "additionalProperties": false,
      "properties": {
        "deadzone": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        },
        "digitalActivationThreshold": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "gain": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "inverted": {
          "type": "boolean"
        },
        "responseCurve": {
          "enum": ["Linear", "EaseIn", "EaseOut", "SmoothStep"]
        }
      }
    },
    "binding": {
      "type": "object",
      "required": ["destination", "id", "source"],
      "additionalProperties": false,
      "properties": {
        "additionalActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "axisTuning": {
          "$ref": "#/$defs/axisTuning"
        },
        "behavior": {
          "enum": [
            "Hold",
            "Toggle",
            "TapOnPress",
            "TapOnRelease",
            "Pulse",
            "Press",
            "Release"
          ],
          "default": "Hold"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "longHold": {
          "$ref": "#/$defs/longHold"
        },
        "multiTap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multiTap"
          }
        },
        "pulseDurationMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000,
          "default": 100,
          "description": "Only a pulse binding sets a value other than 100."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "turbo": {
          "$ref": "#/$defs/turbo"
        }
      }
    },
    "button": {
      "$ref": "vocabulary.schema.json#/$defs/control"
    },
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "chord": {
      "type": "object",
      "description": "Sources pressed together. Their order does not matter.",
      "required": ["destination", "id", "sources"],
      "additionalProperties": false,
      "properties": {
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "mode": {
          "enum": ["Modifier", "Simultaneous"],
          "default": "Modifier"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/discreteSource"
          }
        },
        "windowMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "default": 50
        }
      }
    },
    "color": {
      "type": "object",
      "required": ["blue", "green", "red"],
      "additionalProperties": false,
      "properties": {
        "blue": {
          "$ref": "#/$defs/byte"
        },
        "green": {
          "$ref": "#/$defs/byte"
        },
        "red": {
          "$ref": "#/$defs/byte"
        }
      }
    },
    "destination": {
      "description": "What a control does on the Mac or on the virtual gamepad.",
      "oneOf": [
        {
          "type": "object",
          "required": ["key", "modifiers", "type"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "enum": [
                "KeyA",
                "KeyB",
                "KeyC",
                "KeyD",
                "KeyE",
                "KeyF",
                "KeyG",
                "KeyH",
                "KeyI",
                "KeyJ",
                "KeyK",
                "KeyL",
                "KeyM",
                "KeyN",
                "KeyO",
                "KeyP",
                "KeyQ",
                "KeyR",
                "KeyS",
                "KeyT",
                "KeyU",
                "KeyV",
                "KeyW",
                "KeyX",
                "KeyY",
                "KeyZ",
                "Digit0",
                "Digit1",
                "Digit2",
                "Digit3",
                "Digit4",
                "Digit5",
                "Digit6",
                "Digit7",
                "Digit8",
                "Digit9",
                "Escape",
                "Tab",
                "CapsLock",
                "Space",
                "Enter",
                "Backspace",
                "Delete",
                "Help",
                "Insert",
                "Home",
                "End",
                "PageUp",
                "PageDown",
                "ArrowUp",
                "ArrowDown",
                "ArrowLeft",
                "ArrowRight",
                "Minus",
                "Equal",
                "BracketLeft",
                "BracketRight",
                "Backslash",
                "Semicolon",
                "Quote",
                "Comma",
                "Period",
                "Slash",
                "Backquote",
                "IntlBackslash",
                "F1",
                "F2",
                "F3",
                "F4",
                "F5",
                "F6",
                "F7",
                "F8",
                "F9",
                "F10",
                "F11",
                "F12",
                "F13",
                "F14",
                "F15",
                "F16",
                "F17",
                "F18",
                "F19",
                "F20",
                "Numpad0",
                "Numpad1",
                "Numpad2",
                "Numpad3",
                "Numpad4",
                "Numpad5",
                "Numpad6",
                "Numpad7",
                "Numpad8",
                "Numpad9",
                "NumpadDecimal",
                "NumpadMultiply",
                "NumpadAdd",
                "NumLock",
                "NumpadDivide",
                "NumpadEnter",
                "NumpadSubtract",
                "NumpadEqual"
              ]
            },
            "modifiers": {
              "type": "array",
              "items": {
                "enum": ["Alt", "Control", "Meta", "Shift"]
              }
            },
            "type": {
              "const": "Keyboard"
            }
          },
          "description": "OJD writes modifiers sorted and without repeats."
        },
        {
          "type": "object",
          "required": ["button", "type"],
          "additionalProperties": false,
          "properties": {
            "button": {
              "$ref": "#/$defs/button"
            },
            "type": {
              "const": "GamepadButton"
            }
          }
        },
        {
          "type": "object",
          "required": ["direction", "type"],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "$ref": "vocabulary.schema.json#/$defs/dpadControl"
            },
            "type": {
              "const": "GamepadDpad"
            }
          }
        },
        {
          "type": "object",
          "required": ["axis", "type"],
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/axis"
            },
            "type": {
              "const": "GamepadAxis"
            }
          }
        },
        {
          "type": "object",
          "required": ["button", "type"],
          "additionalProperties": false,
          "properties": {
            "button": {
              "enum": ["Left", "Right", "Middle", "Back", "Forward"]
            },
            "type": {
              "const": "MouseButton"
            }
          }
        },
        {
          "type": "object",
          "required": ["axis", "type"],
          "additionalProperties": false,
          "properties": {
            "axis": {
              "enum": ["X", "Y"]
            },
            "type": {
              "const": "MouseMovement"
            }
          }
        },
        {
          "type": "object",
          "required": ["axis", "type"],
          "additionalProperties": false,
          "properties": {
            "axis": {
              "enum": ["X", "Y"]
            },
            "type": {
              "const": "Scroll"
            }
          }
        },
        {
          "type": "object",
          "required": ["physical", "type"],
          "additionalProperties": false,
          "properties": {
            "physical": {
              "$ref": "#/$defs/physicalOutput"
            },
            "type": {
              "const": "Physical"
            }
          }
        },
        {
          "type": "object",
          "required": ["macro", "type"],
          "additionalProperties": false,
          "properties": {
            "macro": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "const": "Macro"
            }
          }
        },
        {
          "type": "object",
          "required": ["systemKey", "type"],
          "additionalProperties": false,
          "properties": {
            "systemKey": {
              "enum": [
                "PlayPause",
                "NextTrack",
                "PreviousTrack",
                "FastForward",
                "Rewind",
                "VolumeUp",
                "VolumeDown",
                "Mute",
                "BrightnessUp",
                "BrightnessDown",
                "KeyboardIlluminationUp",
                "KeyboardIlluminationDown"
              ]
            },
            "type": {
              "const": "SystemKey"
            }
          }
        },
        {
          "type": "object",
          "required": ["action", "type"],
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": ["MissionControl"]
            },
            "type": {
              "const": "SystemAction"
            }
          }
        },
        {
          "type": "object",
          "required": ["bundleIdentifier", "type"],
          "additionalProperties": false,
          "properties": {
            "bundleIdentifier": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "OpenApplication"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "OpenURL"
            },
            "url": {
              "description": "An absolute URL with a scheme other than file.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": ["name", "type"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "type": {
              "const": "RunShortcut"
            }
          }
        },
        {
          "type": "object",
          "required": ["text", "type"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "TypeText"
            }
          }
        },
        {
          "type": "object",
          "required": ["profile", "type"],
          "additionalProperties": false,
          "properties": {
            "profile": {
              "description": "A profile identifier of the same model, Next or Previous.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "enum": ["Next", "Previous"]
                }
              ]
            },
            "type": {
              "const": "ProfileSwitch"
            }
          }
        },
        {
          "type": "object",
          "required": ["layer", "mode", "type"],
          "additionalProperties": false,
          "properties": {
            "layer": {
              "type": "string",
              "format": "uuid"
            },
            "mode": {
              "enum": ["On", "Off", "Toggle"]
            },
            "type": {
              "const": "LayerSet"
            }
          }
        },
        {
          "type": "object",
          "required": ["mode", "type"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["On", "Off", "Toggle"]
            },
            "type": {
              "const": "Pause"
            }
          }
        },
        {
          "type": "object",
          "required": ["text", "type"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "voice": {
              "description": "An AVSpeechSynthesisVoice identifier that the Mac has.",
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "Speak"
            }
          }
        },
        {
          "type": "object",
          "required": ["channel", "note", "type", "velocity"],
          "additionalProperties": false,
          "properties": {
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "note": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "type": {
              "const": "MidiNote"
            },
            "velocity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": ["channel", "controller", "type"],
          "additionalProperties": false,
          "properties": {
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "controller": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "type": {
              "const": "MidiControlChange"
            }
          }
        }
      ]
    },
    "discreteSource": {
      "description": "A source that is pressed or released, so any source but a whole axis.",
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "not": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "const": "Axis"
              }
            }
          }
        }
      ]
    },
    "pointerSpeed": {
      "type": "object",
      "description": "Multiplies all pointer movement, not scroll, by a scale that a trigger or a stick sets: minScale at 0 and maxScale at 1, shaped by curve.",
      "required": ["curve", "driver", "maxScale", "minScale"],
      "additionalProperties": false,
      "properties": {
        "curve": {
          "enum": ["Linear", "EaseIn", "EaseOut", "SmoothStep"]
        },
        "driver": {
          "type": "object",
          "required": ["side", "type"],
          "additionalProperties": false,
          "properties": {
            "side": {
              "enum": ["Left", "Right"]
            },
            "type": {
              "enum": ["Trigger", "StickDepth"]
            }
          }
        },
        "maxScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "minScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "gyroOutput": {
      "type": "object",
      "description": "activationSource is set exactly when activationMode is not always.",
      "additionalProperties": false,
      "properties": {
        "activationMode": {
          "enum": ["Always", "WhileHeld", "WhileReleased", "Toggle"],
          "default": "Always"
        },
        "activationSource": {
          "$ref": "#/$defs/discreteSource"
        },
        "consumesActivationSource": {
          "type": "boolean",
          "default": true
        },
        "fullStickDegreesPerSecond": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000,
          "default": 360
        },
        "mode": {
          "enum": ["Disabled", "Mouse", "LeftStick", "RightStick"],
          "default": "Disabled"
        },
        "pointerPointsPerDegree": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 1
        },
        "trackball": {
          "$ref": "#/$defs/gyroTrackball"
        }
      },
      "if": {
        "properties": {
          "activationMode": {
            "const": "Always"
          }
        }
      },
      "then": {
        "not": {
          "required": ["activationSource"]
        }
      },
      "else": {
        "required": ["activationSource"]
      }
    },
    "gyroTrackball": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "axes": {
          "enum": ["Pitch", "Yaw", "Both"],
          "default": "Both"
        },
        "consumesSource": {
          "type": "boolean",
          "default": true
        },
        "decayHalvingsPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 1
        },
        "source": {
          "$ref": "#/$defs/discreteSource"
        }
      }
    },
    "layer": {
      "type": "object",
      "description": "Bindings that replace the base bindings while the activator is held or toggled on.",
      "required": [
        "activationMode",
        "activator",
        "bindings",
        "chords",
        "id",
        "name",
        "sequences"
      ],
      "additionalProperties": false,
      "properties": {
        "activationMode": {
          "enum": ["Hold", "Toggle"]
        },
        "activator": {
          "$ref": "#/$defs/discreteSource"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "chords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chord"
          }
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "motionTuning": {
          "$ref": "#/$defs/motionTuning"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$",
          "description": "At most 40 characters, with no space at either end and no control characters."
        },
        "sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequence"
          }
        }
      }
    },
    "lean": {
      "type": "object",
      "description": "hysteresisDegrees is less than thresholdDegrees.",
      "required": ["hysteresisDegrees", "thresholdDegrees"],
      "additionalProperties": false,
      "properties": {
        "hysteresisDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "thresholdDegrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 89
        }
      }
    },
    "longHold": {
      "type": "object",
      "required": ["destination", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "durationMs": {
          "type": "number",
          "minimum": 100,
          "maximum": 5000
        }
      }
    },
    "motionTuning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automaticBias": {
          "type": "boolean",
          "default": true
        },
        "gravityCorrectionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 2
        },
        "invertPitch": {
          "type": "boolean",
          "default": false
        },
        "invertYaw": {
          "type": "boolean",
          "default": false
        },
        "lean": {
          "$ref": "#/$defs/lean"
        },
        "pitchSensitivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "sideReductionThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.125
        },
        "smoothingHalfTimeMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        },
        "space": {
          "enum": ["Local", "Player", "World"],
          "default": "Player"
        },
        "steering": {
          "$ref": "#/$defs/steering"
        },
        "thresholdDegreesPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        },
        "yawRelaxation": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 1.41
        },
        "yawSensitivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        }
      }
    },
    "macro": {
      "description": "A named list of timed output steps that a Macro destination runs.",
      "type": "object",
      "required": ["id", "interruptOnRelease", "name", "repeat", "steps", "whileRunning"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "interruptOnRelease": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "repeat": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            {
              "const": "WhileHeld"
            }
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/macroStep"
          }
        },
        "whileRunning": {
          "enum": ["Ignore", "Restart"]
        }
      }
    },
    "macroStep": {
      "oneOf": [
        {
          "type": "object",
          "required": ["destination", "type"],
          "additionalProperties": false,
          "properties": {
            "destination": {
              "$ref": "#/$defs/destination"
            },
            "type": {
              "enum": ["Tap", "Press", "Release"]
            }
          }
        },
        {
          "type": "object",
          "required": ["destinations", "holdMs", "type"],
          "additionalProperties": false,
          "properties": {
            "destinations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/destination"
              }
            },
            "holdMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "type": {
              "const": "Chord"
            }
          }
        },
        {
          "type": "object",
          "required": ["durationMs", "type"],
          "additionalProperties": false,
          "properties": {
            "durationMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "type": {
              "const": "Wait"
            }
          }
        }
      ]
    },
    "multiTap": {
      "type": "object",
      "required": ["count", "destination", "windowMs"],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "windowMs": {
          "type": "number",
          "minimum": 50,
          "maximum": 1000
        }
      }
    },
    "physicalOutput": {
      "description": "A value sent to the physical controller while the action is active.",
      "oneOf": [
        {
          "type": "object",
          "required": ["intensity", "motor", "type"],
          "additionalProperties": false,
          "properties": {
            "intensity": {
              "$ref": "#/$defs/unitInterval"
            },
            "motor": {
              "enum": [
                "LowFrequency",
                "HighFrequency",
                "LeftTrigger",
                "RightTrigger",
                "LeftHaptic",
                "RightHaptic"
              ]
            },
            "type": {
              "const": "Rumble"
            }
          }
        },
        {
          "type": "object",
          "required": ["indicator", "type"],
          "additionalProperties": false,
          "properties": {
            "indicator": {
              "enum": [0, 1, 2, 3, 4]
            },
            "type": {
              "const": "PlayerIndicator"
            }
          }
        },
        {
          "type": "object",
          "required": ["blue", "green", "red", "type"],
          "additionalProperties": false,
          "properties": {
            "blue": {
              "$ref": "#/$defs/byte"
            },
            "green": {
              "$ref": "#/$defs/byte"
            },
            "red": {
              "$ref": "#/$defs/byte"
            },
            "type": {
              "const": "Color"
            }
          }
        },
        {
          "type": "object",
          "required": ["intensity", "type"],
          "additionalProperties": false,
          "properties": {
            "intensity": {
              "$ref": "#/$defs/unitInterval"
            },
            "type": {
              "const": "Brightness"
            }
          }
        },
        {
          "type": "object",
          "required": ["effect", "trigger", "type"],
          "additionalProperties": false,
          "properties": {
            "effect": {
              "$ref": "#/$defs/adaptiveTriggerEffect"
            },
            "trigger": {
              "enum": ["Left", "Right"]
            },
            "type": {
              "const": "AdaptiveTrigger"
            }
          }
        }
      ]
    },
    "sequence": {
      "type": "object",
      "description": "Sources pressed one after another, in order.",
      "required": ["destination", "id", "sources", "windowMs"],
      "additionalProperties": false,
      "properties": {
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/discreteSource"
          }
        },
        "windowMs": {
          "type": "number",
          "minimum": 200,
          "maximum": 10000
        }
      }
    },
    "source": {
      "description": "A control on the physical controller.",
      "oneOf": [
        {
          "type": "object",
          "required": ["button", "type"],
          "additionalProperties": false,
          "properties": {
            "button": {
              "$ref": "#/$defs/button"
            },
            "type": {
              "const": "Button"
            }
          }
        },
        {
          "type": "object",
          "required": ["direction", "type"],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "$ref": "vocabulary.schema.json#/$defs/dpadControl"
            },
            "type": {
              "const": "Dpad"
            }
          }
        },
        {
          "type": "object",
          "required": ["axis", "type"],
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/axis"
            },
            "type": {
              "const": "Axis"
            }
          }
        },
        {
          "type": "object",
          "required": ["axis", "direction", "type"],
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/axis"
            },
            "direction": {
              "enum": ["Negative", "Positive"]
            },
            "type": {
              "const": "AxisDirection"
            }
          }
        },
        {
          "type": "object",
          "required": ["stage", "trigger", "type"],
          "additionalProperties": false,
          "properties": {
            "stage": {
              "enum": ["Soft", "Full"]
            },
            "trigger": {
              "$ref": "#/$defs/triggerSide"
            },
            "type": {
              "const": "TriggerStage"
            }
          }
        },
        {
          "type": "object",
          "required": ["direction", "type"],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": ["Left", "Right"]
            },
            "type": {
              "const": "MotionLean"
            }
          }
        },
        {
          "type": "object",
          "required": ["surface", "type"],
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/touchSurface"
            },
            "type": {
              "const": "TouchContact"
            }
          }
        },
        {
          "type": "object",
          "required": ["column", "columns", "row", "rows", "surface", "type"],
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "surface": {
              "$ref": "#/$defs/touchSurface"
            },
            "type": {
              "const": "TouchGrid"
            }
          },
          "description": "column is less than columns, and row is less than rows."
        },
        {
          "type": "object",
          "required": ["direction", "minimumDistance", "surface", "type"],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": ["Up", "Down", "Left", "Right"]
            },
            "minimumDistance": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "surface": {
              "$ref": "#/$defs/touchSurface"
            },
            "type": {
              "const": "TouchSwipe"
            }
          }
        },
        {
          "type": "object",
          "required": ["hysteresis", "innerRadius", "outerRadius", "stick", "type"],
          "additionalProperties": false,
          "properties": {
            "fromDegrees": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "hysteresis": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            },
            "innerRadius": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "outerRadius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "stick": {
              "$ref": "#/$defs/stickSide"
            },
            "toDegrees": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 360
            },
            "type": {
              "const": "StickRegion"
            }
          },
          "oneOf": [
            {
              "required": ["fromDegrees", "toDegrees"]
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": ["fromDegrees"]
                  },
                  {
                    "required": ["toDegrees"]
                  }
                ]
              }
            }
          ],
          "description": "innerRadius is less than outerRadius, fromDegrees differs from toDegrees and a sector runs clockwise from up, past 0 when toDegrees is below fromDegrees. Regions of one stick do not overlap."
        },
        {
          "type": "object",
          "required": ["from", "hysteresis", "to", "trigger", "type"],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "hysteresis": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            },
            "to": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "trigger": {
              "$ref": "#/$defs/triggerSide"
            },
            "type": {
              "const": "TriggerBand"
            }
          },
          "description": "from is less than to. Bands of one trigger do not overlap, and a trigger with a triggerMappings entry has no bands."
        },
        {
          "type": "object",
          "required": ["height", "surface", "type", "width", "x", "y"],
          "additionalProperties": false,
          "properties": {
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "surface": {
              "$ref": "#/$defs/touchSurface"
            },
            "type": {
              "const": "TouchArea"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          },
          "description": "x plus width and y plus height are at most 1."
        }
      ]
    },
    "steering": {
      "type": "object",
      "description": "deadzoneDegrees is less than fullScaleDegrees.",
      "required": [
        "deadzoneDegrees",
        "fullScaleDegrees",
        "inverted",
        "output",
        "responseExponent"
      ],
      "additionalProperties": false,
      "properties": {
        "deadzoneDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 89
        },
        "fullScaleDegrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 90
        },
        "inverted": {
          "type": "boolean"
        },
        "output": {
          "$ref": "#/$defs/axisOutput"
        },
        "responseExponent": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        }
      }
    },
    "stickMapping": {
      "type": "object",
      "description": "flickHysteresis is less than flickThreshold.",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "aimDegreesPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 360
        },
        "flickDurationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 100
        },
        "flickHysteresis": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.1
        },
        "flickThreshold": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.9
        },
        "mode": {
          "enum": [
            "Aim",
            "Flick",
            "FlickOnly",
            "RotateOnly",
            "PointerArea",
            "PointerRing",
            "ScrollWheel",
            "Steering"
          ],
          "default": "Aim"
        },
        "passthrough": {
          "type": "boolean",
          "default": false
        },
        "pointerPointsPerDegree": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 1
        },
        "pointerRadiusPoints": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000,
          "default": 128
        },
        "rotationDirection": {
          "enum": ["Clockwise", "Counterclockwise"],
          "default": "Clockwise"
        },
        "scrollAxis": {
          "enum": ["Horizontal", "Vertical"],
          "default": "Vertical"
        },
        "scrollDegreesPerLine": {
          "type": "number",
          "minimum": 1,
          "maximum": 360,
          "default": 15
        },
        "source": {
          "$ref": "#/$defs/stickSide"
        },
        "steeringDegreesAtFullScale": {
          "type": "number",
          "minimum": 45,
          "maximum": 1440,
          "default": 360
        },
        "steeringOutput": {
          "$ref": "vocabulary.schema.json#/$defs/horizontalStickAxis",
          "default": "LeftStickX"
        },
        "steeringReturnDegreesPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 360
        },
        "tuning": {
          "$ref": "#/$defs/stickTuning"
        }
      }
    },
    "stickSide": {
      "enum": ["Left", "Right"]
    },
    "stickTuning": {
      "type": "object",
      "description": "innerDeadzone plus outerDeadzone is less than 1.",
      "additionalProperties": false,
      "properties": {
        "innerDeadzone": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95,
          "default": 0.1
        },
        "invertX": {
          "type": "boolean",
          "default": false
        },
        "invertY": {
          "type": "boolean",
          "default": false
        },
        "outerDeadzone": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95,
          "default": 0
        },
        "responseExponent": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1
        }
      }
    },
    "touchMapping": {
      "type": "object",
      "required": [
        "deadzone",
        "id",
        "mode",
        "pointerSensitivity",
        "stickRadius",
        "surface"
      ],
      "additionalProperties": false,
      "properties": {
        "deadzone": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "mode": {
          "enum": ["Pointer", "LeftStick", "RightStick"]
        },
        "pointerSensitivity": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000
        },
        "stickRadius": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "surface": {
          "$ref": "#/$defs/touchSurface"
        }
      }
    },
    "touchSurface": {
      "enum": ["Primary", "Left", "Right"]
    },
    "triggerMapping": {
      "type": "object",
      "description": "softThreshold is less than fullThreshold, and hysteresis is less than softThreshold.",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "fullThreshold": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.95
        },
        "hysteresis": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25,
          "default": 0.05
        },
        "mode": {
          "enum": [
            "Simultaneous",
            "Exclusive",
            "PreferFull",
            "PreferFullCombined",
            "ResponsivePreferFull",
            "ResponsivePreferFullCombined"
          ],
          "default": "Simultaneous"
        },
        "passthrough": {
          "type": "boolean",
          "default": false
        },
        "skipWindowMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "default": 150
        },
        "softThreshold": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.95,
          "default": 0.1
        },
        "source": {
          "$ref": "#/$defs/triggerSide"
        }
      }
    },
    "triggerSide": {
      "enum": ["Left", "Right"]
    },
    "turbo": {
      "type": "object",
      "required": ["dutyCycle", "repeatRateHz"],
      "additionalProperties": false,
      "properties": {
        "dutyCycle": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95
        },
        "initialDelayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2500,
          "default": 0
        },
        "maxRepeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "repeatRateHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    }
  }
}
