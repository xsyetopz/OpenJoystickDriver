{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller.schema.json",
	"type": "object",
	"required": ["$schema", "vendorID", "productID", "protocol"],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"const": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller.schema.json"
		},
		"vendorID": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"productID": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535
		},
		"protocol": {
			"$ref": "#/$defs/protocol"
		},
		"usb": {
			"$ref": "#/$defs/usbOverride"
		},
		"capabilities": {
			"$ref": "#/$defs/capabilities"
		},
		"ownership": {
			"$ref": "#/$defs/ownership"
		},
		"output": {
			"$ref": "#/$defs/output"
		},
		"input": {
			"$ref": "#/$defs/input"
		}
	},
	"$defs": {
		"protocol": {
			"type": "object",
			"required": ["family"],
			"additionalProperties": false,
			"properties": {
				"family": {
					"enum": [
						"hid.descriptor",
						"hid.report-layout",
						"xbox.xid",
						"xbox.xusb",
						"xbox.gip",
						"sony.sixaxis",
						"sony.dualshock4",
						"sony.dualsense",
						"nintendo.switch1",
						"valve.steam-controller",
						"vendor.flydigi",
						"vendor.ps3-third-party",
						"vendor.gamesir",
						"vendor.nvidia-shield"
					]
				},
				"variant": {
					"enum": [
						"gamepad",
						"wired",
						"receiver",
						"dongle",
						"usb",
						"bluetooth-le",
						"enhanced-hid"
					]
				},
				"quirks": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 1
				},
				"initialization": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/gipInitializationAction"
					}
				},
				"keepAlive": {
					"type": "boolean"
				},
				"assembly": {
					"enum": []
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.xid"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["gamepad"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.xusb"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["wired", "receiver"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "valve.steam-controller"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["wired", "dongle", "bluetooth-le"]
							},
							"quirks": {
								"items": {
									"enum": ["triton", "neptune"]
								},
								"maxItems": 1,
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "vendor.gamesir"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["usb", "enhanced-hid"]
							},
							"quirks": {
								"items": {
									"enum": ["inner-grips", "lighting-slots"]
								},
								"type": "array"
							}
						},
						"allOf": [
							{
								"if": {
									"properties": {
										"variant": {
											"const": "usb"
										}
									},
									"required": ["variant"]
								},
								"then": {
									"not": {
										"required": ["quirks"]
									}
								}
							},
							{
								"if": {
									"properties": {
										"variant": {
											"const": "enhanced-hid"
										}
									},
									"required": ["variant"]
								},
								"then": {
									"required": ["quirks"],
									"properties": {
										"quirks": {
											"maxItems": 1
										}
									}
								}
							}
						]
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"enum": [
										"xbox.xid",
										"xbox.xusb",
										"valve.steam-controller",
										"vendor.gamesir"
									]
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"required": ["variant"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"const": "xbox.gip"
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"anyOf": [
								{
									"required": ["keepAlive"]
								},
								{
									"required": ["initialization"]
								}
							]
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.gip"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"quirks": {
								"items": {
									"enum": ["share-offset"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "vendor.ps3-third-party"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"quirks": {
								"items": {
									"enum": ["dpad-pressure"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "nintendo.switch1"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"quirks": {
								"anyOf": [
									{
										"items": {
											"enum": [
												"joy-con-left",
												"joy-con-right",
												"input-only",
												"bluetooth-only",
												"switch-2"
											]
										},
										"maxItems": 1
									},
									{
										"items": false,
										"minItems": 2,
										"prefixItems": [
											{
												"const": "switch-2"
											},
											{
												"enum": ["joy-con-left", "joy-con-right", "gamecube"]
											}
										]
									}
								],
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"enum": [
										"xbox.gip",
										"nintendo.switch1",
										"valve.steam-controller",
										"vendor.gamesir",
										"vendor.ps3-third-party"
									]
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"required": ["quirks"]
						}
					}
				}
			]
		},
		"gipInitializationAction": {
			"enum": [
				"xbox.gip/power-on",
				"xbox.gip/s-init",
				"xbox.gip/enable-extra-input",
				"xbox.gip/hori-ack",
				"xbox.gip/led-on",
				"xbox.gip/auth-done",
				"xbox.gip/rumble-begin",
				"xbox.gip/rumble-end"
			]
		},
		"capabilities": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"absent": {
					"$ref": "#/$defs/controlList"
				},
				"present": {
					"$ref": "#/$defs/controlList"
				},
				"rumble": {
					"const": "absent"
				}
			}
		},
		"controlList": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/controlID"
			}
		},
		"controlID": {
			"enum": [
				"dpad",
				"left-stick-x",
				"left-stick-y",
				"right-stick-x",
				"right-stick-y",
				"left-stick-click",
				"right-stick-click",
				"face-south",
				"face-east",
				"face-west",
				"face-north",
				"left-shoulder",
				"right-shoulder",
				"left-trigger",
				"right-trigger",
				"left-trigger-button",
				"right-trigger-button",
				"view",
				"menu",
				"guide",
				"share",
				"capture",
				"touchpad-click",
				"microphone",
				"paddle-left-1",
				"paddle-left-2",
				"paddle-right-1",
				"paddle-right-2",
				"auxiliary-1",
				"auxiliary-2",
				"auxiliary-3",
				"auxiliary-4",
				"auxiliary-5",
				"auxiliary-6",
				"auxiliary-7",
				"auxiliary-8",
				"left-stick-touch",
				"right-stick-touch",
				"left-trackpad-click",
				"right-trackpad-click",
				"left-trackpad-touch",
				"right-trackpad-touch"
			]
		},
		"usbOverride": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"configuration": {
					"const": "set1-before-claim"
				},
				"postHandshakeSettleMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"endpoints": {
					"type": "object",
					"required": ["in", "out"],
					"additionalProperties": false,
					"properties": {
						"in": {
							"type": "integer",
							"minimum": 128,
							"maximum": 255
						},
						"out": {
							"type": "integer",
							"minimum": 1,
							"maximum": 127
						}
					}
				}
			},
			"minProperties": 1
		},
		"ownership": {
			"enum": ["macos", "ojd"]
		},
		"output": {
			"type": "object",
			"additionalProperties": false,
			"required": ["rumble"],
			"properties": {
				"rumble": {
					"$ref": "#/$defs/rumbleTemplate"
				}
			}
		},
		"rumbleTemplate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["report"],
			"minProperties": 2,
			"properties": {
				"report": {
					"$ref": "#/$defs/templateReport"
				},
				"leftMain": {
					"$ref": "#/$defs/templateByte"
				},
				"rightMain": {
					"$ref": "#/$defs/templateByte"
				},
				"leftTrigger": {
					"$ref": "#/$defs/templateByte"
				},
				"rightTrigger": {
					"$ref": "#/$defs/templateByte"
				}
			}
		},
		"templateReport": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "id", "length"],
			"properties": {
				"kind": {
					"enum": ["output", "feature"]
				},
				"id": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"length": {
					"type": "integer",
					"minimum": 2,
					"maximum": 64
				}
			}
		},
		"templateByte": {
			"type": "object",
			"additionalProperties": false,
			"required": ["byte"],
			"properties": {
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				}
			}
		},
		"input": {
			"type": "object",
			"additionalProperties": false,
			"required": ["report"],
			"minProperties": 2,
			"properties": {
				"report": {
					"type": "object",
					"additionalProperties": false,
					"required": ["length"],
					"properties": {
						"id": {
							"type": "integer",
							"minimum": 1,
							"maximum": 255
						},
						"length": {
							"type": "integer",
							"minimum": 1,
							"maximum": 64
						}
					}
				},
				"buttons": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/inputButton"
					}
				},
				"axes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 4,
					"items": {
						"$ref": "#/$defs/inputAxis"
					}
				},
				"hat": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/inputHatSource"
					}
				},
				"leftTrigger": {
					"$ref": "#/$defs/inputTrigger"
				},
				"rightTrigger": {
					"$ref": "#/$defs/inputTrigger"
				}
			}
		},
		"inputField": {
			"type": "object",
			"additionalProperties": false,
			"required": ["byte", "mask"],
			"properties": {
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"mask": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"inputButton": {
			"type": "object",
			"additionalProperties": false,
			"required": ["control", "byte", "mask"],
			"properties": {
				"control": {
					"allOf": [
						{
							"$ref": "#/$defs/controlID"
						},
						{
							"not": {
								"enum": [
									"dpad",
									"left-stick-x",
									"left-stick-y",
									"right-stick-x",
									"right-stick-y",
									"left-trigger",
									"right-trigger"
								]
							}
						}
					]
				},
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"mask": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"inputAxis": {
			"type": "object",
			"additionalProperties": false,
			"required": ["control", "byte"],
			"properties": {
				"control": {
					"enum": [
						"left-stick-x",
						"left-stick-y",
						"right-stick-x",
						"right-stick-y"
					]
				},
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"bits": {
					"enum": [8, 16]
				},
				"signed": {
					"type": "boolean"
				},
				"min": {
					"type": "integer",
					"minimum": -32768,
					"maximum": 65535
				},
				"max": {
					"type": "integer",
					"minimum": -32768,
					"maximum": 65535
				},
				"inverted": {
					"type": "boolean"
				}
			}
		},
		"inputHatSource": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["encoding", "byte", "mask"],
					"properties": {
						"encoding": {
							"const": "8-way"
						},
						"byte": {
							"type": "integer",
							"minimum": 0,
							"maximum": 63
						},
						"mask": {
							"type": "integer",
							"minimum": 7,
							"maximum": 255
						},
						"neutralUntilNonzero": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["encoding", "up", "right", "down", "left"],
					"properties": {
						"encoding": {
							"const": "directions"
						},
						"up": {
							"$ref": "#/$defs/inputField"
						},
						"right": {
							"$ref": "#/$defs/inputField"
						},
						"down": {
							"$ref": "#/$defs/inputField"
						},
						"left": {
							"$ref": "#/$defs/inputField"
						}
					}
				}
			]
		},
		"inputTrigger": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"button": {
					"$ref": "#/$defs/inputField"
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"required": ["usb"]
			},
			"then": {
				"properties": {
					"protocol": {
						"anyOf": [
							{
								"properties": {
									"family": {
										"enum": ["xbox.xid", "xbox.xusb", "xbox.gip"]
									}
								}
							},
							{
								"properties": {
									"family": {
										"const": "vendor.gamesir"
									},
									"variant": {
										"const": "usb"
									}
								},
								"required": ["variant"]
							}
						]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"capabilities": {
						"required": ["rumble"],
						"type": "object"
					}
				},
				"required": ["capabilities"]
			},
			"then": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "xbox.gip"
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"not": {
									"enum": ["xbox.xusb", "xbox.xid"]
								}
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 130,
										"out": 2
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "xbox.xid"
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 129,
										"out": 2
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "xbox.xusb"
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 129,
										"out": 1
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"not": {
									"const": "sony.dualsense"
								}
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol"]
			},
			"then": {
				"properties": {
					"capabilities": {
						"not": {
							"required": ["present"]
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "sony.dualsense"
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol"]
			},
			"then": {
				"properties": {
					"capabilities": {
						"properties": {
							"present": {
								"minItems": 4,
								"items": {
									"enum": [
