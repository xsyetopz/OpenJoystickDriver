{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/controller.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "vendorID", "productID", "modes"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "Controller"
    },
    "vendorID": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "productID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "modes": {
      "$ref": "#/$defs/modes"
    },
    "usb": {
      "$ref": "#/$defs/usbOverride"
    },
    "bluetoothLE": {
      "$ref": "#/$defs/bluetoothLE"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "route": {
      "$ref": "#/$defs/route"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/input"
        },
        {
          "$ref": "#/$defs/hidInput"
        }
      ]
    },
    "tuning": {
      "$ref": "#/$defs/tuning"
    }
  },
  "if": {
    "required": ["modes"],
    "properties": {
      "modes": {
        "items": {
          "required": ["idle"]
        }
      }
    }
  },
  "then": {
    "properties": {
      "usb": false,
      "bluetoothLE": false,
      "capabilities": false,
      "server": false,
      "route": false,
      "input": false,
      "tuning": false
    }
  },
  "$defs": {
    "modes": {
      "description": "The modes of one model.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mode"
      },
      "contains": {
        "properties": {
          "id": {
            "const": "default"
          }
        },
        "required": ["id"]
      },
      "minContains": 0,
      "maxContains": 1
    },
    "mode": {
      "type": "object",
      "required": ["id", "protocol"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(?!\\n)$"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "match": {
          "$ref": "#/$defs/modeMatch"
        },
        "interface": {
          "$ref": "#/$defs/modeInterface"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "idle": {
          "description": "The reason OJD serves nothing in this mode: no data is sent, no gamepad is published.",
          "enum": ["NoControllerLinked", "Bootloader"]
        }
      },
      "if": {
        "properties": {
          "id": {
            "const": "default"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "match": false
        }
      },
      "else": {
        "required": ["match"]
      },
      "allOf": [
        {
          "if": {
            "required": ["idle"]
          },
          "then": {
            "properties": {
              "interface": false,
              "session": false
            }
          }
        },
        {
          "not": {
            "properties": {
              "session": {
                "required": ["keepAlive", "rumble"],
                "properties": {
                  "rumble": {
                    "required": ["resendIntervalMilliseconds"]
                  }
                }
              }
            },
            "required": ["session"]
          }
        }
      ]
    },
    "modeMatch": {
      "description": "The keys that select a mode: link, interface signature, strings, release number, and probes.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "link": {
          "enum": [
            "USB",
            "BluetoothClassic",
            "BluetoothLE",
            "ProprietaryRadioReceiver"
          ]
        },
        "interfaceSignature": {
          "$ref": "#/$defs/modeInterfaceSignature"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "bcdDevice": {
          "$ref": "#/$defs/bcdDeviceRange"
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modeProbe"
          }
        }
      }
    },
    "modeInterfaceSignature": {
      "description": "An interface of the device, by USB class triple, HID primary usage, and endpoint set.",
      "type": "object",
      "required": ["interfaceClass", "interfaceSubclass", "interfaceProtocol"],
      "additionalProperties": false,
      "properties": {
        "interfaceClass": {
          "$ref": "#/$defs/modeByte"
        },
        "interfaceSubclass": {
          "$ref": "#/$defs/modeByte"
        },
        "interfaceProtocol": {
          "$ref": "#/$defs/modeByte"
        },
        "usagePage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "usage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "endpoints": {
          "description": "The interface's whole endpoint set.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modeEndpoint"
          }
        }
      },
      "dependentRequired": {
        "usage": ["usagePage"]
      }
    },
    "modeByte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "bcdDeviceRange": {
      "description": "An inclusive range of the device release number.",
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "modeInterface": {
      "description": "The interfaces this mode drives, as an inclusive range of interface numbers.",
      "type": "object",
      "required": ["first", "last"],
      "additionalProperties": false,
      "properties": {
        "first": {
          "$ref": "#/$defs/modeByte"
        },
        "last": {
          "$ref": "#/$defs/modeByte"
        }
      }
    },
    "modeProbe": {
      "description": "A read of one feature report: whether it answers, stalls, or holds given bytes.",
      "type": "object",
      "required": ["report", "length", "expect"],
      "additionalProperties": false,
      "properties": {
        "report": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "expect": {
          "enum": ["Answers", "Stalls", "Bytes"]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65534
        },
        "bytes": {
          "$ref": "#/$defs/hexBytes"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expect": {
                "const": "Bytes"
              }
            },
            "required": ["expect"]
          },
          "then": {
            "required": ["offset", "bytes"]
          },
          "else": {
            "properties": {
              "offset": false,
              "bytes": false
            }
          }
        }
      ]
    },
    "protocol": {
      "type": "object",
      "required": ["family"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "variant": {
          "$ref": "protocol-description.schema.json#/$defs/variant"
        },
        "parameters": {
          "description": "The parameters of the family's driver.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "protocol-description.schema.json#/properties/parameters/propertyNames"
          }
        },
        "initialization": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedPacketAction"
          }
        },
        "keepAlive": {
          "type": "boolean"
        },
        "assembly": {
          "enum": []
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "absent": {
          "$ref": "#/$defs/controlList"
        },
        "present": {
          "$ref": "#/$defs/controlList"
        },
        "rumble": {
          "const": "Absent"
        }
      }
    },
    "controlList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "vocabulary.schema.json#/$defs/control"
      }
    },
    "usbOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "const": "SetConfiguration1BeforeClaim"
        },
        "endpoints": {
          "type": "object",
          "required": ["in", "out"],
          "additionalProperties": false,
          "properties": {
            "in": {
              "type": "integer",
              "minimum": 128,
              "maximum": 255
            },
            "out": {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            }
          }
        }
      },
      "minProperties": 1
    },
    "bluetoothLE": {
      "type": "object",
      "required": ["vibrationCharacteristic"],
      "additionalProperties": false,
      "properties": {
        "vibrationCharacteristic": {
          "type": "string",
          "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
        }
      }
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stickDeadzone": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "inputLivenessTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "hidStartupIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "minimumHIDOutputIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "hidStartupRecoveryIntervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "hidStartupRecoveryRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "lizardResendTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "usbCommandTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "presenceResendReports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "adapterDisconnectDelayMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "usbStartupIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "usbStartupRetryDelayMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "usbTransferTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "irWriteIntervalMs": {
          "description": "The wait after each Wii Remote IR camera register write.",
          "type": "integer",
          "minimum": 50,
          "maximum": 1000
        },
        "speakerMaxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "replyTimeoutMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 10000
        },
        "frameQueueCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64
        }
      }
    },
    "route": {
      "enum": ["ExtensionOwned"]
    },
    "rumbleTemplate": {
      "description": "A rumble report: its target, fixed bytes, one field per motor, a counter byte, and a resend interval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["report"],
      "minProperties": 2,
      "properties": {
        "report": {
          "oneOf": [
            {
              "$ref": "#/$defs/templateReport"
            },
            {
              "$ref": "#/$defs/templateUSBPacket"
            }
          ]
        },
        "bytes": {
          "$ref": "#/$defs/hexBytes",
          "maxLength": 191
        },
        "counter": {
          "$ref": "#/$defs/templateByte"
        },
        "resendIntervalMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "lowFrequency": {
          "$ref": "#/$defs/templateMotor"
        },
        "highFrequency": {
          "$ref": "#/$defs/templateMotor"
        },
        "leftTrigger": {
          "$ref": "#/$defs/templateMotor"
        },
        "rightTrigger": {
          "$ref": "#/$defs/templateMotor"
        }
      }
    },
    "templateUSBPacket": {
      "description": "A raw-USB packet to the family's output endpoint.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "length"],
      "properties": {
        "kind": {
          "const": "USB"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "templateMotor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte"],
      "properties": {
        "byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "encoding": {
          "enum": [
            "UInt8",
            "UInt16BigEndian",
            "UInt16LittleEndian",
            "SwitchHDRumble"
          ]
        }
      }
    },
    "startupWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "#/$defs/startupReport"
        },
        "bytes": {
          "$ref": "#/$defs/hexBytes",
          "maxLength": 383
        },
        "delayMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "transport": {
          "enum": ["USB", "BluetoothClassic", "BluetoothLE"]
        },
        "phase": {
          "enum": ["Startup", "Activation"]
        },
        "crc32Seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "if": {
        "required": ["crc32Seed"]
      },
      "then": {
        "properties": {
          "report": {
            "properties": {
              "length": {
                "minimum": 5
              }
            }
          }
        }
      }
    },
    "templateReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "length"],
      "properties": {
        "kind": {
          "enum": ["Output", "Feature"]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "length": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        }
      }
    },
    "templateByte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte"],
      "properties": {
        "byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layouts"],
      "properties": {
        "layouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputLayout"
          }
        }
      }
    },
    "inputLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report"],
      "minProperties": 2,
      "properties": {
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length"],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "length": {
              "description": "The length of the input report, as a minimum or an exact size.",
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["atLeast"],
                  "properties": {
                    "atLeast": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["exactly"],
                  "properties": {
                    "exactly": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    }
                  }
                }
              ]
            }
          }
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputButton"
          }
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/inputAxis"
          }
        },
        "hat": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputHatSource"
          }
        },
        "leftTrigger": {
          "$ref": "#/$defs/inputTrigger"
        },
        "rightTrigger": {
          "$ref": "#/$defs/inputTrigger"
        }
      }
    },
    "hidInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hidUsageMap"],
      "properties": {
        "hidUsageMap": {
          "$ref": "#/$defs/hidUsageMap"
        }
      }
    },
    "hidUsageMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usages"],
      "properties": {
        "reportID": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "usages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hidUsage"
          }
        }
      }
    },
    "hidUsage": {
      "oneOf": [
        {
          "$ref": "#/$defs/hidButtonUsage"
        },
        {
          "$ref": "#/$defs/hidAxisUsage"
        },
        {
          "$ref": "#/$defs/hidHatUsage"
        },
        {
          "$ref": "#/$defs/hidHalfAxisUsage"
        },
        {
          "$ref": "#/$defs/hidAxisDpadUsage"
        },
        {
          "$ref": "#/$defs/hidAxisButtonUsage"
        },
        {
          "$ref": "#/$defs/hidButtonTriggerUsage"
        }
      ]
    },
    "hidUsagePage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "hidUsageID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "hidButtonUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage", "control"],
      "properties": {
        "kind": {
          "const": "Button"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "control": {
          "allOf": [
            {
              "$ref": "vocabulary.schema.json#/$defs/control"
            },
            {
              "not": {
                "anyOf": [
                  {
                    "$ref": "vocabulary.schema.json#/$defs/stickAxis"
                  },
                  {
                    "$ref": "vocabulary.schema.json#/$defs/dpadControl"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "hidAxisUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage", "control"],
      "properties": {
        "kind": {
          "const": "Axis"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "control": {
          "$ref": "vocabulary.schema.json#/$defs/axis"
        },
        "inverted": {
          "type": "boolean"
        },
        "range": {
          "$ref": "#/$defs/hidAxisRange"
        },
        "deadZone": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "hidHalf": {
      "enum": ["Positive", "Negative"]
    },
    "hidHalfAxisUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage", "half", "control"],
      "properties": {
        "kind": {
          "const": "HalfAxis"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "half": {
          "$ref": "#/$defs/hidHalf"
        },
        "control": {
          "$ref": "vocabulary.schema.json#/$defs/trigger"
        },
        "inverted": {
          "type": "boolean"
        }
      }
    },
    "hidAxisDpadUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage", "half", "control", "threshold"],
      "properties": {
        "kind": {
          "const": "AxisDpad"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "half": {
          "$ref": "#/$defs/hidHalf"
        },
        "control": {
          "$ref": "vocabulary.schema.json#/$defs/dpadControl"
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "hidAxisButtonUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage", "half", "control", "threshold"],
      "properties": {
        "kind": {
          "const": "AxisButton"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "half": {
          "$ref": "#/$defs/hidHalf"
        },
        "control": {
          "$ref": "#/$defs/hidButtonUsage/properties/control"
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "hidButtonTriggerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage", "control"],
      "properties": {
        "kind": {
          "const": "ButtonTrigger"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "control": {
          "$ref": "vocabulary.schema.json#/$defs/trigger"
        }
      }
    },
    "hidAxisRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "max": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    },
    "hidHatUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "usage"],
      "properties": {
        "kind": {
          "const": "Hat"
        },
        "page": {
          "$ref": "#/$defs/hidUsagePage"
        },
        "usage": {
          "$ref": "#/$defs/hidUsageID"
        },
        "range": {
          "oneOf": [
            {
              "const": {
                "min": 0,
                "max": 7
              }
            },
            {
              "const": {
                "min": 1,
                "max": 8
              }
            }
          ]
        }
      }
    },
    "reportBitOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 511
    },
    "reportBitSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "reportByteOrder": {
      "enum": ["LittleEndian", "BigEndian"]
    },
    "reportRawValue": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 4294967295
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bitOffset", "bitSize"],
      "properties": {
        "bitOffset": {
          "$ref": "#/$defs/reportBitOffset"
        },
        "bitSize": {
          "$ref": "#/$defs/reportBitSize"
        }
      }
    },
    "inputButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "bitOffset", "bitSize"],
      "properties": {
        "control": {
          "allOf": [
            {
              "$ref": "vocabulary.schema.json#/$defs/control"
            },
            {
              "not": {
                "anyOf": [
                  {
                    "$ref": "vocabulary.schema.json#/$defs/stickAxis"
                  },
                  {
                    "$ref": "vocabulary.schema.json#/$defs/dpadControl"
                  }
                ]
              }
            }
          ]
        },
        "bitOffset": {
          "$ref": "#/$defs/reportBitOffset"
        },
        "bitSize": {
          "$ref": "#/$defs/reportBitSize"
        }
      }
    },
    "inputAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "bitOffset", "bitSize"],
      "properties": {
        "control": {
          "$ref": "vocabulary.schema.json#/$defs/stickAxis"
        },
        "bitOffset": {
          "$ref": "#/$defs/reportBitOffset"
        },
        "bitSize": {
          "$ref": "#/$defs/reportBitSize"
        },
        "byteOrder": {
          "$ref": "#/$defs/reportByteOrder"
        },
        "signed": {
          "type": "boolean"
        },
        "min": {
          "$ref": "#/$defs/reportRawValue"
        },
        "max": {
          "$ref": "#/$defs/reportRawValue"
        },
        "inverted": {
          "type": "boolean"
        },
        "symmetric": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "symmetric": {
            "const": true
          }
        },
        "required": ["symmetric"]
      },
      "then": {
        "required": ["signed"],
        "properties": {
          "signed": {
            "const": true
          },
          "min": {
            "maximum": -1
          },
          "max": {
            "minimum": 1
          }
        }
      }
    },
    "inputHatSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "bitOffset", "bitSize"],
          "properties": {
            "encoding": {
              "const": "EightWay"
            },
            "bitOffset": {
              "$ref": "#/$defs/reportBitOffset"
            },
            "bitSize": {
              "type": "integer",
              "minimum": 3,
              "maximum": 8
            },
            "neutralUntilNonzero": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "up", "right", "down", "left"],
          "properties": {
            "encoding": {
              "const": "Directions"
            },
            "up": {
              "$ref": "#/$defs/inputField"
            },
            "right": {
              "$ref": "#/$defs/inputField"
            },
            "down": {
              "$ref": "#/$defs/inputField"
            },
            "left": {
              "$ref": "#/$defs/inputField"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "bitOffset", "bitSize", "values"],
          "properties": {
            "encoding": {
              "const": "Table"
            },
            "bitOffset": {
              "$ref": "#/$defs/reportBitOffset"
            },
            "bitSize": {
              "$ref": "#/$defs/reportBitSize"
            },
            "values": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]{0,9})$"
              },
              "additionalProperties": {
                "enum": [
                  "North",
                  "NorthEast",
                  "East",
                  "SouthEast",
                  "South",
                  "SouthWest",
                  "West",
                  "NorthWest"
                ]
              }
            }
          }
        }
      ]
    },
    "inputTrigger": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bitOffset": {
          "$ref": "#/$defs/reportBitOffset"
        },
        "bitSize": {
          "$ref": "#/$defs/reportBitSize"
        },
        "byteOrder": {
          "$ref": "#/$defs/reportByteOrder"
        },
        "signed": {
          "type": "boolean"
        },
        "min": {
          "$ref": "#/$defs/reportRawValue"
        },
        "max": {
          "$ref": "#/$defs/reportRawValue"
        },
        "button": {
          "$ref": "#/$defs/inputField"
        }
      },
      "dependentRequired": {
        "bitOffset": ["bitSize"],
        "bitSize": ["bitOffset"],
        "byteOrder": ["bitOffset"],
        "signed": ["bitOffset"],
        "min": ["bitOffset"],
        "max": ["bitOffset"]
      }
    },
    "startupReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "length"],
      "properties": {
        "kind": {
          "enum": ["Output", "Feature"]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "length": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128
        }
      }
    },
    "usbStartupWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/hexBytes",
          "maxLength": 191
        },
        "endpoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "delayMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sessionByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "toleratesRejection": {
          "type": "boolean"
        }
      }
    },
    "server": {
      "enum": ["System", "OJD"]
    },
    "modeEndpoint": {
      "description": "One endpoint of an endpoint set.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/modeByte"
        },
        "direction": {
          "enum": ["In", "Out"]
        },
        "transferType": {
          "enum": ["Control", "Isochronous", "Bulk", "Interrupt"]
        },
        "maxPacketSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "hexBytes": {
      "description": "Raw bytes as uppercase hex pairs separated by single spaces.",
      "type": "string",
      "pattern": "^[0-9A-F]{2}( [0-9A-F]{2})*(?!\\n)$"
    },
    "sessionKeepAlive": {
      "description": "Fixed writes repeated at an interval while a raw-USB session runs.",
      "type": "object",
      "required": ["intervalMilliseconds", "writes"],
      "additionalProperties": false,
      "properties": {
        "intervalMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/keepAliveWrite"
          }
        }
      }
    },
    "controlTransfer": {
      "description": "A vendor control transfer on the device, gated by a match on its strings and release number.",
      "type": "object",
      "required": ["bmRequestType", "bRequest", "wValue", "wIndex", "wLength"],
      "additionalProperties": false,
      "properties": {
        "bmRequestType": {
          "enum": [64, 65, 66, 67, 192, 193, 194, 195]
        },
        "bRequest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "wValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "wIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "wLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "data": {
          "$ref": "#/$defs/hexBytes",
          "maxLength": 191
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "delayMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "toleratesRejection": {
          "type": "boolean"
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "manufacturer": {
              "type": "string",
              "minLength": 1
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "bcdDevice": {
              "$ref": "#/$defs/bcdDeviceRange"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bmRequestType": {
                "enum": [192, 193, 194, 195]
              }
            },
            "required": ["bmRequestType"]
          },
          "then": {
            "not": {
              "required": ["data"]
            },
            "properties": {
              "wLength": {
                "minimum": 1
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "wLength": {
                  "const": 0
                }
              },
              "required": ["wLength"]
            },
            "then": {
              "not": {
                "required": ["data"]
              }
            },
            "else": {
              "required": ["data"]
            }
          }
        }
      ]
    },
    "session": {
      "description": "The steps one mode runs: startup, keep-alive, settle time, shutdown, control transfers, and rumble.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/startupWrite"
              },
              {
                "$ref": "#/$defs/usbStartupWrite"
              }
            ]
          },
          "not": {
            "allOf": [
              {
                "contains": {
                  "required": ["report"]
                }
              },
              {
                "contains": {
                  "not": {
                    "required": ["report"]
                  }
                }
              }
            ]
          }
        },
        "keepAlive": {
          "$ref": "#/$defs/sessionKeepAlive"
        },
        "settleMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "shutdown": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/usbStartupWrite"
          }
        },
        "control": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/controlTransfer"
          }
        },
        "rumble": {
          "$ref": "#/$defs/rumbleTemplate"
        }
      }
    },
    "keepAliveWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/hexBytes",
          "maxLength": 191
        },
        "endpoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "sessionByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        }
      }
    },
    "namedPacketAction": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*/[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
