{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller.schema.json",
	"type": "object",
	"required": ["$schema", "vendorID", "productID", "transport", "protocol"],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"const": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller.schema.json"
		},
		"vendorID": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"productID": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535
		},
		"transport": {
			"enum": ["usb", "hid"]
		},
		"protocol": {
			"$ref": "#/$defs/protocol"
		},
		"usb": {
			"$ref": "#/$defs/usbOverride"
		}
	},
	"$defs": {
		"protocol": {
			"type": "object",
			"required": ["driver", "variant"],
			"additionalProperties": false,
			"properties": {
				"driver": {
					"enum": [
						"GIP",
						"XUSB",
						"XID",
						"DS3",
						"DS4",
						"DualSense",
						"SteamController",
						"SwitchPro",
						"XboxAdaptiveJoystick",
						"XboxBluetoothHID",
						"Flydigi",
						"FlydigiVendor",
						"GameSir",
						"GenericHID"
					]
				},
				"variant": {
					"enum": [
						"xid",
						"xbox360",
						"xbox360Wireless",
						"xboxOne",
						"dualShock3",
						"dualShock4",
						"dualSense",
						"steamController",
						"switchPro",
						"xboxAdaptiveJoystick",
						"xboxBluetoothHID",
						"flydigi",
						"flydigiVendor",
						"gameSirG7ProUSB",
						"gameSirEnhancedHID",
						"genericHID",
						"unknown"
					]
				},
				"quirks": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 1
				},
				"startupPackets": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": [
							"powerOn",
							"xboxOneSInit",
							"extraInput",
							"horiAck",
							"ledOn",
							"authDone",
							"rumbleBegin",
							"rumbleEnd"
						]
					}
				},
				"keepAlive": {
					"type": "boolean"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"driver": {
								"const": "GameSir"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["gameSirG7ProUSB", "gameSirEnhancedHID"]
							}
						},
						"not": {
							"required": ["quirks"]
						}
					}
				},
				{
					"if": {
						"required": ["driver"],
						"properties": {
							"driver": {
								"not": {
									"const": "GIP"
								}
							}
						}
					},
					"then": {
						"not": {
							"required": ["keepAlive"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "GIP"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["unknown", "xboxOne"]
							},
							"quirks": {
								"items": {
									"enum": [
										"dpadToButtons",
										"shareOffset",
										"sticksToNull",
										"triggersToButtons",
										"inputOnly"
									]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "XUSB"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["unknown", "xbox360", "xbox360Wireless"]
							},
							"quirks": {
								"items": {
									"enum": ["dpadToButtons", "sticksToNull", "triggersToButtons"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "XID"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["unknown", "xid"]
							},
							"quirks": {
								"items": {
									"enum": ["dpadToButtons", "sticksToNull", "triggersToButtons"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "DS3"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["dualShock3", "unknown"]
							},
							"quirks": {
								"items": {
									"enum": ["accelerometer", "battery", "gyro"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "DS4"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["dualShock4", "unknown"]
							},
							"quirks": {
								"items": {
									"enum": [
										"accelerometer",
										"battery",
										"gyro",
										"lightbar",
										"touchpad"
									]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "DualSense"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["dualSense", "unknown"]
							},
							"quirks": {
								"items": {
									"enum": [
										"accelerometer",
										"adaptiveTriggers",
										"edgeButtons",
										"battery",
										"gyro",
										"lightbar",
										"microphoneMute",
										"touchpad"
									]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "SteamController"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["steamController", "unknown"]
							},
							"quirks": {
								"items": {
									"enum": [
										"battery",
										"gyro",
										"lizardMode",
										"trackpads",
										"wirelessReceiver"
									]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "SwitchPro"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["switchPro", "unknown"]
							},
							"quirks": {
								"items": {
									"enum": [
										"calibration",
										"imu",
										"rumble",
										"usbHandshake",
										"joyConLeft",
										"joyConRight"
									]
								},
								"not": {
									"allOf": [
										{
											"contains": {
												"const": "joyConLeft"
											}
										},
										{
											"contains": {
												"const": "joyConRight"
											}
										}
									]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "FlydigiVendor"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["flydigiVendor"]
							}
						},
						"not": {
							"required": ["quirks"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "XboxBluetoothHID"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["xboxBluetoothHID"]
							}
						},
						"not": {
							"required": ["quirks"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "XboxAdaptiveJoystick"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["unknown", "xboxAdaptiveJoystick"]
							},
							"quirks": {
								"items": {
									"enum": ["genericHIDPackets", "rawUSBPackets"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "Flydigi"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["flydigi"]
							}
						},
						"not": {
							"required": ["quirks"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"driver": {
								"const": "GenericHID"
							}
						},
						"required": ["driver"]
					},
					"then": {
						"properties": {
							"variant": {
								"enum": ["genericHID"]
							}
						},
						"not": {
							"required": ["quirks"]
						}
					}
				}
			]
		},
		"usbOverride": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"interface": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				},
				"configuration": {
					"const": "set1-before-claim"
				},
				"postHandshakeSettleMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"endpoints": {
					"type": "object",
					"required": ["in", "out"],
					"additionalProperties": false,
					"properties": {
						"in": {
							"type": "integer",
							"minimum": 128,
							"maximum": 255
						},
						"out": {
							"type": "integer",
							"minimum": 1,
							"maximum": 127
						}
					}
				}
			},
			"minProperties": 1
		}
	},
	"allOf": [
		{
			"if": {
				"required": ["usb"]
			},
			"then": {
				"properties": {
					"transport": {
						"const": "usb"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"startupPackets": {}
						},
						"required": ["startupPackets"],
						"type": "object"
					}
				},
				"required": ["protocol"]
			},
			"then": {
				"properties": {
					"protocol": {
						"properties": {
							"driver": {
								"const": "GIP"
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"driver": {
								"const": "GIP"
							}
						},
						"required": ["driver"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 130,
										"out": 2
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"driver": {
								"const": "XUSB"
							}
						},
						"required": ["driver"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 129,
										"out": 1
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		}
	]
}
