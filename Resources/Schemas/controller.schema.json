{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller.schema.json",
	"type": "object",
	"required": ["$schema", "vendorID", "productID", "protocol"],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"const": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller.schema.json"
		},
		"vendorID": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"productID": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535
		},
		"protocol": {
			"$ref": "#/$defs/protocol"
		},
		"usb": {
			"$ref": "#/$defs/usbOverride"
		},
		"capabilities": {
			"$ref": "#/$defs/capabilities"
		}
	},
	"$defs": {
		"protocol": {
			"type": "object",
			"required": ["family"],
			"additionalProperties": false,
			"properties": {
				"family": {
					"enum": [
						"hid.descriptor",
						"xbox.xid",
						"xbox.xusb",
						"xbox.gip",
						"sony.sixaxis",
						"sony.dualshock4",
						"sony.dualsense",
						"nintendo.switch1",
						"valve.steam-controller",
						"vendor.flydigi",
						"vendor.gamesir",
						"generic.byte-layout"
					]
				},
				"variant": {
					"enum": [
						"gamepad",
						"wired",
						"receiver",
						"dongle",
						"usb",
						"enhanced-hid"
					]
				},
				"quirks": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 1
				},
				"initialization": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/gipInitializationAction"
					}
				},
				"keepAlive": {
					"type": "boolean"
				},
				"assembly": {
					"enum": []
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.xid"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["gamepad"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.xusb"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["wired", "receiver"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "valve.steam-controller"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["wired", "dongle"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "vendor.gamesir"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["usb", "enhanced-hid"]
							},
							"quirks": {
								"items": {
									"enum": ["inner-grips", "lighting-slots"]
								},
								"type": "array"
							}
						},
						"allOf": [
							{
								"if": {
									"properties": {
										"variant": {
											"const": "usb"
										}
									},
									"required": ["variant"]
								},
								"then": {
									"not": {
										"required": ["quirks"]
									}
								}
							},
							{
								"if": {
									"properties": {
										"variant": {
											"const": "enhanced-hid"
										}
									},
									"required": ["variant"]
								},
								"then": {
									"required": ["quirks"],
									"properties": {
										"quirks": {
											"maxItems": 1
										}
									}
								}
							}
						]
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"enum": [
										"xbox.xid",
										"xbox.xusb",
										"valve.steam-controller",
										"vendor.gamesir"
									]
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"required": ["variant"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"const": "xbox.gip"
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"anyOf": [
								{
									"required": ["keepAlive"]
								},
								{
									"required": ["initialization"]
								}
							]
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.gip"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"quirks": {
								"items": {
									"enum": ["share-offset"]
								},
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "nintendo.switch1"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"quirks": {
								"items": {
									"enum": ["joy-con-left", "joy-con-right"]
								},
								"maxItems": 1,
								"type": "array"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"enum": ["xbox.gip", "nintendo.switch1", "vendor.gamesir"]
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"required": ["quirks"]
						}
					}
				}
			]
		},
		"gipInitializationAction": {
			"enum": [
				"xbox.gip/power-on",
				"xbox.gip/s-init",
				"xbox.gip/enable-extra-input",
				"xbox.gip/hori-ack",
				"xbox.gip/led-on",
				"xbox.gip/auth-done",
				"xbox.gip/rumble-begin",
				"xbox.gip/rumble-end"
			]
		},
		"capabilities": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"absent": {
					"$ref": "#/$defs/controlList"
				},
				"present": {
					"$ref": "#/$defs/controlList"
				},
				"rumble": {
					"const": "absent"
				}
			}
		},
		"controlList": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/controlID"
			}
		},
		"controlID": {
			"enum": [
				"dpad",
				"left-stick-x",
				"left-stick-y",
				"right-stick-x",
				"right-stick-y",
				"left-stick-click",
				"right-stick-click",
				"face-south",
				"face-east",
				"face-west",
				"face-north",
				"left-shoulder",
				"right-shoulder",
				"left-trigger",
				"right-trigger",
				"left-trigger-button",
				"right-trigger-button",
				"view",
				"menu",
				"guide",
				"share",
				"capture",
				"touchpad-click",
				"microphone",
				"paddle-left-1",
				"paddle-left-2",
				"paddle-right-1",
				"paddle-right-2",
				"auxiliary-1",
				"auxiliary-2",
				"auxiliary-3",
				"auxiliary-4",
				"auxiliary-5",
				"auxiliary-6",
				"auxiliary-7",
				"auxiliary-8",
				"left-stick-touch",
				"right-stick-touch",
				"left-trackpad-click",
				"right-trackpad-click",
				"left-trackpad-touch",
				"right-trackpad-touch"
			]
		},
		"usbOverride": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"configuration": {
					"const": "set1-before-claim"
				},
				"postHandshakeSettleMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"endpoints": {
					"type": "object",
					"required": ["in", "out"],
					"additionalProperties": false,
					"properties": {
						"in": {
							"type": "integer",
							"minimum": 128,
							"maximum": 255
						},
						"out": {
							"type": "integer",
							"minimum": 1,
							"maximum": 127
						}
					}
				}
			},
			"minProperties": 1
		}
	},
	"allOf": [
		{
			"if": {
				"required": ["usb"]
			},
			"then": {
				"properties": {
					"protocol": {
						"anyOf": [
							{
								"properties": {
									"family": {
										"enum": ["xbox.xid", "xbox.xusb", "xbox.gip"]
									}
								}
							},
							{
								"properties": {
									"family": {
										"const": "vendor.gamesir"
									},
									"variant": {
										"const": "usb"
									}
								},
								"required": ["variant"]
							}
						]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"capabilities": {
						"required": ["rumble"],
						"type": "object"
					}
				},
				"required": ["capabilities"]
			},
			"then": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "xbox.gip"
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"not": {
									"enum": ["xbox.xusb", "xbox.xid"]
								}
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 130,
										"out": 2
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "xbox.xid"
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 129,
										"out": 2
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "xbox.xusb"
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol", "usb"]
			},
			"then": {
				"properties": {
					"usb": {
						"properties": {
							"endpoints": {
								"not": {
									"const": {
										"in": 129,
										"out": 1
									}
								}
							}
						},
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"not": {
									"const": "sony.dualsense"
								}
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol"]
			},
			"then": {
				"properties": {
					"capabilities": {
						"not": {
							"required": ["present"]
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"protocol": {
						"properties": {
							"family": {
								"const": "sony.dualsense"
							}
						},
						"required": ["family"],
						"type": "object"
					}
				},
				"required": ["protocol"]
			},
			"then": {
				"properties": {
					"capabilities": {
						"properties": {
							"present": {
								"minItems": 4,
								"items": {
									"enum": [
										"paddle-left-1",
										"paddle-right-1",
										"auxiliary-1",
										"auxiliary-2"
									]
								}
							}
						}
					}
				}
			}
		}
	]
}
