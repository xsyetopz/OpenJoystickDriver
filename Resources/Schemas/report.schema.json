{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/report.schema.json",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "source": {
      "const": "urn:openjoystickdriver:support"
    },
    "type": {
      "const": "com.openjoystickdriver.support.diagnostic"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/report.schema.json#/$defs/supportDiagnosticData"
    },
    "data": {
      "$ref": "#/$defs/supportDiagnosticData"
    }
  },
  "$defs": {
    "supportDiagnosticData": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "privacy",
        "system",
        "permissions",
        "applicationService",
        "configuration",
        "controllers",
        "unboundDevices",
        "hidGamepads",
        "frameTimings",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "openjoystickdriver/v1alpha3"
        },
        "kind": {
          "const": "SupportDiagnostic"
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "system": {
          "$ref": "#/$defs/system"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "applicationService": {
          "$ref": "#/$defs/applicationService"
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "controllers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controller"
          }
        },
        "unboundDevices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unboundDevice"
          }
        },
        "hidGamepads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hidGamepad"
          }
        },
        "systemGamepadAudit": {
          "$ref": "#/$defs/systemGamepadAudit"
        },
        "frameTimings": {
          "description": "The newest frames of each connected controller, oldest first, with a summary.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/controllerFrameTimings"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "frameTimingSummary": {
      "description": "What the frame window of one controller says about stutter.",
      "type": "object",
      "required": ["frames", "spanNanoseconds", "gaps"],
      "additionalProperties": false,
      "properties": {
        "lastSeconds": {
          "description": "The number of seconds before the answer that the window covers.",
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "spanNanoseconds": {
          "description": "From the first to the last Read stamp of the window.",
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gap",
              "samples",
              "p50Nanoseconds",
              "p99Nanoseconds",
              "maxNanoseconds"
            ],
            "additionalProperties": false,
            "properties": {
              "gap": {
                "enum": [
                  "ReadToParse",
                  "ParseToDispatch",
                  "DispatchToDeliveryVirtualDevice",
                  "DispatchToDeliveryEndpoint",
                  "ReadToRead"
                ]
              },
              "samples": {
                "type": "integer",
                "minimum": 1
              },
              "p50Nanoseconds": {
                "type": "integer",
                "minimum": 0
              },
              "p99Nanoseconds": {
                "type": "integer",
                "minimum": 0
              },
              "maxNanoseconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "stalls": {
          "type": "object",
          "required": ["thresholdNanoseconds", "count"],
          "additionalProperties": false,
          "properties": {
            "thresholdNanoseconds": {
              "description": "The read interval above which a read counts as a stall.",
              "type": "integer",
              "minimum": 0
            },
            "count": {
              "description": "The read intervals that are stalls.",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "controllerFrameTimings": {
      "type": "object",
      "required": ["controller", "name", "frames", "summary"],
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/frameTimingSummary"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sequence", "stages"],
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["stage", "nanoseconds"],
                  "additionalProperties": false,
                  "properties": {
                    "stage": {
                      "enum": [
                        "Read",
                        "Parse",
                        "Dispatch",
                        "DeliveryVirtualDevice",
                        "DeliveryEndpoint"
                      ]
                    },
                    "nanoseconds": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "includesRawSerialNumbers",
        "includesFilesystemPaths",
        "includesPacketPayloads",
        "includesHIDLocationIDs",
        "includesDeviceProductNames"
      ],
      "additionalProperties": false,
      "properties": {
        "includesRawSerialNumbers": {
          "const": false
        },
        "includesFilesystemPaths": {
          "const": false
        },
        "includesPacketPayloads": {
          "const": false
        },
        "includesHIDLocationIDs": {
          "const": false
        },
        "includesDeviceProductNames": {
          "type": "boolean"
        }
      }
    },
    "system": {
      "type": "object",
      "required": ["buildIdentity", "osName", "osVersion", "architecture"],
      "additionalProperties": false,
      "properties": {
        "buildIdentity": {
          "$ref": "#/$defs/buildIdentity"
        },
        "osName": {
          "type": "string"
        },
        "osVersion": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        }
      }
    },
    "buildIdentity": {
      "type": "object",
      "required": [
        "semanticVersion",
        "appBundleVersion",
        "sourceCommit",
        "sourceState"
      ],
      "additionalProperties": false,
      "properties": {
        "semanticVersion": {
          "type": "string"
        },
        "appBundleVersion": {
          "type": "string"
        },
        "sourceCommit": {
          "type": "string"
        },
        "sourceState": {
          "enum": ["Clean", "Dirty", "Unknown"]
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["inputRead", "inputInject"],
      "additionalProperties": false,
      "properties": {
        "inputRead": {
          "description": "The input read permission state.",
          "enum": ["Granted", "Denied", "Unknown"]
        },
        "inputInject": {
          "description": "The input injection permission state.",
          "enum": ["Granted", "Denied", "Unknown"]
        }
      }
    },
    "applicationService": {
      "type": "object",
      "required": ["installed", "connected"],
      "additionalProperties": false,
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "runtimeState": {
          "type": "string"
        },
        "activeCount": {
          "type": "integer"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userSpaceVirtualDeviceEnabled": {
          "type": "boolean"
        }
      }
    },
    "controller": {
      "type": "object",
      "required": [
        "name",
        "vendorID",
        "productID",
        "protocolBinding",
        "connection",
        "serialNumberPresent",
        "parameters",
        "binding",
        "inputEndpoint",
        "outputEndpoint",
        "needsSetConfiguration",
        "postHandshakeSettleMilliseconds",
        "preferredBackends",
        "physicalOutputCapabilities",
        "sessionState",
        "inputHealth"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "vendorID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "productID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "protocolBinding": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*(:[A-Z][A-Za-z0-9]*)?$"
        },
        "connection": {
          "type": "string"
        },
        "serialNumberPresent": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding": {
          "allOf": [
            { "$ref": "#/$defs/bindingResult" },
            { "properties": { "outcome": { "const": "Bound" } } }
          ]
        },
        "inputEndpoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "outputEndpoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "needsSetConfiguration": {
          "type": "boolean"
        },
        "postHandshakeSettleMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "preferredBackends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "physicalOutputCapabilities": {
          "$ref": "#/$defs/physicalOutputCapabilities"
        },
        "sessionState": {
          "enum": ["Active", "Suspended"]
        },
        "startupCommandStatus": {
          "type": "string"
        },
        "inputHealth": {
          "$ref": "#/$defs/controllerInputHealth"
        },
        "connectionState": {
          "$ref": "#/$defs/controllerConnectionState"
        }
      }
    },
    "controllerInputHealth": {
      "type": "object",
      "required": ["state", "recoveryCount"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": ["AwaitingInput", "Healthy", "Stale", "WaitingForNeutral"]
        },
        "failureReason": {
          "enum": ["MissingReports", "FreshnessNotAdvancing", "GuideNotPressed"]
        },
        "reportFormat": {
          "type": "string"
        },
        "lastReportAgeNanoseconds": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "controllerConnectionState": {
      "type": "object",
      "required": ["backend", "isConnected", "power"],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "USB",
            "BluetoothClassic",
            "BluetoothLE",
            "ProprietaryRadioReceiver"
          ]
        },
        "backend": {
          "enum": ["HID", "RawUSB", "USBExtension", "GATT"]
        },
        "isConnected": {
          "type": "boolean"
        },
        "power": {
          "type": "object",
          "required": ["charging", "battery"],
          "additionalProperties": false,
          "properties": {
            "charging": {
              "enum": [
                "Unknown",
                "Discharging",
                "Charging",
                "Full",
                "NotChargeable"
              ]
            },
            "battery": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "percentage": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    }
                  ],
                  "items": false,
                  "minItems": 2
                }
              }
            },
            "wiredPower": {
              "type": "boolean"
            }
          }
        },
        "wiiRemote": {
          "description": "The Wii Remote session facts.",
          "type": "object",
          "required": ["reportMode", "motionPlusActive", "isGyroRestReady"],
          "additionalProperties": false,
          "properties": {
            "reportMode": {
              "description": "The report mode the driver chose.",
              "type": "integer",
              "minimum": 48,
              "maximum": 63
            },
            "extensionKind": {
              "description": "The extension that the handshake identified.",
              "enum": [
                "Nunchuk",
                "ClassicController",
                "ClassicControllerPro",
                "MotionPlusInactive",
                "MotionPlus",
                "MotionPlusNunchuk",
                "MotionPlusClassic"
              ]
            },
            "unknownExtensionID": {
              "description": "The six ID bytes of an extension the table lacks, as twelve uppercase hex digits.",
              "type": "string",
              "pattern": "^[0-9A-F]{12}$"
            },
            "motionPlusActive": {
              "type": "boolean"
            },
            "isGyroRestReady": {
              "description": "False while the gyro rest offset is being measured.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "physicalOutputCapabilities": {
      "type": "object",
      "required": [
        "rumbleMotors",
        "lightingFeatures",
        "binaryRumbleMotors",
        "adaptiveTriggers"
      ],
      "additionalProperties": false,
      "properties": {
        "rumbleMotors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rumbleMotor"
          }
        },
        "lightingFeatures": {
          "type": "array",
          "items": {
            "enum": [
              "PlayerIndicator",
              "ProgrammableColor",
              "ProgrammableBrightness"
            ]
          }
        },
        "binaryRumbleMotors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rumbleMotor"
          }
        },
        "adaptiveTriggers": {
          "type": "array",
          "items": {
            "enum": ["Left", "Right"]
          }
        },
        "speaker": {
          "description": "The audio format of the controller's speaker.",
          "enum": ["YamahaADPCM4Bit"]
        }
      }
    },
    "rumbleMotor": {
      "enum": [
        "LowFrequency",
        "HighFrequency",
        "LeftTrigger",
        "RightTrigger",
        "LeftHaptic",
        "RightHaptic"
      ]
    },
    "unboundDevice": {
      "type": "object",
      "required": ["vendorID", "productID", "connection", "binding"],
      "additionalProperties": false,
      "properties": {
        "vendorID": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "productID": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "connection": { "type": "string" },
        "binding": {
          "allOf": [
            { "$ref": "#/$defs/bindingResult" },
            { "properties": { "outcome": { "const": "Unsupported" } } }
          ]
        }
      }
    },
    "bindingResult": {
      "type": "object",
      "required": [
        "outcome",
        "accessBackend",
        "interfaces",
        "matchedPredicates",
        "rejectedCandidates"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": { "enum": ["Bound", "Unsupported"] },
        "reason": { "$ref": "#/$defs/bindingReason" },
        "accessBackend": {
          "enum": ["HID", "RawUSB", "USBExtension", "GATT"]
        },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/bindingInterface" }
        },
        "rule": {
          "enum": [
            "CatalogRecord",
            "InterfaceSignature",
            "HIDDescriptor",
            "SDLGameControllerDB"
          ]
        },
        "matchedPredicates": {
          "type": "array",
          "items": {
            "enum": [
              "CatalogIdentity",
              "CatalogAccessPath",
              "HostTransport",
              "InterfaceSignature",
              "DeviceClassSignature",
              "InterruptEndpointPair",
              "HIDDescriptorContract"
            ]
          }
        },
        "catalogRecordID": { "$ref": "#/$defs/catalogRecordID" },
        "inputMapping": { "$ref": "#/$defs/inputMapping" },
        "rejectedCandidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/rejectedCandidate" }
        }
      },
      "if": { "properties": { "outcome": { "const": "Bound" } } },
      "then": {
        "required": ["rule"],
        "properties": { "rejectedCandidates": { "maxItems": 0 } },
        "not": { "required": ["reason"] }
      },
      "else": {
        "required": ["reason"],
        "properties": { "matchedPredicates": { "maxItems": 0 } },
        "not": {
          "anyOf": [
            { "required": ["rule"] },
            { "required": ["catalogRecordID"] },
            { "required": ["inputMapping"] }
          ]
        }
      }
    },
    "bindingInterface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaceNumber": { "type": "integer", "minimum": 0, "maximum": 255 },
        "alternateSetting": { "type": "integer", "minimum": 0, "maximum": 255 },
        "interfaceClass": { "type": "integer", "minimum": 0, "maximum": 255 },
        "interfaceSubclass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "interfaceProtocol": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "hostTransport": {
          "enum": [
            "USB",
            "BluetoothClassic",
            "BluetoothLE",
            "ProprietaryRadioReceiver"
          ]
        },
        "primaryUsage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usagePage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "usage": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        },
        "hasGamePadOrJoystickCollection": { "type": "boolean" },
        "descriptorFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rejectedCandidate": {
      "type": "object",
      "required": ["protocolID", "reason"],
      "additionalProperties": false,
      "properties": {
        "protocolID": {
          "enum": [
            "HIDDescriptor",
            "HIDReportLayout",
            "XboxXID",
            "XboxXUSB",
            "XboxGIP",
            "SonySixaxis",
            "SonyDualShock4",
            "SonyDualSense",
            "NintendoSwitch1",
            "NintendoSwitch2",
            "NintendoSwitchInputOnly",
            "ValveSteamController",
            "ValveSteamTriton",
            "ValveSteamDeck",
            "VendorFlydigi",
            "VendorPS3ThirdParty",
            "VendorGameSir",
            "VendorNVIDIAShield",
            "NintendoWii"
          ]
        },
        "reason": { "$ref": "#/$defs/bindingReason" },
        "catalogRecordID": { "$ref": "#/$defs/catalogRecordID" },
        "inputMapping": { "$ref": "#/$defs/inputMapping" }
      }
    },
    "inputMapping": {
      "description": "Where a HID pad's usage map comes from.",
      "type": "object",
      "required": ["source", "unmapped"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "Record",
            "SDLGameControllerDB",
            "StandardHIDUsageMap",
            "None"
          ]
        },
        "guid": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "match": {
          "enum": [
            "ExactGUID",
            "GUIDWithoutNameCRC",
            "GUIDWithoutVersion",
            "GUIDWithoutVersionAndNameCRC"
          ]
        },
        "unmapped": { "type": "array", "items": { "type": "string" } },
        "rejection": { "type": "string" }
      }
    },
    "catalogRecordID": {
      "type": "string",
      "pattern": "^[0-9a-f]{4}-[0-9a-f]{4}$"
    },
    "bindingReason": {
      "enum": [
        "NoProtocolMatch",
        "AmbiguousProtocolMatch",
        "InterfaceContractMismatch",
        "DescriptorContractMismatch",
        "UnsupportedProtocolVariant",
        "UnsupportedTransportVariant",
        "VirtualProfileUnavailable",
        "DeviceInUse",
        "ConfigurationUnreadable",
        "BootloaderIdentity",
        "NoModeMatched",
        "IdleIdentity"
      ]
    },
    "hidGamepad": {
      "type": "object",
      "required": ["vendorID", "productID", "serialKind", "isOJDUserSpace"],
      "additionalProperties": false,
      "properties": {
        "vendorID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "productID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "product": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "serialKind": {
          "enum": ["None", "OJDUserSpace", "Present"]
        },
        "ioUserClass": {
          "type": "string"
        },
        "isOJDUserSpace": {
          "type": "boolean"
        },
        "isGameControllerSupported": {
          "type": "boolean"
        }
      }
    },
    "systemGamepadAudit": {
      "type": "object",
      "required": [
        "source",
        "bundleVersions",
        "systemExactDeviceCount",
        "skippedSystemDeviceCount",
        "ojdRecordCount",
        "catalogListedOJDRecordCount",
        "records",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "DownloadedMobileAsset",
            "PreinstalledMobileAsset",
            "Unavailable"
          ]
        },
        "bundleVersions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systemExactDeviceCount": {
          "type": "integer",
          "minimum": 0
        },
        "skippedSystemDeviceCount": {
          "type": "integer",
          "minimum": 0
        },
        "ojdRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "catalogListedOJDRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/systemRecord"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "systemRecord": {
      "type": "object",
      "required": [
        "vendorID",
        "productID",
        "name",
        "catalogListed",
        "systemIdentifiers",
        "transportConstraints",
        "versionConstraints"
      ],
      "additionalProperties": false,
      "properties": {
        "vendorID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "productID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "name": {
          "type": "string"
        },
        "catalogListed": {
          "type": "boolean"
        },
        "systemIdentifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transportConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versionConstraints": {
          "type": "array",
          "items": {
