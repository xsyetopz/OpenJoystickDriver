{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/protocol-description.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "family", "endpoints"],
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "ProtocolDescription"
    },
    "family": {
      "$ref": "controller.schema.json#/$defs/protocol/properties/family"
    },
    "variants": {
      "description": "The implemented variants of the family.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "storesVariant": {
      "description": "Whether catalog records store the variant; otherwise classification derives it from the observed transport.",
      "const": true
    },
    "endpoints": {
      "$ref": "controller.schema.json#/$defs/usbOverride/properties/endpoints"
    },
    "rawUSB": {
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      ]
    },
    "recordSections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["input", "rumble", "hidUsageMap", "bluetoothLE", "keepAlive"]
      },
      "description": "The record sections the driver reads."
    },
    "sessionKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["startup", "keepAlive"]
      },
      "description": "The general session keys that the driver reads, besides the rumble template."
    },
    "tuningKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inputLivenessTimeoutMs",
          "hidStartupIntervalMs",
          "minimumHIDOutputIntervalMs",
          "hidStartupRecoveryIntervalMs",
          "hidStartupRecoveryRounds",
          "lizardResendTicks",
          "usbCommandTimeoutMs",
          "presenceResendReports",
          "adapterDisconnectDelayMs",
          "usbStartupIntervalMs",
          "usbStartupRetryDelayMs",
          "usbTransferTimeoutMs",
          "irWriteIntervalMs",
          "speakerMaxSeconds",
          "replyTimeoutMs"
        ]
      }
    },
    "rawUSBTuningKeys": {
      "description": "The tuning keys a raw-USB variant reads beyond stickDeadzone.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lizardResendTicks",
          "usbCommandTimeoutMs",
          "presenceResendReports",
          "adapterDisconnectDelayMs",
          "usbStartupIntervalMs",
          "usbStartupRetryDelayMs",
          "usbTransferTimeoutMs"
        ]
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "recordCapabilities": {
      "$ref": "#/$defs/recordCapabilities"
    },
    "macOSOwnedOutput": {
      "$ref": "#/$defs/macOSOwnedOutput"
    },
    "inputStart": {
      "description": "What the user does before a controller of the family sends its first input report.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": ["PressGuide"]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "interfaceSignatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/interfaceSignature"
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/parameterDeclaration"
      },
      "propertyNames": {
        "enum": [
          "shareButton",
          "layout",
          "usbProtocol",
          "innerGrips",
          "lightingMemory",
          "hatSource",
          "motionCalibration",
          "role",
          "motionScale",
          "reportRevision",
          "maker",
          "unprobedSensors",
          "unprobedTouchpad",
          "forcedVibration"
        ]
      },
      "description": "The parameters that records of this family may set, by name."
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "parameterRules": {
      "description": "Rules that a record's parameters obey, beyond each parameter's own type.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameterRule"
      }
    },
    "writeTransports": {
      "description": "The transports that an activation or deactivation write may name.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "controller.schema.json#/$defs/startupWrite/properties/transport"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["recordSections"],
        "properties": {
          "recordSections": {
            "contains": {
              "const": "input"
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "input": {
                "$ref": "controller.schema.json#/$defs/input"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["recordSections"],
        "properties": {
          "recordSections": {
            "contains": {
              "const": "hidUsageMap"
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "input": {
                "$ref": "#/$defs/hidDescriptorInput"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "required": ["recordSections"],
              "properties": {
                "recordSections": {
                  "contains": {
                    "const": "input"
                  }
                }
              }
            },
            {
              "required": ["recordSections"],
              "properties": {
                "recordSections": {
                  "contains": {
                    "const": "hidUsageMap"
                  }
                }
              }
            }
          ]
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "input": false
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["recordSections"],
          "properties": {
            "recordSections": {
              "contains": {
                "const": "rumble"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "session": {
                "properties": {
                  "rumble": false
                }
              },
              "variants": {
                "additionalProperties": {
                  "properties": {
                    "session": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["rawUSB"]
        }
      },
      "then": {
        "not": {
          "required": ["rawUSBTuningKeys"]
        }
      }
    },
    {
      "if": {
        "required": ["rawUSB"],
        "properties": {
          "rawUSB": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": ["tuningKeys"]
        },
        "properties": {
          "defaults": {
            "properties": {
              "session": {
                "properties": {
                  "startup": {
                    "items": {
                      "not": {
                        "required": ["report"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "not": {
              "const": "XboxXUSB"
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "not": {
              "required": ["receiverPowerOff"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "interfaceSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "interfaceClass",
        "interfaceSubclass",
        "interfaceProtocol"
      ],
      "properties": {
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "interfaceClass": {
          "$ref": "#/$defs/byte"
        },
        "interfaceSubclass": {
          "$ref": "#/$defs/byte"
        },
        "interfaceProtocol": {
          "$ref": "#/$defs/byte"
        },
        "interfaceNumber": {
          "$ref": "#/$defs/byte"
        }
      }
    },
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "parameterDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "Flag"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": {
            "type": {
              "const": "Enum"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fields"],
          "properties": {
            "type": {
              "const": "Object"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/integerField"
              }
            }
          }
        }
      ]
    },
    "integerField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum", "maximum"],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "not": {
        "required": ["session"],
        "properties": {
          "session": {
            "required": ["keepAlive"]
          }
        },
        "anyOf": [
          {
            "properties": {
              "session": {
                "required": ["rumble"],
                "properties": {
                  "rumble": {
                    "required": ["resendIntervalMilliseconds"]
                  }
                }
              }
            }
          },
          {
            "required": ["variants"],
            "properties": {
              "variants": {
                "not": {
                  "additionalProperties": {
                    "not": {
                      "required": ["session"],
                      "properties": {
                        "session": {
                          "required": ["rumble"],
                          "properties": {
                            "rumble": {
                              "required": ["resendIntervalMilliseconds"]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "properties": {
        "session": {
          "$ref": "#/$defs/descriptionSession"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "controller.schema.json#/$defs/input"
            },
            {
              "$ref": "#/$defs/hidDescriptorInput"
            }
          ]
        },
        "tuning": {
          "$ref": "controller.schema.json#/$defs/tuning"
        },
        "receiverPowerOff": {
          "$ref": "#/$defs/descriptionReceiverPowerOff"
        },
        "variants": {
          "description": "Tuning and the rumble template that differ by variant.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/variant"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "tuning": {
                "$ref": "controller.schema.json#/$defs/tuning"
              },
              "session": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rumble"],
                "properties": {
                  "rumble": {
                    "$ref": "controller.schema.json#/$defs/rumbleTemplate"
                  }
                }
              }
            }
          }
        }
      }
    },
    "macOSOwnedOutput": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "lightingFeatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PlayerIndicator",
              "ProgrammableColor",
              "ProgrammableBrightness"
            ]
          }
        },
        "drivesRumble": {
          "type": "boolean"
        },
        "reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "controller.schema.json#/$defs/templateReport"
          }
        },
        "setsStartupPlayerIndicator": {
          "type": "boolean"
        },
        "readsStartupFeatures": {
          "type": "boolean"
        },
        "rationale": {
          "description": "Why macOS leaves this output undone, for the reader of the description.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controls": {
      "description": "The controls every controller of the family has: a base layout, removals, additions, touch contacts, and motion.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "base": {
          "enum": ["Xbox"]
        },
        "remove": {
          "$ref": "controller.schema.json#/$defs/controlList"
        },
        "add": {
          "$ref": "controller.schema.json#/$defs/controlList"
        },
        "digitalTriggers": {
          "description": "The triggers whose press the protocol reports as its own digital signal.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["LeftTrigger", "RightTrigger"]
          }
        },
        "touchContactCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "motion": {
          "type": "boolean"
        }
      }
    },
    "recordCapabilities": {
      "description": "The capability deltas a record of the family may declare: added controls and dropped rumble.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "present": {
          "$ref": "controller.schema.json#/$defs/controlList"
        },
        "rumbleAbsent": {
          "type": "boolean"
        }
      }
    },
    "hidDescriptorInput": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hidUsageMap": {
          "$ref": "controller.schema.json#/$defs/hidUsageMap"
        },
        "descriptorShapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/descriptorShape"
          }
        }
      }
    },
    "descriptorShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "hidUsageMap"],
      "properties": {
        "present": {
          "$ref": "#/$defs/usageList"
        },
        "absent": {
          "$ref": "#/$defs/usageList"
        },
        "anyOf": {
          "$ref": "#/$defs/usageList"
        },
        "hidUsageMap": {
          "$ref": "controller.schema.json#/$defs/hidUsageMap"
        }
      }
    },
    "usageList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "usage"],
        "properties": {
          "page": {
            "$ref": "controller.schema.json#/$defs/hidUsagePage"
          },
          "usage": {
            "$ref": "controller.schema.json#/$defs/hidUsageID"
          }
        }
      }
    },
    "startupVariants": {
      "description": "The stored variants that a startup or keep-alive write is sent on.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "startupWhen": {
      "description": "The enumeration parameter value that selects a startup write, or that excludes it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter"],
      "properties": {
        "parameter": {
          "enum": [
            "layout",
            "usbProtocol",
            "lightingMemory",
            "hatSource",
            "motionCalibration",
            "role",
            "motionScale",
            "reportRevision",
            "maker"
          ]
        },
        "is": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "isNot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "required": ["is"]
        },
        {
          "required": ["isNot"]
        }
      ]
    },
    "descriptionHIDStartupWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/report"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/bytes"
        },
        "delayMilliseconds": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/delayMilliseconds"
        },
        "transport": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/transport"
        },
        "phase": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/phase"
        },
        "crc32Seed": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/crc32Seed"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "when": {
          "$ref": "#/$defs/startupWhen"
        }
      },
      "if": {
        "required": ["crc32Seed"]
      },
      "then": {
        "properties": {
          "report": {
            "properties": {
              "length": {
                "minimum": 5
              }
            }
          }
        }
      }
    },
    "descriptionUSBStartupWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/bytes"
        },
        "endpoint": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/endpoint"
        },
        "timeoutMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/timeoutMilliseconds"
        },
        "delayMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/delayMilliseconds"
        },
        "sessionByte": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/sessionByte"
        },
        "toleratesRejection": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/toleratesRejection"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "when": {
          "$ref": "#/$defs/startupWhen"
        }
      }
    },
    "descriptionReceiverPowerOff": {
      "description": "The one raw-USB packet that a receiver slot gets when OJD closes it on purpose.",
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/bytes"
        },
        "endpoint": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/endpoint"
        },
        "timeoutMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/timeoutMilliseconds"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        }
      }
    },
    "descriptionPacketStartupWrite": {
      "description": "A startup write that sends one of the family's named packets, in the order listed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packet"],
      "properties": {
        "packet": {
          "$ref": "controller.schema.json#/$defs/namedPacketAction"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "when": {
          "$ref": "#/$defs/startupWhen"
        }
      }
    },
    "descriptionSessionWrite": {
      "description": "One HID report of a controller's activation or deactivation, sent as written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/report"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/bytes"
        },
        "transport": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/transport"
        }
      }
    },
    "descriptionSessionWrites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/descriptionSessionWrite"
      }
    },
    "generalSessionKeys": {
      "description": "The session keys that every family may set.",
      "properties": {
        "startup": true,
        "rumble": true,
        "keepAlive": true
      }
    },
    "wiiBitField": {
      "description": "The bits of one byte of the two core button bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["byte", "mask"],
      "properties": {
        "byte": { "type": "integer", "minimum": 0, "maximum": 1 },
        "mask": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "wiiExtensionPart": {
      "description": "Some bits of one byte of the six extension data bytes: a contiguous mask.",
      "type": "object",
      "additionalProperties": false,
      "required": ["byte", "mask"],
      "properties": {
        "byte": { "type": "integer", "minimum": 0, "maximum": 5 },
        "mask": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "wiiExtensionField": {
      "description": "One value assembled from extension parts, the most significant part first.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/wiiExtensionPart" }
    },
    "wiiExtensionLayout": {
      "description": "The decode of the six data bytes of an extension, with the rule for the center of every stick.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "buttons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["control", "byte", "mask", "pressedWhen"],
            "properties": {
              "control": { "$ref": "vocabulary.schema.json#/$defs/control" },
              "byte": { "type": "integer", "minimum": 0, "maximum": 5 },
              "mask": { "type": "integer", "minimum": 1, "maximum": 255 },
              "pressedWhen": { "enum": ["Set", "Clear"] }
            }
          }
        },
        "sticks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["control", "parts", "halfRange"],
            "properties": {
              "control": {
                "enum": ["LeftStickX", "LeftStickY", "RightStickX", "RightStickY"]
              },
              "parts": { "$ref": "#/$defs/wiiExtensionField" },
              "halfRange": { "type": "integer", "minimum": 1, "maximum": 128 }
            }
          }
        },
        "stickCenter": { "enum": ["FirstSample"] },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["control", "parts"],
            "properties": {
              "control": { "enum": ["LeftTrigger", "RightTrigger"] },
              "parts": { "$ref": "#/$defs/wiiExtensionField" }
            }
          }
        },
        "accelerometer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "$ref": "#/$defs/wiiExtensionField" },
            "y": { "$ref": "#/$defs/wiiExtensionField" },
            "z": { "$ref": "#/$defs/wiiExtensionField" }
          }
        }
      },
      "dependentRequired": { "sticks": ["stickCenter"], "stickCenter": ["sticks"] }
    },
    "wiiBlockKind": {
      "description": "What a block of an input report mode carries.",
      "enum": [
        "Buttons",
        "Accelerometer",
        "IRBasic",
        "IRExtended",
        "IRFull",
        "Extension"
      ]
    },
    "wiiAddress": {
      "description": "A register address of the remote, as six uppercase hex digits.",
      "type": "string",
      "pattern": "^[0-9A-F]{6}$"
    },
    "wiiStep": {
      "description": "One step of a register script: a report, a write, a read, or a mode setting.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "Report",
            "Write",
            "Read",
            "Sensitivity",
            "IRMode",
            "MotionPlusMode"
          ]
        },
        "report": { "type": "integer", "minimum": 16, "maximum": 26 },
        "data": {
          "$ref": "controller.schema.json#/$defs/hexBytes",
          "maxLength": 59
        },
        "address": { "$ref": "#/$defs/wiiAddress" },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/hexBytes",
          "maxLength": 47
        },
        "length": { "type": "integer", "minimum": 1, "maximum": 16 },
        "block": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "wiiScript": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/wiiStep" }
    },
    "descriptionWiiRemote": {
      "description": "The wire facts of the Wii Remote: bits, report modes, extensions, IR levels, Motion Plus modes, and scripts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rumbleBit",
        "led",
        "coreButtons",
        "accelerometerLowBits",
        "reportModes",
        "modeChoices",
        "extensions",
        "irSensitivity",
        "irModeBytes",
        "motionPlusModeBytes",
        "scripts"
      ],
      "properties": {
        "rumbleBit": { "type": "integer", "minimum": 0, "maximum": 7 },
        "led": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report", "firstBit"],
          "properties": {
            "report": { "type": "integer", "minimum": 16, "maximum": 26 },
            "firstBit": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        "coreButtons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["control", "byte", "mask"],
            "properties": {
              "control": { "$ref": "vocabulary.schema.json#/$defs/control" },
              "byte": { "type": "integer", "minimum": 0, "maximum": 1 },
              "mask": { "type": "integer", "minimum": 1, "maximum": 255 }
            }
          }
        },
        "accelerometerLowBits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "$ref": "#/$defs/wiiBitField" },
            "y": { "$ref": "#/$defs/wiiBitField" },
            "z": { "$ref": "#/$defs/wiiBitField" }
          }
        },
        "reportModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "blocks"],
            "properties": {
              "id": { "type": "integer", "minimum": 48, "maximum": 63 },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "offset", "length"],
                  "properties": {
                    "kind": { "$ref": "#/$defs/wiiBlockKind" },
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "length": { "type": "integer", "minimum": 1, "maximum": 21 }
                  }
                }
              }
            }
          }
        },
        "modeChoices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["features", "mode"],
            "properties": {
              "features": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/wiiBlockKind" }
              },
              "mode": { "type": "integer", "minimum": 48, "maximum": 63 }
            }
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string", "pattern": "^[A-Z][A-Za-z]*$" },
              "id": {
                "description": "The six bytes an id read returns.",
                "type": "string",
                "pattern": "^[0-9A-F]{2}( [0-9A-F]{2}){5}$"
              },
              "layout": { "$ref": "#/$defs/wiiExtensionLayout" }
            }
          }
        },
        "irSensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "levels"],
          "properties": {
            "default": { "type": "integer", "minimum": 1, "maximum": 9 },
            "levels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["level", "block1", "block2"],
                "properties": {
                  "level": { "type": "integer", "minimum": 1, "maximum": 9 },
                  "block1": {
                    "description": "The nine bytes written to the first sensitivity register.",
                    "type": "string",
                    "pattern": "^[0-9A-F]{2}( [0-9A-F]{2}){8}$"
                  },
                  "block2": {
                    "description": "The two bytes written to the second sensitivity register.",
                    "type": "string",
                    "pattern": "^[0-9A-F]{2} [0-9A-F]{2}$"
                  }
                }
              }
            }
          }
        },
        "irModeBytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basic", "extended", "full"],
          "properties": {
            "basic": { "$ref": "#/$defs/byte" },
            "extended": { "$ref": "#/$defs/byte" },
            "full": { "$ref": "#/$defs/byte" }
          }
        },
        "motionPlusModeBytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standalone", "nunchuk", "classic"],
          "properties": {
            "standalone": { "$ref": "#/$defs/byte" },
            "nunchuk": { "$ref": "#/$defs/byte" },
            "classic": { "$ref": "#/$defs/byte" }
          }
        },
        "scripts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handshake",
            "accelerometerCalibration",
            "motionPlus",
            "ir",
            "irStop",
            "speaker",
            "speakerStop"
          ],
          "properties": {
            "handshake": { "$ref": "#/$defs/wiiScript" },
            "accelerometerCalibration": { "$ref": "#/$defs/wiiScript" },
            "motionPlus": { "$ref": "#/$defs/wiiScript" },
            "ir": { "$ref": "#/$defs/wiiScript" },
            "irStop": { "$ref": "#/$defs/wiiScript" },
            "speaker": { "$ref": "#/$defs/wiiScript" },
            "speakerStop": { "$ref": "#/$defs/wiiScript" }
          }
        }
      }
    },
    "descriptionSession": {
      "description": "What runs while the device is open: startup writes, rumble, keep-alive, and family-specific steps.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "keepAlive": {
          "$ref": "#/$defs/descriptionKeepAlive"
        },
        "namedPackets": {
          "$ref": "#/$defs/descriptionNamedPackets"
        },
        "subcommands": {
          "$ref": "#/$defs/descriptionSubcommands"
        },
        "activation": {
          "description": "For the Valve families, the reports sent in order when the controller is activated.",
          "$ref": "#/$defs/descriptionSessionWrites"
        },
        "deactivation": {
          "description": "For the Valve families, the reports sent in order when the controller is deactivated.",
          "$ref": "#/$defs/descriptionSessionWrites"
        },
        "handshakeAttempts": {
          "description": "The startup attempts a raw-USB handshake makes before it fails.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "announceResendLimit": {
          "description": "The most startup resends after announces before the first input.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "commandChannel": {
          "description": "The USB interface that carries commands and replies, with its endpoint, reply size, and timeouts.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface",
            "inEndpoint",
            "replyLength",
            "usbReplyTimeoutMilliseconds",
            "bluetoothLEReplyTimeoutMilliseconds"
          ],
          "properties": {
            "interface": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "inEndpoint": {
              "type": "integer",
              "minimum": 128,
              "maximum": 255
            },
            "replyLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "usbReplyTimeoutMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "bluetoothLEReplyTimeoutMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          }
        },
        "wiiRemote": {
          "$ref": "#/$defs/descriptionWiiRemote"
        },
        "trailingStopPackets": {
          "description": "The zero-amplitude packets the rumble refresh sends after a stop.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "startup": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/descriptionHIDStartupWrite"
              },
              {
                "$ref": "#/$defs/descriptionUSBStartupWrite"
              },
              {
                "$ref": "#/$defs/descriptionPacketStartupWrite"
              }
            ]
          }
        },
        "rumble": {
          "$ref": "controller.schema.json#/$defs/rumbleTemplate"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["startup"],
            "properties": {
              "startup": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["report"]
                    }
                  },
                  {
                    "contains": {
                      "not": {
                        "required": ["report"]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "not": {
            "required": ["startup"],
            "properties": {
              "startup": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["packet"]
                    }
                  },
                  {
                    "contains": {
                      "required": ["bytes"]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "descriptionNamedPackets": {
      "description": "The GIP packets that a record can select by name at initialization.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/descriptionNamedPacket"
      }
    },
    "descriptionNamedPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bytes", "sessionByte"],
      "properties": {
        "id": {
          "$ref": "controller.schema.json#/$defs/namedPacketAction"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/hexBytes",
          "minLength": 8,
          "maxLength": 191
        },
        "sessionByte": {
          "description": "The byte offset of the GIP sequence number.",
          "const": 2
        }
      }
    },
    "descriptionSubcommands": {
      "description": "The Switch 1 subcommand report: its id, the packet counter modulus, the startup requests, and the player indicator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reportID", "counterModulus", "requests", "playerIndicator"],
      "properties": {
        "reportID": {
          "$ref": "#/$defs/byte"
        },
        "counterModulus": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/descriptionSubcommandRequest"
          }
        },
        "playerIndicator": {
          "$ref": "#/$defs/descriptionPlayerIndicator"
        }
      }
    },
    "descriptionPlayerIndicator": {
      "description": "The player-indicator subcommand: its id and the one data byte that lights each indicator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subcommand", "patterns"],
      "properties": {
        "subcommand": {
          "$ref": "#/$defs/byte"
        },
        "patterns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["off", "player1", "player2", "player3", "player4"],
          "properties": {
            "off": {
              "$ref": "#/$defs/byte"
            },
            "player1": {
              "$ref": "#/$defs/byte"
            },
            "player2": {
              "$ref": "#/$defs/byte"
            },
            "player3": {
              "$ref": "#/$defs/byte"
            },
            "player4": {
              "$ref": "#/$defs/byte"
            }
          }
        }
      }
    },
    "descriptionSubcommandRequest": {
      "description": "One subcommand: its id and either fixed data bytes or an SPI flash read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subcommand"],
      "properties": {
        "subcommand": {
          "$ref": "#/$defs/byte"
        },
        "data": {
          "$ref": "controller.schema.json#/$defs/hexBytes",
          "maxLength": 47
        },
        "spiRead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "length", "purpose"],
          "properties": {
            "address": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 29
            },
            "purpose": {
              "enum": ["FactoryMotionCalibration", "UserMotionCalibration"]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["data"]
        },
        {
          "required": ["spiRead"]
        }
      ]
    },
    "descriptionKeepAlive": {
      "description": "The family's keep-alive: its period and the fixed writes of each run.",
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalMilliseconds"],
      "properties": {
        "intervalMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/descriptionKeepAliveHIDWrite"
              },
              {
                "$ref": "#/$defs/descriptionKeepAliveUSBWrite"
              }
            ]
          }
        }
      }
    },
    "descriptionKeepAliveHIDWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/report"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/bytes"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "resendTuning": {
          "description": "The tuning key that gives the number of runs between sends of this write.",
          "enum": ["lizardResendTicks"]
        }
      }
    },
    "descriptionKeepAliveUSBWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/bytes"
        },
        "endpoint": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/endpoint"
        },
        "timeoutMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/timeoutMilliseconds"
        },
        "sessionByte": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/sessionByte"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "resendTuning": {
          "description": "The tuning key that gives the number of runs between sends of this write.",
          "enum": ["lizardResendTicks"]
        }
      }
    },
    "variant": {
      "description": "A protocol variant name.",
      "enum": [
        "USB",
        "BluetoothClassic",
        "BluetoothLE",
        "Gamepad",
        "Wired",
        "Receiver",
        "Dongle",
        "EnhancedHID"
      ]
    },
    "parameterRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": {
        "rule": {
          "enum": ["None", "AtMostOne", "ExactlyOne", "Requires"]
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      },
      "if": {
        "properties": {
          "rule": {
            "const": "None"
          }
        },
        "required": ["rule"]
      },
      "then": {
        "not": {
          "required": ["parameters"]
        }
      },
      "else": {
        "required": ["parameters"]
      }
    }
  },
  "dependentRequired": {
    "storesVariant": ["variants"]
  }
}
