{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha1/protocol-description.schema.json",
  "$comment": "Each family's variants and whether records store the variant are its `variants` and `storesVariant`, the one source Swift and the Python tools read; its interface signatures, rawUSB list and defaults.variants name only those variants, and a family with none has no interface signatures, which a schema cannot say and the validators check. The parameter names of each family are those its driver declares in ProtocolParameters. The family facts a driver reads live here and nowhere in code: its default endpoints, whether it is reached through raw USB (for every variant, or only the listed ones), the record sections whose layouts it reads, the tuning keys it reads beyond stickDeadzone (none for a raw-USB variant), its button labels, and what OJD still sends when macOS serves the controller. defaults holds the sections a record layers over, limited to what the family reads: input is a byte layout where recordSections lists input and a HID usage map where it lists hidUsageMap, sessionKeys lists the startup and keepAlive session keys the driver reads, a rumble template, flat or per variant, needs the matching recordSections entry, HID startup writes need a family that is not always raw USB, raw-USB startup writes (bytes, endpoint, timeoutMilliseconds, delayMilliseconds, sessionByte, toleratesRejection) carry the packets a raw-USB driver sends, each startup write is limited by variants and by a when rule on an enumeration parameter the description declares and whose values it lists, which a schema cannot say and the validators check, and each defaults.tuning key must be stickDeadzone or in tuningKeys, which a schema cannot say and the validators check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "family", "endpoints"],
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha1"
    },
    "kind": {
      "const": "ProtocolDescription"
    },
    "family": {
      "$ref": "controller.schema.json#/$defs/protocol/properties/family"
    },
    "variants": {
      "description": "The implemented variants of the family; absent when it has one contract. Interface signatures, rawUSB and defaults.variants name only these.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "storesVariant": {
      "description": "Whether catalog records store the variant; otherwise classification derives it from the observed transport.",
      "const": true
    },
    "endpoints": {
      "$ref": "controller.schema.json#/$defs/usbOverride/properties/endpoints"
    },
    "rawUSB": {
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      ]
    },
    "recordSections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["input", "rumble", "hidUsageMap", "bluetoothLE", "keepAlive"]
      },
      "description": "The record sections the driver reads: input (a byte layout), rumble (a rumble template), hidUsageMap (an input hidUsageMap), bluetoothLE (the record's bluetoothLE section) and keepAlive (protocol.keepAlive)."
    },
    "sessionKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["startup", "keepAlive"]
      },
      "description": "The general defaults.session keys, besides the rumble template that recordSections governs, that the driver reads; absent means none. A schema cannot say that defaults.session sets only these, which the validators check."
    },
    "tuningKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inputLivenessTimeoutMs",
          "hidStartupIntervalMs",
          "minimumHIDOutputIntervalMs",
          "hidStartupRecoveryIntervalMs",
          "hidStartupRecoveryRounds",
          "lizardResendTicks",
          "usbCommandTimeoutMs",
          "presenceResendReports",
          "adapterDisconnectDelayMs",
          "usbStartupIntervalMs",
          "usbStartupRetryDelayMs",
          "usbTransferTimeoutMs"
        ]
      }
    },
    "rawUSBTuningKeys": {
      "description": "The tuning keys a raw-USB variant reads beyond stickDeadzone.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lizardResendTicks",
          "usbCommandTimeoutMs",
          "presenceResendReports",
          "adapterDisconnectDelayMs",
          "usbStartupIntervalMs",
          "usbStartupRetryDelayMs",
          "usbTransferTimeoutMs"
        ]
      }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "recordCapabilities": {
      "$ref": "#/$defs/recordCapabilities"
    },
    "macOSOwnedOutput": {
      "$ref": "#/$defs/macOSOwnedOutput"
    },
    "inputStart": {
      "description": "What the user does before a controller of the family sends its first input report: PressGuide presses the home button. variants limits it to those variants, each one the family lists, which a schema cannot say and the validators check; absent means every variant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": ["PressGuide"]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "interfaceSignatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/interfaceSignature"
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/parameterDeclaration"
      },
      "propertyNames": {
        "enum": [
          "shareButton",
          "layout",
          "usbProtocol",
          "innerGrips",
          "lightingMemory",
          "hatSource",
          "motionCalibration",
          "role",
          "motionScale",
          "reportRevision",
          "maker",
          "unprobedSensors",
          "unprobedTouchpad",
          "forcedVibration"
        ]
      },
      "description": "The parameters records of this family may set, by name; each name is one a driver reads in ProtocolParameters."
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "parameterRules": {
      "description": "Rules a record's parameters obey beyond each parameter's own type. Each rule applies to the listed variants, or to every variant when it lists none: None allows no parameters, AtMostOne and ExactlyOne limit how many of the listed parameters are set, and Requires needs every listed parameter whenever any parameter is set. The listed parameters are ones the description declares and the variants are ones the family has, which a schema cannot say and the validators check.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameterRule"
      }
    },
    "writeTransports": {
      "description": "The transports an activation or deactivation write may name; absent when the family's writes name no transport.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "controller.schema.json#/$defs/startupWrite/properties/transport"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["recordSections"],
        "properties": {
          "recordSections": {
            "contains": {
              "const": "input"
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "input": {
                "$ref": "controller.schema.json#/$defs/input"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["recordSections"],
        "properties": {
          "recordSections": {
            "contains": {
              "const": "hidUsageMap"
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "input": {
                "$ref": "#/$defs/hidDescriptorInput"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "required": ["recordSections"],
              "properties": {
                "recordSections": {
                  "contains": {
                    "const": "input"
                  }
                }
              }
            },
            {
              "required": ["recordSections"],
              "properties": {
                "recordSections": {
                  "contains": {
                    "const": "hidUsageMap"
                  }
                }
              }
            }
          ]
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "input": false
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["recordSections"],
          "properties": {
            "recordSections": {
              "contains": {
                "const": "rumble"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "properties": {
              "session": {
                "properties": {
                  "rumble": false
                }
              },
              "variants": {
                "additionalProperties": {
                  "properties": {
                    "session": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["rawUSB"]
        }
      },
      "then": {
        "not": {
          "required": ["rawUSBTuningKeys"]
        }
      }
    },
    {
      "if": {
        "required": ["rawUSB"],
        "properties": {
          "rawUSB": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": ["tuningKeys"]
        },
        "properties": {
          "defaults": {
            "properties": {
              "session": {
                "properties": {
                  "startup": {
                    "items": {
                      "not": {
                        "required": ["report"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "interfaceSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "interfaceClass",
        "interfaceSubclass",
        "interfaceProtocol"
      ],
      "properties": {
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "interfaceClass": {
          "$ref": "#/$defs/byte"
        },
        "interfaceSubclass": {
          "$ref": "#/$defs/byte"
        },
        "interfaceProtocol": {
          "$ref": "#/$defs/byte"
        },
        "interfaceNumber": {
          "$ref": "#/$defs/byte"
        }
      }
    },
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "parameterDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "Flag"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": {
            "type": {
              "const": "Enum"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fields"],
          "properties": {
            "type": {
              "const": "Object"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/integerField"
              }
            }
          }
        }
      ]
    },
    "integerField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum", "maximum"],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "$comment": "a rumble resendIntervalMilliseconds needs a family whose description declares no keepAlive",
      "not": {
        "required": ["session"],
        "properties": {
          "session": {
            "required": ["keepAlive"]
          }
        },
        "anyOf": [
          {
            "properties": {
              "session": {
                "required": ["rumble"],
                "properties": {
                  "rumble": {
                    "required": ["resendIntervalMilliseconds"]
                  }
                }
              }
            }
          },
          {
            "required": ["variants"],
            "properties": {
              "variants": {
                "not": {
                  "additionalProperties": {
                    "not": {
                      "required": ["session"],
                      "properties": {
                        "session": {
                          "required": ["rumble"],
                          "properties": {
                            "rumble": {
                              "required": ["resendIntervalMilliseconds"]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "properties": {
        "session": {
          "$ref": "#/$defs/descriptionSession"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "controller.schema.json#/$defs/input"
            },
            {
              "$ref": "#/$defs/hidDescriptorInput"
            }
          ]
        },
        "tuning": {
          "$ref": "controller.schema.json#/$defs/tuning"
        },
        "variants": {
          "description": "Tuning and the rumble template that differ by variant, over the flat tuning and the flat session rumble template.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/variant"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "tuning": {
                "$ref": "controller.schema.json#/$defs/tuning"
              },
              "session": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rumble"],
                "properties": {
                  "rumble": {
                    "$ref": "controller.schema.json#/$defs/rumbleTemplate"
                  }
                }
              }
            }
          }
        }
      }
    },
    "macOSOwnedOutput": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "lightingFeatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PlayerIndicator",
              "ProgrammableColor",
              "ProgrammableBrightness"
            ]
          }
        },
        "drivesRumble": {
          "type": "boolean"
        },
        "reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "controller.schema.json#/$defs/templateReport"
          }
        },
        "setsStartupPlayerIndicator": {
          "type": "boolean"
        },
        "readsStartupFeatures": {
          "type": "boolean"
        },
        "rationale": {
          "description": "Why macOS leaves this output undone, for the reader of the description.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controls": {
      "description": "The controls every controller of the family has: the Xbox layout (without guide) when base is Xbox, less remove, plus add, with the touch contacts and motion the family reports. A driver adds only what its record or layout makes true.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "base": {
          "enum": ["Xbox"]
        },
        "remove": {
          "$ref": "controller.schema.json#/$defs/controlList"
        },
        "add": {
          "$ref": "controller.schema.json#/$defs/controlList"
        },
        "digitalTriggers": {
          "description": "The triggers whose press the protocol reports as its own digital signal; they are controls of the family.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["LeftTrigger", "RightTrigger"]
          }
        },
        "touchContactCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "motion": {
          "type": "boolean"
        }
      }
    },
    "recordCapabilities": {
      "description": "The capability deltas a record of the family may declare, because its driver acts on them: the exact controls a record may add with present, and whether it may drop rumble.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "present": {
          "$ref": "controller.schema.json#/$defs/controlList"
        },
        "rumbleAbsent": {
          "type": "boolean"
        }
      }
    },
    "hidDescriptorInput": {
      "$comment": "The input defaults of a description whose recordSections lists hidUsageMap: hidUsageMap is the map every record layers over, and descriptorShapes picks another map for a controller whose report descriptor has a shape. The first shape whose usages are all present, none of absent present, and at least one of anyOf present (when listed) applies.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hidUsageMap": {
          "$ref": "controller.schema.json#/$defs/hidUsageMap"
        },
        "descriptorShapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/descriptorShape"
          }
        }
      }
    },
    "descriptorShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "hidUsageMap"],
      "properties": {
        "present": {
          "$ref": "#/$defs/usageList"
        },
        "absent": {
          "$ref": "#/$defs/usageList"
        },
        "anyOf": {
          "$ref": "#/$defs/usageList"
        },
        "hidUsageMap": {
          "$ref": "controller.schema.json#/$defs/hidUsageMap"
        }
      }
    },
    "usageList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "usage"],
        "properties": {
          "page": {
            "$ref": "controller.schema.json#/$defs/hidUsagePage"
          },
          "usage": {
            "$ref": "controller.schema.json#/$defs/hidUsageID"
          }
        }
      }
    },
    "startupVariants": {
      "description": "The stored variants a startup or keep-alive write is sent on; absent sends it on every variant.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "startupWhen": {
      "description": "Limits a startup write to controllers whose record sets an enumeration parameter to a listed value (is), or not to one (isNot, which also matches an unset parameter).",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter"],
      "properties": {
        "parameter": {
          "enum": [
            "layout",
            "usbProtocol",
            "lightingMemory",
            "hatSource",
            "motionCalibration",
            "role",
            "motionScale",
            "reportRevision",
            "maker"
          ]
        },
        "is": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "isNot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "required": ["is"]
        },
        {
          "required": ["isNot"]
        }
      ]
    },
    "descriptionHIDStartupWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/report"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/bytes"
        },
        "delayMilliseconds": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/delayMilliseconds"
        },
        "transport": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/transport"
        },
        "phase": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/phase"
        },
        "crc32Seed": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/crc32Seed"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "when": {
          "$ref": "#/$defs/startupWhen"
        }
      },
      "if": {
        "required": ["crc32Seed"]
      },
      "then": {
        "properties": {
          "report": {
            "properties": {
              "length": {
                "minimum": 5
              }
            }
          }
        }
      }
    },
    "descriptionUSBStartupWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/bytes"
        },
        "endpoint": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/endpoint"
        },
        "timeoutMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/timeoutMilliseconds"
        },
        "delayMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/delayMilliseconds"
        },
        "sessionByte": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/sessionByte"
        },
        "toleratesRejection": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/toleratesRejection"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "when": {
          "$ref": "#/$defs/startupWhen"
        }
      }
    },
    "descriptionPacketStartupWrite": {
      "description": "A startup write that sends one of the family's named packets, in the order listed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packet"],
      "properties": {
        "packet": {
          "$ref": "controller.schema.json#/$defs/namedPacketAction"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "when": {
          "$ref": "#/$defs/startupWhen"
        }
      }
    },
    "descriptionSessionWrite": {
      "description": "One HID report of a controller's activation or deactivation, sent as written. A write limited by transport is sent only over that transport.",
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/report"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/bytes"
        },
        "transport": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/transport"
        }
      }
    },
    "descriptionSessionWrites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/descriptionSessionWrite"
      }
    },
    "generalSessionKeys": {
      "description": "The defaults.session keys every family may set. Any other session key belongs to the families whose drivers read it.",
      "properties": {
        "startup": true,
        "rumble": true,
        "keepAlive": true
      }
    },
    "descriptionSession": {
      "description": "What runs while the device is open: startup writes, the rumble template, the keep-alive, for NintendoSwitch1 its subcommands, for XboxGIP its named packets, handshake attempts and announce resend limit, and for XboxXUSB its receiver inquiry resend limit, and for NintendoSwitch2 its command channel and trailing stop packets. Startup writes are all HID reports, all raw-USB packets, or all references to the family's named packets; a reference names an id that namedPackets lists, which a schema cannot say and the validators check.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "keepAlive": {
          "$ref": "#/$defs/descriptionKeepAlive"
        },
        "namedPackets": {
          "$ref": "#/$defs/descriptionNamedPackets"
        },
        "subcommands": {
          "$ref": "#/$defs/descriptionSubcommands"
        },
        "activation": {
          "description": "For the Valve families, the reports sent in order when the controller is activated.",
          "$ref": "#/$defs/descriptionSessionWrites"
        },
        "deactivation": {
          "description": "For the Valve families, the reports sent in order when the controller is deactivated.",
          "$ref": "#/$defs/descriptionSessionWrites"
        },
        "handshakeAttempts": {
          "description": "The startup attempts a raw-USB handshake makes before it fails.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "announceResendLimit": {
          "description": "The most startup resends after announces before the first input.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "commandChannel": {
          "description": "The USB interface that carries commands and their replies: its number, the IN endpoint, the largest reply read after each command, and the reply read timeout over USB and over Bluetooth LE.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface",
            "inEndpoint",
            "replyLength",
            "usbReplyTimeoutMilliseconds",
            "bluetoothLEReplyTimeoutMilliseconds"
          ],
          "properties": {
            "interface": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "inEndpoint": {
              "type": "integer",
              "minimum": 128,
              "maximum": 255
            },
            "replyLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "usbReplyTimeoutMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "bluetoothLEReplyTimeoutMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          }
        },
        "trailingStopPackets": {
          "description": "The zero-amplitude packets the rumble refresh sends after a stop.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "startup": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/descriptionHIDStartupWrite"
              },
              {
                "$ref": "#/$defs/descriptionUSBStartupWrite"
              },
              {
                "$ref": "#/$defs/descriptionPacketStartupWrite"
              }
            ]
          }
        },
        "rumble": {
          "$ref": "controller.schema.json#/$defs/rumbleTemplate"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["startup"],
            "properties": {
              "startup": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["report"]
                    }
                  },
                  {
                    "contains": {
                      "not": {
                        "required": ["report"]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "not": {
            "required": ["startup"],
            "properties": {
              "startup": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["packet"]
                    }
                  },
                  {
                    "contains": {
                      "required": ["bytes"]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "descriptionNamedPackets": {
      "description": "The GIP packets a record can select by name in protocol.initialization. A named packet is a raw-USB packet whose byte 2 is the sequence number the driver stamps; its id is the family name, a slash and a lowercase hyphenated name, and appears at most once, which a schema cannot say and the validators check.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/descriptionNamedPacket"
      }
    },
    "descriptionNamedPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bytes", "sessionByte"],
      "properties": {
        "id": {
          "$ref": "controller.schema.json#/$defs/namedPacketAction"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/hexBytes",
          "minLength": 8,
          "maxLength": 191
        },
        "sessionByte": {
          "description": "The GIP sequence number sits at byte 2.",
          "const": 2
        }
      }
    },
    "descriptionSubcommands": {
      "description": "The Switch 1 subcommand report: its id, the modulus of the rolling packet counter that every output report of the family shares (the counter starts at 0 and wraps to 0 after modulus - 1), the requests sent in order at startup and the player-indicator subcommand. A startup recovery round re-sends the SPI reads whose reply has not arrived.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reportID", "counterModulus", "requests", "playerIndicator"],
      "properties": {
        "reportID": {
          "$ref": "#/$defs/byte"
        },
        "counterModulus": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/descriptionSubcommandRequest"
          }
        },
        "playerIndicator": {
          "$ref": "#/$defs/descriptionPlayerIndicator"
        }
      }
    },
    "descriptionPlayerIndicator": {
      "description": "The player-indicator subcommand: its id and the one data byte that lights each indicator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subcommand", "patterns"],
      "properties": {
        "subcommand": {
          "$ref": "#/$defs/byte"
        },
        "patterns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["off", "player1", "player2", "player3", "player4"],
          "properties": {
            "off": {
              "$ref": "#/$defs/byte"
            },
            "player1": {
              "$ref": "#/$defs/byte"
            },
            "player2": {
              "$ref": "#/$defs/byte"
            },
            "player3": {
              "$ref": "#/$defs/byte"
            },
            "player4": {
              "$ref": "#/$defs/byte"
            }
          }
        }
      }
    },
    "descriptionSubcommandRequest": {
      "description": "One subcommand: its id and either fixed data bytes or an SPI flash read. An SPI read sends the address as four little-endian bytes and then the length; its purpose names the calibration the reply feeds, and each purpose appears at most once, which a schema cannot say and the validators check.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subcommand"],
      "properties": {
        "subcommand": {
          "$ref": "#/$defs/byte"
        },
        "data": {
          "$ref": "controller.schema.json#/$defs/hexBytes",
          "maxLength": 47
        },
        "spiRead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "length", "purpose"],
          "properties": {
            "address": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 29
            },
            "purpose": {
              "enum": ["FactoryMotionCalibration", "UserMotionCalibration"]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["data"]
        },
        {
          "required": ["spiRead"]
        }
      ]
    },
    "descriptionKeepAlive": {
      "description": "The family's keep-alive: its period, and the fixed writes of each run. The driver adds the writes that follow its state. A list may mix HID reports and raw-USB packets, each limited to the variants it is for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalMilliseconds"],
      "properties": {
        "intervalMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/descriptionKeepAliveHIDWrite"
              },
              {
                "$ref": "#/$defs/descriptionKeepAliveUSBWrite"
              }
            ]
          }
        }
      }
    },
    "descriptionKeepAliveHIDWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "bytes"],
      "properties": {
        "report": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/report"
        },
        "bytes": {
          "$ref": "controller.schema.json#/$defs/startupWrite/properties/bytes"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "resendTuning": {
          "description": "The tuning key that gives the number of runs between sends of this write; absent sends it on every run.",
          "enum": ["lizardResendTicks"]
        }
      }
    },
    "descriptionKeepAliveUSBWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/bytes"
        },
        "endpoint": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/endpoint"
        },
        "timeoutMilliseconds": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/timeoutMilliseconds"
        },
        "sessionByte": {
          "$ref": "controller.schema.json#/$defs/usbStartupWrite/properties/sessionByte"
        },
        "variants": {
          "$ref": "#/$defs/startupVariants"
        },
        "resendTuning": {
          "description": "The tuning key that gives the number of runs between sends of this write; absent sends it on every run.",
          "enum": ["lizardResendTicks"]
        }
      }
    },
    "variant": {
      "description": "A protocol variant name; a family that has the variant lists it in its variants.",
      "enum": [
        "USB",
        "BluetoothClassic",
        "BluetoothLE",
        "Gamepad",
        "Wired",
        "Receiver",
        "Dongle",
        "EnhancedHID"
      ]
    },
    "parameterRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": {
        "rule": {
          "enum": ["None", "AtMostOne", "ExactlyOne", "Requires"]
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      },
      "if": {
        "properties": {
          "rule": {
            "const": "None"
          }
        },
        "required": ["rule"]
      },
      "then": {
        "not": {
          "required": ["parameters"]
        }
      },
      "else": {
        "required": ["parameters"]
      }
    }
  },
  "dependentRequired": {
    "storesVariant": ["variants"]
  }
}
