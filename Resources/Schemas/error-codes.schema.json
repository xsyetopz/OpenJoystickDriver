{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/error-codes.schema.json",
  "title": "OpenJoystickDriver error codes",
  "description": "The authored catalog Resources/ErrorCodes.json. Each entry gives one stable E#### code. A code is never reused for another error. The English explanation of a code is the localization key error.E####.",
  "type": "object",
  "required": ["apiVersion", "kind", "codes"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "ErrorCatalog"
    },
    "codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["code", "domain", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E[1-5][0-9]{3}$",
          "description": "E1xxx is Endpoint, E2xxx is CLI, E3xxx is Remapping, E4xxx is Mod, and E5xxx is Document."
        },
        "domain": {
          "enum": ["Endpoint", "CLI", "Remapping", "Mod", "Document"]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "The lowerCamelCase name of the Swift ErrorCode case."
        },
        "exitCode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "The exit status of ojd; cli entries only."
        },
        "wire": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The code value of the remapping RPC that this code stands for; remapping and document entries only."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "domain": {
                "const": "CLI"
              }
            }
          },
          "then": {
            "required": ["exitCode"]
          },
          "else": {
            "not": {
              "required": ["exitCode"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "Remapping"
              }
            }
          },
          "then": {
            "required": ["wire"]
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "enum": ["CLI", "Endpoint", "Mod"]
              }
            }
          },
          "then": {
            "not": {
              "required": ["wire"]
            }
          }
        }
      ]
    }
  }
}
