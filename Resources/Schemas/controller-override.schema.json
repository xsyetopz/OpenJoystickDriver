{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller-override.schema.json",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["$schema", "operation", "record"],
			"properties": {
				"$schema": {
					"const": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller-override.schema.json"
				},
				"operation": {
					"const": "add"
				},
				"record": {
					"$ref": "controller.schema.json"
				}
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["$schema", "operation", "vendorID", "productID", "set"],
			"properties": {
				"$schema": {
					"const": "https://raw.githubusercontent.com/xsyetopz/OpenJoystickDriver/main/Resources/Schemas/controller-override.schema.json"
				},
				"operation": {
					"const": "patch"
				},
				"vendorID": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"productID": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"set": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": false,
					"properties": {
						"protocol": {
							"$ref": "controller.schema.json#/$defs/protocol"
						},
						"usb": {
							"$ref": "controller.schema.json#/$defs/usbOverride"
						},
						"ownership": {
							"$ref": "controller.schema.json#/$defs/ownership"
						},
						"output": {
							"$ref": "controller.schema.json#/$defs/output"
						},
						"input": {
							"$ref": "controller.schema.json#/$defs/input"
						}
					}
				}
			}
		}
	]
}
