{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha3/virtual-device.schema.json",
  "description": "A virtual device record: a persona, or a selection of a persona for a controller model or unit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "persona"],
  "properties": {
    "apiVersion": {
      "const": "openjoystickdriver/v1alpha3"
    },
    "kind": {
      "const": "VirtualDevice"
    },
    "persona": {
      "enum": ["Generic", "SDLCompatible", "GameControllerCompatible"]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorID", "productID"],
      "properties": {
        "vendorID": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "productID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "unit": {
          "type": "string",
          "pattern": "^U-[A-Za-z0-9_-]{16}$"
        }
      }
    },
    "layout": {
      "description": "The HID report layout the persona publishes.",
      "enum": ["OJDGenericGamepad", "XboxOneGIP", "XboxSeriesBluetooth"]
    },
    "transport": {
      "description": "The transport the published device reports.",
      "enum": ["USB", "Bluetooth"]
    },
    "labels": {
      "description": "The control glyph family the published product shows.",
      "enum": ["Xbox", "Generic"]
    },
    "worksWithDefaultSDLHints": {
      "description": "Whether SDL recognizes the published device with its default hints.",
      "type": "boolean"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorID", "productID", "productName", "manufacturer"],
      "properties": {
        "vendorID": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "productID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "version": {
          "description": "The published HID version number, which SDL puts in its controller GUID.",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "productName": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "if": {
    "required": ["match"]
  },
  "then": {
    "not": {
      "anyOf": [
        { "required": ["layout"] },
        { "required": ["transport"] },
        { "required": ["worksWithDefaultSDLHints"] }
      ]
    }
  },
  "else": {
    "required": [
      "layout",
      "transport",
      "labels",
      "worksWithDefaultSDLHints",
      "identity"
    ],
    "properties": {
      "identity": { "required": ["version"] }
    }
  }
}
