{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "XboxGIP",
  "variants": ["USB"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "rawUSB": true,
  "recordSections": ["keepAlive"],
  "sessionKeys": ["startup", "keepAlive"],
  "interfaceSignatures": [
    {
      "variant": "USB",
      "interfaceClass": 255,
      "interfaceSubclass": 71,
      "interfaceProtocol": 208,
      "interfaceNumber": 0
    }
  ],
  "parameters": {
    "shareButton": {
      "type": "Object",
      "fields": {
        "fromEnd": {
          "type": "Integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    }
  },
  "controls": {
    "base": "Xbox",
    "add": ["Guide"]
  },
  "rawUSBTuningKeys": [
    "presenceResendReports",
    "usbStartupIntervalMs",
    "usbStartupRetryDelayMs",
    "usbTransferTimeoutMs"
  ],
  "recordCapabilities": {
    "rumbleAbsent": true
  },
  "defaults": {
    "session": {
      "startup": [
        {
          "packet": "XboxGIP/power-on"
        },
        {
          "packet": "XboxGIP/led-on"
        },
        {
          "packet": "XboxGIP/auth-done"
        }
      ],
      "handshakeAttempts": 3,
      "announceResendLimit": 8,
      "keepAlive": {
        "intervalMilliseconds": 4000,
        "writes": [
          {
            "bytes": "03 20 00 03 00 00 00",
            "sessionByte": 2
          }
        ]
      },
      "namedPackets": [
        {
          "id": "XboxGIP/power-on",
          "bytes": "05 20 00 01 00",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/s-init",
          "bytes": "05 20 00 0F 06",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/enable-extra-input",
          "bytes": "4D 10 00 02 07 00",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/hori-ack",
          "bytes": "01 20 00 09 00 04 20 3A 00 00 00 80 00",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/led-on",
          "bytes": "0A 20 00 03 00 01 14",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/auth-done",
          "bytes": "06 20 00 02 01 00",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/rumble-begin",
          "bytes": "09 00 00 09 00 0F 00 00 1D 1D FF 00 00",
          "sessionByte": 2
        },
        {
          "id": "XboxGIP/rumble-end",
          "bytes": "09 00 00 09 00 0F 00 00 00 00 00 00 00",
          "sessionByte": 2
        }
      ]
    },
    "tuning": {
      "presenceResendReports": 4,
      "usbStartupIntervalMs": 50,
      "usbStartupRetryDelayMs": 1000,
      "usbTransferTimeoutMs": 2000
    }
  }
}
