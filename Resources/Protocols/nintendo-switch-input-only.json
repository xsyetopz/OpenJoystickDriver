{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "NintendoSwitchInputOnly",
  "variants": ["USB", "BluetoothClassic"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["input"],
  "tuningKeys": ["hidStartupIntervalMs", "minimumHIDOutputIntervalMs"],
  "controls": {
    "base": "Xbox",
    "add": ["Guide", "Capture"],
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "input": {
      "layouts": [
        {
          "report": {
            "length": {
              "atLeast": 7
            }
          },
          "buttons": [
            {
              "control": "West",
              "bitOffset": 0,
              "bitSize": 1
            },
            {
              "control": "South",
              "bitOffset": 1,
              "bitSize": 1
            },
            {
              "control": "East",
              "bitOffset": 2,
              "bitSize": 1
            },
            {
              "control": "North",
              "bitOffset": 3,
              "bitSize": 1
            },
            {
              "control": "LeftShoulder",
              "bitOffset": 4,
              "bitSize": 1
            },
            {
              "control": "RightShoulder",
              "bitOffset": 5,
              "bitSize": 1
            },
            {
              "control": "LeftTrigger",
              "bitOffset": 6,
              "bitSize": 1
            },
            {
              "control": "RightTrigger",
              "bitOffset": 7,
              "bitSize": 1
            },
            {
              "control": "Back",
              "bitOffset": 8,
              "bitSize": 1
            },
            {
              "control": "Start",
              "bitOffset": 9,
              "bitSize": 1
            },
            {
              "control": "LeftStickClick",
              "bitOffset": 10,
              "bitSize": 1
            },
            {
              "control": "RightStickClick",
              "bitOffset": 11,
              "bitSize": 1
            },
            {
              "control": "Guide",
              "bitOffset": 12,
              "bitSize": 1
            },
            {
              "control": "Capture",
              "bitOffset": 13,
              "bitSize": 1
            }
          ],
          "axes": [
            {
              "control": "LeftStickX",
              "bitOffset": 24,
              "bitSize": 8
            },
            {
              "control": "LeftStickY",
              "bitOffset": 32,
              "bitSize": 8
            },
            {
              "control": "RightStickX",
              "bitOffset": 40,
              "bitSize": 8
            },
            {
              "control": "RightStickY",
              "bitOffset": 48,
              "bitSize": 8
            }
          ],
          "hat": [
            {
              "encoding": "EightWay",
              "bitOffset": 16,
              "bitSize": 8
            }
          ]
        }
      ]
    }
  }
}
