{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "SonyDualSense",
  "variants": ["USB", "BluetoothClassic"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "adapterDisconnectDelayMs"
  ],
  "parameters": {
    "maker": {
      "type": "Enum",
      "values": ["ThirdParty"]
    },
    "unprobedSensors": {
      "type": "Flag"
    },
    "unprobedTouchpad": {
      "type": "Flag"
    },
    "forcedVibration": {
      "type": "Flag"
    },
    "role": {
      "type": "Enum",
      "values": ["Receiver"]
    }
  },
  "parameterRules": [
    {
      "rule": "Requires",
      "parameters": ["maker"]
    }
  ],
  "controls": {
    "base": "Xbox",
    "add": ["Guide", "TouchpadClick", "Microphone"],
    "touchContactCount": 2,
    "motion": true,
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "recordCapabilities": {
    "present": ["LeftPaddle1", "RightPaddle1", "Auxiliary1", "Auxiliary2"]
  },
  "defaults": {
    "tuning": {
      "adapterDisconnectDelayMs": 500
    }
  }
}
