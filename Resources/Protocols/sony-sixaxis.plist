<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>apiVersion</key>
	<string>openjoystickdriver/v1alpha3</string>
	<key>controls</key>
	<dict>
		<key>add</key>
		<array>
			<string>Guide</string>
		</array>
		<key>base</key>
		<string>Xbox</string>
		<key>digitalTriggers</key>
		<array>
			<string>LeftTrigger</string>
			<string>RightTrigger</string>
		</array>
	</dict>
	<key>defaults</key>
	<dict>
		<key>variants</key>
		<dict>
			<key>USB</key>
			<dict>
				<key>tuning</key>
				<dict>
					<key>inputLivenessTimeoutMs</key>
					<integer>1000</integer>
				</dict>
			</dict>
		</dict>
	</dict>
	<key>endpoints</key>
	<dict>
		<key>in</key>
		<integer>130</integer>
		<key>out</key>
		<integer>2</integer>
	</dict>
	<key>family</key>
	<string>SonySixaxis</string>
	<key>inputStart</key>
	<dict>
		<key>action</key>
		<string>PressGuide</string>
		<key>variants</key>
		<array>
			<string>USB</string>
		</array>
	</dict>
	<key>kind</key>
	<string>ProtocolDescription</string>
	<key>macOSOwnedOutput</key>
	<dict>
		<key>drivesRumble</key>
		<true/>
		<key>lightingFeatures</key>
		<array>
			<string>PlayerIndicator</string>
		</array>
		<key>rationale</key>
		<string>macOS never writes output report 0x01 to a Sixaxis, and a USB Sixaxis ignores it until the host reads feature report 0xF2.</string>
		<key>readsStartupFeatures</key>
		<true/>
		<key>reports</key>
		<array>
			<dict>
				<key>id</key>
				<integer>1</integer>
				<key>kind</key>
				<string>Output</string>
				<key>length</key>
				<integer>49</integer>
			</dict>
		</array>
		<key>setsStartupPlayerIndicator</key>
		<true/>
	</dict>
	<key>tuningKeys</key>
	<array>
		<string>hidStartupIntervalMs</string>
		<string>minimumHIDOutputIntervalMs</string>
		<string>inputLivenessTimeoutMs</string>
	</array>
	<key>variants</key>
	<array>
		<string>USB</string>
		<string>BluetoothClassic</string>
	</array>
</dict>
</plist>
