{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "XboxXUSB",
  "variants": ["Wired", "Receiver"],
  "storesVariant": true,
  "endpoints": {
    "in": 129,
    "out": 1
  },
  "rawUSB": true,
  "recordSections": ["rumble"],
  "sessionKeys": ["startup"],
  "interfaceSignatures": [
    {
      "variant": "Wired",
      "interfaceClass": 255,
      "interfaceSubclass": 93,
      "interfaceProtocol": 1
    },
    {
      "variant": "Receiver",
      "interfaceClass": 255,
      "interfaceSubclass": 93,
      "interfaceProtocol": 129
    }
  ],
  "controls": {
    "base": "Xbox",
    "add": ["Guide"]
  },
  "rawUSBTuningKeys": ["usbTransferTimeoutMs"],
  "defaults": {
    "session": {
      "startup": [
        {
          "bytes": "08 00 0F C0 00 00 00 00 00 00 00 00",
          "timeoutMilliseconds": 2000,
          "toleratesRejection": true,
          "variants": ["Receiver"]
        }
      ]
    },
    "tuning": {
      "usbTransferTimeoutMs": 2000
    },
    "variants": {
      "Wired": {
        "session": {
          "rumble": {
            "report": {
              "kind": "USB",
              "length": 8
            },
            "bytes": "00 08 00 00 00 00 00 00",
            "lowFrequency": {
              "byte": 3
            },
            "highFrequency": {
              "byte": 4
            }
          }
        }
      },
      "Receiver": {
        "session": {
          "rumble": {
            "report": {
              "kind": "USB",
              "length": 12
            },
            "bytes": "00 01 0F C0 00 00 00 00 00 00 00 00",
            "lowFrequency": {
              "byte": 5
            },
            "highFrequency": {
              "byte": 6
            }
          }
        }
      }
    }
  }
}
