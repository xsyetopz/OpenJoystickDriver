{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "VendorFlydigi",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["input"],
  "tuningKeys": ["hidStartupIntervalMs", "minimumHIDOutputIntervalMs"],
  "controls": {
    "base": "Xbox",
    "add": ["Guide"],
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "input": {
      "layouts": [
        {
          "report": {
            "id": 1,
            "length": {
              "exactly": 15
            }
          },
          "buttons": [
            {
              "control": "South",
              "bitOffset": 76,
              "bitSize": 1
            },
            {
              "control": "East",
              "bitOffset": 77,
              "bitSize": 1
            },
            {
              "control": "West",
              "bitOffset": 78,
              "bitSize": 1
            },
            {
              "control": "North",
              "bitOffset": 79,
              "bitSize": 1
            },
            {
              "control": "LeftShoulder",
              "bitOffset": 80,
              "bitSize": 1
            },
            {
              "control": "RightShoulder",
              "bitOffset": 81,
              "bitSize": 1
            },
            {
              "control": "LeftTrigger",
              "bitOffset": 82,
              "bitSize": 1
            },
            {
              "control": "RightTrigger",
              "bitOffset": 83,
              "bitSize": 1
            },
            {
              "control": "Back",
              "bitOffset": 84,
              "bitSize": 1
            },
            {
              "control": "Start",
              "bitOffset": 85,
              "bitSize": 1
            },
            {
              "control": "LeftStickClick",
              "bitOffset": 86,
              "bitSize": 1
            },
            {
              "control": "RightStickClick",
              "bitOffset": 87,
              "bitSize": 1
            },
            {
              "control": "Guide",
              "bitOffset": 103,
              "bitSize": 1
            }
          ],
          "axes": [
            {
              "control": "LeftStickX",
              "bitOffset": 8,
              "bitSize": 8,
              "signed": true,
              "min": -128,
              "max": 127,
              "symmetric": true
            },
            {
              "control": "LeftStickY",
              "bitOffset": 16,
              "bitSize": 8,
              "signed": true,
              "min": -128,
              "max": 127,
              "symmetric": true
            },
            {
              "control": "RightStickX",
              "bitOffset": 24,
              "bitSize": 8,
              "signed": true,
              "min": -128,
              "max": 127,
              "symmetric": true
            },
            {
              "control": "RightStickY",
              "bitOffset": 32,
              "bitSize": 8,
              "signed": true,
              "min": -128,
              "max": 127,
              "symmetric": true
            }
          ],
          "hat": [
            {
              "encoding": "Table",
              "bitOffset": 72,
              "bitSize": 4,
              "values": {
                "1": "North",
                "2": "NorthEast",
                "3": "East",
                "4": "SouthEast",
                "5": "South",
                "6": "SouthWest",
                "7": "West",
                "8": "NorthWest"
              }
            }
          ],
          "leftTrigger": {
            "bitOffset": 104,
            "bitSize": 8
          },
          "rightTrigger": {
            "bitOffset": 112,
            "bitSize": 8
          }
        }
      ]
    }
  }
}
