{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "LinuxXpadRules",
  "driverHandledDeviceFlags": [
    {
      "flag": "FLAG_DELAY_INIT",
      "xtype": "XTYPE_XBOXONE",
      "note": "FLAG_DELAY_INIT holds the GIP init sequence until the pad's announce packet; GIPDriver resends its startup sequence on the announces before the first input"
    }
  ],
  "mappingParameters": [
    {
      "flag": "MAP_SHARE_BUTTON",
      "parameters": {
        "shareButton": {
          "fromEnd": 18
        }
      },
      "family": "XboxGIP"
    },
    {
      "flag": "MAP_SHARE_OFFSET",
      "parameters": {
        "shareButton": {
          "fromEnd": 26
        }
      },
      "family": "XboxGIP"
    }
  ],
  "capabilityAbsences": [
    {
      "flag": "MAP_STICKS_TO_NULL",
      "controls": ["LeftStickX", "LeftStickY", "RightStickX", "RightStickY"]
    },
    {
      "flag": "MAP_TRIGGERS_TO_BUTTONS",
      "controls": ["LeftTrigger", "RightTrigger"]
    }
  ],
  "representationFlags": ["MAP_DPAD_TO_BUTTONS"],
  "presenceFlags": ["MAP_PADDLES", "MAP_PROFILE_BUTTON"],
  "dancepadFlags": [
    "MAP_DPAD_TO_BUTTONS",
    "MAP_STICKS_TO_NULL",
    "MAP_TRIGGERS_TO_BUTTONS"
  ],
  "initPacketNames": {
    "xboxone_power_on": "XboxGIP/power-on",
    "xboxone_s_init": "XboxGIP/s-init",
    "extra_input_packet_init": "XboxGIP/enable-extra-input",
    "xboxone_hori_ack_id": "XboxGIP/hori-ack",
    "xboxone_led_on": "XboxGIP/led-on",
    "xboxone_auth_done": "XboxGIP/auth-done",
    "xboxone_rumblebegin_init": "XboxGIP/rumble-begin",
    "xboxone_rumbleend_init": "XboxGIP/rumble-end"
  },
  "defaultInitialization": [
    "XboxGIP/power-on",
    "XboxGIP/led-on",
    "XboxGIP/auth-done"
  ],
  "types": [
    {
      "xtype": "XTYPE_XBOX",
      "family": "XboxXID",
      "variant": "Gamepad"
    },
    {
      "xtype": "XTYPE_XBOX360",
      "family": "XboxXUSB",
      "variant": "Wired"
    },
    {
      "xtype": "XTYPE_XBOX360W",
      "family": "XboxXUSB",
      "variant": "Receiver"
    },
    {
      "xtype": "XTYPE_XBOXONE",
      "family": "XboxGIP"
    }
  ],
  "typeFilters": [
    {
      "name": "all"
    },
    {
      "name": "XboxXID",
      "xtype": "XTYPE_XBOX"
    },
    {
      "name": "XboxXUSB:Wired",
      "xtype": "XTYPE_XBOX360"
    },
    {
      "name": "XboxXUSB:Receiver",
      "xtype": "XTYPE_XBOX360W"
    },
    {
      "name": "XboxGIP",
      "xtype": "XTYPE_XBOXONE"
    }
  ]
}
