// The Xcode project's base configuration: the same language mode, features, and strictness as the
// settings block at the end of Package.swift. Project settings go in the project or in an xcconfig
// that includes this one.

MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = YES
DEAD_CODE_STRIPPING = YES
CLANG_CXX_LANGUAGE_STANDARD = c++20
OJD_SWIFT_FLAGS = -enable-upcoming-feature ExistentialAny -enable-upcoming-feature InternalImportsByDefault -enable-upcoming-feature MemberImportVisibility -enable-upcoming-feature InferIsolatedConformances -enable-upcoming-feature NonisolatedNonsendingByDefault -enable-upcoming-feature ImmutableWeakCaptures -strict-memory-safety
OTHER_SWIFT_FLAGS = $(inherited) $(OJD_SWIFT_FLAGS) $(OJD_CXX_FLAGS)

// Compilation caching stays off: with C++ interop, the compiler warns about its own module map once
// caching is on, and warnings fail the build.
COMPILATION_CACHE_ENABLE_CACHING = NO

// Swift needs both flags to import a C++20 target.
OJD_CXX_FLAGS = -cxx-interoperability-mode=default -Xcc -std=c++20
