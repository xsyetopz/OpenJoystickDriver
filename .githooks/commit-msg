#!/bin/sh
# Port of compilerla/conventional-pre-commit v4.5.0 (Apache-2.0), default options:
# https://github.com/compilerla/conventional-pre-commit/blob/v4.5.0/conventional_pre_commit/format.py
# Changed: POSIX sh and awk so every template runs it without a language runtime. The subject
# must be the first line, where upstream accepts a conventional line anywhere in the message.
set -eu

if [ "$#" -eq 1 ] && [ -f "$1" ] && awk '
	$0 == "# ------------------------ >8 ------------------------" { cut = 1 }
	{ raw[++total] = $0 }
	!cut && !/^#/ { kept[++count] = $0 }
	END {
		if (count == 0) {
			for (i = 1; i <= total; i++) kept[i] = raw[i]
			count = total
		}
		subject = kept[1]
		if (subject ~ /^(amend|fixup|squash)! / || tolower(subject) ~ /^merge([^a-z0-9_]|$)/) exit 0
		type = "(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)"
		if (tolower(subject) !~ ("^" type "(\\([A-Za-z0-9_ :,./#-]+\\))?!?: .+$")) exit 1
		if (count < 2 || kept[2] == "") {
			if (count >= 3 && kept[2] == "" && toupper(kept[3]) ~ /^BREAKING[ -]CHANGE: / && kept[3] !~ /^BREAKING[ -]CHANGE: /) exit 1
			exit 0
		}
		exit 1
	}
' "$1"; then
	exit 0
fi

echo 'commit-msg: use Conventional Commits, for example "feat(cli): add --dry-run".' >&2
echo "Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test. https://www.conventionalcommits.org" >&2
exit 1
