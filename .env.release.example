# OpenJoystickDriver release signing and notarization
# Copy to `.env.release` or run `./scripts/ojd signing configure`.

# Developer ID Application certificate display name or 40-hex SHA1 identity.
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
GUI_CODESIGN_IDENTITY="$CODESIGN_IDENTITY"
DAEMON_CODESIGN_IDENTITY="$CODESIGN_IDENTITY"

# Apple Developer Team ID used by entitlement templates.
DEVELOPMENT_TEAM="ABCDEF1234"

# DriverKit extension is built with Apple Development signing before packaging.
DEXT_BUILD_IDENTITY="Apple Development: Your Name (TEAMID)"
DEXT_BUILD_PROFILE="OpenJoystickDriver (VirtualHIDDevice)"

# Developer ID provisioning profiles for the app and daemon.
GUI_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriver_DevID.provisionprofile"
DAEMON_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriverDaemon_DevID.provisionprofile"

# Preferred notarization credentials: App Store Connect API key.
# Store the .p8 payload as base64 for CI/local parity, or point to a local file.
# NOTARIZE_KEY_ID="ABC123DEFG"
# NOTARIZE_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# NOTARIZE_API_KEY_BASE64="base64-encoded-AuthKey_ABC123DEFG.p8"
# NOTARIZE_API_KEY_PATH="$HOME/Downloads/AuthKey_ABC123DEFG.p8"

# Optional fallback: notarytool keychain profile. Create it with:
#   OJD_ENV=release ./scripts/ojd notarize store-credentials OJDNotary
NOTARIZE_KEYCHAIN_PROFILE="OJDNotary"

# Optional fallback when no API key or keychain profile is configured.
# NOTARIZE_APPLE_ID="you@example.com"
# NOTARIZE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
