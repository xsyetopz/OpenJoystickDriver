# PUBLISHER RELEASE SIGNING
#
# Development builds and end users do not need this file.
# Only the OpenJoystickDriver publishing team can obtain matching assets for the
# globally owned App IDs. Prefer `./scripts/ojd signing configure`; do not copy
# these placeholders unchanged.
#
# Required inputs in addition to the development assets described in
# `.env.dev.example` and `docs/development/signing.md`:
# 1. A Developer ID Application certificate WITH ITS PRIVATE KEY. Apple's
#    Account Holder creates it in Certificates, Identifiers & Profiles.
# 2. A Developer ID provisioning profile for `com.openjoystickdriver`, with the
#    host capabilities listed in `docs/development/signing.md`, downloaded as
#    `~/Documents/Profiles/OpenJoystickDriver_DevID.provisionprofile`.
# 3. Apple notarization credentials and Sparkle signing keys owned by the
#    publisher. These are not supplied to contributors.
#
# Install/configure:
#   ./scripts/ojd signing install-profiles
#   ./scripts/ojd signing configure
#   ./scripts/ojd signing doctor
CODESIGN_IDENTITY="DEVELOPER_ID_APPLICATION_CERTIFICATE_SHA1"
GUI_CODESIGN_IDENTITY="DEVELOPER_ID_APPLICATION_CERTIFICATE_SHA1"
DEVELOPMENT_TEAM="YOUR_10_CHARACTER_TEAM_ID"
DEXT_BUILD_IDENTITY="APPLE_DEVELOPMENT_CERTIFICATE_SHA1"
DEXT_BUILD_PROFILE="PROFILE_NAME_EMBEDDED_IN_OPENJOYSTICKDRIVER_DRIVERKIT_PROFILE"
GUI_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriver_DevID.provisionprofile"

OJD_USE_LOCAL_SWIFTERKIT="0"
NOTARIZE_APPLE_ID="PUBLISHER_APPLE_ACCOUNT_EMAIL"
NOTARIZE_PASSWORD="APP_SPECIFIC_PASSWORD"
NOTARIZE_KEYCHAIN_PROFILE=""
SPARKLE_PUBLIC_ED_KEY=""
SPARKLE_ED_PRIVATE_KEY=""
SPARKLE_FEED_URL="https://github.com/xsyetopz/OpenJoystickDriver/releases/latest/download/appcast.xml"
