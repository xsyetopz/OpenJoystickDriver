# OpenJoystickDriver local defaults
#
# Copy to `.env` only for values shared by all local environments.
# Prefer `.env.dev` for development signing and `.env.release` for release signing.
# The scripts load, in order:
#   #   .env
#   .env.$OJD_ENV
#   $OJD_ENV_FILE           (optional explicit override)
#
# Default environment: OJD_ENV=dev
# Disable automatic env loading: OJD_ENV=none ./scripts/ojd ...

# Apple Developer Team ID used by entitlement templates.
DEVELOPMENT_TEAM="ABCDEF1234"

# Optional: full Xcode path if xcode-select points at Command Line Tools.
# DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"

# Optional: Sparkle public EdDSA key for app updates.
# SPARKLE_PUBLIC_ED_KEY="abcdefghijklmnopqrstuvwxyz1234567890abcdefg="
