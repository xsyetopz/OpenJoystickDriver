# OpenJoystickDriver development signing
# Copy to `.env.dev` or run `./scripts/ojd signing configure`.

# Apple Development certificate display name or 40-hex SHA1 identity.
CODESIGN_IDENTITY="Apple Development: Your Name (TEAMID)"

# Apple Developer Team ID used by entitlement templates.
DEVELOPMENT_TEAM="ABCDEF1234"

# DriverKit extension provisioning profile name or UUID for local development.
DEXT_BUILD_PROFILE="OpenJoystickDriver (VirtualHIDDevice)"

# Optional explicit profile paths. Defaults are in scripts/ojd-common.sh.
# GUI_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriver.provisionprofile"
# DAEMON_PROVISIONING_PROFILE="$HOME/Library/MobileDevice/Provisioning Profiles/OpenJoystickDriverDaemon.provisionprofile"
