<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DextOutputDispatcher sends reports via IOHIDDeviceSetReport (public  -->
    <!-- HID manager API). No user-client entitlement is needed — the daemon -->
    <!-- never calls IOServiceOpen on the dext.                              -->

    <!-- Required for IOHIDUserDevice (user-space virtual gamepad / SDL compatibility mode). -->
    <key>com.apple.developer.hid.virtual.device</key>
    <true/>

    <!-- Required by AMFI on macOS 26+ to validate the embedded provisioning
         profile. Must match the daemon profile's application-identifier. -->
    <key>com.apple.application-identifier</key>
    <string>${DEVELOPMENT_TEAM}.com.openjoystickdriver.daemon</string>
    <key>com.apple.developer.team-identifier</key>
    <string>${DEVELOPMENT_TEAM}</string>
</dict>
</plist>
