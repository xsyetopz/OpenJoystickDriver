			<string>アクティブなプロファイル: %d</string>
			<key>two</key>
			<string>アクティブなプロファイル: %d</string>
			<key>few</key>
			<string>アクティブなプロファイル: %d</string>
			<key>many</key>
			<string>アクティブなプロファイル: %d</string>
			<key>other</key>
			<string>アクティブなプロファイル: %d</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>割り当て %d件</string>
			<key>zero</key>
			<string>割り当て %d件</string>
			<key>two</key>
			<string>割り当て %d件</string>
			<key>few</key>
