<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d контролер підключено</string>
			<key>zero</key>
			<string>%d контролерів підключено</string>
			<key>two</key>
			<string>%d контролери підключено</string>
			<key>few</key>
			<string>%d контролери підключено</string>
			<key>many</key>
			<string>%d контролерів підключено</string>
			<key>other</key>
			<string>%d контролера підключено</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d активний профіль</string>
			<key>zero</key>
			<string>%d активних профілів</string>
			<key>two</key>
			<string>%d активні профілі</string>
			<key>few</key>
			<string>%d активні профілі</string>
			<key>many</key>
			<string>%d активних профілів</string>
			<key>other</key>
			<string>%d активного профілю</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d призначення</string>
			<key>zero</key>
			<string>%d призначень</string>
			<key>two</key>
			<string>%d призначення</string>
			<key>few</key>
			<string>%d призначення</string>
			<key>many</key>
			<string>%d призначень</string>
			<key>other</key>
			<string>%d призначення</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Нічого не виявлено</string>
			<key>one</key>
			<string>Виявлено %d</string>
			<key>two</key>
			<string>Виявлено %d</string>
			<key>few</key>
			<string>Виявлено %d</string>
			<key>many</key>
			<string>Виявлено %d</string>
			<key>other</key>
			<string>Виявлено %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Пристроїв виводу контролера не виявлено</string>
			<key>one</key>
			<string>Виявлено %d пристрій виводу контролера</string>
			<key>two</key>
			<string>Виявлено %d пристрої виводу контролера</string>
			<key>few</key>
			<string>Виявлено %d пристрої виводу контролера</string>
			<key>many</key>
			<string>Виявлено %d пристроїв виводу контролера</string>
			<key>other</key>
			<string>Виявлено %d пристрою виводу контролера</string>
		</dict>
	</dict>
</dict>
</plist>
