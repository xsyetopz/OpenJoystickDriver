<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d кантролер падключаны</string>
			<key>zero</key>
			<string>%d кантролераў падключана</string>
			<key>two</key>
			<string>%d кантролеры падключаны</string>
			<key>few</key>
			<string>%d кантролеры падключаны</string>
			<key>many</key>
			<string>%d кантролераў падключана</string>
			<key>other</key>
			<string>%d кантролера падключана</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d актыўны профіль</string>
			<key>zero</key>
			<string>%d актыўных профіляў</string>
			<key>two</key>
			<string>%d актыўныя профілі</string>
			<key>few</key>
			<string>%d актыўныя профілі</string>
			<key>many</key>
			<string>%d актыўных профіляў</string>
			<key>other</key>
			<string>%d актыўнага профілю</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d прызначэнне</string>
			<key>zero</key>
			<string>%d прызначэнняў</string>
			<key>two</key>
			<string>%d прызначэнні</string>
			<key>few</key>
			<string>%d прызначэнні</string>
			<key>many</key>
			<string>%d прызначэнняў</string>
			<key>other</key>
			<string>%d прызначэння</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Нічога не выяўлена</string>
			<key>one</key>
			<string>Выяўлена %d</string>
			<key>two</key>
			<string>Выяўлена %d</string>
			<key>few</key>
			<string>Выяўлена %d</string>
			<key>many</key>
			<string>Выяўлена %d</string>
			<key>other</key>
			<string>Выяўлена %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Прылады вываду кантролера не выяўлены</string>
			<key>one</key>
			<string>Выяўлена %d прылада вываду кантролера</string>
			<key>two</key>
			<string>Выяўлена %d прылады вываду кантролера</string>
			<key>few</key>
			<string>Выяўлена %d прылады вываду кантролера</string>
			<key>many</key>
			<string>Выяўлена %d прылад вываду кантролера</string>
			<key>other</key>
			<string>Выяўлена %d прылады вываду кантролера</string>
		</dict>
	</dict>
</dict>
</plist>
