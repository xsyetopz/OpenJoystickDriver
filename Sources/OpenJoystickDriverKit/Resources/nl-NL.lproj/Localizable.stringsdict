<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d controller verbonden</string>
			<key>zero</key>
			<string>%d controllers verbonden</string>
			<key>two</key>
			<string>%d controllers verbonden</string>
			<key>few</key>
			<string>%d controllers verbonden</string>
			<key>many</key>
			<string>%d controllers verbonden</string>
			<key>other</key>
			<string>%d controllers verbonden</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d toewijzing</string>
			<key>zero</key>
			<string>%d toewijzingen</string>
			<key>two</key>
			<string>%d toewijzingen</string>
			<key>few</key>
			<string>%d toewijzingen</string>
			<key>many</key>
			<string>%d toewijzingen</string>
			<key>other</key>
			<string>%d toewijzingen</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Geen controlleruitvoerapparaten gedetecteerd</string>
			<key>one</key>
			<string>%d controlleruitvoerapparaat gedetecteerd</string>
			<key>two</key>
			<string>%d controlleruitvoerapparaten gedetecteerd</string>
			<key>few</key>
			<string>%d controlleruitvoerapparaten gedetecteerd</string>
			<key>many</key>
			<string>%d controlleruitvoerapparaten gedetecteerd</string>
			<key>other</key>
			<string>%d controlleruitvoerapparaten gedetecteerd</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>‘%1$@’ komt overeen met %2$lld controller. Gebruik een van deze ID's:</string>
			<key>other</key>
			<string>‘%1$@’ komt overeen met %2$lld controllers. Gebruik een van deze ID's:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>‘%1$@’ is de naam van %2$lld profiel. Gebruik een van deze ID’s:</string>
			<key>other</key>
			<string>‘%1$@’ is de naam van %2$lld profielen. Gebruik een van deze ID’s:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>--soak met deze --interval-ms zou %lld meting nemen; verhoog --interval-ms.</string>
			<key>other</key>
			<string>--soak met deze --interval-ms zou %lld metingen nemen; verhoog --interval-ms.</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Meten zou %lld meting vereisen. Verhoog het meetinterval.</string>
			<key>other</key>
			<string>Meten zou %lld metingen vereisen. Verhoog het meetinterval.</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Deze meting zou %lld meting vereisen. Verhoog het meetinterval.</string>
			<key>other</key>
			<string>Deze meting zou %lld metingen vereisen. Verhoog het meetinterval.</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ komt overeen met de verwachte status: %2$lld invoerrapport afgespeeld.</string>
			<key>other</key>
			<string>%1$@ komt overeen met de verwachte status: %2$lld invoerrapporten afgespeeld.</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>De status die de parser van %1$@ opleverde, wijkt van %2$@ af in %3$lld veld.</string>
			<key>other</key>
			<string>De status die de parser van %1$@ opleverde, wijkt van %2$@ af in %3$lld velden.</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld inactief pakket verborgen (nog steeds inbegrepen in de export).</string>
			<key>other</key>
			<string>%lld inactieve pakketten verborgen (nog steeds inbegrepen in de export).</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Gestopt · %lld pakket</string>
			<key>other</key>
			<string>Gestopt · %lld pakketten</string>
		</dict>
	</dict>
	<!-- Choice of the idle disconnect picker in the General pane of the settings window. %d is a number of minutes, such as 15. -->
	<key>ui.settings.general.idleDisconnectMinutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d minuten</string>
			<key>one</key>
			<string>%d minuut</string>
			<key>two</key>
			<string>%d minuten</string>
			<key>few</key>
			<string>%d minuten</string>
			<key>many</key>
			<string>%d minuten</string>
			<key>other</key>
			<string>%d minuten</string>
		</dict>
	</dict>
	<!-- Row of the Simple interface in the controller detail and the profile editor: how many advanced settings that Simple hides hold a value other than their default. %d is the number of changed advanced settings. The Dutch plural forms are a first draft that a native speaker reviews. -->
	<key>ui.interface.hiddenChanges</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d geavanceerde instellingen zijn gewijzigd</string>
			<key>one</key>
			<string>%d geavanceerde instelling is gewijzigd</string>
			<key>two</key>
			<string>%d geavanceerde instellingen zijn gewijzigd</string>
			<key>few</key>
			<string>%d geavanceerde instellingen zijn gewijzigd</string>
			<key>many</key>
			<string>%d geavanceerde instellingen zijn gewijzigd</string>
			<key>other</key>
			<string>%d geavanceerde instellingen zijn gewijzigd</string>
		</dict>
	</dict>
</dict>
</plist>
