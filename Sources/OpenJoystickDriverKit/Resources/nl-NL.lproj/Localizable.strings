"cli.diagnose.group.timingsSummaryStallsNeedFrames" = "Haperingen: alleen gemeten met --frames, terwijl de sticks blijven bewegen";
/* Line of 'ojd diagnose --frames' above the timing summaries. %@ is the length of the window, such as 10s. The frames are those the controller reported in that time. */
"cli.diagnose.group.timingsWindow" = "Tijdvenster: frames die in de laatste %@ zijn gelezen.";
/* One-line summary of 'ojd record' in the command list and at the top of its help. */
"cli.record.group.abstract" = "Maakt concepten van controllerrecords, toont, controleert, installeert of verwijdert ze.";
/* Long description in the help of 'ojd record'. The folder path stays as written. A controller record describes how the driver talks to one controller model. */
"cli.record.group.discussion" = "Een controllerrecord vertelt OpenJoystickDriver hoe één controllermodel moet worden aangestuurd. Je records staan in ~/Library/Application Support/OpenJoystickDriver/Controllers en voegen een model toe of passen een meegeleverd model aan. De draaiende service past ze toe wanneer de map verandert. Alleen ‘ojd record draft’ heeft de service nodig.";
/* One-line summary of 'ojd record draft' in the command list and at the top of its help. */
"cli.record.draft.abstract" = "Maakt een concept-controllerrecord van een verbonden controller.";
