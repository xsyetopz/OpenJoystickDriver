"cli.root.abstract" = "Configureer en inspecteer OpenJoystickDriver, het gamepadstuurprogramma voor macOS.";
"cli.root.discussion" = "Begin hier:\n  ojd status             Controleer de service, extensie en toestemmingen.\n  ojd diagnose           Voer alle controles uit en meld wat er mis is.\n  ojd controller list    Toon de aangesloten controllers.\n\nVoorbeelden:\n  # Toon de invoer van één controller terwijl die verandert\n  ojd controller watch 045E:028E\n  # Toon de aangesloten controllers als JSON\n  ojd --json controller list\n\nOmgeving (een optie wint van de variabele):\n  OJD_NO_INPUT=1         Hetzelfde als --no-input.\n  OJD_TIMEOUT=SECONDS    Hetzelfde als --timeout.\n  OJD_COLOR=WHEN         auto, always (ook kleur buiten een terminal) of never.\n\nShell-aanvulling:\n  ojd --generate-completion-script zsh|bash|fish\n\nAfsluitcodes:\n  0    Gelukt.\n  1    De opdracht is mislukt.\n  64   Gebruiksfout.\n  69   De service draait niet. Start die met ‘ojd service start’.\n  77   Een macOS-toestemming ontbreekt.\n  127  Een repository-build kon de opdracht niet doorgeven aan de geïnstalleerde app.\n  130  Onderbroken.";
"cli.help.global_options" = "Elke opdracht accepteert ook de algemene opties; ‘ojd --help’ toont ze.";
"cli.error.env_timeout" = "OJD_TIMEOUT vereist een aantal seconden boven 0.";
"cli.error.env_color" = "OJD_COLOR vereist auto, always of never.";
"cli.virtual.feed.error.plain" = "--plain geldt niet voor ‘virtual feed’, dat JSON-regels afdrukt. Laat --plain weg.";
"cli.controller.watch.examples" = "Voorbeelden:\n  # Toon de invoer gedurende 10 seconden\n  ojd controller watch 045E:028E --duration 10\n  # Toon de eerste ingedrukte besturing, als JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Volg elke controller en wat de virtuele gamepad verstuurt\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Voorbeelden:\n  # Laat beide hoofdmotoren 0,45 seconden op 180 draaien\n  ojd controller rumble 045E:028E\n  # Laat beide hoofdmotoren 2 seconden op volle sterkte draaien\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Voorbeelden:\n  # Zet de lichtbalk op oranje\n  ojd controller light 054C:09CC --color FF8000\n  # Stel de kleur en een lage helderheid in\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Voorbeelden:\n  # Maak een profiel voor een controllermodel\n  ojd profile create Racing --controller 045E:028E\n  # Pas het alleen toe zolang Safari op de voorgrond staat\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Voorbeelden:\n  # Hernoem een profiel\n  ojd profile set Racing name Rally\n  # Stel de binnenste dode zone van de eerste stickmapping in\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Voorbeelden:\n  # Houd de spatiebalk ingedrukt zolang de zuidknop wordt ingedrukt\n  ojd binding set Racing button:south key:space\n  # Schakel J om bij elke druk\n  ojd binding set Racing button:west key:j --behavior toggle\n  # Herhaal J 10 keer per seconde zolang de knop wordt ingedrukt\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Voorbeelden:\n  # Installeer een opnamebestand\n  ojd record install 045E-028E.json\n  # Lees de opname van stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Voorbeelden:\n  # Laat een programma de service gebruiken\n  ojd access grant /Applications/Example.app\n  # Maak een token voor pagina's die vanaf één oorsprong worden aangeboden\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
