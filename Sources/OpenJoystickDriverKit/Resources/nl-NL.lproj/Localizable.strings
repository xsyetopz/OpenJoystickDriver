"cli.service.wait.timeout" = "De service heeft niet binnen %@ verzoeken geaccepteerd. Start die met ‘ojd service start’, of probeer het opnieuw met een grotere --timeout.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Toon de service, extensie, toestemmingen en aangesloten controllers.";
/* Long description in the help of 'ojd status'. It says that the command also works while the service is stopped. The exit status 0 stays as written. */
"cli.status.group.discussion" = "Werkt ook als de service is gestopt: meldt de service als gestopt en sluit af met 0.";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "Toegankelijkheid";
