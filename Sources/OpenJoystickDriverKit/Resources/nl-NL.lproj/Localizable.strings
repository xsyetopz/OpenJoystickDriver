/* Error of ojd for a command that does not exist. %1$@ is the text the user typed and %2$@ is the closest command name. */
"cli.shared.error.unknownCommand" = "Onbekende opdracht ‘%1$@’. Bedoelde je ‘%2$@’?";
/* Help text of the --json flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.json" = "Print JSON naar stdout.";
/* Help text of the --no-color flag that every command takes. */
"cli.shared.option.noColor" = "Gebruik geen kleur.";
/* Help text of the --no-input flag that every command takes. */
"cli.shared.option.noInput" = "Vraag nooit om invoer; mislukt als een waarde ontbreekt.";
/* Help text of the --plain flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.plain" = "Print door tabs gescheiden records naar stdout.";
/* Help text of the --quiet flag that every command takes. stderr is the standard error stream and stays as written. */
"cli.shared.option.quiet" = "Print geen succesmeldingen naar stderr.";
/* Help text of the --timeout option that every command takes. %1$g is the default number of seconds for a service request and %2$g is the default for the service, virtual set and virtual reset commands, which stay as written in quotes. */
"cli.shared.option.timeout" = "Seconden wachten op elk verzoek aan de service (standaard: %1$g), of tot de opdrachten ‘service’, ‘virtual set’ en ‘virtual reset’ klaar zijn (standaard: %2$g).";
/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "Configureer en inspecteer OpenJoystickDriver, het gamepadstuurprogramma voor macOS.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Begin hier:\n  ojd status             Controleer de service, extensie en toestemmingen.\n  ojd diagnose           Voer alle controles uit en meld wat er mis is.\n  ojd controller list    Toon de aangesloten controllers.\n\nVoorbeelden:\n  # Toon de invoer van één controller terwijl die verandert\n  ojd controller watch 045E:028E\n  # Toon de aangesloten controllers als JSON\n  ojd --json controller list\n\nOmgeving (een optie wint van de variabele):\n  OJD_NO_INPUT=1         Hetzelfde als --no-input.\n  OJD_TIMEOUT=SECONDS    Hetzelfde als --timeout.\n  OJD_COLOR=WHEN         auto, always (ook kleur buiten een terminal) of never.\n\nShell-aanvulling:\n  ojd --generate-completion-script zsh|bash|fish\n\nAfsluitcodes:\n  0    Gelukt.\n  1    De opdracht is mislukt.\n  64   Gebruiksfout.\n  69   De service draait niet. Start die met ‘ojd service start’.\n  77   Een macOS-toestemming ontbreekt.\n  127  Een repository-build kon de opdracht niet doorgeven aan de geïnstalleerde app.\n  130  Onderbroken.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Elke opdracht accepteert ook de algemene opties; ‘ojd --help’ toont ze.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT vereist een aantal seconden boven 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR vereist auto, always of never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT vereist 1, true, yes, 0, false of no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain geldt niet voor ‘virtual feed’, dat JSON-regels afdrukt. Laat --plain weg.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Voorbeelden:\n  # Toon de invoer gedurende 10 seconden\n  ojd controller watch 045E:028E --duration 10\n  # Toon de eerste ingedrukte besturing, als JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Volg elke controller en wat de virtuele gamepad verstuurt\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Voorbeelden:\n  # Laat beide hoofdmotoren 0,45 seconden op 180 draaien\n  ojd controller rumble 045E:028E\n  # Laat beide hoofdmotoren 2 seconden op volle sterkte draaien\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Voorbeelden:\n  # Zet de lichtbalk op oranje\n  ojd controller light 054C:09CC --color FF8000\n  # Stel de kleur en een lage helderheid in\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Voorbeelden:\n  # Maak een profiel voor een controllermodel\n  ojd profile create Racing --controller 045E:028E\n  # Pas het alleen toe zolang Safari op de voorgrond staat\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Voorbeelden:\n  # Hernoem een profiel\n  ojd profile set Racing name Rally\n  # Stel de binnenste dode zone van de eerste stickmapping in\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Voorbeelden:\n  # Houd de spatiebalk ingedrukt zolang de zuidknop wordt ingedrukt\n  ojd binding set Racing button:south key:space\n  # Schakel J om bij elke druk\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Herhaal J 10 keer per seconde zolang de knop wordt ingedrukt\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Voorbeelden:\n  # Installeer een recordbestand\n  ojd record install 045e-028e.plist\n  # Lees het record van stdin\n  ojd record install - < 045e-028e.plist";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Voorbeelden:\n  # Laat een programma de service gebruiken\n  ojd access grant /Applications/Example.app\n  # Maak een token voor pagina’s die vanaf één oorsprong worden aangeboden\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "Start of stop de OpenJoystickDriver-service, of wacht tot die verzoeken accepteert.";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "De service draait.";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "Open de app op de achtergrond en wacht tot de service ervan verzoeken accepteert.";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "Deze ojd zit niet in OpenJoystickDriver.app en kan de service dus niet starten. Open de geïnstalleerde app, of voer de ojd erin uit.";
