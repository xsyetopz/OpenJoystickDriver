/* Error of every command that talks to the service when the service reports a failure. %@ is the reason from the service. The command in quotes stays as written. */
"cli.shared.error.serviceRequestFailed" = "De service heeft het verzoek niet voltooid: %@. Controleer het met ‘ojd status’.";
/* Error of the profile commands when another profile has the name. The command in quotes stays as written. */
"cli.shared.error.duplicateProfileName" = "Er bestaat al een profiel met die naam. ‘ojd profile list’ toont alle profielen.";
/* Error of every command that talks to the service when it did not reply in time and the wait is not named. The command in quotes stays as written. */
"cli.shared.error.serviceTimeout" = "De service heeft niet op tijd geantwoord. Probeer het opnieuw, of controleer het met ‘ojd status’.";
/* Error of every command that needs the service when it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"cli.shared.error.serviceUnavailable" = "De OpenJoystickDriver-service draait niet. Start die met ‘ojd service start’.";
/* Error of every command when --timeout is not a number above 0. --timeout stays as written. */
