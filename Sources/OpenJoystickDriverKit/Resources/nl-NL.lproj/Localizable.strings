"cli.status.group.virtualPublished" = "Aan, publiceert %@";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "Controllers en toestemmingen verschijnen als de service draait: ‘ojd service start’.";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "Schakel het eindpunt in en kies welke programma’s er controllers via kunnen lezen.";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "Het pad van het programma, of een client-ID.";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "Er is geen programma op %@ en geen client met dat ID. Bekijk de ID’s met ‘ojd access list’.";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ bevat geen ondertekend programma. Geef toegang aan de appbundel of het uitvoerbare bestand van het programma.";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "Schakel het eindpunt uit en sluit de verbindingen; verleende toegang blijft behouden.";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "Het eindpunt is uit en de verbindingen zijn gesloten.";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "Het eindpunt is een lokale socket waaruit programma’s met toegang controllergebeurtenissen lezen. Het is uit totdat je ‘ojd access enable’ uitvoert, en de service bedient alleen programma’s waarvan je de handtekening toegang hebt gegeven, of die een token sturen waaraan je toegang hebt gegeven. ‘ojd access web enable’ voegt een WebSocket toe op 127.0.0.1 voor overlaypagina’s.";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "Schakel het eindpunt in.";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "Het eindpunt inschakelen, zodat de programma’s waaraan je toegang geeft de invoer van elke controller kunnen lezen?";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "Vraagt eerst om bevestiging. Alleen programma’s met toegang kunnen het eindpunt gebruiken; voeg ze toe met ‘ojd access grant’.";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "Het eindpunt luistert op %@.";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "Sta een ondertekend programma, of een nieuw token, toe het eindpunt te gebruiken.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ is ad-hoc ondertekend of niet ondertekend, dus elk lokaal programma kan de handtekening claimen. Onderteken het met een Developer ID- of Apple Development-certificaat en geef het daarna toegang.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "Apple heeft dit programma ondertekend. Als het scripts uitvoert, zoals python3 of osascript, krijgt elk script dat het uitvoert deze toegang.";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "Geef CLIENT of --token NAME op.";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "%1$@, ondertekend als %2$@, toestaan het eindpunt te gebruiken met %3$@?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
"cli.access.grant.controlWarning" = "Het bereik control laat het programma knoppen op een virtuele gamepad indrukken, die games en apps als jouw invoer behandelen.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT is het pad van het programma of een ID uit ‘ojd access list’. De toegang verwijst naar de handtekening van het programma en blijft dus geldig wanneer het programma wordt bijgewerkt of verplaatst. Ad-hoc ondertekende en niet-ondertekende programma’s kunnen geen toegang krijgen. Met --token in plaats van CLIENT wordt een token gemaakt waarmee een client in zijn hello de uitdaging van de service ondertekent, via de socket, via de WebSocket vanaf een pagina van een van de waarden van --origin of, bij een token zonder --origin, via de WebSocket vanaf een programma dat geen Origin-header verstuurt, zoals een app in een sandbox. Een pagina kan het bereik control niet gebruiken. Het token wordt maar één keer getoond. Vraagt eerst om bevestiging.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Een weboorsprong, zoals http://127.0.0.1:8080, waarvan de pagina’s het token op de WebSocket mogen gebruiken. Herhaal om er meer toe te voegen. De overlaypagina’s die de WebSocket serveert, hebben de oorsprong http://127.0.0.1:PORT, met de poort die ‘ojd access status’ toont.";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin kan niet worden gecombineerd met het bereik control. Een pagina bestuurt nooit een virtuele gamepad; geef control aan een token zonder --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin vereist --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Een bereik om te verlenen: read of control. Herhaal voor beide.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "%1$@ verleend aan %2$@ (ID %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Maak een token met deze naam in plaats van een programma toegang te geven.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "Het token %1$@ maken met %2$@, voor programma’s op deze Mac?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "%1$@ verleend aan het token %2$@ (ID %3$@). Houd het token geheim; het wordt niet opnieuw getoond:";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "Het token %1$@ maken met %2$@, voor programma’s op deze Mac en voor pagina’s van %3$@?";
/* One-line summary of 'ojd access list' in the command list and at the top of its help. */
"cli.access.list.abstract" = "Toont clients en tokens met toegang, en die zijn geweigerd in de afgelopen 24 uur.";
/* Long description in the help of 'ojd access list'. It says that the printed IDs work with 'ojd access grant' and 'ojd access revoke'. token:NAME stays as written. */
"cli.access.list.discussion" = "Elke client heeft een ID dat ‘ojd access grant’ en ‘ojd access revoke’ accepteren; het ID van een token is token:NAME.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Met toegang:";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Geen";
/* Heading of the list of clients that connected and were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refused" = "Geweigerd in de afgelopen 24 uur:";
/* Heading of the list of tokens that were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refusedTokens" = "Tokens geweigerd in de afgelopen 24 uur:";
/* Heading of the list of granted tokens printed by 'ojd access list'. */
"cli.access.list.tokens" = "Tokens met toegang:";
/* Lowercase placeholder printed in the token list when a refused token has no name. */
"cli.access.list.unknownToken" = "onbekend token";
/* Error of 'ojd access' commands that change who may read the controllers, when the input is not a terminal and --force is missing. --force stays as written. */
"cli.access.group.needsForce" = "Deze wijziging geeft programma’s toegang tot je controllers. Voeg --force toe om het zonder prompt te bevestigen.";
/* One-line summary of 'ojd access revoke' in the command list and at the top of its help. */
"cli.access.revoke.abstract" = "Verwijdert de toegang van een programma, of een deel van de bereiken.";
/* Help text of the CLIENT argument of 'ojd access revoke'. token:NAME stays as written. */
"cli.access.revoke.client" = "Het pad van het programma, een client-ID of token:NAME.";
