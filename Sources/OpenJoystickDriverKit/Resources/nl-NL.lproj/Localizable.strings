"cli.record.draft.discussion" = "Leest de HID-rapportdescriptor van de controller en legt de invoerrapporten vast terwijl je elke bediening indrukt, en toont daarna een record om mee te beginnen. Het record wijst de knoppen, sticks, triggers en het richtingskruis toe die de descriptor duidelijk vermeldt. De bytes die tijdens het vastleggen veranderden, tonen waar de andere bedieningselementen zitten. Heeft de service nodig.";
/* Help text of the duration option of 'ojd record draft'. */
"cli.record.draft.duration" = "Legt invoerrapporten zoveel seconden vast.";
/* Help text of the --from-sdl flag of 'ojd record draft'. SDL_GameControllerDB is a project name and stays as written. */
"cli.record.draft.fromSDL" = "Maak het concept van de SDL_GameControllerDB-regel van de controller in plaats van invoerrapporten vast te leggen.";
