"cli.diagnose.group.switchSerialPlaceholder" = "%1$@ meldt %2$@ met serienummer %3$@, de identiteit en het serienummer van een Nintendo Switch Pro Controller; andere controllers kunnen hetzelfde serienummer melden. OpenJoystickDriver behandelt hem als een Pro Controller.";
/* Help text of the --output option of 'ojd diagnose'. A support bundle is a file with the diagnostic report for a bug report. */
"cli.diagnose.group.output" = "Schrijft ook een supportbundel naar dit bestand.";
