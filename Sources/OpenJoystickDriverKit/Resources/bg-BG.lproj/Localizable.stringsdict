<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d контролер е свързан</string>
			<key>zero</key>
			<string>%d контролера са свързани</string>
			<key>two</key>
			<string>%d контролера са свързани</string>
			<key>few</key>
			<string>%d контролера са свързани</string>
			<key>many</key>
			<string>%d контролера са свързани</string>
			<key>other</key>
			<string>%d контролера са свързани</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d активен профил</string>
			<key>zero</key>
			<string>%d активни профила</string>
			<key>two</key>
			<string>%d активни профила</string>
			<key>few</key>
			<string>%d активни профила</string>
			<key>many</key>
			<string>%d активни профила</string>
			<key>other</key>
			<string>%d активни профила</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d назначение</string>
			<key>zero</key>
			<string>%d назначения</string>
			<key>two</key>
			<string>%d назначения</string>
			<key>few</key>
			<string>%d назначения</string>
			<key>many</key>
			<string>%d назначения</string>
			<key>other</key>
			<string>%d назначения</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Нищо не е открито</string>
			<key>one</key>
			<string>Открито: %d</string>
			<key>two</key>
			<string>Открити: %d</string>
			<key>few</key>
			<string>Открити: %d</string>
			<key>many</key>
			<string>Открити: %d</string>
			<key>other</key>
			<string>Открити: %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Няма открити изходни устройства на контролера</string>
			<key>one</key>
			<string>Открито е %d изходно устройство на контролера</string>
			<key>two</key>
			<string>Открити са %d изходни устройства на контролера</string>
			<key>few</key>
			<string>Открити са %d изходни устройства на контролера</string>
			<key>many</key>
			<string>Открити са %d изходни устройства на контролера</string>
			<key>other</key>
			<string>Открити са %d изходни устройства на контролера</string>
		</dict>
	</dict>
</dict>
</plist>
