{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "XboxXID",
  "variants": ["Gamepad"],
  "storesVariant": true,
  "endpoints": {
    "in": 129,
    "out": 2
  },
  "rawUSB": true,
  "recordSections": ["input", "rumble"],
  "interfaceSignatures": [
    {
      "variant": "Gamepad",
      "interfaceClass": 88,
      "interfaceSubclass": 66,
      "interfaceProtocol": 0
    }
  ],
  "controls": {
    "base": "Xbox"
  },
  "rawUSBTuningKeys": ["usbTransferTimeoutMs"],
  "defaults": {
    "tuning": {
      "usbTransferTimeoutMs": 2000
    },
    "session": {
      "rumble": {
        "report": {
          "kind": "USB",
          "length": 6
        },
        "bytes": "00 06 00 00 00 00",
        "lowFrequency": {
          "byte": 2,
          "encoding": "UInt16BigEndian"
        },
        "highFrequency": {
          "byte": 4,
          "encoding": "UInt16BigEndian"
        }
      }
    },
    "input": {
      "layouts": [
        {
          "report": {
            "length": {
              "atLeast": 20
            }
          },
          "buttons": [
            {
              "control": "Start",
              "bitOffset": 20,
              "bitSize": 1
            },
            {
              "control": "Back",
              "bitOffset": 21,
              "bitSize": 1
            },
            {
              "control": "LeftStickClick",
              "bitOffset": 22,
              "bitSize": 1
            },
            {
              "control": "RightStickClick",
              "bitOffset": 23,
              "bitSize": 1
            },
            {
              "control": "South",
              "bitOffset": 32,
              "bitSize": 8
            },
            {
              "control": "East",
              "bitOffset": 40,
              "bitSize": 8
            },
            {
              "control": "West",
              "bitOffset": 48,
              "bitSize": 8
            },
            {
              "control": "North",
              "bitOffset": 56,
              "bitSize": 8
            },
            {
              "control": "LeftShoulder",
              "bitOffset": 64,
              "bitSize": 8
            },
            {
              "control": "RightShoulder",
              "bitOffset": 72,
              "bitSize": 8
            }
          ],
          "axes": [
            {
              "control": "LeftStickX",
              "bitOffset": 96,
              "bitSize": 16,
              "signed": true,
              "min": -32768,
              "max": 32767,
              "symmetric": true
            },
            {
              "control": "LeftStickY",
              "bitOffset": 112,
              "bitSize": 16,
              "signed": true,
              "min": -32768,
              "max": 32767,
              "inverted": true,
              "symmetric": true
            },
            {
              "control": "RightStickX",
              "bitOffset": 128,
              "bitSize": 16,
              "signed": true,
              "min": -32768,
              "max": 32767,
              "symmetric": true
            },
            {
              "control": "RightStickY",
              "bitOffset": 144,
              "bitSize": 16,
              "signed": true,
              "min": -32768,
              "max": 32767,
              "inverted": true,
              "symmetric": true
            }
          ],
          "hat": [
            {
              "encoding": "Table",
              "bitOffset": 16,
              "bitSize": 4,
              "values": {
                "1": "North",
                "2": "South",
                "4": "West",
                "8": "East",
                "9": "NorthEast",
                "10": "SouthEast",
                "6": "SouthWest",
                "5": "NorthWest"
              }
            }
          ],
          "leftTrigger": {
            "bitOffset": 80,
            "bitSize": 8
          },
          "rightTrigger": {
            "bitOffset": 88,
            "bitSize": 8
          }
        }
      ]
    }
  }
}
