{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "NintendoSwitch1",
  "variants": ["USB", "BluetoothClassic"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["rumble"],
  "sessionKeys": ["startup"],
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "hidStartupRecoveryIntervalMs",
    "hidStartupRecoveryRounds"
  ],
  "parameters": {
    "layout": {
      "type": "Enum",
      "values": ["Pro", "JoyConLeft", "JoyConRight"]
    },
    "usbProtocol": {
      "type": "Enum",
      "values": ["ChargingOnly"]
    }
  },
  "parameterRules": [
    {
      "rule": "AtMostOne",
      "parameters": ["layout", "usbProtocol"]
    }
  ],
  "defaults": {
    "session": {
      "rumble": {
        "report": {
          "kind": "Output",
          "id": 16,
          "length": 10
        },
        "bytes": "10 00 00 01 40 40 00 01 40 40",
        "counter": {
          "byte": 1
        },
        "lowFrequency": {
          "byte": 2,
          "encoding": "SwitchHDRumble"
        },
        "highFrequency": {
          "byte": 6,
          "encoding": "SwitchHDRumble"
        }
      },
      "startup": [
        {
          "report": {
            "kind": "Output",
            "id": 128,
            "length": 2
          },
          "bytes": "02",
          "phase": "Startup",
          "variants": ["USB"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "Output",
            "id": 128,
            "length": 2
          },
          "bytes": "03",
          "phase": "Startup",
          "variants": ["USB"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "Output",
            "id": 128,
            "length": 2
          },
          "bytes": "02",
          "phase": "Startup",
          "variants": ["USB"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "Output",
            "id": 128,
            "length": 2
          },
          "bytes": "04",
          "phase": "Startup",
          "variants": ["USB"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        }
      ],
      "subcommands": {
        "reportID": 1,
        "counterModulus": 16,
        "playerIndicator": {
          "subcommand": 48,
          "patterns": {
            "off": 0,
            "player1": 1,
            "player2": 3,
            "player3": 7,
            "player4": 15
          }
        },
        "requests": [
          {
            "subcommand": 3,
            "data": "30"
          },
          {
            "subcommand": 64,
            "data": "01"
          },
          {
            "subcommand": 72,
            "data": "01"
          },
          {
            "subcommand": 16,
            "spiRead": {
              "address": 24608,
              "length": 24,
              "purpose": "FactoryMotionCalibration"
            }
          },
          {
            "subcommand": 16,
            "spiRead": {
              "address": 32806,
              "length": 20,
              "purpose": "UserMotionCalibration"
            }
          }
        ]
      }
    },
    "tuning": {
      "minimumHIDOutputIntervalMs": 50,
      "hidStartupRecoveryIntervalMs": 200,
      "hidStartupRecoveryRounds": 2
    },
    "variants": {
      "BluetoothClassic": {
        "tuning": {
          "hidStartupIntervalMs": 60
        }
      },
      "USB": {
        "tuning": {
          "hidStartupIntervalMs": 20
        }
      }
    }
  }
}
