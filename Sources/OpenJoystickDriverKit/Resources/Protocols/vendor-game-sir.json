{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "VendorGameSir",
  "variants": ["USB", "EnhancedHID"],
  "storesVariant": true,
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "rawUSB": ["USB"],
  "recordSections": ["rumble"],
  "sessionKeys": ["startup", "keepAlive"],
  "tuningKeys": ["hidStartupIntervalMs", "minimumHIDOutputIntervalMs"],
  "parameters": {
    "innerGrips": {
      "type": "Flag"
    },
    "lightingMemory": {
      "type": "Enum",
      "values": ["ProfileSlots"]
    }
  },
  "parameterRules": [
    {
      "rule": "None",
      "variants": ["USB"]
    },
    {
      "rule": "ExactlyOne",
      "parameters": ["innerGrips", "lightingMemory"],
      "variants": ["EnhancedHID"]
    }
  ],
  "controls": {
    "base": "Xbox",
    "add": ["Guide", "LeftPaddle1", "RightPaddle1", "Auxiliary1"]
  },
  "rawUSBTuningKeys": ["usbCommandTimeoutMs"],
  "defaults": {
    "session": {
      "startup": [
        {
          "report": {
            "kind": "Output",
            "id": 15,
            "length": 64
          },
          "bytes": "F2 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "phase": "Startup",
          "variants": ["EnhancedHID"]
        },
        {
          "report": {
            "kind": "Output",
            "id": 15,
            "length": 64
          },
          "bytes": "04 20 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "phase": "Startup",
          "variants": ["EnhancedHID"],
          "when": {
            "parameter": "lightingMemory",
            "is": ["ProfileSlots"]
          }
        }
      ],
      "keepAlive": {
        "intervalMilliseconds": 500,
        "writes": [
          {
            "report": {
              "kind": "Output",
              "id": 15,
              "length": 64
            },
            "bytes": "F2 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "variants": ["EnhancedHID"]
          },
          {
            "bytes": "0F 00 00 02 F2 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "sessionByte": 2,
            "variants": ["USB"]
          }
        ]
      }
    },
    "tuning": {
      "hidStartupIntervalMs": 20,
      "minimumHIDOutputIntervalMs": 20,
      "usbCommandTimeoutMs": 2000
    },
    "variants": {
      "EnhancedHID": {
        "session": {
          "rumble": {
            "report": {
              "kind": "Output",
              "id": 15,
              "length": 64
            },
            "bytes": "0F 20 66 55 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "lowFrequency": {
              "byte": 4
            },
            "highFrequency": {
              "byte": 5
            }
          }
        }
      }
    }
  }
}
