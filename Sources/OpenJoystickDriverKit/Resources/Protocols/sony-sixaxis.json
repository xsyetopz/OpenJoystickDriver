{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "SonySixaxis",
  "variants": ["USB", "BluetoothClassic"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "inputLivenessTimeoutMs"
  ],
  "macOSOwnedOutput": {
    "lightingFeatures": ["PlayerIndicator"],
    "drivesRumble": true,
    "reports": [
      {
        "kind": "Output",
        "id": 1,
        "length": 49
      }
    ],
    "setsStartupPlayerIndicator": true,
    "readsStartupFeatures": true,
    "rationale": "macOS never writes output report 0x01 to a Sixaxis, and a USB Sixaxis ignores it until the host reads feature report 0xF2."
  },
  "inputStart": {
    "action": "PressGuide",
    "variants": ["USB"]
  },
  "defaults": {
    "variants": {
      "USB": {
        "tuning": {
          "inputLivenessTimeoutMs": 1000
        }
      }
    }
  },
  "controls": {
    "base": "Xbox",
    "add": ["Guide"],
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  }
}
