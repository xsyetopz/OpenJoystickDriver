{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "NintendoSwitch2",
  "variants": ["USB", "BluetoothLE"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["bluetoothLE"],
  "sessionKeys": ["startup", "keepAlive"],
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "usbCommandTimeoutMs"
  ],
  "parameters": {
    "layout": {
      "type": "Enum",
      "values": ["Pro", "JoyConLeft", "JoyConRight", "GameCube"]
    }
  },
  "defaults": {
    "session": {
      "commandChannel": {
        "interface": 1,
        "inEndpoint": 130,
        "replyLength": 80,
        "usbReplyTimeoutMilliseconds": 100,
        "bluetoothLEReplyTimeoutMilliseconds": 500
      },
      "trailingStopPackets": 2,
      "startup": [
        {
          "bytes": "02 91 00 01 00 08 00 00 00 00 00 00 80 30 01 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "02 91 00 01 00 08 00 00 00 00 00 00 C0 30 01 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "02 91 00 01 00 08 00 00 00 00 00 00 40 31 01 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"],
          "when": {
            "parameter": "layout",
            "is": ["GameCube"]
          }
        },
        {
          "bytes": "02 91 00 01 00 08 00 00 00 00 00 00 40 C0 1F 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "02 91 00 01 00 08 00 00 00 00 00 00 80 C0 1F 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "07 91 00 01 00 00 00 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "0C 91 00 02 00 04 00 00 27 00 00 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "11 91 00 01 00 00 00 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "0A 91 00 08 00 14 00 00 01 FF FF FF FF FF FF FF FF 35 00 46 00 00 00 00 00 00 00 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "0C 91 00 04 00 04 00 00 27 00 00 00",
          "sessionByte": 2,
          "variants": ["USB", "BluetoothLE"]
        },
        {
          "bytes": "01 91 00 0C 00 00 00 00",
          "sessionByte": 2,
          "variants": ["USB"]
        },
        {
          "bytes": "01 91 00 01 00 00 00 00",
          "sessionByte": 2,
          "variants": ["USB"]
        },
        {
          "bytes": "08 91 00 02 00 04 00 00 01 00 00 00",
          "sessionByte": 2,
          "variants": ["USB"]
        },
        {
          "bytes": "03 91 00 0A 00 04 00 00 05 00 00 00",
          "sessionByte": 2,
          "variants": ["USB"]
        },
        {
          "bytes": "03 91 00 0D 00 08 00 00 01 00 FF FF FF FF FF FF",
          "sessionByte": 2,
          "variants": ["USB"]
        }
      ],
      "keepAlive": {
        "intervalMilliseconds": 12
      }
    },
    "tuning": {
      "usbCommandTimeoutMs": 1000
    }
  }
}
