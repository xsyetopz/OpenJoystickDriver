{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "ProtocolDescription",
  "family": "ValveSteamTriton",
  "variants": ["Wired", "Dongle", "BluetoothLE"],
  "storesVariant": true,
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "sessionKeys": ["keepAlive"],
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "lizardResendTicks"
  ],
  "controls": {
    "base": "Xbox",
    "add": [
      "Guide",
      "Auxiliary1",
      "LeftPaddle1",
      "LeftPaddle2",
      "RightPaddle1",
      "RightPaddle2",
      "LeftStickTouch",
      "RightStickTouch",
      "LeftTrackpadClick",
      "RightTrackpadClick",
      "LeftTrackpadTouch",
      "RightTrackpadTouch",
      "LeftGripTouch",
      "RightGripTouch"
    ],
    "touchContactCount": 1,
    "motion": true,
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "session": {
      "activation": [
        {
          "report": {
            "kind": "Feature",
            "id": 1,
            "length": 64
          },
          "bytes": "87 03 09 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        },
        {
          "report": {
            "kind": "Feature",
            "id": 1,
            "length": 64
          },
          "bytes": "87 03 30 18 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        }
      ],
      "deactivation": [
        {
          "report": {
            "kind": "Feature",
            "id": 1,
            "length": 64
          },
          "bytes": "87 03 30 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        }
      ],
      "keepAlive": {
        "intervalMilliseconds": 40,
        "writes": [
          {
            "report": {
              "kind": "Feature",
              "id": 1,
              "length": 64
            },
            "bytes": "87 03 09 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "resendTuning": "lizardResendTicks"
          }
        ]
      }
    },
    "tuning": {
      "lizardResendTicks": 75
    }
  }
}
