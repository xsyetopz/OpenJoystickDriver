/* Error E5007, shown when a user or package record file is skipped: a Controller file names a bundled controller. %2$@ is the model. %1$@ is the file. */
"error.E5007.userFile.bundledController" = "%1$@, vendorID, productID: %2$@ ist ein mitgelieferter Controller, den eine Controller-Datei nicht hinzufügen kann. Lösung: Schreibe stattdessen eine Patch-Datei dafür.";
/* Error E5007, shown when a user or package record file is skipped: the file adds or patches a bootloader identity. %2$@ is the model. %1$@ is the file. */
"error.E5007.userFile.bootloaderController" = "%1$@, vendorID, productID: %2$@ ist eine Bootloader-Kennung, daher kann keine Benutzer- oder Paketdatei sie hinzufügen oder patchen. Lösung: Entferne die Datei; OJD sendet einem Controller im Bootloader-Zustand keine Daten.";
/* Error E5007, shown when a user or package record file is skipped: a patch selects no known controller. %2$@ is the selector. %1$@ is the file. */
"error.E5007.userFile.unknownController" = "%1$@, selector: Der Selector %2$@ passt auf keinen bekannten Controller. Lösung: Nutze eine Controller-Datei, um einen neuen Controller hinzuzufügen, oder korrigiere den Selector.";
/* Error E5007, shown when a user or package record file is skipped: the record that a patch applies to is not a dictionary. %1$@ is the file. */
"error.E5007.userFile.upstreamNotDictionary" = "%1$@, document: Der Eintrag, auf den der Patch wirkt, ist kein Dictionary. Lösung: Repariere die Eintragsdatei, auf die der Patch wirkt.";
/* Error E5007, shown when a user or package record file is skipped: a patch changes nothing in the record. %1$@ is the file. */
"error.E5007.userFile.patchNoChange" = "%1$@, patch: Der Patch ändert nichts am Eintrag. Lösung: Lösche den Patch oder setze einen Wert, der vom Eintrag abweicht.";
/* Error E5007, shown when an input layout of a record fails: input lists no layout. %1$@ is the file. */
"error.E5007.inputLayout.layoutsEmpty" = "%1$@, input.layouts: Input muss mindestens ein Layout enthalten. Lösung: Füge ein Layout hinzu oder lösche input.";
/* Error E5007, shown when an input layout of a record fails: two layouts select one report. %2$@ and %3$@ are the layouts. %1$@ is the file. */
"error.E5007.inputLayout.layoutsSameReport" = "%1$@, input.layouts: Zwei Layouts wählen denselben Report: %2$@ und %3$@. Lösung: Gib ihnen verschiedene Report-IDs oder -Längen oder lösche eines.";
/* Error E5007, shown when an input layout of a record fails: a report ID is out of range. %1$@ is the file. */
"error.E5007.inputLayout.reportIdRange" = "%1$@, input.layouts[].report.id: Eine Report-ID liegt zwischen 1...255. Lösung: Setze die ID auf eine ganze Zahl von 1 bis 255 oder lasse sie weg.";
/* Error E5007, shown when an input layout of a record fails: a report length is out of range. %2$@ is the longest length. %1$@ is the file. */
"error.E5007.inputLayout.reportLength" = "%1$@, input.layouts[].report.length: Ein Report ist 1...%2$@ Byte lang, mit seinem ID-Byte. Lösung: Setze die Länge in diesen Bereich.";
/* Error E5007, shown when an input layout of a record fails: an 8-way hat has a bad bit size. %1$@ is the file. */
"error.E5007.inputLayout.hatBits" = "%1$@, input.layouts[].hat: Ein 8-Wege-Hat hat 3 bis 8 Bit. Lösung: Setze bitSize auf 3 bis 8.";
/* Error E5007, shown when an input layout of a record fails: a table hat names bad directions. %1$@ is the file. */
"error.E5007.inputLayout.hatTable" = "%1$@, input.layouts[].hat: Ein Tabellen-Hat nennt Richtungen nur für Werte, die seine Bits fassen, und hat keinen Neutral-Eintrag. Lösung: Liste nur Werte auf, die die Bits fassen, und lasse neutral weg.";
/* Error E5007, shown when an input layout of a record fails: a field has a bad bit size. %2$@ is the largest bit size. %1$@ is the file. */
"error.E5007.inputLayout.fieldBits" = "%1$@, input.layouts[]: Ein Feld hat 1 bis %2$@ Bit. Lösung: Setze jede bitSize in diesen Bereich.";
/* Error E5007, shown when an input layout of a record fails: a field lies outside the report. %1$@ is the file. */
"error.E5007.inputLayout.fieldOutside" = "%1$@, input.layouts[]: Felder müssen nach dem Report-ID-Byte und innerhalb der Report-Länge liegen. Lösung: Verschiebe das Feld oder erhöhe die Report-Länge.";
/* Error E5007, shown when an input layout of a record fails: a BigEndian field is misplaced or has a bad size. %1$@ is the file. */
"error.E5007.inputLayout.bigEndian" = "%1$@, input.layouts[]: Ein BigEndian-Feld beginnt an einer Bytegrenze und hat 16, 24 oder 32 Bit. Lösung: Beginne bei einem Vielfachen von 8 mit einer bitSize von 16, 24 oder 32 oder nutze LittleEndian.";
/* Error E5007, shown when an input layout of a record fails: a button names a control that is not a button. %1$@ is the file. */
"error.E5007.inputLayout.buttonControl" = "%1$@, input.layouts[].buttons: Eine Taste nennt ein digitales Steuerelement, nicht das Steuerkreuz oder eine Stickachse. Lösung: Nenne ein Tastenelement oder verschiebe den Eintrag nach axes oder hat.";
/* Error E5007, shown when an input layout of a record fails: axes repeat a control or name a control that is not a stick axis. %1$@ is the file. */
"error.E5007.inputLayout.axesDistinct" = "%1$@, input.layouts[].axes: Axes müssen verschiedene Stickachsen nennen. Lösung: Nenne jede Stickachse einmal.";
/* Error E5007, shown when an input layout of a record fails: an axis has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.axisRange" = "%1$@, input.layouts[].axes: Eine Achse hat min unter max, innerhalb des Bereichs ihrer Größe. Lösung: Setze min unter max, beide innerhalb des Bereichs von bitSize.";
/* Error E5007, shown when an input layout of a record fails: a trigger value has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.triggerRange" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: Ein Trigger-Wert hat min unter max, innerhalb des Bereichs seiner Größe. Lösung: Setze min unter max, beide innerhalb des Bereichs von bitSize.";
/* Error E5007, shown when an input layout of a record fails: a symmetric axis is not signed around zero. %1$@ is the file. */
"error.E5007.inputLayout.axisSymmetric" = "%1$@, input.layouts[].axes: Eine symmetrische Achse ist vorzeichenbehaftet, mit min unter 0 und max über 0. Lösung: Setze signed auf true mit min unter 0 und max über 0 oder schalte symmetric aus.";
/* Error E5007, shown when an input layout of a record fails: a trigger has neither an analog value nor a button. %1$@ is the file. */
"error.E5007.inputLayout.triggerSources" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: Ein Trigger nennt einen Analogwert, eine Taste oder beides. Lösung: Gib dem Trigger einen Analogwert oder eine Taste.";
/* Error E5007, shown when an input layout of a record fails: a layout decodes no control. %1$@ is the file. */
"error.E5007.inputLayout.noControls" = "%1$@, input.layouts[]: Ein Layout muss mindestens ein Steuerelement dekodieren. Lösung: Füge eine Taste, Achse, einen Hat oder Trigger hinzu.";
/* Error E5007, shown when the HID usage map of a record fails: a usage map lists no usage. %1$@ is the file. */
"error.E5007.usageMap.mapEmpty" = "%1$@, input.hidUsageMap.usages: Eine Usage-Zuordnung muss mindestens eine Usage enthalten. Lösung: Füge eine Usage hinzu oder lösche hidUsageMap.";
/* Error E5007, shown when the HID usage map of a record fails: two entries of one usage name the same half. %2$@ is the usage as page/usage, %3$@ the half. %1$@ is the file. */
"error.E5007.usageMap.halfTwice" = "%1$@, input.hidUsageMap.usages[].half: Usage %2$@ nennt die Hälfte %3$@ zweimal. Lösung: Gib jeder Hälfte einer Usage genau einen Eintrag.";
/* Error E5007, shown when the HID usage map of a record fails: a usage is named twice. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.usageTwice" = "%1$@, input.hidUsageMap.usages[]: Usage %2$@ wird zweimal genannt, und nur Einträge für ihre beiden Hälften dürfen eine Usage teilen. Lösung: Nenne jede Usage einmal oder gib den Einträgen die Hälften Positive und Negative.";
/* Error E5007, shown when the HID usage map of a record fails: a Button entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ ist eine Taste, und %3$@ ist kein Tastenelement. Lösung: Nenne ein Tastenelement oder nutze eine andere Eintragsart.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis entry names a control that is not a stick axis or trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ ist eine Achse, und %3$@ ist weder eine Stickachse noch ein Trigger. Lösung: Nenne eine Stickachse oder einen Trigger oder nutze eine andere Eintragsart.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis range has min at or above max. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.rangeOrder" = "%1$@, input.hidUsageMap.usages[].range: Der Bereich von Usage %2$@ muss min unter max haben. Lösung: Setze min unter max.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis deadZone is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.deadZone" = "%1$@, input.hidUsageMap.usages[].deadZone: Die deadZone von Usage %2$@ muss über 0 und unter 1 liegen. Lösung: Setze deadZone über 0 und unter 1.";
/* Error E5007, shown when the HID usage map of a record fails: a Hat range is not 0...7 or 1...8. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.hatRange" = "%1$@, input.hidUsageMap.usages[].range: Der Hat-Bereich von Usage %2$@ muss 0...7 oder 1...8 sein. Lösung: Setze range auf 0...7 oder 1...8 oder lasse es weg.";
/* Error E5007, shown when the HID usage map of a record fails: a HalfAxis entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.halfAxisControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ ist eine Halbachse, und %3$@ ist kein Trigger. Lösung: Nenne LeftTrigger oder RightTrigger.";
/* Error E5007, shown when the HID usage map of a record fails: a ButtonTrigger entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonTriggerControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ ist ein Tasten-Trigger, und %3$@ ist kein Trigger. Lösung: Nenne LeftTrigger oder RightTrigger oder nutze eine andere Eintragsart.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad entry names a control that is not a D-pad direction. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisDpadControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ ist ein Achsen-Steuerkreuz, und %3$@ ist keine Steuerkreuzrichtung. Lösung: Nenne DpadUp, DpadDown, DpadLeft oder DpadRight.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisButton entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisButtonControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ ist eine Achsen-Taste, und %3$@ ist kein Tastenelement. Lösung: Nenne ein Tastenelement oder nutze eine andere Eintragsart für die Achse.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad or AxisButton threshold is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.threshold" = "%1$@, input.hidUsageMap.usages[].threshold: Der threshold von Usage %2$@ muss über 0 und unter 1 liegen. Lösung: Setze threshold über 0 und unter 1.";
/* Error E5007, shown when a startup write of a record fails: a startup write names an input report. %1$@ is the file. */
"error.E5007.startupWrite.reportKind" = "%1$@, session.startup[].report: Ein Startschreibvorgang darf keinen Input-Report senden. Lösung: Setze report auf einen Output- oder Feature-Report.";
/* Error E5007, shown when a startup write of a record fails: a startup report is not 2...128 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.reportLength" = "%1$@, session.startup[].report: Ein Start-Report muss 2...128 Bytes lang sein. Lösung: Gib dem Report eine Länge von 2...128 Bytes.";
/* Error E5007, shown when a startup write of a record fails: a startup write lists the wrong number of bytes. %2$@ is the number of bytes the report takes after its ID. %1$@ is the file. */
"error.E5007.startupWrite.bytesCount" = "%1$@, session.startup[].bytes: Ein Startschreibvorgang muss %2$@ Bytes auflisten, jedes Byte nach der Report-ID. Lösung: Gib bytes genau %2$@ Bytes.";
/* Error E5007, shown when a startup write of a record fails: a startup delay is outside 0...1000 ms. %1$@ is the file. */
"error.E5007.startupWrite.delay" = "%1$@, session.startup[].delayMilliseconds: Eine Startverzögerung muss 0...1000 ms betragen. Lösung: Setze delayMilliseconds auf 0...1000 oder lasse es weg.";
/* Error E5007, shown when a startup write of a record fails: a startup transport is not USB, BluetoothClassic or BluetoothLE. %1$@ is the file. */
"error.E5007.startupWrite.transport" = "%1$@, session.startup[].transport: Ein Start-Transport muss USB, BluetoothClassic oder BluetoothLE sein. Lösung: Setze transport auf einen davon oder lasse es weg.";
/* Error E5007, shown when a startup write of a record fails: a startup report with crc32Seed has no room for its 4-byte trailer. %1$@ is the file. */
"error.E5007.startupWrite.crcRoom" = "%1$@, session.startup[].crc32Seed: Ein Start-Report mit crc32Seed muss Platz für seinen 4-Byte-Abschluss haben. Lösung: Mache den Report länger als 4 Bytes oder entferne crc32Seed.";
/* Error E5007, shown when a startup write of a record fails: a USB startup packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.usbLength" = "%1$@, session.startup[].bytes: Ein USB-Startpaket muss 1...64 Bytes lang sein. Lösung: Gib bytes eine Länge von 1...64.";
/* Error E5007, shown when a startup write of a record fails: a USB startup endpoint is outside 1...127. %1$@ is the file. */
"error.E5007.startupWrite.usbEndpoint" = "%1$@, session.startup[].endpoint: Ein USB-Start-Endpunkt muss 1...127 sein. Lösung: Setze endpoint auf 1...127 oder lasse es weg.";
/* Error E5007, shown when a startup write of a record fails: a USB startup timeout is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.startupWrite.usbTimeout" = "%1$@, session.startup[].timeoutMilliseconds: Ein USB-Start-Timeout muss 1...60000 ms betragen. Lösung: Setze timeoutMilliseconds auf 1...60000 oder lasse es weg.";
/* Error E5007, shown when a startup write of a record fails: a USB startup session byte does not index the packet. %1$@ is the file. */
"error.E5007.startupWrite.sessionByte" = "%1$@, session.startup[].sessionByte: Ein USB-Start-Sitzungsbyte muss ein Byte des Pakets adressieren. Lösung: Setze sessionByte auf eine Position innerhalb von bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names an input report. %1$@ is the file. */
"error.E5007.rumble.reportKind" = "%1$@, session.rumble.report.kind: Eine Rumble-Vorlage darf keinen Input-Report schreiben. Lösung: Setze report auf einen Output- oder Feature-Report.";
/* Error E5007, shown when the rumble template of a record fails: a rumble HID report is not 2...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.reportLength" = "%1$@, session.rumble.report.length: Ein Rumble-HID-Report muss 2...64 Bytes lang sein. Lösung: Gib dem Report eine Länge von 2...64 Bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble USB packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.packetLength" = "%1$@, session.rumble.report.length: Ein Rumble-USB-Paket muss 1...64 Bytes lang sein. Lösung: Gib dem Paket eine Länge von 1...64 Bytes.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a rumble template do not cover the whole report. %1$@ is the file. */
"error.E5007.rumble.bytesCover" = "%1$@, session.rumble.bytes: Die Bytes einer Rumble-Vorlage müssen den ganzen Report abdecken. Lösung: Liste jedes Byte des Reports auf, einschließlich der Report-ID.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a numbered rumble report do not start with its report ID. %1$@ is the file. */
"error.E5007.rumble.bytesReportId" = "%1$@, session.rumble.bytes: Die Bytes eines nummerierten Rumble-Reports müssen mit seiner Report-ID beginnen. Lösung: Beginne bytes mit der Report-ID.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names no motor it can drive. %1$@ is the file. */
"error.E5007.rumble.motors" = "%1$@, session.rumble: Eine Rumble-Vorlage muss mindestens einen Motor nennen, den sie ansteuern kann. Lösung: Füge lowFrequency, highFrequency, leftTrigger oder rightTrigger hinzu.";
/* Error E5007, shown when the rumble template of a record fails: the motor and counter bytes of a rumble template overlap or fall outside the report. %1$@ is the file. */
"error.E5007.rumble.fields" = "%1$@, session.rumble: Die Motor- und Zählerbytes einer Rumble-Vorlage müssen verschieden sein und innerhalb des Reports nach der Report-ID liegen. Lösung: Gib jedem Motor und dem Zähler ein eigenes Byte nach der Report-ID.";
/* Error E5007, shown when the rumble template of a record fails: a rumble resend interval is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.rumble.resendInterval" = "%1$@, session.rumble.resendIntervalMilliseconds: Ein Rumble-Wiederholungsintervall muss 1...60000 ms betragen. Lösung: Setze resendIntervalMilliseconds auf 1...60000 oder lasse es weg.";
/* Error E5008, shown when the SDL_GameControllerDB line of a controller cannot drive it; the message names the reason. */
"error.E5008.message" = "Die SDL_GameControllerDB-Zeile eines Controllers kann ihn nicht steuern. Die Meldung nennt den Grund. Schreibe mit ojd record draft einen Controller-Eintrag für den Controller.";
