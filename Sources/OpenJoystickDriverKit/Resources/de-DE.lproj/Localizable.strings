"cli.root.abstract" = "OpenJoystickDriver, den Gamepad-Treiber für macOS, konfigurieren und prüfen.";
"cli.root.discussion" = "Hier starten:\n  ojd status             Dienst, Erweiterung und Berechtigungen prüfen.\n  ojd diagnose           Alle Prüfungen ausführen und Fehler melden.\n  ojd controller list    Verbundene Controller auflisten.\n\nBeispiele:\n  # Eingaben eines Controllers bei jeder Änderung ausgeben\n  ojd controller watch 045E:028E\n  # Verbundene Controller als JSON auflisten\n  ojd --json controller list\n\nUmgebung (eine Option hat Vorrang vor ihrer Variable):\n  OJD_NO_INPUT=1         Wie --no-input.\n  OJD_TIMEOUT=SECONDS    Wie --timeout.\n  OJD_COLOR=WHEN         auto, always (auch ohne Terminal farbig) oder never.\n\nShell-Vervollständigung:\n  ojd --generate-completion-script zsh|bash|fish\n\nExit-Codes:\n  0    Erfolg.\n  1    Der Befehl ist fehlgeschlagen.\n  64   Verwendungsfehler.\n  69   Der Dienst läuft nicht. Starte ihn mit „ojd service start“.\n  77   Eine macOS-Berechtigung fehlt.\n  127  Ein Repository-Build konnte den Befehl nicht an die installierte App übergeben.\n  130  Unterbrochen.";
"cli.help.global_options" = "Jeder Befehl akzeptiert auch die globalen Optionen; „ojd --help“ listet sie auf.";
"cli.error.env_timeout" = "OJD_TIMEOUT erwartet eine Anzahl von Sekunden größer als 0.";
"cli.error.env_color" = "OJD_COLOR erwartet auto, always oder never.";
"cli.virtual.feed.error.plain" = "--plain gilt nicht für „virtual feed“, das JSON-Zeilen ausgibt. Lass --plain weg.";
"cli.controller.watch.examples" = "Beispiele:\n  # Eingaben 10 Sekunden lang ausgeben\n  ojd controller watch 045E:028E --duration 10\n  # Das erste gedrückte Bedienelement als JSON ausgeben\n  ojd controller watch 045E:028E --first-press --json\n  # Alle Controller und die Ausgabe ihres virtuellen Gamepads beobachten\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Beispiele:\n  # Beide Hauptmotoren 0,45 Sekunden lang mit 180 laufen lassen\n  ojd controller rumble 045E:028E\n  # Beide Hauptmotoren 2 Sekunden lang mit voller Stärke laufen lassen\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Beispiele:\n  # Die Lightbar auf Orange setzen\n  ojd controller light 054C:09CC --color FF8000\n  # Farbe und eine niedrige Helligkeit setzen\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Beispiele:\n  # Ein Profil für ein Controller-Modell erstellen\n  ojd profile create Racing --controller 045E:028E\n  # Es nur anwenden, solange Safari im Vordergrund ist\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Beispiele:\n  # Ein Profil umbenennen\n  ojd profile set Racing name Rally\n  # Die innere Totzone der ersten Stick-Zuordnung setzen\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Beispiele:\n  # Leertaste halten, solange die südliche Taste gehalten wird\n  ojd binding set Racing button:south key:space\n  # J bei jedem Drücken umschalten\n  ojd binding set Racing button:west key:j --behavior toggle\n  # J 10-mal pro Sekunde wiederholen, solange die Taste gehalten wird\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Beispiele:\n  # Eine Record-Datei installieren\n  ojd record install 045E-028E.json\n  # Den Record von stdin lesen\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Beispiele:\n  # Einem Programm die Nutzung des Dienstes erlauben\n  ojd access grant /Applications/Example.app\n  # Ein Token für Seiten erstellen, die von einem Ursprung ausgeliefert werden\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
