"cli.controller.group.optionDuration" = "Nach so vielen Sekunden anhalten. Ohne diese Option läuft der Befehl, bis du Control-C drückst.";
/* Error of the controller output commands when the controller rejects a command. %1$@ is the controller name, %2$@ is the command name and %3$@ is the outcome in kebab case, which stays as written. The command in quotes stays as written. */
"cli.controller.group.outputFailed" = "%1$@ hat den Befehl %2$@ nicht akzeptiert (%3$@). Prüfe das mit „ojd log show“.";
/* Error of the controller output commands when the controller disconnects before the command is sent. %@ is the controller name. */
"cli.controller.group.outputGone" = "%@ wurde getrennt, bevor der Befehl gesendet wurde. Verbinde ihn erneut und versuche es noch einmal.";
/* Error of the controller output commands when the controller cannot take output yet. %@ is the controller name. */
"cli.controller.group.outputNotReady" = "%@ ist noch nicht bereit für die Ausgabe. Versuche es gleich noch einmal.";
/* Message printed after the controller output commands succeeded. %1$@ is the comma-separated list of commands sent and %2$@ is the controller name. */
"cli.controller.group.outputSent" = "%1$@ an %2$@ gesendet.";
/* Error of the controller output commands when the controller lacks the feature. %1$@ is the controller name, %2$@ is the missing feature as a noun phrase and %3$@ is the session token for 'ojd controller show'. */
"cli.controller.group.outputUnsupported" = "%1$@ hat kein %2$@. Führe „ojd controller show %3$@“ aus, um zu sehen, was er unterstützt.";
/* One-line summary of 'ojd controller claim' in the command list and at the top of its help. OpenJoystickDriver is the product name. To serve a model means to read its input and publish it as a virtual gamepad. */
"cli.controller.claim.abstract" = "OpenJoystickDriver ein Controller-Modell bedienen lassen.";
/* Long description in the help of 'ojd controller claim'. server, ojd, vvvv-pppp.plist and the record terms stay as written. */
"platform.macos.cli.controller.claim.discussion" = "Setzt server in deinem Eintrag für das Modell, vvvv-pppp.plist in deinem Eintragsordner, auf ojd und behält die anderen Felder des Eintrags. Gilt für jeden Controller des Modells. Der laufende Dienst wendet es ohne erneutes Einstecken an. Braucht den Dienst, um den Controller zu finden. --dry-run schreibt nichts. Endet mit 1 und E2023 für einen Controller, der rohes USB nutzt und den OpenJoystickDriver immer bedient, oder den macOS nicht nativ bedient.";
/* One-line summary of 'ojd controller release' in the command list and at the top of its help. */
"platform.macos.cli.controller.release.abstract" = "Ein Controller-Modell an macOS zurückgeben.";
/* Long description in the help of 'ojd controller release'. server, system and vvvv-pppp.plist stay as written. */
"platform.macos.cli.controller.release.discussion" = "Setzt server in deinem Eintrag für das Modell, vvvv-pppp.plist in deinem Eintragsordner, auf system und behält die anderen Felder des Eintrags. Gilt für jeden Controller des Modells. Der laufende Dienst wendet es ohne erneutes Einstecken an. Braucht den Dienst, um den Controller zu finden. --dry-run schreibt nichts. Endet mit 1 und E2023 für einen Controller, der rohes USB nutzt und den OpenJoystickDriver immer bedient, oder den macOS nicht nativ bedient.";
/* Message printed by 'ojd controller claim' and related commands with --dry-run instead of writing the record. %1$@ is the controller identity, %2$@ is the server name in kebab case and %3$@ is the record file. */
"cli.controller.group.serverDryRun" = "Würde %1$@ auf %2$@ setzen, in %3$@.";
/* Error when the record file of a controller cannot be changed. %1$@ is the path of the record file and %2$@ is the description of the problem. */
"cli.controller.group.serverInvalid" = "%1$@ kann nicht geändert werden: %2$@";
/* Error when a controller has no record to change. %1$@ is the controller identity and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.controller.group.serverNoRecord" = "%1$@ hat keinen Controller-Eintrag, der sich ändern lässt. Erstelle einen mit „ojd record draft %2$@“.";
/* Message when a controller cannot be released to macOS because macOS does not serve it natively. %@ is the controller identity. OpenJoystickDriver is the product name. */
"platform.macos.cli.controller.group.serverNotNative" = "macOS bedient %@ nicht nativ, daher bedient OpenJoystickDriver ihn immer.";
/* Message when the server of a controller cannot be changed because it uses raw USB. %@ is the controller identity. OpenJoystickDriver is the product name. */
"cli.controller.group.serverRawUsb" = "%@ nutzt rohes USB, daher bedient OpenJoystickDriver ihn immer.";
/* Message printed after the server of a controller is changed. %1$@ is the controller identity, %2$@ is the server name in kebab case and %3$@ is the record file. The service picks the change up without a restart. */
"cli.controller.group.serverSuccess" = "%1$@ wurde auf %2$@ gesetzt, in %3$@. Der laufende Dienst wendet es jetzt an.";
