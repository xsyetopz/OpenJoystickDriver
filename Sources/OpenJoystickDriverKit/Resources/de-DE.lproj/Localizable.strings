"cli.diagnose.group.soakVerdictStable" = "Stabil: residenter Speicher %1$.1f MiB, Speicherfußabdruck %2$.1f MiB, Dateideskriptoren %3$lld, CPU-Last %4$.1f %% in %5$.0f s";
