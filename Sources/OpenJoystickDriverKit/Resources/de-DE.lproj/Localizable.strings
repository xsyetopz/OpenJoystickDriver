/* Text of error E2002, printed when the first word after ojd is not a command. ojd and the command in quotes stay as written. */
"error.E2002.message" = "Das ist kein ojd-Befehl. Führe „ojd --help“ aus, um die Befehle zu sehen.";
/* Text of error E2003, printed when the options or values of a command are wrong or missing. --help stays as written. */
"error.E2003.message" = "In der Befehlszeile ist eine Option oder ein Wert falsch oder fehlt. Führe den Befehl mit --help aus, um zu sehen, was er erwartet.";
/* Text of error E2004, printed when a command needs the service and it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2004.message" = "Der OpenJoystickDriver-Dienst läuft nicht. Starte ihn mit „ojd service start“.";
/* Text of error E2005, printed when the service does not answer in time. The command in quotes and --timeout stay as written. */
"error.E2005.message" = "Der Dienst hat nicht rechtzeitig geantwortet. Prüfe ihn mit „ojd status“ oder warte mit --timeout länger.";
/* Text of error E2006, printed when the service reports that it could not complete a request. The command in quotes stays as written. */
"error.E2006.message" = "Der Dienst hat die Anfrage nicht abgeschlossen. Prüfe ihn mit „ojd status“ und versuche es erneut.";
/* Text of error E2007, printed when the service refuses this ojd because its code signature differs from the app. ojd and OpenJoystickDriver.app stay as written. */
"error.E2007.message" = "Der Dienst hat dieses ojd abgelehnt, weil es nicht wie die App signiert ist. Führe das ojd aus, das in OpenJoystickDriver.app enthalten ist.";
/* Text of error E2008, printed when a command needs a macOS permission that is missing. The command in quotes stays as written. */
"error.E2008.message" = "Eine Berechtigung fehlt. Erteile sie mit „ojd permission request“.";
/* Text of error E2009, printed when a command that changes or deletes data runs without a terminal and without --force. --force stays as written. */
"error.E2009.message" = "Dieser Befehl ändert oder löscht Daten und braucht eine Bestätigung. Führe ihn erneut mit --force aus.";
/* Text of error E2010, printed when a command stops before it finishes because the user declined, an editor failed or no input came. */
"error.E2010.message" = "Der Befehl wurde beendet, bevor er fertig war, weil du abgelehnt hast, ein Editor fehlgeschlagen ist oder keine Eingabe kam. Führe ihn erneut aus.";
/* Text of error E2011, printed when a profile file or a record file is not valid against its schema. */
"error.E2011.message" = "Die Profil- oder Eintragsdatei ist ungültig. Korrigiere sie anhand ihres Schemas und versuche es erneut.";
/* Text of error E2012, printed when a name matches no controller, profile, binding or client, or matches more than one. The word list in quotes is the name of the matching list command and stays as written. */
"error.E2012.message" = "Kein Controller, Profil, keine Zuordnung und kein Client passt, oder es passen mehrere. Liste sie mit dem passenden „list“-Befehl auf und gib genau einen an.";
/* Text of error E2013, printed when the controller cannot take a requested action. The command in quotes stays as written. */
"error.E2013.message" = "Der Controller kann das gerade nicht. Er wird möglicherweise nicht unterstützt, ist nicht bereit oder getrennt. Prüfe ihn mit „ojd controller list“.";
/* Text of error E2014, printed when the app is not fully installed or its signature is not valid. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2014.message" = "OpenJoystickDriver ist nicht vollständig installiert oder seine Signatur ist ungültig. Installiere die App erneut und führe „ojd diagnose“ aus.";
/* Text of error E2015, printed when macOS does not complete or apply a request of the driver. */
"error.E2015.message" = "Das System hat die Anfrage nicht abgeschlossen oder angewendet. Prüfe die Systemeinstellungen und versuche es erneut.";
/* Text of error E2016, printed when a file cannot be read, written or deleted, or is present although it must not be. */
"error.E2016.message" = "Eine Datei konnte nicht gelesen, geschrieben oder gelöscht werden, oder sie existiert bereits. Prüfe den Pfad und seine Berechtigungen.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Dieser Client ist nicht oder nur ad hoc signiert und kann daher keinen Zugriff erhalten. Signiere ihn mit einer Developer ID und versuche es erneut.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "„ojd diagnose“ hat eine fehlgeschlagene Prüfung gefunden. Lies die Ausgabe und behebe die fehlgeschlagenen Punkte.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "Die Suche nach Updates wurde nicht abgeschlossen. Prüfe deine Netzwerkverbindung und versuche es erneut.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "Die installierte OpenJoystickDriver-App ist älter als dieses ojd. Führe „just install-fast-dev“ aus oder setze OJD_RUN_REPOSITORY_CLI=1, um diesen Build auszuführen.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Ein Repository-Build von ojd konnte den Befehl nicht an die installierte App übergeben. Installiere OpenJoystickDriver.app erneut und führe den Befehl noch einmal aus.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "Der Controller ist nicht verbunden oder nicht bereit für die Neuzuordnung. Verbinde ihn erneut und versuche es noch einmal.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "Die ausgewählten Joy-Cons konnten nicht gekoppelt werden. Aktualisiere die verbundenen Controller und versuche es erneut.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "Der Controller meldet keine Bewegungsdaten. Wähle einen Controller mit Bewegungssensoren oder lass die Bewegungsoptionen aus.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Ein Wert in der Anfrage ist größer, als der Dienst annimmt. Sende einen kleineren Wert.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "Die Liste der aktiven Profile ist beschädigt und konnte nicht geladen werden. Repariere oder entferne die beschädigte Datei und versuche es erneut.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "Ein Profil mit diesem Namen existiert bereits. Wähle einen anderen Namen; „ojd profile list“ zeigt die verwendeten Namen.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "In der Anfrage fehlen Argumente oder sie sind ungültig. Prüfe die Werte und versuche es erneut.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "Das Profil ist ungültig. Prüfe die Zuweisungen und versuche es erneut.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "Die Profilbibliothek würde zu groß. Lösche Profile, die du nicht brauchst, und versuche es erneut.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "Ein Profil mit dieser Kennung existiert bereits. Verwende eine neue Kennung oder aktualisiere das vorhandene Profil.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "Das Profil wurde nach dem Laden anderswo geändert. Lade es neu und nimm deine Änderung erneut vor.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "Die Bibliothek enthält bereits die höchste erlaubte Anzahl an Profilen. Lösche ein Profil, das du nicht brauchst, und versuche es erneut.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "Kein Profil hat diese Kennung. Liste die Profile mit „ojd profile list“ auf.";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "Der Dienst konnte seine Antwort nicht kodieren. Versuche es erneut und melde das Problem, falls es bestehen bleibt.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "Die Antwort ist größer, als der Dienst senden kann. Fordere weniger Daten an und versuche es erneut.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "Die Neuzuordnungs-Engine ist nicht verfügbar. Warte einen Moment und versuche es erneut oder starte den Dienst neu.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "Die Profilbibliothek und die Neuzuordnungs-Engine sind nicht verfügbar. Warte einen Moment und versuche es erneut oder starte den Dienst neu.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "Die Profilbibliothek ist nicht verfügbar. Warte einen Moment und versuche es erneut oder starte den Dienst neu.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "Der Neuzuordnungs-Router wurde heruntergefahren. Starte den Dienst neu und versuche es erneut.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "Der Dienst konnte nicht bestätigen, ob die letzte Profiländerung gespeichert wurde. Lade die Profile neu und prüfe sie, bevor du sie wieder änderst.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "Eine Profildatei konnte nicht gelesen werden. Prüfe, ob die Datei existiert und der Dienst sie lesen kann.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "Beschädigte Profildateien müssen repariert oder entfernt werden, bevor Profile geändert werden können. Repariere oder entferne sie und versuche es erneut.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "Eine Profildatei konnte nicht geschrieben werden. Prüfe den freien Speicherplatz und die Ordnerberechtigungen.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "Der Neuzuordnungsdienst ist auf einen unbekannten Fehler gestoßen. Führe „ojd diagnose“ aus und melde das Problem zusammen mit der Ausgabe.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "Das Profil erzeugt keine Ausgabe. Füge ihm eine Belegung oder eine Lichtfarbe hinzu oder aktiviere es mit --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "Das Profil des Joy-Con-Paars bezieht das Gyroskop vom anderen Joy-Con. Kalibriere die Bewegung des Controllers, den das Profil für das Gyroskop auswählt.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Für den Controller ist kein Neuzuordnungsprofil aktiv, daher verarbeitet er keine Bewegung. Aktiviere ein Profil dafür, bringe die Ziel-App in den Vordergrund und versuche es noch einmal.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "Die Neuzuordnungssitzung des Controllers hat sich während der Anfrage geändert. Versuche es noch einmal.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Ein Profil aus einem installierten Paket kann nicht geändert werden. Dupliziere das Profil und ändere die Kopie.";
/* Text of error E3030, returned when an action needs Post Event access and it is not granted. */
"error.E3030.message" = "Die Aktion wurde nicht ausgeführt, weil der Post-Event-Zugriff nicht erteilt ist. Erteile ihn OpenJoystickDriver und versuche es noch einmal.";
/* Text of error E3031, returned when an action needs Automation access and it is not granted. */
"error.E3031.message" = "Die Aktion wurde nicht ausgeführt, weil der Automation-Zugriff nicht erteilt ist. Erteile ihn OpenJoystickDriver und versuche es noch einmal.";
/* Text of error E3032, returned when an action needs to send keys while Secure Input blocks them. */
"error.E3032.message" = "Die Aktion wurde nicht ausgeführt, weil Secure Input aktiv ist. Schließe die App, die es aktiviert hat, etwa ein Passwortfeld, und versuche es noch einmal.";
/* Text of error E3033, returned when a system action fails. The action name and the reason follow it. */
"error.E3033.message" = "Die Aktion ist fehlgeschlagen.";
/* Text of error E3034, returned when the system refuses to create the MIDI source of a MIDI action. */
"error.E3034.message" = "Die MIDI-Aktion wurde nicht ausgeführt, weil das System das Erstellen der MIDI-Quelle OpenJoystickDriver verweigert hat. Versuche es noch einmal.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.plist stays as written. */
"error.E4001.message" = "Das Paketmanifest mod.plist fehlt oder ist ungültig. Prüfe es anhand des mod-package-Schemas und führe den Befehl erneut aus.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "Das Paket benötigt eine andere Version von OpenJoystickDriver als die laufende. Installiere eine Paketversion, die diese Version unterstützt, oder aktualisiere OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.plist stays as written. */
"error.E4003.message" = "Eine Datei des Pakets ist ungültig, fehlt oder ist in mod.plist nicht aufgeführt. Korrigiere die im Befehl genannte Datei und führe ihn erneut aus.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "Das Paket deckt einen Controller, eine Persona oder ein Profil ab, das bereits in deinen eigenen Dateien oder einem anderen installierten Paket vorhanden ist. Entferne die kollidierende Datei oder das Paket oder ändere das Paket und führe den Befehl erneut aus.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Ein Paket mit diesem Namen ist bereits installiert. Führe den Befehl mit --force aus, um es zu ersetzen.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Kein installiertes Paket hat diesen Namen. Führe ojd mod list aus, um die installierten Pakete anzuzeigen.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "Der Paketordner konnte nicht geändert werden. Prüfe den freien Speicherplatz und die Ordnerberechtigungen.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Einem Dokument fehlt die apiVersion, oder seine apiVersion wird von dieser Version von OpenJoystickDriver nicht unterstützt. Ändere das Dokument auf die unterstützte apiVersion, die die Meldung nennt, und führe den Befehl erneut aus.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Eine Protokollbeschreibung ist ungültig. Prüfe die Datei gegen das Schema protocol-description und korrigiere das Feld, das die Meldung nennt.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Eine Protokollbeschreibung nennt eine Familie, die vom Dateinamen abweicht. Benenne die Datei nach ihrer Familie.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Eine Protokollbeschreibung führt eine Variante auf, die ihre Familie nicht hat. Verwende eine der Varianten der Familie.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.plist is a file name and stays as written. */
"error.E5005.message" = "Die Zugriffsdatei AccessGrants.plist ist beschädigt. Repariere die Datei oder lösche sie und erteile den Zugriff dann erneut.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Die Schlüsseldatei der Geräte-IDs, PortKeyInstallation.key, kann nicht gelesen werden oder ist nicht 32 Byte groß. Stellen Sie die Datei aus einer Sicherung wieder her. Wenn Sie sie stattdessen löschen, erstellt OpenJoystickDriver einen neuen Schlüssel, und jede Geräte-ID ändert sich.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Ein Controller-Eintrag oder -Patch ist ungültig. Prüfe die Datei gegen ihr Schema und korrigiere das Feld, das die Meldung nennt.";
/* Error E5007, in place of a file path when the message does not know which file failed. */
"error.E5007.thisFile" = "diese Eintragsdatei";
/* Error E5007, shown when the bundled controller catalog holds no record file. */
"error.E5007.record.catalogEmpty" = "Ordner Controllers des mitgelieferten Katalogs: Der Katalog enthält keine Eintragsdatei. Regel: Der Katalog enthält mindestens einen Controller-Eintrag. Lösung: OpenJoystickDriver neu installieren.";
/* Error E5007, shown when a record file is not named after its own vendorID and productID. %1$@ is the file, %2$@ the name it must have. */
"error.E5007.record.fileName" = "%1$@, vendorID und productID: Der Dateiname muss %2$@ lauten, also die beiden IDs hexadezimal. Lösung: Benenne die Datei in %2$@ um oder korrigiere die IDs darin.";
/* Error E5007, shown when two record files give one controller model. %1$@ is the file, %2$@ the model, %3$@ the file that holds it first. */
"error.E5007.record.duplicateIdentity" = "%1$@, vendorID und productID: %2$@ ist bereits die Identität des Eintrags in %3$@. Lösung: Lösche eine der beiden Dateien oder ändere die IDs dieser Datei.";
/* Error E5007, shown when a value of a record cannot be written as JSON. %1$@ is the file, %2$@ the reason. */
"error.E5007.record.unwritableValue" = "%1$@, document: Ein Wert lässt sich nicht als JSON schreiben (%2$@). Lösung: Ersetze den Wert, den der Grund nennt, durch eine Zeichenkette, Zahl, Boolesche Angabe, Liste oder ein Dictionary.";
/* Error E5007, shown when the vendorID or productID of a record is out of range. %1$@ is the file. */
"error.E5007.record.idRange" = "%1$@, vendorID und productID: vendorID muss 1...65535 und productID 0...65535 sein. Lösung: Setze beide auf eine ganze Zahl in ihrem Bereich.";
/* Error E5007, shown when a patch file fails: the file is not a dictionary. %1$@ is the file. */
"error.E5007.patch.patchNotObject" = "%1$@, document: Die Datei ist kein JSON-Objekt. Lösung: Mache die Datei zu einem Dictionary mit apiVersion, kind, selector und patch oder remove.";
/* Error E5007, shown when a patch file fails: the file lacks apiVersion, kind, selector, or patch and remove. %1$@ is the file. */
"error.E5007.patch.patchFields" = "%1$@, document: Die Datei muss apiVersion, kind, selector und patch oder remove enthalten. Lösung: Ergänze das fehlende Mitglied.";
/* Error E5007, shown when a record or protocol description breaks a rule: HID startup writes are in a raw-USB mode or family. %1$@ is the file. */
"error.E5007.session.hidStartup" = "%1$@, session.startup: HID-Startschreibvorgänge gelten nur für HID-Controller, also nicht für einen Raw-USB-Modus oder eine Raw-USB-Familie. Lösung: Entferne die HID-Startschreibvorgänge oder verwende Raw-USB-Pakete.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode names a session keepAlive for a family that declares its own. %2$@ is the family. %1$@ is the file. */
"error.E5007.session.keepAliveFamily" = "%1$@, session.keepAlive: Ein session keepAlive braucht eine Raw-USB-Familie, deren Beschreibung keinen deklariert, und %2$@ deklariert einen. Lösung: Entferne das session keepAlive, denn %2$@ führt bereits ein eigenes aus.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names a session key that only raw-USB modes take. %2$@ is the key. %1$@ is the file. */
"error.E5007.session.rawUSBOnly" = "%1$@, session.%2$@: Session %2$@ gilt nur für Raw-USB-Modi. Lösung: Entferne %2$@ aus der Session oder verwende ein Raw-USB-Protokoll.";
/* Error E5007, shown when a record or protocol description breaks a rule: raw-USB startup writes are in a mode whose family does not read them or that lists initialization. %1$@ is the file. */
"error.E5007.session.usbStartup" = "%1$@, session.startup: Raw-USB-Startschreibvorgänge brauchen eine Familie, die sie liest, und einen Modus ohne Initialisierungsliste. Lösung: Entferne die Raw-USB-Startschreibvorgänge oder verwende eine Familie, die sie liest, und lass die Initialisierungsliste weg.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is not the kind of packet its protocol uses. %1$@ is the file. */
"error.E5007.rumble.templateKind" = "%1$@, session.rumble: Eine Rumble-Vorlage ist für ein Raw-USB-Protokoll ein usb-Paket und für ein HID-Protokoll ein HID-Report. Lösung: Schreibe die Vorlage als die Paketart, die das Protokoll verwendet.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is in a family whose driver does not encode it. %1$@ is the file. */
"error.E5007.rumble.templateDriver" = "%1$@, session.rumble: Rumble-Vorlagen brauchen einen Treiber, der sie kodiert. Lösung: Entferne die Rumble-Vorlage oder verwende eine Familie, deren Treiber sie kodiert.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is beside a session keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: Ein Rumble-resendIntervalMilliseconds lässt sich nicht mit einem session keepAlive kombinieren. Lösung: Entferne resendIntervalMilliseconds oder das session keepAlive.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is in a family that declares its own keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithFamilyKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: Ein Rumble-resendIntervalMilliseconds braucht eine Familie, deren Beschreibung kein keepAlive deklariert. Lösung: Entferne resendIntervalMilliseconds, denn das Keep-alive der Familie bestimmt das Timing.";
/* Error E5007, shown when a record or protocol description breaks a rule: a record has no mode. %1$@ is the file. */
"error.E5007.modes.empty" = "%1$@, modes: Modes muss mindestens einen Modus enthalten. Lösung: Füge einen Modus hinzu.";
/* Error E5007, shown when a record or protocol description breaks a rule: more than one mode has the id default. %1$@ is the file. */
"error.E5007.modes.defaultCount" = "%1$@, modes: Höchstens ein Modus hat die ID default. Lösung: Gib die ID default nur einem Modus.";
/* Error E5007, shown when a record or protocol description breaks a rule: two modes share an id. %1$@ is the file. */
"error.E5007.modes.uniqueIDs" = "%1$@, modes: Jede Modus-ID muss eindeutig sein. Lösung: Benenne die Modi um, die eine ID wiederholen.";
/* Error E5007, shown when a record or protocol description breaks a rule: a raw-USB mode names an interface. %1$@ is the file. */
"error.E5007.modes.interfaceRawUSB" = "%1$@, modes[].interface: Ein Raw-USB-Modus hat kein interface, weil er die Schnittstelle belegt, die sein usb-Transport auflöst. Lösung: Entferne interface aus dem Modus.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names endpoints in its interfaceSignature. %1$@ is the file. */
"error.E5007.modes.endpointsHID" = "%1$@, modes[].match.interfaceSignature.endpoints: Die interfaceSignature eines HID-Modus hat keine endpoints, weil nur der Raw-USB-Scanner einen Endpunktsatz liest. Lösung: Entferne endpoints aus der interfaceSignature.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode that needs input layouts finds none in the record. %1$@ is the file. */
"error.E5007.modes.inputLayoutNeeded" = "%1$@, input: Ein HIDReportLayout-Modus braucht die Eingabelayouts des Eintrags. Lösung: Füge input mit den Layouts hinzu oder verwende ein anderes Protokoll.";
