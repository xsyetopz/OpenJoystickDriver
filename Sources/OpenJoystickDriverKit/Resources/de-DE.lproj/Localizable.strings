/* Help text of the --json flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.json" = "JSON auf stdout ausgeben.";
/* Help text of the --no-color flag that every command takes. */
"cli.shared.option.noColor" = "Keine Farben verwenden.";
/* Help text of the --no-input flag that every command takes. */
"cli.shared.option.noInput" = "Nie nachfragen; bei fehlendem Wert fehlschlagen.";
/* Help text of the --plain flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.plain" = "Tabulatorgetrennte Datensätze auf stdout ausgeben.";
/* Help text of the --quiet flag that every command takes. stderr is the standard error stream and stays as written. */
"cli.shared.option.quiet" = "Keine Erfolgsmeldungen auf stderr ausgeben.";
/* Help text of the --timeout option that every command takes. %1$g is the default number of seconds for a service request and %2$g is the default for the service, virtual set and virtual reset commands, which stay as written in quotes. */
"cli.shared.option.timeout" = "Sekunden, die auf jede Dienstanfrage gewartet wird (Standard: %1$g), oder bis die Befehle „service“, „virtual set“ und „virtual reset“ abgeschlossen sind (Standard: %2$g).";
/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "OpenJoystickDriver, den Gamepad-Treiber für macOS, konfigurieren und prüfen.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Hier starten:\n  ojd status             Dienst, Erweiterung und Berechtigungen prüfen.\n  ojd diagnose           Alle Prüfungen ausführen und Fehler melden.\n  ojd controller list    Verbundene Controller auflisten.\n\nBeispiele:\n  # Eingaben eines Controllers bei jeder Änderung ausgeben\n  ojd controller watch 045E:028E\n  # Verbundene Controller als JSON auflisten\n  ojd --json controller list\n\nUmgebung (eine Option hat Vorrang vor ihrer Variable):\n  OJD_NO_INPUT=1         Wie --no-input.\n  OJD_TIMEOUT=SECONDS    Wie --timeout.\n  OJD_COLOR=WHEN         auto, always (auch ohne Terminal farbig) oder never.\n\nShell-Vervollständigung:\n  ojd --generate-completion-script zsh|bash|fish\n\nExit-Codes:\n  0    Erfolg.\n  1    Der Befehl ist fehlgeschlagen.\n  64   Verwendungsfehler.\n  69   Der Dienst läuft nicht. Starte ihn mit „ojd service start“.\n  77   Eine macOS-Berechtigung fehlt.\n  127  Ein Repository-Build konnte den Befehl nicht an die installierte App übergeben.\n  130  Unterbrochen.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Jeder Befehl akzeptiert auch die globalen Optionen; „ojd --help“ listet sie auf.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT erwartet eine Anzahl von Sekunden größer als 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR erwartet auto, always oder never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT erwartet 1, true, yes, 0, false oder no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain gilt nicht für „virtual feed“, das JSON-Zeilen ausgibt. Lass --plain weg.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Beispiele:\n  # Eingaben 10 Sekunden lang ausgeben\n  ojd controller watch 045E:028E --duration 10\n  # Das erste gedrückte Bedienelement als JSON ausgeben\n  ojd controller watch 045E:028E --first-press --json\n  # Alle Controller und die Ausgabe ihres virtuellen Gamepads beobachten\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Beispiele:\n  # Beide Hauptmotoren 0,45 Sekunden lang mit 180 laufen lassen\n  ojd controller rumble 045E:028E\n  # Beide Hauptmotoren 2 Sekunden lang mit voller Stärke laufen lassen\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Beispiele:\n  # Die Lightbar auf Orange setzen\n  ojd controller light 054C:09CC --color FF8000\n  # Farbe und eine niedrige Helligkeit setzen\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Beispiele:\n  # Ein Profil für ein Controller-Modell erstellen\n  ojd profile create Racing --controller 045E:028E\n  # Es nur anwenden, solange Safari im Vordergrund ist\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Beispiele:\n  # Ein Profil umbenennen\n  ojd profile set Racing name Rally\n  # Die innere Totzone der ersten Stick-Zuordnung setzen\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Beispiele:\n  # Leertaste halten, solange die südliche Taste gehalten wird\n  ojd binding set Racing button:south key:space\n  # J bei jedem Drücken umschalten\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # J 10-mal pro Sekunde wiederholen, solange die Taste gehalten wird\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Beispiele:\n  # Eine Record-Datei installieren\n  ojd record install 045e-028e.plist\n  # Den Record von stdin lesen\n  ojd record install - < 045e-028e.plist";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Beispiele:\n  # Einem Programm die Nutzung des Dienstes erlauben\n  ojd access grant /Applications/Example.app\n  # Ein Token für Seiten erstellen, die von einem Ursprung ausgeliefert werden\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "Den Dienst von OpenJoystickDriver starten oder stoppen, oder warten, bis er Anfragen annimmt.";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "Der Dienst läuft.";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "Die App im Hintergrund öffnen und warten, bis ihr Dienst Anfragen annimmt.";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "Dieses ojd befindet sich nicht in OpenJoystickDriver.app und kann den Dienst daher nicht starten. Öffne die installierte App oder führe das ojd darin aus.";
/* Error of 'ojd service start' when macOS cannot open the app. %@ is the path of the app. Finder is the macOS file manager. */
"platform.macos.cli.service.start.openFailed" = "macOS konnte %@ nicht öffnen. Öffne es im Finder, um den Grund zu sehen.";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "Den Dienst stoppen und warten, bis er beendet ist. Verbundene Controller gehen an macOS zurück.";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "Der Dienst konnte nicht gestoppt werden: %@. Beende OpenJoystickDriver über sein Menü.";
/* Error of 'ojd service stop' when the service keeps running. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.service.stop.timeout" = "Der Dienst wurde nicht innerhalb von %@ gestoppt. Versuche es mit einem größeren --timeout erneut.";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "Der Dienst ist gestoppt.";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "Warten, bis der Dienst Anfragen annimmt. --timeout begrenzt die Wartezeit (Standard: 5 Sekunden).";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "Der Dienst hat nicht innerhalb von %@ Anfragen angenommen. Starte ihn mit „ojd service start“ oder versuche es mit einem größeren --timeout erneut.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Dienst, Erweiterung, Berechtigungen und verbundene Controller anzeigen.";
/* Long description in the help of 'ojd status'. It says that the command also works while the service is stopped. The exit status 0 stays as written. */
"cli.status.group.discussion" = "Funktioniert auch bei gestopptem Dienst: Er wird als gestoppt gemeldet und mit 0 beendet.";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "Bedienungshilfen";
/* Row label in the output of 'ojd status'. The version of this command line tool follows. */
"cli.status.group.labelCommandLineTool" = "Befehlszeilenwerkzeug";
/* Heading in the output of 'ojd status' above the list of connected controllers. %lld is the number of controllers. */
"cli.status.group.labelControllers" = "Controller (%lld)";
/* Row label in the output of 'ojd status'. The state of the driver extension follows. */
"cli.status.group.labelTransportExtension" = "Erweiterung";
/* Row label in the output of 'ojd status' for the Input Monitoring permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputRead" = "Eingabeüberwachung";
/* Row label in the output of 'ojd status'. The reason why the stored profile overrides could not be read follows. */
"cli.status.group.labelOverrideError" = "Überschreibungsfehler";
/* Heading in the output of 'ojd status' above the list of controllers that macOS serves natively. %lld is the number of controllers. */
"platform.macos.cli.status.group.labelPassThrough" = "macOS überlassen (%lld)";
/* Row label in the output of 'ojd status'. The state and version of the service follow. */
"cli.status.group.labelService" = "Dienst";
/* Heading in the output of 'ojd status' above the list of connected devices that the driver does not support. %lld is the number of devices. */
"cli.status.group.labelUnbound" = "Nicht unterstützte Geräte (%lld)";
/* Row label in the output of 'ojd status'. The state of the virtual gamepad follows. */
"cli.status.group.labelVirtualDevice" = "Virtuelles Gamepad";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is turned off. */
"cli.status.group.virtualOff" = "Aus";
/* Value of the 'Virtual gamepad' row of 'ojd status' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.status.group.virtualError" = "Fehler: %@";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on and no connected controller has a virtual gamepad. */
"cli.status.group.virtualNonePublished" = "Ein, kein Controller veröffentlicht";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on. %@ is the comma-separated list of the names of the controllers that a virtual gamepad stands for. */
"cli.status.group.virtualPublished" = "Ein, veröffentlicht %@";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "Controller und Berechtigungen erscheinen, sobald der Dienst läuft: „ojd service start“.";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "Schalte den Endpunkt ein und wähle, welche Programme darüber Controller lesen dürfen.";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "Der Pfad des Programms oder eine Client-ID.";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "Unter %@ gibt es kein Programm und keinen Client mit dieser ID. Die IDs zeigt „ojd access list“.";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ enthält kein signiertes Programm. Erteile dem App-Bundle oder der ausführbaren Datei des Programms die Freigabe.";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "Schalte den Endpunkt aus und schließe seine Verbindungen; erteilte Freigaben bleiben erhalten.";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "Der Endpunkt ist aus, und seine Verbindungen sind geschlossen.";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "Der Endpunkt ist ein lokaler Socket, über den freigegebene Programme Controller-Ereignisse lesen. Er ist aus, bis du „ojd access enable“ ausführst, und der Dienst bedient nur Programme, deren Signatur du freigegeben hast, oder die ein Token senden, das du freigegeben hast. „ojd access web enable“ fügt einen WebSocket auf 127.0.0.1 für Overlay-Seiten hinzu.";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "Schalte den Endpunkt ein.";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "Den Endpunkt einschalten, damit die von dir freigegebenen Programme die Eingaben aller Controller lesen können?";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "Fragt zuerst nach einer Bestätigung. Nur freigegebene Programme können den Endpunkt nutzen; füge sie mit „ojd access grant“ hinzu.";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "Der Endpunkt lauscht auf %@.";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "Erlaubt einem signierten Programm oder einem neuen Token, den Endpunkt zu nutzen.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ ist ad hoc signiert oder nicht signiert, daher kann jedes lokale Programm seine Signatur beanspruchen. Signiere es mit einem Developer-ID- oder Apple-Development-Zertifikat und erteile ihm dann die Freigabe.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "Apple hat dieses Programm signiert. Wenn es Skripte ausführt, etwa python3 oder osascript, erhält jedes Skript, das es ausführt, diesen Zugriff.";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "Gib entweder CLIENT oder --token NAME an.";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "%1$@, signiert als %2$@, die Nutzung des Endpunkts mit %3$@ erlauben?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
"cli.access.grant.controlWarning" = "Der Bereich control erlaubt dem Programm, Tasten auf einem virtuellen Gamepad zu drücken, was Spiele und Apps als deine Eingabe behandeln.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT ist der Pfad des Programms oder eine ID aus „ojd access list“. Die Freigabe nennt die Signatur des Programms und bleibt daher gültig, wenn das Programm aktualisiert oder verschoben wird. Ad hoc signierte und nicht signierte Programme können nicht freigegeben werden. Mit --token statt CLIENT wird ein Token erstellt, mit dem ein Client die Challenge des Dienstes in seinem hello signiert, über den Socket, über den WebSocket von einer Seite eines der --origin-Werte oder, bei einem Token ohne --origin, über den WebSocket von einem Programm, das keinen Origin-Header sendet, etwa einer Sandbox-App. Eine Seite kann den Bereich control nicht verwenden. Das Token wird nur einmal angezeigt. Fragt zuerst nach einer Bestätigung.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Ein Web-Ursprung, z. B. http://127.0.0.1:8080, dessen Seiten das Token über den WebSocket nutzen dürfen. Wiederhole die Option, um weitere hinzuzufügen. Die Overlay-Seiten, die der WebSocket ausliefert, haben den Ursprung http://127.0.0.1:PORT, mit dem Port, den „ojd access status“ anzeigt.";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin lässt sich nicht mit dem Bereich control kombinieren. Eine Seite steuert nie ein virtuelles Gamepad; erteile control einem Token ohne --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin erfordert --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Ein Bereich, der erteilt wird: read oder control. Für beide wiederholen.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "%1$@ für %2$@ erteilt (ID %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Erstellt ein Token mit diesem Namen, statt ein Programm freizugeben.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "Token %1$@ mit %2$@ für Programme auf diesem Mac erstellen?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "%1$@ für Token %2$@ freigegeben (ID %3$@). Halte das Token geheim; es wird nicht noch einmal angezeigt:";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "Token %1$@ mit %2$@ für Programme auf diesem Mac und für Seiten von %3$@ erstellen?";
/* One-line summary of 'ojd access list' in the command list and at the top of its help. */
"cli.access.list.abstract" = "Listet freigegebene Clients und Tokens sowie die in den letzten 24 Stunden abgelehnten auf.";
/* Long description in the help of 'ojd access list'. It says that the printed IDs work with 'ojd access grant' and 'ojd access revoke'. token:NAME stays as written. */
"cli.access.list.discussion" = "Jeder Client hat eine ID, die „ojd access grant“ und „ojd access revoke“ akzeptieren; die ID eines Tokens ist token:NAME.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Freigegeben:";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Keine";
/* Heading of the list of clients that connected and were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refused" = "In den letzten 24 Stunden abgelehnt:";
/* Heading of the list of tokens that were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refusedTokens" = "In den letzten 24 Stunden abgelehnte Tokens:";
/* Heading of the list of granted tokens printed by 'ojd access list'. */
"cli.access.list.tokens" = "Freigegebene Tokens:";
/* Lowercase placeholder printed in the token list when a refused token has no name. */
"cli.access.list.unknownToken" = "unbekanntes Token";
/* Error of 'ojd access' commands that change who may read the controllers, when the input is not a terminal and --force is missing. --force stays as written. */
"cli.access.group.needsForce" = "Diese Änderung gibt Programmen Zugriff auf deine Controller. Füge --force hinzu, um sie ohne Rückfrage zu bestätigen.";
/* One-line summary of 'ojd access revoke' in the command list and at the top of its help. */
"cli.access.revoke.abstract" = "Entfernt die Freigabe eines Programms oder einzelne ihrer Bereiche.";
/* Help text of the CLIENT argument of 'ojd access revoke'. token:NAME stays as written. */
"cli.access.revoke.client" = "Der Pfad des Programms, eine Client-ID oder token:NAME.";
/* Long description in the help of 'ojd access revoke'. CLIENT, --scope, 'ojd access list' and token:NAME stay as written. */
"cli.access.revoke.discussion" = "CLIENT ist der Pfad des Programms, eine ID aus „ojd access list“ oder token:NAME für ein Token. Ohne --scope wird die gesamte Freigabe entfernt. Verbindungen, die einen Bereich verlieren, werden geschlossen.";
/* Message printed after 'ojd access revoke --scope' removed some scopes. %1$@ is the client ID, %2$@ is the list of scopes it keeps and %3$@ is the number of connections that were closed. */
"cli.access.revoke.partial" = "Client %1$@ behält %2$@. Geschlossene Verbindungen: %3$@.";
/* Help text of the --scope option of 'ojd access revoke'. The values read and control stay as written because the user types them. */
"cli.access.revoke.scope" = "Ein Bereich, der entfernt wird: read oder control. Für beide wiederholen.";
/* Message printed after 'ojd access revoke' removed a whole grant. %1$@ is the client ID and %2$@ is the number of connections that were closed. */
"cli.access.revoke.success" = "Die Freigabe von Client %1$@ wurde entfernt. Geschlossene Verbindungen: %2$@.";
/* One-line summary of 'ojd access status' in the command list and at the top of its help. */
"cli.access.status.abstract" = "Zeigt, ob der Endpunkt eingeschaltet ist, seinen Socket und seine verbundenen Clients.";
/* Line of 'ojd access status' with three counts. %1$@ is the number of connected clients, %2$@ the number of granted clients and %3$@ the number of clients refused in the last 24 hours. */
"cli.access.status.counts" = "Verbundene Clients: %1$@. Freigegebene Clients: %2$@. In den letzten 24 Stunden abgelehnt: %3$@.";
/* Line of 'ojd access status' when the endpoint is off. Keep the colon and the space after it. */
"cli.access.status.off" = "Endpunkt: aus";
/* Line of 'ojd access status' when the endpoint is on. Keep the colon and the space after it. */
"cli.access.status.on" = "Endpunkt: ein";
/* Line of 'ojd access status' that shows where the endpoint listens. %@ is the socket path. */
"cli.access.status.socket" = "Socket: %@";
/* Line of 'ojd access status' with two token counts. %1$@ is the number of granted tokens and %2$@ the number of tokens refused in the last 24 hours. */
"cli.access.status.tokenCounts" = "Freigegebene Tokens: %1$@. In den letzten 24 Stunden abgelehnte Tokens: %2$@.";
/* Line of 'ojd access status' when the WebSocket is turned on but its port could not be opened. %@ is the port number. */
