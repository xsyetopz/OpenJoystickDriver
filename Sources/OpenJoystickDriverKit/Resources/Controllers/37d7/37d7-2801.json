{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "Controller",
  "vendorID": 14295,
  "productID": 10241,
  "modes": [
    {
      "id": "default",
      "protocol": {
        "family": "XboxGIP"
      },
      "session": {
        "settleMilliseconds": 200
      }
    },
    {
      "id": "xusb",
      "protocol": {
        "family": "XboxXUSB",
        "variant": "Wired"
      },
      "match": {
        "interfaceSignature": {
          "interfaceClass": 255,
          "interfaceSubclass": 93,
          "interfaceProtocol": 1
        }
      }
    }
  ],
  "usb": {
    "endpoints": {
      "in": 129,
      "out": 1
    },
    "configuration": "SetConfiguration1BeforeClaim"
  }
}
