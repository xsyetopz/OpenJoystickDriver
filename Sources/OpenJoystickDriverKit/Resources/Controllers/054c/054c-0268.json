{
  "apiVersion": "openjoystickdriver/v1alpha2",
  "kind": "Controller",
  "vendorID": 1356,
  "productID": 616,
  "modes": [
    {
      "id": "default",
      "protocol": {
        "family": "SonySixaxis"
      }
    },
    {
      "id": "bluetooth",
      "protocol": {
        "family": "SonySixaxis"
      },
      "match": {
        "link": "BluetoothClassic"
      },
      "session": {
        "startup": [
          {
            "report": {
              "kind": "Feature",
              "id": 244,
              "length": 5
            },
            "bytes": "42 03 00 00"
          }
        ]
      }
    },
    {
      "id": "feature-ef-answers",
      "protocol": {
        "family": "SonySixaxis"
      },
      "match": {
        "probes": [
          {
            "report": 239,
            "length": 49,
            "expect": "Answers"
          }
        ]
      }
    }
  ]
}
