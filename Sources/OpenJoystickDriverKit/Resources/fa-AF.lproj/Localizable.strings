"error.E2003" = "در خط فرمان یک گزینه یا مقدار نادرست است یا وجود ندارد. فرمان را با --help اجرا کنید تا ببینید چه چیزی می‌پذیرد.";
"error.E2004" = "سرویس OpenJoystickDriver در حال اجرا نیست. آن را با «ojd service start» راه‌اندازی کنید.";
"error.E2005" = "سرویس به‌موقع پاسخ نداد. آن را با «ojd status» بررسی کنید یا با --timeout بیشتر صبر کنید.";
"error.E2006" = "سرویس درخواست را کامل نکرد. آن را با «ojd status» بررسی کنید و دوباره تلاش کنید.";
"error.E2007" = "سرویس این ojd را رد کرد، چون مانند برنامه امضا نشده است. ojd موجود در OpenJoystickDriver.app را اجرا کنید.";
"error.E2008" = "یک مجوز macOS وجود ندارد. آن را با «ojd permission request» بدهید.";
"error.E2009" = "این فرمان داده‌ها را تغییر می‌دهد یا حذف می‌کند و به تأیید نیاز دارد. آن را دوباره با --force اجرا کنید.";
"error.E2010" = "فرمان پیش از پایان متوقف شد، چون شما رد کردید، یک ویرایشگر شکست خورد یا ورودی‌ای نرسید. آن را دوباره اجرا کنید.";
"error.E2011" = "فایل پروفایل یا ضبط معتبر نیست. آن را طبق طرح‌واره‌اش اصلاح کنید و دوباره تلاش کنید.";
"error.E2012" = "هیچ دسته، پروفایل، نگاشت یا کلاینتی مطابقت ندارد، یا بیش از یکی مطابقت دارد. آن‌ها را با فرمان «list» مربوطه فهرست کنید و دقیقاً یکی را نام ببرید.";
"error.E2013" = "دسته در حال حاضر نمی‌تواند این کار را انجام دهد. ممکن است پشتیبانی نشود، آماده نباشد یا قطع شده باشد. آن را با «ojd controller list» بررسی کنید.";
"error.E2014" = "OpenJoystickDriver به‌طور کامل نصب نشده یا امضای آن معتبر نیست. برنامه را دوباره نصب کنید و «ojd diagnose» را اجرا کنید.";
"error.E2015" = "macOS درخواست را کامل یا اعمال نکرد. تنظیمات سیستم را بررسی کنید و دوباره تلاش کنید.";
"error.E2016" = "خواندن، نوشتن یا حذف یک فایل ممکن نبود، یا از قبل وجود دارد. مسیر و مجوزهای آن را بررسی کنید.";
"error.E2017" = "این کلاینت امضا نشده یا امضای ad hoc دارد، پس نمی‌توان به آن دسترسی داد. آن را با Developer ID امضا کنید و دوباره تلاش کنید.";
"error.E2018" = "«ojd diagnose» یک بررسی ناموفق پیدا کرد. خروجی آن را بخوانید و موارد ناموفق را برطرف کنید.";
"error.E2019" = "بررسی به‌روزرسانی کامل نشد. اتصال شبکه را بررسی کنید و دوباره تلاش کنید.";
"error.E2020" = "برنامهٔ نصب‌شدهٔ OpenJoystickDriver قدیمی‌تر از این ojd است. «./Scripts/ojd build install-fast dev» را اجرا کنید یا OJD_RUN_REPOSITORY_CLI=1 را تنظیم کنید تا این ساخت اجرا شود.";
"error.E2021" = "یک ساخت ojd از مخزن نتوانست فرمان را به برنامهٔ نصب‌شده بسپارد. OpenJoystickDriver.app را دوباره نصب کنید و فرمان را دوباره اجرا کنید.";
"error.E3001" = "دسته متصل نیست یا برای نگاشت مجدد آماده نیست. آن را دوباره وصل کنید و دوباره تلاش کنید.";
"error.E3002" = "جفت‌سازی Joy-Conهای انتخاب‌شده ممکن نبود. دسته‌های متصل را تازه کنید و دوباره تلاش کنید.";
"error.E3003" = "دسته داده‌های حرکتی گزارش نمی‌کند. دسته‌ای با حسگر حرکتی انتخاب کنید یا گزینه‌های حرکتی را خاموش بگذارید.";
"error.E3004" = "یکی از مقادیر درخواست بزرگ‌تر از چیزی است که سرویس می‌پذیرد. مقدار کوچک‌تری بفرستید.";
"error.E3005" = "فهرست پروفایل‌های فعال خراب است و بارگذاری نشد. فایل خراب را تعمیر یا حذف کنید و دوباره تلاش کنید.";
"error.E3006" = "پروفایلی با این نام از قبل وجود دارد. نام دیگری انتخاب کنید؛ «ojd profile list» نام‌های استفاده‌شده را نشان می‌دهد.";
"error.E3007" = "در درخواست آرگومان‌ها وجود ندارند یا نامعتبرند. مقادیر را بررسی کنید و دوباره تلاش کنید.";
"error.E3008" = "پروفایل معتبر نیست. نگاشت‌ها را بررسی کنید و دوباره تلاش کنید.";
"error.E3009" = "کتابخانهٔ پروفایل بیش از حد بزرگ می‌شود. پروفایل‌هایی را که نیاز ندارید حذف کنید و دوباره تلاش کنید.";
"error.E3010" = "پروفایلی با این شناسه از قبل وجود دارد. شناسهٔ جدیدی به کار ببرید یا پروفایل موجود را به‌روزرسانی کنید.";
"error.E3011" = "پروفایل پس از بارگذاری در جای دیگری تغییر کرد. آن را دوباره بارگذاری کنید و تغییر خود را دوباره انجام دهید.";
"error.E3012" = "کتابخانه از قبل بیشترین تعداد مجاز پروفایل را دارد. پروفایلی را که نیاز ندارید حذف کنید و دوباره تلاش کنید.";
"error.E3013" = "هیچ پروفایلی این شناسه را ندارد. پروفایل‌ها را با «ojd profile list» فهرست کنید.";
"error.E3014" = "سرویس نتوانست پاسخ خود را کدگذاری کند. دوباره تلاش کنید و اگر ادامه یافت مشکل را گزارش دهید.";
"error.E3015" = "پاسخ بزرگ‌تر از چیزی است که سرویس می‌تواند بفرستد. داده‌های کمتری بخواهید و دوباره تلاش کنید.";
"error.E3016" = "موتور نگاشت مجدد در دسترس نیست. کمی صبر کنید و دوباره تلاش کنید، یا سرویس را دوباره راه‌اندازی کنید.";
"error.E3017" = "کتابخانهٔ پروفایل و موتور نگاشت مجدد در دسترس نیستند. کمی صبر کنید و دوباره تلاش کنید، یا سرویس را دوباره راه‌اندازی کنید.";
"error.E3018" = "کتابخانهٔ پروفایل در دسترس نیست. کمی صبر کنید و دوباره تلاش کنید، یا سرویس را دوباره راه‌اندازی کنید.";
"error.E3019" = "مسیریاب نگاشت مجدد خاموش شده است. سرویس را دوباره راه‌اندازی کنید و دوباره تلاش کنید.";
"error.E3020" = "سرویس نتوانست تأیید کند که آخرین تغییر پروفایل ذخیره شده است یا نه. پروفایل‌ها را دوباره بارگذاری و بررسی کنید و سپس دوباره تغییر دهید.";
"error.E3021" = "خواندن یک فایل پروفایل ممکن نبود. بررسی کنید فایل وجود دارد و سرویس می‌تواند آن را بخواند.";
"error.E3022" = "فایل‌های پروفایل خراب باید پیش از تغییر پروفایل‌ها تعمیر یا حذف شوند. آن‌ها را تعمیر یا حذف کنید و دوباره تلاش کنید.";
"error.E3023" = "نوشتن یک فایل پروفایل ممکن نبود. فضای آزاد دیسک و مجوزهای پوشه را بررسی کنید.";
"error.E3024" = "سرویس نگاشت مجدد با خطایی روبه‌رو شد که آن را نمی‌شناسد. «ojd diagnose» را اجرا کنید و مشکل را همراه با خروجی آن گزارش دهید.";
