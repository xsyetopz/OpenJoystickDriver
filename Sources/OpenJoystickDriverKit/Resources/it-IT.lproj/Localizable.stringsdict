<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d controller collegato</string>
			<key>zero</key>
			<string>%d controller collegati</string>
			<key>two</key>
			<string>%d controller collegati</string>
			<key>few</key>
			<string>%d controller collegati</string>
			<key>many</key>
			<string>%d di controller collegati</string>
			<key>other</key>
			<string>%d controller collegati</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d assegnazione</string>
			<key>zero</key>
			<string>%d assegnazioni</string>
			<key>two</key>
			<string>%d assegnazioni</string>
			<key>few</key>
			<string>%d assegnazioni</string>
			<key>many</key>
			<string>%d di assegnazioni</string>
			<key>other</key>
			<string>%d assegnazioni</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Nessun dispositivo di output del controller rilevato</string>
			<key>one</key>
			<string>%d dispositivo di output del controller rilevato</string>
			<key>two</key>
			<string>%d dispositivi di output del controller rilevati</string>
			<key>few</key>
			<string>%d dispositivi di output del controller rilevati</string>
			<key>many</key>
			<string>%d di dispositivi di output del controller rilevati</string>
			<key>other</key>
			<string>%d dispositivi di output del controller rilevati</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>«%1$@» corrisponde a %2$lld controller. Usa uno di questi ID:</string>
			<key>many</key>
			<string>«%1$@» corrisponde a %2$lld di controller. Usa uno di questi ID:</string>
			<key>other</key>
			<string>«%1$@» corrisponde a %2$lld controller. Usa uno di questi ID:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>«%1$@» indica %2$lld profilo. Usa uno di questi ID:</string>
			<key>many</key>
			<string>«%1$@» indica %2$lld di profili. Usa uno di questi ID:</string>
			<key>other</key>
			<string>«%1$@» indica %2$lld profili. Usa uno di questi ID:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>--soak con questo --interval-ms richiederebbe %lld campione; aumenta --interval-ms.</string>
			<key>many</key>
			<string>--soak con questo --interval-ms richiederebbe %lld di campioni; aumenta --interval-ms.</string>
			<key>other</key>
			<string>--soak con questo --interval-ms richiederebbe %lld campioni; aumenta --interval-ms.</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Il campionamento richiederebbe %lld campione. Aumenta l’intervallo di campionamento.</string>
			<key>many</key>
			<string>Il campionamento richiederebbe %lld di campioni. Aumenta l’intervallo di campionamento.</string>
			<key>other</key>
			<string>Il campionamento richiederebbe %lld campioni. Aumenta l’intervallo di campionamento.</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Questa esecuzione richiederebbe %lld campione. Aumenta l’intervallo di campionamento.</string>
			<key>many</key>
			<string>Questa esecuzione richiederebbe %lld di campioni. Aumenta l’intervallo di campionamento.</string>
			<key>other</key>
			<string>Questa esecuzione richiederebbe %lld campioni. Aumenta l’intervallo di campionamento.</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ corrisponde allo stato atteso: %2$lld report di input riprodotto.</string>
			<key>many</key>
			<string>%1$@ corrisponde allo stato atteso: %2$lld di report di input riprodotti.</string>
			<key>other</key>
			<string>%1$@ corrisponde allo stato atteso: %2$lld report di input riprodotti.</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Lo stato prodotto dal parser di %1$@ differisce da %2$@ in %3$lld campo.</string>
			<key>many</key>
			<string>Lo stato prodotto dal parser di %1$@ differisce da %2$@ in %3$lld di campi.</string>
			<key>other</key>
			<string>Lo stato prodotto dal parser di %1$@ differisce da %2$@ in %3$lld campi.</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pacchetto inattivo nascosto (ancora incluso nell’esportazione).</string>
			<key>many</key>
			<string>%lld di pacchetti inattivi nascosti (ancora inclusi nell’esportazione).</string>
			<key>other</key>
			<string>%lld pacchetti inattivi nascosti (ancora inclusi nell’esportazione).</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Italian plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Interrotto · %lld pacchetto</string>
			<key>many</key>
			<string>Interrotto · %lld di pacchetti</string>
			<key>other</key>
			<string>Interrotto · %lld pacchetti</string>
		</dict>
	</dict>
</dict>
</plist>
