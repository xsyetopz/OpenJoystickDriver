/* One-line summary of 'ojd transport-extension deactivate' in the command list and at the top of its help. */
"platform.macos.cli.transportExtension.deactivate.abstract" = "Chiede a macOS di disattivare l’estensione. I controller tornano a macOS.";
/* Long description in the help of 'ojd transport-extension deactivate'. The ojd program and the path stay as written. */
"cli.transportExtension.deactivate.discussion" = "Esegui ojd dall’interno di /Applications/OpenJoystickDriver.app.";
/* Message printed after 'ojd transport-extension deactivate' when the driver extension is inactive. */
"cli.transportExtension.group.deactivated" = "L’estensione non è attiva.";
/* Error of 'ojd transport-extension' commands when ojd runs from a folder other than Applications. %@ is the path of this ojd. The path of the installed app stays as written. */
"cli.transportExtension.group.notInstalled" = "Questo ojd viene eseguito da %@, non da /Applications. Esegui ojd dall’interno di /Applications/OpenJoystickDriver.app.";
/* Error of 'ojd transport-extension' commands when the app code signature is not valid. %@ is the description of the signature problem. The build command stays as written. */
"cli.transportExtension.group.signatureInvalid" = "La firma dell’app non è valida (%@). Ricostruiscila con «just install-fast-dev», poi riprova.";
