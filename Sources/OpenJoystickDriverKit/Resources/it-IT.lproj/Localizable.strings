"cli.root.abstract" = "Configura e ispeziona OpenJoystickDriver, il driver per gamepad di macOS.";
"cli.root.discussion" = "Da qui si parte:\n  ojd status             Controlla servizio, estensione e permessi.\n  ojd diagnose           Esegue ogni controllo e segnala i problemi.\n  ojd controller list    Elenca i controller collegati.\n\nEsempi:\n  # Mostra l’input di un controller mentre cambia\n  ojd controller watch 045E:028E\n  # Elenca i controller collegati come JSON\n  ojd --json controller list\n\nAmbiente (un’opzione ha la precedenza sulla variabile):\n  OJD_NO_INPUT=1         Come --no-input.\n  OJD_TIMEOUT=SECONDS    Come --timeout.\n  OJD_COLOR=WHEN         auto, always (colore anche fuori da un terminale) o never.\n\nCompletamento della shell:\n  ojd --generate-completion-script zsh|bash|fish\n\nCodici di uscita:\n  0    Operazione riuscita.\n  1    Il comando non è riuscito.\n  64   Errore di utilizzo.\n  69   Il servizio non è in esecuzione. Avvialo con «ojd service start».\n  77   Manca un’autorizzazione di macOS.\n  127  Una build del repository non ha passato il comando all’app installata.\n  130  Interrotto.";
"cli.help.global_options" = "Ogni comando accetta anche le opzioni globali; «ojd --help» le elenca.";
"cli.error.env_timeout" = "OJD_TIMEOUT richiede un numero di secondi maggiore di 0.";
"cli.error.env_color" = "OJD_COLOR richiede auto, always o never.";
"cli.error.env_no_input" = "OJD_NO_INPUT richiede 1, true, yes, 0, false o no.";
"cli.virtual.feed.error.plain" = "--plain non si applica a «virtual feed», che stampa righe JSON. Ometti --plain.";
"cli.controller.watch.examples" = "Esempi:\n  # Mostra l’input per 10 secondi\n  ojd controller watch 045E:028E --duration 10\n  # Mostra il primo controllo premuto, come JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Osserva ogni controller e ciò che invia il suo gamepad virtuale\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Esempi:\n  # Aziona entrambi i motori principali a 180 per 0,45 secondi\n  ojd controller rumble 045E:028E\n  # Aziona entrambi i motori principali a piena potenza per 2 secondi\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Esempi:\n  # Imposta la barra luminosa su arancione\n  ojd controller light 054C:09CC --color FF8000\n  # Imposta il colore e una luminosità bassa\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Esempi:\n  # Crea un profilo per un modello di controller\n  ojd profile create Racing --controller 045E:028E\n  # Applicalo solo quando Safari è in primo piano\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Esempi:\n  # Rinomina un profilo\n  ojd profile set Racing name Rally\n  # Imposta la zona morta interna della prima mappatura dello stick\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Esempi:\n  # Tieni premuto Spazio mentre il pulsante sud è premuto\n  ojd binding set Racing button:south key:space\n  # Attiva/disattiva J a ogni pressione\n  ojd binding set Racing button:west key:j --behavior toggle\n  # Ripeti J 10 volte al secondo finché è premuto\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Esempi:\n  # Installa un file di registrazione\n  ojd record install 045E-028E.json\n  # Leggi la registrazione dallo stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Esempi:\n  # Consenti a un programma di usare il servizio\n  ojd access grant /Applications/Example.app\n  # Crea un token per le pagine servite da una sola origine\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
