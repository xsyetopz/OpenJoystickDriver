"cli.transportExtension.status.bundle" = "Estensione incorporata:  %@";
/* Long description in the help of 'ojd transport-extension status'. present, missing, invalid, active, inactive, absent and unavailable are values the command prints and stay as written. */
"cli.transportExtension.status.discussion" = "Il bundle è present, missing o invalid. La registrazione è active, inactive, absent o unavailable; unavailable termina con codice 1. Funziona anche con il servizio fermo.";
/* Row of 'ojd transport-extension status'. %@ is the registration state: active, inactive, absent or unavailable. Keep the two spaces after the colon. */
"platform.macos.cli.transportExtension.status.registration" = "Registrazione macOS:  %@";
