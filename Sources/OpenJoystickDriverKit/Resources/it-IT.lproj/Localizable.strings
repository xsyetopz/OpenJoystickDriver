/* Error of 'ojd transport-extension' when macOS does not finish the request in time. System Settings is the name of the macOS app. The command in quotes stays as written. */
"platform.macos.cli.transportExtension.group.timeout" = "macOS non ha completato la richiesta in tempo. Controlla in Impostazioni di Sistema se c’è una richiesta di approvazione, poi esegui «ojd transport-extension status».";
/* One-line summary of 'ojd log' in the command list and at the top of its help. */
"cli.log.group.abstract" = "Mostra i log del servizio o stampa dove si trovano.";
/* One-line summary of 'ojd log path' in the command list and at the top of its help. The command line after 'Open it with:' stays as written, including the backslashes before the quotes. */
"cli.log.path.abstract" = "Stampa la cartella che contiene i log del servizio. Aprila con: open \"$(ojd log path)\"";
