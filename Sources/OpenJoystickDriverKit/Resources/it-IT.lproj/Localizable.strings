"error.E5007.usageMap.mapEmpty" = "%1$@, input.hidUsageMap.usages: una mappa di usi deve elencare almeno un uso. Correzione: aggiungi un uso o elimina hidUsageMap.";
/* Error E5007, shown when the HID usage map of a record fails: two entries of one usage name the same half. %2$@ is the usage as page/usage, %3$@ the half. %1$@ is the file. */
"error.E5007.usageMap.halfTwice" = "%1$@, input.hidUsageMap.usages[].half: l’uso %2$@ nomina due volte la metà %3$@. Correzione: dai una sola voce a ogni metà di un uso.";
/* Error E5007, shown when the HID usage map of a record fails: a usage is named twice. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.usageTwice" = "%1$@, input.hidUsageMap.usages[]: l’uso %2$@ è nominato due volte, e solo le voci delle sue due metà possono condividere un uso. Correzione: nomina ogni uso una volta o dai alle voci le metà Positive e Negative.";
/* Error E5007, shown when the HID usage map of a record fails: a Button entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonControl" = "%1$@, input.hidUsageMap.usages[].control: l’uso %2$@ è un pulsante, e %3$@ non è un controllo pulsante. Correzione: indica un controllo pulsante o usa un altro tipo di voce.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis entry names a control that is not a stick axis or trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisControl" = "%1$@, input.hidUsageMap.usages[].control: l’uso %2$@ è un asse, e %3$@ non è un asse della levetta né un grilletto. Correzione: indica un asse della levetta o un grilletto, oppure usa un altro tipo di voce.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis range has min at or above max. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.rangeOrder" = "%1$@, input.hidUsageMap.usages[].range: l’intervallo dell’uso %2$@ deve avere min sotto max. Correzione: imposta min sotto max.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis deadZone is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.deadZone" = "%1$@, input.hidUsageMap.usages[].deadZone: deadZone dell’uso %2$@ deve essere sopra 0 e sotto 1. Correzione: imposta deadZone sopra 0 e sotto 1.";
/* Error E5007, shown when the HID usage map of a record fails: a Hat range is not 0...7 or 1...8. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.hatRange" = "%1$@, input.hidUsageMap.usages[].range: l’intervallo hat dell’uso %2$@ deve essere 0...7 o 1...8. Correzione: imposta range su 0...7 o 1...8, oppure omettilo.";
/* Error E5007, shown when the HID usage map of a record fails: a HalfAxis entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.halfAxisControl" = "%1$@, input.hidUsageMap.usages[].control: l’uso %2$@ è un semiasse, e %3$@ non è un grilletto. Correzione: indica LeftTrigger o RightTrigger.";
/* Error E5007, shown when the HID usage map of a record fails: a ButtonTrigger entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonTriggerControl" = "%1$@, input.hidUsageMap.usages[].control: l’uso %2$@ è un grilletto a pulsante, e %3$@ non è un grilletto. Correzione: indica LeftTrigger o RightTrigger, oppure usa un altro tipo di voce.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad entry names a control that is not a D-pad direction. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisDpadControl" = "%1$@, input.hidUsageMap.usages[].control: l’uso %2$@ è una croce ad asse, e %3$@ non è una direzione della croce. Correzione: indica DpadUp, DpadDown, DpadLeft o DpadRight.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisButton entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisButtonControl" = "%1$@, input.hidUsageMap.usages[].control: l’uso %2$@ è un pulsante ad asse, e %3$@ non è un controllo pulsante. Correzione: indica un controllo pulsante o usa un altro tipo di voce per l’asse.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad or AxisButton threshold is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.threshold" = "%1$@, input.hidUsageMap.usages[].threshold: threshold dell’uso %2$@ deve essere sopra 0 e sotto 1. Correzione: imposta threshold sopra 0 e sotto 1.";
/* Error E5007, shown when a startup write of a record fails: a startup write names an input report. %1$@ is the file. */
"error.E5007.startupWrite.reportKind" = "%1$@, session.startup[].report: una scrittura di avvio non può inviare un report di ingresso. Correzione: imposta report su un report di uscita o di funzionalità.";
/* Error E5007, shown when a startup write of a record fails: a startup report is not 2...128 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.reportLength" = "%1$@, session.startup[].report: un report di avvio deve essere lungo 2...128 byte. Correzione: dai al report una lunghezza di 2...128 byte.";
/* Error E5007, shown when a startup write of a record fails: a startup write lists the wrong number of bytes. %2$@ is the number of bytes the report takes after its ID. %1$@ is the file. */
"error.E5007.startupWrite.bytesCount" = "%1$@, session.startup[].bytes: una scrittura di avvio deve elencare %2$@ byte, tutti quelli dopo l’ID del report. Correzione: dai a bytes esattamente %2$@ byte.";
/* Error E5007, shown when a startup write of a record fails: a startup delay is outside 0...1000 ms. %1$@ is the file. */
"error.E5007.startupWrite.delay" = "%1$@, session.startup[].delayMilliseconds: un ritardo di avvio deve essere di 0...1000 ms. Correzione: imposta delayMilliseconds su 0...1000, oppure omettilo.";
/* Error E5007, shown when a startup write of a record fails: a startup transport is not USB, BluetoothClassic or BluetoothLE. %1$@ is the file. */
"error.E5007.startupWrite.transport" = "%1$@, session.startup[].transport: un trasporto di avvio deve essere USB, BluetoothClassic o BluetoothLE. Correzione: imposta transport su uno di questi, oppure omettilo.";
/* Error E5007, shown when a startup write of a record fails: a startup report with crc32Seed has no room for its 4-byte trailer. %1$@ is the file. */
"error.E5007.startupWrite.crcRoom" = "%1$@, session.startup[].crc32Seed: un report di avvio con crc32Seed deve avere spazio per la sua coda di 4 byte. Correzione: rendi il report più lungo di 4 byte, oppure rimuovi crc32Seed.";
/* Error E5007, shown when a startup write of a record fails: a USB startup packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.usbLength" = "%1$@, session.startup[].bytes: un pacchetto di avvio USB deve essere lungo 1...64 byte. Correzione: dai a bytes una lunghezza di 1...64.";
/* Error E5007, shown when a startup write of a record fails: a USB startup endpoint is outside 1...127. %1$@ is the file. */
"error.E5007.startupWrite.usbEndpoint" = "%1$@, session.startup[].endpoint: un endpoint di avvio USB deve essere 1...127. Correzione: imposta endpoint su 1...127, oppure omettilo.";
/* Error E5007, shown when a startup write of a record fails: a USB startup timeout is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.startupWrite.usbTimeout" = "%1$@, session.startup[].timeoutMilliseconds: un timeout di avvio USB deve essere di 1...60000 ms. Correzione: imposta timeoutMilliseconds su 1...60000, oppure omettilo.";
/* Error E5007, shown when a startup write of a record fails: a USB startup session byte does not index the packet. %1$@ is the file. */
"error.E5007.startupWrite.sessionByte" = "%1$@, session.startup[].sessionByte: un byte di sessione di avvio USB deve indicizzare un byte del pacchetto. Correzione: imposta sessionByte su una posizione dentro bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names an input report. %1$@ is the file. */
"error.E5007.rumble.reportKind" = "%1$@, session.rumble.report.kind: un modello di vibrazione non può scrivere un report di ingresso. Correzione: imposta report su un report di uscita o di funzionalità.";
/* Error E5007, shown when the rumble template of a record fails: a rumble HID report is not 2...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.reportLength" = "%1$@, session.rumble.report.length: un report HID di vibrazione deve essere lungo 2...64 byte. Correzione: dai al report una lunghezza di 2...64 byte.";
/* Error E5007, shown when the rumble template of a record fails: a rumble USB packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.packetLength" = "%1$@, session.rumble.report.length: un pacchetto USB di vibrazione deve essere lungo 1...64 byte. Correzione: dai al pacchetto una lunghezza di 1...64 byte.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a rumble template do not cover the whole report. %1$@ is the file. */
"error.E5007.rumble.bytesCover" = "%1$@, session.rumble.bytes: i byte di un modello di vibrazione devono coprire l’intero report. Correzione: elenca ogni byte del report, ID del report incluso.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a numbered rumble report do not start with its report ID. %1$@ is the file. */
"error.E5007.rumble.bytesReportId" = "%1$@, session.rumble.bytes: i byte di un report di vibrazione numerato devono iniziare con il suo ID del report. Correzione: inizia bytes con l’ID del report.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names no motor it can drive. %1$@ is the file. */
"error.E5007.rumble.motors" = "%1$@, session.rumble: un modello di vibrazione deve indicare almeno un motore che può pilotare. Correzione: aggiungi lowFrequency, highFrequency, leftTrigger o rightTrigger.";
/* Error E5007, shown when the rumble template of a record fails: the motor and counter bytes of a rumble template overlap or fall outside the report. %1$@ is the file. */
"error.E5007.rumble.fields" = "%1$@, session.rumble: i byte dei motori e del contatore di un modello di vibrazione devono essere distinti e seguire l’ID del report dentro il report. Correzione: dai a ogni motore e al contatore un proprio byte dopo l’ID del report.";
/* Error E5007, shown when the rumble template of a record fails: a rumble resend interval is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.rumble.resendInterval" = "%1$@, session.rumble.resendIntervalMilliseconds: un intervallo di reinvio della vibrazione deve essere di 1...60000 ms. Correzione: imposta resendIntervalMilliseconds su 1...60000, oppure omettilo.";
