"cli.diagnose.group.hidInputDropsFound" = "Report di input persi da %1$@: %2$lld";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the user turned the virtual gamepad off. */
"cli.diagnose.group.virtualDisabled" = "gamepad virtuale disattivato";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.diagnose.group.virtualError" = "errore del gamepad virtuale: %@";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the stored profile overrides cannot be read. %@ is the error message. */
"cli.diagnose.group.virtualOverride" = "le sostituzioni del profilo salvate non sono leggibili: %@";
/* Error of the commands that need a macOS permission. %@ is the permission name. The command in quotes stays as written. */
"cli.shared.error.permissionMissing" = "Manca l’accesso a %@. Concedilo con «ojd permission request».";
/* Error of 'ojd permission request' when a permission is missing after the request. %1$@ is the permission name and %2$@ is the path of the pane in System Settings. The command in quotes stays as written. */
"platform.macos.cli.shared.error.permissionStillMissing" = "L’accesso a %1$@ manca ancora. Consenti OpenJoystickDriver in Impostazioni di Sistema > %2$@, poi esegui di nuovo «ojd permission request».";
/* One-line summary of 'ojd transport-extension' in the command list and at the top of its help. DriverKit is an Apple framework name. */
"platform.macos.cli.transportExtension.group.abstract" = "Mostra, attiva o disattiva l’estensione di sistema DriverKit di OpenJoystickDriver.";
/* One-line summary of 'ojd transport-extension activate' in the command list and at the top of its help. System Settings is the name of the macOS app. */
"platform.macos.cli.transportExtension.activate.abstract" = "Chiede a macOS di attivare l’estensione. Potrebbe servire l’approvazione in Impostazioni di Sistema.";
