/* Error of 'ojd config set' and 'ojd config unset' for a name that is not a tuning key. %1$@ is the text the user gave and %2$@ is the comma-separated list of valid keys, which stay as written. */
"cli.config.group.unknownKey" = "«%1$@» non è una chiave di regolazione. Usane una tra queste: %2$@.";
/* One-line summary of 'ojd config show' in the command list and at the top of its help. */
"cli.config.show.abstract" = "Stampa ogni valore di regolazione e il livello che lo ha impostato.";
