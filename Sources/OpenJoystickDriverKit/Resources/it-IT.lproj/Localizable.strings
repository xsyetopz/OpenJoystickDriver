"cli.profile.recover.discussion" = "Agisce su ogni problema segnalato da «ojd profile list». Il servizio prima esegue il backup di ogni file accanto all’originale, con un nome che contiene .backup-. Chiede conferma su un terminale; altrimenti richiede --force.";
/* Message printed by 'ojd profile recover' when no profile file is damaged. */
"cli.profile.recover.none" = "Nessun file di profilo danneggiato.";
/* Message printed by 'ojd profile recover' for each damaged profile file it removed. %@ is the ID of the issue that 'ojd profile list' reports. */
"cli.profile.recover.removeDone" = "Il file di profilo danneggiato del problema %@ è stato rimosso.";
/* Message printed by 'ojd profile recover --dry-run' for each damaged profile file. %@ is the ID of the issue that 'ojd profile list' reports. */
"cli.profile.recover.removeDryRun" = "Rimuoverebbe il file di profilo danneggiato del problema %@.";
/* Message printed by 'ojd profile recover' after it reset the list of active profiles. */
"cli.profile.recover.resetDone" = "L’elenco dei profili attivi è stato reimpostato.";
/* Message printed by 'ojd profile recover --dry-run' instead of resetting the list of active profiles. */
"cli.profile.recover.resetDryRun" = "Reimposterebbe l’elenco dei profili attivi.";
/* One-line summary of 'ojd profile rename' in the command list and at the top of its help. */
"cli.profile.rename.abstract" = "Rinomina un profilo.";
/* Message printed after 'ojd profile rename'. %@ is the name of the profile after the rename, shown in quotes. */
"cli.profile.rename.done" = "Rinominato in «%@».";
/* Help text of the NAME argument of 'ojd profile rename'. The limit of 80 characters is fixed. */
"cli.profile.rename.name" = "Il nuovo nome, da 1 a 80 caratteri.";
/* Error when a PROFILE argument matches no profile. %@ is the text the user gave. The command in quotes stays as written. */
"cli.profile.group.selectorNotFound" = "Nessun profilo ha l’ID o il nome «%@». «ojd profile list» mostra tutti i profili.";
/* One-line summary of 'ojd profile set' in the command list and at the top of its help. */
"cli.profile.set.abstract" = "Cambia un valore in un profilo.";
/* Long description in the help of 'ojd profile set'. KEY, VALUE, null, JSON, the command in quotes and the example values stay as written. */
"cli.profile.set.discussion" = "KEY è un percorso nel file del profilo, come in «ojd profile get». VALUE viene letto come JSON, o come stringa quando non è JSON, quindi 0.2 è un numero e space è una stringa. null rimuove la chiave o l’elemento dell’array, e l’indice subito dopo la fine di un array aggiunge un elemento. L’intero profilo viene controllato prima di essere salvato, e l’ID non può cambiare.";
/* Message printed after 'ojd profile set'. %1$@ is the key path and %2$@ is the profile name, shown in quotes. */
"cli.profile.set.done" = "Impostato %1$@ in «%2$@».";
/* Error of 'ojd profile set' when the key is the profile ID. The command in quotes stays as written. */
"cli.profile.set.idChanged" = "L’ID del profilo non può cambiare. Usa «ojd profile duplicate» per farne una copia.";
/* Error of 'ojd profile set' when the given value makes the profile invalid. %1$@ is the key path and %2$@ is the description of the problem. */
"cli.profile.set.invalid" = "Impostare %1$@ rende il profilo non valido: %2$@";
/* Error of 'ojd profile set' when the key has no place in the profile. %1$@ is the profile name, shown in quotes, and %2$@ is the key path. */
"cli.profile.set.missing" = "«%1$@» non ha spazio per %2$@. Imposta una chiave esistente, oppure imposta il suo elemento padre su un valore intero.";
/* Help text of the VALUE argument of 'ojd profile set'. JSON stays as written. */
"cli.profile.set.value" = "Il nuovo valore, come JSON o come stringa.";
/* One-line summary of 'ojd profile show' in the command list and at the top of its help. */
"cli.profile.show.abstract" = "Mostra le impostazioni e le assegnazioni di un profilo.";
/* One-line summary of 'ojd profile validate' in the command list and at the top of its help. */
"cli.profile.validate.abstract" = "Controlla un file di profilo senza importarlo.";
/* Long description in the help of 'ojd profile validate'. The single hyphen means stdin and stays as written. */
"cli.profile.validate.discussion" = "Controlla il file rispetto allo schema del profilo e alle regole che coinvolgono più campi, come le sorgenti duplicate. Usa - per leggere il profilo da stdin. Non richiede un servizio in esecuzione. Termina con codice 1 quando il profilo non è valido.";
/* Help text of the FILE argument of 'ojd profile validate'. The single hyphen means stdin and stays as written. */
"cli.profile.validate.file" = "Il file del profilo, oppure - per stdin.";
/* Message printed by 'ojd profile validate' for a correct profile. %1$@ is the file path or the word stdin, %2$@ is the profile name, shown in quotes, %3$@ is the controller model and %4$@ is the app scope. The command in quotes stays as written. */
"cli.profile.validate.valid" = "%1$@ è un profilo valido: «%2$@» per %3$@ (%4$@). Aggiungilo con «ojd profile import».";
/* Error when the service accepted a profile and does not list it afterwards. The command in quotes stays as written. */
"cli.profile.group.vanished" = "Il servizio non ha conservato il profilo. Controllalo con «ojd profile list».";
/* Text of error E1001, sent to a client that connects to the endpoint while the endpoint is off, and printed by 'ojd explain'. The command in quotes stays as written. */
"error.E1001.message" = "L’endpoint è disattivato. Attivalo con «ojd access enable» e riconnettiti.";
/* Text of error E1002, sent to an endpoint client that has no grant for the scopes it asked for or whose signature or proof is not valid. The two commands in quotes stay as written. */
"error.E1002.message" = "Il servizio ha rifiutato questo client. Non ha l’autorizzazione per gli ambiti richiesti, oppure la sua firma o la sua prova non è valida. Esegui «ojd access list», autorizza il client con «ojd access grant» e riconnettiti.";
/* Text of error E1003, sent when a line on the endpoint is invalid or arrives at the wrong time. Hello is the name of the first line kind and stays as written. */
"error.E1003.message" = "Il servizio non ha potuto accettare la riga. Non è valida oppure è arrivata nel momento sbagliato. Invia prima hello, poi una sola richiesta, e controlla ogni riga con lo schema dell’endpoint.";
/* Text of error E1004, sent when the endpoint refuses a ninth connection on one transport. The number 8 is the fixed limit; the socket and the WebSocket are the two transports. */
"error.E1004.message" = "L’endpoint serve già 8 connessioni per trasporto (socket e WebSocket, ciascuno). Chiudi una connessione che non ti serve e riconnettiti.";
/* Text of error E1005, sent to an endpoint client whose grant is removed while it is connected. The command in quotes stays as written. */
"error.E1005.message" = "L’autorizzazione di questo client è stata rimossa mentre era connesso. Autorizzalo di nuovo con «ojd access grant» e riconnettiti.";
/* Text of error E1006, sent to an endpoint client that reads lines too slowly, so that 256 lines wait for it. 256 is the fixed limit. */
"error.E1006.message" = "Il client ha letto le righe troppo lentamente e 256 righe sono rimaste in attesa. Leggi le righe alla stessa velocità con cui arrivano e riconnettiti.";
/* Text of error E1007, sent when the service runs four virtual gamepads and a feed asks for another one. feed is a request kind of the endpoint and stays as written. */
"error.E1007.message" = "Il servizio esegue già 4 gamepad virtuali. Chiudi un feed che non ti serve e invia di nuovo feed.";
/* Text of error E1008, sent when the virtual gamepad of a feed is closed. feed is a request kind of the endpoint and stays as written. */
"error.E1008.message" = "Il gamepad virtuale si è chiuso, oppure il servizio non ne esegue nessuno. Riconnettiti e invia feed.";
/* Text of error E1009, sent when a line names an API version that the service does not speak. apiVersion and details.supportedAPIVersions are field names and stay as written. */
"error.E1009.message" = "Il servizio non supporta l’apiVersion di una riga. Invia una delle versioni in details.supportedAPIVersions e connettiti di nuovo.";
/* Text of error E1010, sent when a line has a kind that the service does not know or does not accept at this point. Hello, Subscription, FeedRequest and Frame are kinds of lines and stay as written. */
"error.E1010.message" = "Una riga ha un kind che il servizio non conosce o non accetta a questo punto. Invia prima Hello, poi Subscription o FeedRequest, poi righe Frame, e connettiti di nuovo.";
/* Text of error E1011, sent when a line has no apiVersion or no kind. apiVersion and kind are field names and stay as written. */
"error.E1011.message" = "A una riga mancano apiVersion o kind. Ogni riga li porta entrambi. Aggiungili e connettiti di nuovo.";
