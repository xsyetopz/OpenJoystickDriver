/* Help text of the --lines option of 'ojd log show'. The range is fixed. */
"cli.log.show.lines" = "Righe da stampare da ogni log, da 1 a 10000.";
/* Error of 'ojd log show' when --lines is out of range. --lines stays as written. The range is fixed. */
"cli.log.show.linesRange" = "--lines deve essere compreso tra 1 e 10000.";
/* Placeholder line printed for a log file that does not exist, in the log text that 'ojd log show' prints. Keep the parentheses. */
"cli.log.show.missing" = "(il file di log non esiste)";
/* Error of 'ojd log show' when the log files cannot be read. %@ is the reason from the system. The command in quotes stays as written. */
"cli.log.show.readFailed" = "Impossibile leggere i log del servizio: %@. Controlla la cartella stampata da «ojd log path».";
/* Placeholder line printed above the shown part of a long log file, in the log text that 'ojd log show' prints. Keep the parentheses. */
"cli.log.show.truncated" = "(contenuto precedente del log omesso)";
