"cli.access.grant.controlWarning" = "Cakupan control memungkinkan program menekan tombol pada gamepad virtual, yang oleh game dan app dianggap sebagai input Anda.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT adalah path program atau ID dari “ojd access list”. Pemberian akses menyebut tanda tangan program, sehingga tetap valid saat program diperbarui atau dipindahkan. Program yang ditandatangani ad-hoc dan yang tidak ditandatangani tidak dapat diberi akses. Dengan --token sebagai ganti CLIENT, membuat token yang digunakan klien untuk menandatangani tantangan layanan dalam hello-nya: di soket, di WebSocket dari halaman pada salah satu nilai --origin, atau, untuk token tanpa --origin, di WebSocket dari program yang tidak mengirim header Origin, seperti app dalam sandbox. Halaman tidak dapat menggunakan cakupan control. Token hanya ditampilkan sekali. Meminta konfirmasi terlebih dahulu.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Asal web, seperti http://127.0.0.1:8080, yang halamannya boleh menggunakan token di WebSocket. Ulangi untuk menambah. Halaman overlay yang dilayani WebSocket memiliki asal http://127.0.0.1:PORT, dengan port yang ditampilkan “ojd access status”.";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin tidak dapat digabungkan dengan cakupan control. Halaman tidak pernah mengendalikan gamepad virtual; beri akses control ke token tanpa --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin memerlukan --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Cakupan yang diberikan: read atau control. Ulangi untuk keduanya.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "Akses %1$@ diberikan kepada %2$@ (ID %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Buat token dengan nama ini sebagai ganti memberi akses ke program.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "Buat token %1$@ dengan %2$@, untuk program di Mac ini?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "Akses %1$@ diberikan kepada token %2$@ (ID %3$@). Jaga kerahasiaan token; token tidak ditampilkan lagi:";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "Buat token %1$@ dengan %2$@, untuk program di Mac ini dan untuk halaman dari %3$@?";
