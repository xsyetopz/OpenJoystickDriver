"error.E3002.message" = "Joy-Con yang dipilih tidak dapat dipasangkan. Segarkan pengontrol yang terhubung dan coba lagi.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "Pengontrol tidak melaporkan data gerak. Pilih pengontrol dengan sensor gerak, atau biarkan opsi gerak mati.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Nilai dalam permintaan lebih besar daripada yang diterima layanan. Kirim nilai yang lebih kecil.";
