"cli.access.list.discussion" = "Setiap klien memiliki ID yang diterima “ojd access grant” dan “ojd access revoke”; ID token adalah token:NAME.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Diberi akses:";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Tidak Ada";
