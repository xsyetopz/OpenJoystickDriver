/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "Konfigurasikan dan periksa OpenJoystickDriver, driver gamepad macOS.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Mulai di sini:\n  ojd status             Periksa layanan, ekstensi, dan izin.\n  ojd diagnose           Jalankan semua pemeriksaan dan laporkan masalahnya.\n  ojd controller list    Daftarkan pengontrol yang terhubung.\n\nContoh:\n  # Cetak input satu pengontrol saat berubah\n  ojd controller watch 045E:028E\n  # Daftarkan pengontrol yang terhubung sebagai JSON\n  ojd --json controller list\n\nLingkungan (flag mengalahkan variabelnya):\n  OJD_NO_INPUT=1         Sama dengan --no-input.\n  OJD_TIMEOUT=SECONDS    Sama dengan --timeout.\n  OJD_COLOR=WHEN         auto, always (berwarna meski bukan terminal), atau never.\n\nPelengkapan shell:\n  ojd --generate-completion-script zsh|bash|fish\n\nKode keluar:\n  0    Berhasil.\n  1    Perintah gagal.\n  64   Kesalahan penggunaan.\n  69   Layanan tidak berjalan. Mulai dengan “ojd service start”.\n  77   Izin macOS tidak ada.\n  127  Build repositori tidak dapat menyerahkan perintah ke app terinstal.\n  130  Diinterupsi.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Setiap perintah juga menerima opsi global; “ojd --help” mencantumkannya.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT memerlukan jumlah detik di atas 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR memerlukan auto, always, atau never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT memerlukan 1, true, yes, 0, false, atau no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain tidak berlaku untuk “virtual feed”, yang mencetak baris JSON. Hilangkan --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Contoh:\n  # Cetak input selama 10 detik\n  ojd controller watch 045E:028E --duration 10\n  # Cetak kontrol pertama yang ditekan, sebagai JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Pantau semua pengontrol dan apa yang dikirim gamepad virtualnya\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Contoh:\n  # Jalankan kedua motor utama pada 180 selama 0,45 detik\n  ojd controller rumble 045E:028E\n  # Jalankan kedua motor utama pada kekuatan penuh selama 2 detik\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Contoh:\n  # Atur lightbar menjadi oranye\n  ojd controller light 054C:09CC --color FF8000\n  # Atur warna dan kecerahan rendah\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Contoh:\n  # Buat profil untuk satu model pengontrol\n  ojd profile create Racing --controller 045E:028E\n  # Terapkan hanya saat Safari berada di depan\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Contoh:\n  # Ganti nama profil\n  ojd profile set Racing name Rally\n  # Atur deadzone dalam dari pemetaan stik pertama\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Contoh:\n  # Tahan Space selama tombol selatan ditahan\n  ojd binding set Racing button:south key:space\n  # Alihkan J pada setiap penekanan\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Ulangi J 10 kali per detik selama ditahan\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Contoh:\n  # Instal file rekaman\n  ojd record install 045E-028E.json\n  # Baca rekaman dari stdin\n  ojd record install - < 045E-028E.json";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Contoh:\n  # Izinkan program menggunakan layanan\n  ojd access grant /Applications/Example.app\n  # Buat token untuk halaman yang disajikan dari satu origin\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
