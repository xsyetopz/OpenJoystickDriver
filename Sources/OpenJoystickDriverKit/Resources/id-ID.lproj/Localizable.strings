"error.E2016.message" = "File tidak dapat dibaca, ditulis, atau dihapus, atau sudah ada. Periksa path dan izinnya.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Klien itu tidak ditandatangani atau ditandatangani ad-hoc, sehingga tidak dapat diberi akses. Tandatangani dengan Developer ID dan coba lagi.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "“ojd diagnose” menemukan pemeriksaan yang gagal. Baca outputnya dan perbaiki item yang gagal.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "Pemeriksaan pembaruan tidak selesai. Periksa koneksi jaringan Anda dan coba lagi.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "OpenJoystickDriver yang terinstal lebih lama daripada ojd ini. Jalankan “./Scripts/ojd build install-fast dev”, atau atur OJD_RUN_REPOSITORY_CLI=1 untuk menjalankan build ini.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Build repositori ojd tidak dapat menyerahkan perintah ke app yang terinstal. Instal ulang OpenJoystickDriver.app dan jalankan perintah lagi.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "Pengontrol tidak terhubung atau belum siap untuk pemetaan ulang. Hubungkan kembali dan coba lagi.";
