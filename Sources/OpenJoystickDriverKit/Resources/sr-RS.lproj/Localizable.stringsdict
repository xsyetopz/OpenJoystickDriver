<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d контролер повезан</string>
			<key>zero</key>
			<string>%d контролера повезано</string>
			<key>two</key>
			<string>%d контролера повезана</string>
			<key>few</key>
			<string>%d контролера повезана</string>
			<key>many</key>
			<string>%d контролера повезано</string>
			<key>other</key>
			<string>%d контролера повезано</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d активни профил</string>
			<key>zero</key>
			<string>%d активних профила</string>
			<key>two</key>
			<string>%d активна профила</string>
			<key>few</key>
			<string>%d активна профила</string>
			<key>many</key>
			<string>%d активних профила</string>
			<key>other</key>
			<string>%d активних профила</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d додела</string>
			<key>zero</key>
			<string>%d додела</string>
			<key>two</key>
			<string>%d доделе</string>
			<key>few</key>
			<string>%d доделе</string>
			<key>many</key>
			<string>%d додела</string>
			<key>other</key>
			<string>%d додела</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Ништа није откривено</string>
			<key>one</key>
			<string>Откривено: %d</string>
			<key>two</key>
			<string>Откривено: %d</string>
			<key>few</key>
			<string>Откривено: %d</string>
			<key>many</key>
			<string>Откривено: %d</string>
			<key>other</key>
			<string>Откривено: %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Није откривен ниједан излазни уређај контролера</string>
			<key>one</key>
			<string>Откривен је %d излазни уређај контролера</string>
			<key>two</key>
			<string>Откривена су %d излазна уређаја контролера</string>
			<key>few</key>
			<string>Откривена су %d излазна уређаја контролера</string>
			<key>many</key>
			<string>Откривено је %d излазних уређаја контролера</string>
			<key>other</key>
			<string>Откривено је %d излазних уређаја контролера</string>
		</dict>
	</dict>
</dict>
</plist>
