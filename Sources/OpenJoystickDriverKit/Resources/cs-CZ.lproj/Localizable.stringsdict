<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d ovladač připojen</string>
			<key>zero</key>
			<string>%d ovladačů připojeno</string>
			<key>two</key>
			<string>%d ovladače připojeny</string>
			<key>few</key>
			<string>%d ovladače připojeny</string>
			<key>many</key>
			<string>%d ovladače připojeno</string>
			<key>other</key>
			<string>%d ovladačů připojeno</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d aktivní profil</string>
			<key>zero</key>
			<string>%d aktivních profilů</string>
			<key>two</key>
			<string>%d aktivní profily</string>
			<key>few</key>
			<string>%d aktivní profily</string>
			<key>many</key>
			<string>%d aktivního profilu</string>
			<key>other</key>
			<string>%d aktivních profilů</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d přiřazení</string>
			<key>zero</key>
			<string>%d přiřazení</string>
			<key>two</key>
			<string>%d přiřazení</string>
			<key>few</key>
			<string>%d přiřazení</string>
			<key>many</key>
			<string>%d přiřazení</string>
			<key>other</key>
			<string>%d přiřazení</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Nic nezjištěno</string>
			<key>one</key>
			<string>Zjištěno: %d</string>
			<key>two</key>
			<string>Zjištěno: %d</string>
			<key>few</key>
			<string>Zjištěno: %d</string>
			<key>many</key>
			<string>Zjištěno: %d</string>
			<key>other</key>
			<string>Zjištěno: %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Nebyla zjištěna žádná výstupní zařízení ovladače</string>
			<key>one</key>
			<string>Zjištěno %d výstupní zařízení ovladače</string>
			<key>two</key>
			<string>Zjištěna %d výstupní zařízení ovladače</string>
			<key>few</key>
			<string>Zjištěna %d výstupní zařízení ovladače</string>
			<key>many</key>
			<string>Zjištěno %d výstupního zařízení ovladače</string>
			<key>other</key>
