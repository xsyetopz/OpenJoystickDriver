"cli.access.grant.token_web_confirm" = "Ստեղծե՞լ %@ թոքենը %@ շրջանակով այս Mac-ի ծրագրերի և %@-ի էջերի համար։";
"cli.access.list.abstract" = "Թվարկում է թույլտվություն ստացած հաճախորդներին և թոքեններին, ինչպես նաև վերջին 24 ժամվա ընթացքում մերժվածներին։";
