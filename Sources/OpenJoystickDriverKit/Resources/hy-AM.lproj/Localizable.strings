"error.E1002" = "Ծառայությունը մերժեց այս հաճախորդին։ Նա թույլտվություն չունի պահանջված շրջանակների համար, կամ նրա ստորագրությունը կամ ապացույցը անվավեր է։ Գործարկեք «ojd access list», հաճախորդին թույլտվություն տվեք «ojd access grant» հրամանով և նորից կապվեք։";
