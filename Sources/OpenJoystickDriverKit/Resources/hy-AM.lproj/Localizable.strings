"cli.record.install.abstract" = "Ստուգել կարգավորիչի գրառումը և տեղադրել այն ձեր օգտատիրոջ համար։";
"cli.record.install.discussion" = "Գրառումը VVVV-PPPP.json անունով գրում է ձեր գրառումների թղթապանակում և փոխարինում է այդ մոդելի համար արդեն տեղադրված գրառումը։ Աշխատող ծառայությունը այն կիրառում է անմիջապես։ Գրառման անվավեր լինելու դեպքում ավարտվում է 1 կոդով և ոչինչ չի գրում։";
