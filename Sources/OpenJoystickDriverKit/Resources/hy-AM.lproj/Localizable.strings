"cli.record.abstract" = "Կազմել սևագիր, թվարկել, ստուգել, տեղադրել կամ հեռացնել կարգավորիչների գրառումները։";
"cli.record.discussion" = "Կարգավորիչի գրառումը OpenJoystickDriver-ին ասում է, թե ինչպես աշխատել կարգավորիչի մեկ մոդելի հետ։ Ձեր գրառումները գտնվում են ~/Library/Application Support/OpenJoystickDriver/Controllers թղթապանակում և ավելացնում են մոդել կամ փոփոխում ներկառուցվածը։ Աշխատող ծառայությունը կիրառում է դրանք, երբ թղթապանակը փոխվում է։ Ծառայություն պետք է միայն «ojd record draft»-ին։";
"cli.record.draft.abstract" = "Կազմել կարգավորիչի գրառման սևագիր միացված կարգավորիչից։";
"cli.record.draft.captured" = "Գրանցված մուտքային զեկույցներ՝ %lld։";
"cli.record.draft.changed_byte" = "%lld բայթը փոխվել է՝ %lld-ից %lld։";
"cli.record.draft.discussion" = "Կարդում է կարգավորիչի HID զեկույցի նկարագրիչը և գրանցում է դրա մուտքային զեկույցները, մինչ դուք սեղմում եք յուրաքանչյուր կառավարման տարր, ապա տպում է գրառում՝ որպես մեկնարկային կետ։ Գրառումը համապատասխանեցնում է կոճակները, ձողերը, ձգանները և ուղղության խաչը, որոնք նկարագրիչը հստակ նշում է։ Գրանցման ժամանակ փոխված բայթերը ցույց են տալիս, թե որտեղ են մյուս կառավարման տարրերը։ Պահանջում է ծառայությունը։";
"cli.record.draft.duration" = "Գրանցել մուտքային զեկույցներ այսքան վայրկյան։";
"cli.record.draft.next" = "Պահեք գրառումը ֆայլում, ստուգեք յուրաքանչյուր կառավարման տարր, ապա գործարկեք «ojd record validate FILE»-ը։";
"cli.record.draft.no_layout" = "%@-ի ոչ մի կառավարման տարր չհաջողվեց կարդալ HID զեկույցի նկարագրիչից, իսկ դրա ներկառուցված գրառումն արդեն նշում է դրա ընտանիքը։ «ojd record show %@»-ը ցույց է տալիս այդ գրառումը։";
"cli.record.draft.started" = "Սեղմեք %@-ի (%@) յուրաքանչյուր կառավարման տարր և շարժեք յուրաքանչյուր ձող ու ձգան։";
