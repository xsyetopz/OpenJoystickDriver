"cli.access.client.unsigned" = "%@-ը ստորագրված ծրագիր չի պարունակում։ Թույլտվություն տվեք ծրագրի հավելվածի փաթեթին կամ կատարվող ֆայլին։";
"cli.access.disable.abstract" = "Անջատեք վերջնակետը և փակեք դրա կապերը․ տրված թույլտվությունները պահպանվում են։";
"cli.access.disable.success" = "Վերջնակետն անջատված է, և դրա կապերը փակված են։";
"cli.access.discussion" = "Վերջնակետը տեղային սոկետ է, որից թույլտվություն ստացած ծրագրերը կարդում են կարգավորիչների իրադարձությունները։ Այն անջատված է, մինչև չկատարեք «ojd access enable», և ծառայությունը սպասարկում է միայն այն ծրագրերին, որոնց ստորագրությանը դուք թույլտվություն եք տվել, կամ որոնք ուղարկում են ձեր թույլատրած թոքեն։ «ojd access web enable» ավելացնում է WebSocket 127.0.0.1 հասցեում՝ overlay էջերի համար։";
"cli.access.enable.abstract" = "Միացրեք վերջնակետը։";
"cli.access.enable.confirm" = "Միացնե՞լ վերջնակետը, որպեսզի ձեր թույլատրած ծրագրերը կարողանան կարդալ յուրաքանչյուր կարգավորիչի մուտքը։";
"cli.access.enable.discussion" = "Նախ հարցնում է հաստատում։ Վերջնակետն օգտագործել կարող են միայն թույլտվություն ստացած ծրագրերը․ ավելացրեք դրանք «ojd access grant»-ով։";
"cli.access.enable.success" = "Վերջնակետը լսում է %@-ում։";
"cli.access.grant.abstract" = "Թույլատրեք ստորագրված ծրագրին կամ նոր թոքենին օգտագործել վերջնակետը։";
"cli.access.grant.ad_hoc" = "%@-ն ստորագրված է ad-hoc եղանակով կամ ստորագրված չէ, ուստի ցանկացած տեղային ծրագիր կարող է յուրացնել դրա ստորագրությունը։ Ստորագրեք այն Developer ID կամ Apple Development վկայականով, ապա թույլտվություն տվեք։";
"cli.access.grant.apple_warning" = "Այս ծրագիրը ստորագրել է Apple-ը։ Եթե այն սկրիպտներ է գործարկում, օրինակ՝ python3 կամ osascript, ապա իր գործարկած յուրաքանչյուր սկրիպտ ստանում է այս հասանելիությունը։";
"cli.access.grant.client_or_token" = "Նշեք կա՛մ CLIENT, կա՛մ --token NAME։";
"cli.access.grant.confirm" = "Թույլատրե՞լ %@-ին, ստորագրված՝ %@, օգտագործել վերջնակետը %@ շրջանակով։";
"cli.access.grant.control_warning" = "control շրջանակը թույլ է տալիս ծրագրին սեղմել վիրտուալ խաղային վահանակի կոճակները, և խաղերն ու հավելվածներն այն դիտարկում են որպես ձեր մուտքագրում։";
"cli.access.grant.discussion" = "CLIENT-ը ծրագրի ուղին է կամ «ojd access list»-ի ID-ն։ Թույլտվությունը վերաբերում է ծրագրի ստորագրությանը, ուստի այն մնում է վավեր, երբ ծրագիրը թարմացվում կամ տեղափոխվում է։ Ad-hoc ստորագրված և չստորագրված ծրագրերին թույլտվություն տալ հնարավոր չէ։ CLIENT-ի փոխարեն --token-ի դեպքում ստեղծվում է թոքեն, որով հաճախորդն իր hello-ում ստորագրում է ծառայության մարտահրավերը՝ սոկետով, WebSocket-ով՝ --origin-ի արժեքներից մեկի էջից, կամ --origin չունեցող թոքենի դեպքում՝ WebSocket-ով այն ծրագրից, որը Origin վերնագիր չի ուղարկում, օրինակ՝ ավազարկղային հավելվածից։ Էջը չի կարող օգտագործել control շրջանակը։ Թոքենը ցուցադրվում է միայն մեկ անգամ։ Նախ հարցնում է հաստատում։";
"cli.access.grant.origin" = "Վեբ ծագում, օրինակ՝ http://127.0.0.1:8080, որի էջերը կարող են օգտագործել թոքենը WebSocket-ով։ Կրկնեք՝ ավելի շատ ավելացնելու համար։ WebSocket-ի մատուցած overlay էջերի ծագումը http://127.0.0.1:PORT է, այն պորտով, որը ցույց է տալիս «ojd access status»-ը։";
