<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d կարգավորիչ միացված է</string>
			<key>zero</key>
			<string>%d կարգավորիչ միացված է</string>
			<key>two</key>
			<string>%d կարգավորիչ միացված է</string>
			<key>few</key>
			<string>%d կարգավորիչ միացված է</string>
			<key>many</key>
			<string>%d կարգավորիչ միացված է</string>
			<key>other</key>
			<string>%d կարգավորիչ միացված է</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d ակտիվ պրոֆիլ</string>
			<key>zero</key>
			<string>%d ակտիվ պրոֆիլ</string>
			<key>two</key>
			<string>%d ակտիվ պրոֆիլ</string>
			<key>few</key>
			<string>%d ակտիվ պրոֆիլ</string>
			<key>many</key>
			<string>%d ակտիվ պրոֆիլ</string>
			<key>other</key>
			<string>%d ակտիվ պրոֆիլ</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d նշանակում</string>
			<key>zero</key>
			<string>%d նշանակում</string>
			<key>two</key>
			<string>%d նշանակում</string>
			<key>few</key>
			<string>%d նշանակում</string>
			<key>many</key>
			<string>%d նշանակում</string>
			<key>other</key>
			<string>%d նշանակում</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Ոչինչ չի հայտնաբերվել</string>
			<key>one</key>
			<string>Հայտնաբերվել է %d</string>
			<key>two</key>
			<string>Հայտնաբերվել է %d</string>
			<key>few</key>
			<string>Հայտնաբերվել է %d</string>
			<key>many</key>
			<string>Հայտնաբերվել է %d</string>
			<key>other</key>
			<string>Հայտնաբերվել է %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Կարգավորիչի ելքային սարքեր չեն հայտնաբերվել</string>
			<key>one</key>
			<string>Հայտնաբերվել է կարգավորիչի %d ելքային սարք</string>
			<key>two</key>
			<string>Հայտնաբերվել է կարգավորիչի %d ելքային սարք</string>
			<key>few</key>
			<string>Հայտնաբերվել է կարգավորիչի %d ելքային սարք</string>
			<key>many</key>
			<string>Հայտնաբերվել է կարգավորիչի %d ելքային սարք</string>
			<key>other</key>
			<string>Հայտնաբերվել է կարգավորիչի %d ելքային սարք</string>
		</dict>
	</dict>
</dict>
</plist>
