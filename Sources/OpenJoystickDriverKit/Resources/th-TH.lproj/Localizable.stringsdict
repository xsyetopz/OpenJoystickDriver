<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>เชื่อมต่อคอนโทรลเลอร์ %d ตัว</string>
			<key>zero</key>
			<string>เชื่อมต่อคอนโทรลเลอร์ %d ตัว</string>
			<key>two</key>
			<string>เชื่อมต่อคอนโทรลเลอร์ %d ตัว</string>
			<key>few</key>
			<string>เชื่อมต่อคอนโทรลเลอร์ %d ตัว</string>
			<key>many</key>
			<string>เชื่อมต่อคอนโทรลเลอร์ %d ตัว</string>
			<key>other</key>
			<string>เชื่อมต่อคอนโทรลเลอร์ %d ตัว</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>การกำหนด %d รายการ</string>
			<key>zero</key>
			<string>การกำหนด %d รายการ</string>
			<key>two</key>
			<string>การกำหนด %d รายการ</string>
			<key>few</key>
			<string>การกำหนด %d รายการ</string>
			<key>many</key>
			<string>การกำหนด %d รายการ</string>
			<key>other</key>
			<string>การกำหนด %d รายการ</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>ไม่พบอุปกรณ์เอาต์พุตของคอนโทรลเลอร์</string>
			<key>one</key>
			<string>พบอุปกรณ์เอาต์พุตของคอนโทรลเลอร์ %d รายการ</string>
			<key>two</key>
			<string>พบอุปกรณ์เอาต์พุตของคอนโทรลเลอร์ %d รายการ</string>
			<key>few</key>
			<string>พบอุปกรณ์เอาต์พุตของคอนโทรลเลอร์ %d รายการ</string>
			<key>many</key>
			<string>พบอุปกรณ์เอาต์พุตของคอนโทรลเลอร์ %d รายการ</string>
			<key>other</key>
			<string>พบอุปกรณ์เอาต์พุตของคอนโทรลเลอร์ %d รายการ</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>“%1$@” ตรงกับคอนโทรลเลอร์ %2$lld ตัว ใช้ ID ใดก็ได้ต่อไปนี้:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>“%1$@” เป็นชื่อของโปรไฟล์ %2$lld รายการ ใช้ ID ใดก็ได้ต่อไปนี้:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>--soak ที่ใช้ --interval-ms นี้จะสุ่มตัวอย่าง %lld ครั้ง เพิ่ม --interval-ms</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>การสุ่มตัวอย่างจะต้องใช้ %lld ตัวอย่าง เพิ่มช่วงห่างการสุ่มตัวอย่าง</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>การเรียกใช้นี้ต้องใช้ %lld ตัวอย่าง เพิ่มช่วงห่างการสุ่มตัวอย่าง</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%1$@ ตรงกับสถานะที่คาดไว้: เล่นรายงานอินพุตซ้ำ %2$lld รายการ</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>สถานะที่ตัวแยกวิเคราะห์ของ %1$@ สร้างขึ้นต่างจาก %2$@ ใน %3$lld ช่อง</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>ซ่อนแพ็กเก็ตว่าง %lld รายการ (ยังรวมอยู่ในการส่งออก)</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Thai plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>หยุดแล้ว · %lld แพ็กเก็ต</string>
		</dict>
	</dict>
	<!-- Choice of the idle disconnect picker in the General pane of the settings window. %d is a number of minutes, such as 15. -->
	<key>ui.settings.general.idleDisconnectMinutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d นาที</string>
			<key>one</key>
			<string>%d นาที</string>
			<key>two</key>
			<string>%d นาที</string>
			<key>few</key>
			<string>%d นาที</string>
			<key>many</key>
			<string>%d นาที</string>
			<key>other</key>
			<string>%d นาที</string>
		</dict>
	</dict>
</dict>
</plist>
