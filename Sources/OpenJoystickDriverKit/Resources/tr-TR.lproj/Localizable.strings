"cli.shared.error.serviceTimeout" = "Servis zamanında yanıt vermedi. Yeniden deneyin veya “ojd status” ile kontrol edin.";
/* Error of every command that needs the service when it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"cli.shared.error.serviceUnavailable" = "OpenJoystickDriver servisi çalışmıyor. “ojd service start” ile başlatın.";
/* Error of every command when --timeout is not a number above 0. --timeout stays as written. */
"cli.shared.error.timeoutValue" = "--timeout, 0’dan büyük bir saniye sayısı gerektirir.";
/* Error printed for a failure that no other message covers. %@ is the description of the failure. The command with PATH in quotes stays as written. */
"cli.shared.error.unexpected" = "Beklenmeyen hata: %@. “ojd diagnose --output PATH” komutunu çalıştırın ve paketi bir hata raporuna ekleyin.";
/* Error of ojd for a command that does not exist. %1$@ is the text the user typed and %2$@ is the closest command name. */
"cli.shared.error.unknownCommand" = "Bilinmeyen komut “%1$@”. Şunu mu demek istediniz: “%2$@”?";
/* Help text of the --json flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.json" = "JSON’u stdout’a yazdırır.";
/* Help text of the --no-color flag that every command takes. */
"cli.shared.option.noColor" = "Renk kullanmaz.";
/* Help text of the --no-input flag that every command takes. */
"cli.shared.option.noInput" = "Asla sormaz; bir değer eksikse başarısız olur.";
/* Help text of the --plain flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.plain" = "Sekmeyle ayrılmış kayıtları stdout’a yazdırır.";
/* Help text of the --quiet flag that every command takes. stderr is the standard error stream and stays as written. */
"cli.shared.option.quiet" = "Başarı iletilerini stderr’e yazdırmaz.";
/* Help text of the --timeout option that every command takes. %1$g is the default number of seconds for a service request and %2$g is the default for the service, virtual set and virtual reset commands, which stay as written in quotes. */
"cli.shared.option.timeout" = "Her servis isteği için (varsayılan: %1$g) veya “service”, “virtual set” ve “virtual reset” komutlarının bitmesi için (varsayılan: %2$g) beklenecek saniye.";
/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "macOS oyun kontrolcüsü sürücüsü OpenJoystickDriver’ı yapılandırın ve inceleyin.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Buradan başlayın:\n  ojd status             Servisi, uzantıyı ve izinleri denetler.\n  ojd diagnose           Tüm denetimleri çalıştırır, sorunu bildirir.\n  ojd controller list    Bağlı kontrolcüleri listeler.\n\nÖrnekler:\n  # Bir kontrolcünün girdisini değiştikçe yazdır\n  ojd controller watch 045E:028E\n  # Bağlı kontrolcüleri JSON olarak listele\n  ojd --json controller list\n\nOrtam (seçenek, değişkenin önüne geçer):\n  OJD_NO_INPUT=1         --no-input ile aynı.\n  OJD_TIMEOUT=SECONDS    --timeout ile aynı.\n  OJD_COLOR=WHEN         auto, always (terminal dışında da renkli) veya never.\n\nKabuk tamamlama:\n  ojd --generate-completion-script zsh|bash|fish\n\nÇıkış kodları:\n  0    Başarılı.\n  1    Komut başarısız oldu.\n  64   Kullanım hatası.\n  69   Servis çalışmıyor. “ojd service start” ile başlatın.\n  77   Bir macOS izni eksik.\n  127  Depo derlemesi komutu kurulu uygulamaya aktaramadı.\n  130  Kesintiye uğradı.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Her komut genel seçenekleri de kabul eder; “ojd --help” bunları listeler.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT, 0’dan büyük bir saniye sayısı ister.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR auto, always veya never ister.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT 1, true, yes, 0, false veya no ister.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain, JSON satırları yazdıran “virtual feed” için geçerli değildir. --plain seçeneğini kullanmayın.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Örnekler:\n  # Girdiyi 10 saniye boyunca yazdır\n  ojd controller watch 045E:028E --duration 10\n  # Basılan ilk kontrolü JSON olarak yazdır\n  ojd controller watch 045E:028E --first-press --json\n  # Tüm kontrolcüleri ve sanal oyun kontrolcülerinin gönderdiğini izle\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Örnekler:\n  # Her iki ana motoru 0,45 saniye boyunca 180 değerinde çalıştır\n  ojd controller rumble 045E:028E\n  # Her iki ana motoru 2 saniye boyunca tam güçte çalıştır\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Örnekler:\n  # Işık çubuğunu turuncuya ayarla\n  ojd controller light 054C:09CC --color FF8000\n  # Rengi ve düşük bir parlaklığı ayarla\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Örnekler:\n  # Bir kontrolcü modeli için profil oluştur\n  ojd profile create Racing --controller 045E:028E\n  # Yalnızca Safari öndeyken uygula\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Örnekler:\n  # Bir profili yeniden adlandır\n  ojd profile set Racing name Rally\n  # İlk çubuk eşlemesinin iç ölü bölgesini ayarla\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Örnekler:\n  # Güney düğmesi basılıyken Boşluk tuşunu basılı tut\n  ojd binding set Racing button:south key:space\n  # Her basışta J tuşunu aç/kapat\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Basılı tutulduğu sürece J tuşunu saniyede 10 kez tekrarla\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Örnekler:\n  # Bir kayıt dosyası kur\n  ojd record install 045e-028e.plist\n  # Kaydı stdin’den oku\n  ojd record install - < 045e-028e.plist";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Örnekler:\n  # Bir programın servisi kullanmasına izin ver\n  ojd access grant /Applications/Example.app\n  # Tek bir kaynaktan sunulan sayfalar için jeton oluştur\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "OpenJoystickDriver servisini başlatır veya durdurur ya da istekleri kabul edene kadar bekler.";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "Servis çalışıyor.";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "Uygulamayı arka planda açar ve servisi istekleri kabul edene kadar bekler.";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "Bu ojd, OpenJoystickDriver.app içinde değil, bu yüzden servisi başlatamaz. Yüklü uygulamayı açın veya onun içindeki ojd’yi çalıştırın.";
/* Error of 'ojd service start' when macOS cannot open the app. %@ is the path of the app. Finder is the macOS file manager. */
"platform.macos.cli.service.start.openFailed" = "macOS %@ öğesini açamadı. Nedenini görmek için Finder’dan açın.";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "Servisi durdurur ve çıkana kadar bekler. Bağlı kontrolcüler macOS’a döner.";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "Servis durdurulamadı: %@. OpenJoystickDriver’ı menüsünden kapatın.";
/* Error of 'ojd service stop' when the service keeps running. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.service.stop.timeout" = "Servis %@ içinde durmadı. Daha büyük bir --timeout ile yeniden deneyin.";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "Servis durduruldu.";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "Servis istekleri kabul edene kadar bekler. --timeout beklemeyi sınırlar (varsayılan 5 saniye).";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "Servis %@ içinde istekleri kabul etmedi. “ojd service start” ile başlatın veya daha büyük bir --timeout ile yeniden deneyin.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Servisi, eklentiyi, izinleri ve bağlı kontrolcüleri gösterir.";
/* Long description in the help of 'ojd status'. It says that the command also works while the service is stopped. The exit status 0 stays as written. */
"cli.status.group.discussion" = "Servis durdurulmuşken de çalışır: servisi durdurulmuş olarak bildirir ve 0 koduyla çıkar.";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "Erişilebilirlik";
/* Row label in the output of 'ojd status'. The version of this command line tool follows. */
"cli.status.group.labelCommandLineTool" = "Komut Satırı Aracı";
/* Heading in the output of 'ojd status' above the list of connected controllers. %lld is the number of controllers. */
"cli.status.group.labelControllers" = "Kontrolcüler (%lld)";
/* Row label in the output of 'ojd status'. The state of the driver extension follows. */
"cli.status.group.labelTransportExtension" = "Eklenti";
/* Row label in the output of 'ojd status' for the Input Monitoring permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputRead" = "Giriş İzleme";
/* Row label in the output of 'ojd status'. The reason why the stored profile overrides could not be read follows. */
"cli.status.group.labelOverrideError" = "Geçersiz Kılma Hatası";
/* Heading in the output of 'ojd status' above the list of controllers that macOS serves natively. %lld is the number of controllers. */
