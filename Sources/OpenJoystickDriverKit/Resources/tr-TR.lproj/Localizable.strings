"cli.record.draft.sdl.contract" = "%1$@ aygıtının HID rapor tanımlayıcısı HIDDescriptor sözleşmesine (%2$@) uymuyor, bu yüzden hiçbir SDL_GameControllerDB satırı onu bağlayamaz.";
