/* Error of 'ojd controller light' when no option is given. --color and --brightness stay as written. */
"cli.controller.light.errorMissing" = "--color, --brightness veya ikisini birden verin.";
/* One-line summary of 'ojd controller list' in the command list and at the top of its help. */
"cli.controller.list.abstract" = "Bağlı kontrolcüleri listeler.";
/* Message printed by 'ojd controller list' when no controller is connected. */
