"platform.macos.cli.controller.disconnect.discussion" = "Klasik Bluetooth bağlantısını kapatır. Kontrolcü eşleşmiş kalır ve yeniden açtığınızda tekrar bağlanır. Bluetooth’un onaylaması için en az 6 saniye bekler. Servis, Bluetooth Low Energy kontrolcüsünün bağlantısını kesemez. Kontrolcüyü kapatın veya Sistem Ayarları > Bluetooth içinde bağlantısını kesin.";
/* Message printed after 'ojd controller disconnect' disconnected the controller. %@ is the controller name. */
"cli.controller.disconnect.done" = "%@ bağlantısı kesildi.";
/* Error of 'ojd controller disconnect' for a Bluetooth Low Energy controller. %@ is the controller name. System Settings and Bluetooth are macOS names. */
"platform.macos.cli.controller.disconnect.bluetoothLe" = "%@ Bluetooth Low Energy ile bağlı ve servis bağlantısını kesemez. Kontrolcüyü kapatın veya Sistem Ayarları > Bluetooth içinde bağlantısını kesin.";
/* Error of 'ojd controller disconnect' when the Bluetooth disconnect fails. %1$@ names the step that failed and %2$@ is the system's reason, which can end with an error code. */
"cli.controller.disconnect.failed" = "%1$@ için Bluetooth bağlantısı kesilemedi: %2$@.";
/* Error of 'ojd controller disconnect' for a controller on a wire. %@ is the controller name. */
"cli.controller.disconnect.notBluetooth" = "%@ Bluetooth ile bağlı değil. Bağlantısını kesmek için fişini çekin.";
/* Long description in the help of 'ojd controller'. CONTROLLER, the command in quotes and VVVV:PPPP stay as written. */
"cli.controller.group.discussion" = "CONTROLLER, “ojd controller list” çıktısındaki bir kimliktir; bağlı kontrolcülerden yalnızca biri sahipse VVVV:PPPP (onaltılık üretici ve ürün kimliği) da olabilir. Her kontrolcü komutu servise ihtiyaç duyar.";
/* Second paragraph of the help of 'ojd controller'. It explains the unit ID, which starts with U- and stays as written. */
"cli.controller.group.discussionUnit" = "Cihaz kimliği (U-...), bir kontrolcüyü modeli ve kullandığı USB bağlantı noktası üzerinden adlandırır. Kontrolcü aynı bağlantı noktasını kullandığı sürece yeniden başlatmalarda aynı kalır.";
/* Error of 'ojd controller' commands when --duration is not a number above 0. --duration stays as written. */
"cli.controller.group.errorDuration" = "--duration için 0’dan büyük bir saniye sayısı gerekir.";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureBrightness" = "ayarlanabilir ışık parlaklığı";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureColor" = "programlanabilir ışık rengi";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featurePlayer" = "oyuncu göstergesi ışıkları";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureRumble" = "titreşim motoru";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureSpeaker" = "hoparlör";
/* One-line summary of 'ojd controller light' in the command list and at the top of its help. */
"cli.controller.light.abstract" = "Bir kontrolcünün ışık rengini veya parlaklığını ayarlar.";
/* Help text of the --brightness option of 'ojd controller light'. LED means light-emitting diode. */
"cli.controller.light.brightness" = "LED parlaklığı.";
/* Help text of the --color option of 'ojd controller light'. The value is a hexadecimal RGB color; FF8000 stays as written. */
