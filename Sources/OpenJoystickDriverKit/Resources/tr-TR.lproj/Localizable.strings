"cli.access.grant.abstract" = "İmzalı bir programın veya yeni bir token'ın uç noktayı kullanmasına izin verir.";
"cli.access.grant.ad_hoc" = "%@ ad-hoc imzalı veya imzasız, bu yüzden herhangi bir yerel program imzasını üstlenebilir. Onu bir Developer ID veya Apple Development sertifikasıyla imzalayın, ardından erişim verin.";
"cli.access.grant.apple_warning" = "Bu programı Apple imzaladı. Komut dosyaları çalıştırıyorsa, örneğin python3 veya osascript, çalıştırdığı her komut dosyası bu erişimi alır.";
"cli.access.grant.client_or_token" = "CLIENT veya --token NAME verin.";
