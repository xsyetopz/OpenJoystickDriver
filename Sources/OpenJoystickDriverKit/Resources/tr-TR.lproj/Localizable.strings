"cli.diagnose.group.serviceRunning" = "çalışıyor %@";
/* Detail of the service check of 'ojd diagnose' when the service is stopped. The command in quotes stays as written. */
"cli.diagnose.group.serviceStopped" = "çalışmıyor; “ojd service start” ile başlatın";
