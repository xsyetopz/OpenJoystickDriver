"cli.diagnose.group.virtualDisabled" = "sanal oyun kontrolcüsü devre dışı";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.diagnose.group.virtualError" = "sanal oyun kontrolcüsü hatası: %@";
