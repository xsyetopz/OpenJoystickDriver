"platform.macos.cli.controller.claim.discussion" = "Model için kaydınızda, yani kayıt dizininizdeki vvvv-pppp.plist dosyasında server değerini ojd yapar ve kaydın diğer alanlarını korur. Modelin her kontrolcüsü için geçerlidir. Çalışan servis bunu yeniden takmadan uygular. Kontrolcüyü bulmak için servis gerekir. --dry-run hiçbir şey yazmaz. OpenJoystickDriver’ın her zaman sunduğu ham USB kullanan ya da macOS’un yerel olarak sunmadığı bir kontrolcü için E2023 ile 1 koduyla çıkar.";
/* One-line summary of 'ojd controller release' in the command list and at the top of its help. */
"platform.macos.cli.controller.release.abstract" = "Bir kontrolcü modelini macOS’a geri verin.";
/* Long description in the help of 'ojd controller release'. server, system and vvvv-pppp.plist stay as written. */
"platform.macos.cli.controller.release.discussion" = "Model için kaydınızda, yani kayıt dizininizdeki vvvv-pppp.plist dosyasında server değerini system yapar ve kaydın diğer alanlarını korur. Modelin her kontrolcüsü için geçerlidir. Çalışan servis bunu yeniden takmadan uygular. Kontrolcüyü bulmak için servis gerekir. --dry-run hiçbir şey yazmaz. OpenJoystickDriver’ın her zaman sunduğu ham USB kullanan ya da macOS’un yerel olarak sunmadığı bir kontrolcü için E2023 ile 1 koduyla çıkar.";
/* Message printed by 'ojd controller claim' and related commands with --dry-run instead of writing the record. %1$@ is the controller identity, %2$@ is the server name in kebab case and %3$@ is the record file. */
"cli.controller.group.serverDryRun" = "%1$@, %2$@ olarak ayarlanırdı (%3$@).";
/* Error when the record file of a controller cannot be changed. %1$@ is the path of the record file and %2$@ is the description of the problem. */
"cli.controller.group.serverInvalid" = "%1$@ değiştirilemiyor: %2$@";
/* Error when a controller has no record to change. %1$@ is the controller identity and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.controller.group.serverNoRecord" = "%1$@ için değiştirilecek bir kontrolcü kaydı yok. “ojd record draft %2$@” ile bir tane oluşturun.";
