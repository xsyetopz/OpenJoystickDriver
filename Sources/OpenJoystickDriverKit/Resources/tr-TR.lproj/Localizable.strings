"cli.root.abstract" = "macOS oyun kontrolcüsü sürücüsü OpenJoystickDriver’ı yapılandırın ve inceleyin.";
"cli.root.discussion" = "Buradan başlayın:\n  ojd status             Servisi, uzantıyı ve izinleri denetler.\n  ojd diagnose           Tüm denetimleri çalıştırır, sorunu bildirir.\n  ojd controller list    Bağlı kontrolcüleri listeler.\n\nÖrnekler:\n  # Bir kontrolcünün girdisini değiştikçe yazdır\n  ojd controller watch 045E:028E\n  # Bağlı kontrolcüleri JSON olarak listele\n  ojd --json controller list\n\nOrtam (seçenek, değişkenin önüne geçer):\n  OJD_NO_INPUT=1         --no-input ile aynı.\n  OJD_TIMEOUT=SECONDS    --timeout ile aynı.\n  OJD_COLOR=WHEN         auto, always (terminal dışında da renkli) veya never.\n\nKabuk tamamlama:\n  ojd --generate-completion-script zsh|bash|fish\n\nÇıkış kodları:\n  0    Başarılı.\n  1    Komut başarısız oldu.\n  64   Kullanım hatası.\n  69   Servis çalışmıyor. “ojd service start” ile başlatın.\n  77   Bir macOS izni eksik.\n  127  Depo derlemesi komutu kurulu uygulamaya aktaramadı.\n  130  Kesintiye uğradı.";
"cli.help.global_options" = "Her komut genel seçenekleri de kabul eder; “ojd --help” bunları listeler.";
"cli.error.env_timeout" = "OJD_TIMEOUT, 0’dan büyük bir saniye sayısı ister.";
"cli.error.env_color" = "OJD_COLOR auto, always veya never ister.";
"cli.error.env_no_input" = "OJD_NO_INPUT 1, true, yes, 0, false veya no ister.";
"cli.virtual.feed.error.plain" = "--plain, JSON satırları yazdıran “virtual feed” için geçerli değildir. --plain seçeneğini kullanmayın.";
"cli.controller.watch.examples" = "Örnekler:\n  # Girdiyi 10 saniye boyunca yazdır\n  ojd controller watch 045E:028E --duration 10\n  # Basılan ilk kontrolü JSON olarak yazdır\n  ojd controller watch 045E:028E --first-press --json\n  # Tüm kontrolcüleri ve sanal oyun kumandalarının gönderdiğini izle\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Örnekler:\n  # Her iki ana motoru 0,45 saniye boyunca 180 değerinde çalıştır\n  ojd controller rumble 045E:028E\n  # Her iki ana motoru 2 saniye boyunca tam güçte çalıştır\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Örnekler:\n  # Işık çubuğunu turuncuya ayarla\n  ojd controller light 054C:09CC --color FF8000\n  # Rengi ve düşük bir parlaklığı ayarla\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Örnekler:\n  # Bir kontrolcü modeli için profil oluştur\n  ojd profile create Racing --controller 045E:028E\n  # Yalnızca Safari öndeyken uygula\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Örnekler:\n  # Bir profili yeniden adlandır\n  ojd profile set Racing name Rally\n  # İlk çubuk eşlemesinin iç ölü bölgesini ayarla\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Örnekler:\n  # Güney düğmesi basılıyken Boşluk tuşunu basılı tut\n  ojd binding set Racing button:south key:space\n  # Her basışta J tuşunu aç/kapat\n  ojd binding set Racing button:west key:j --behavior toggle\n  # Basılı tutulduğu sürece J tuşunu saniyede 10 kez tekrarla\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Örnekler:\n  # Bir kayıt dosyası kur\n  ojd record install 045E-028E.json\n  # Kaydı stdin’den oku\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Örnekler:\n  # Bir programın servisi kullanmasına izin ver\n  ojd access grant /Applications/Example.app\n  # Tek bir kaynaktan sunulan sayfalar için jeton oluştur\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
