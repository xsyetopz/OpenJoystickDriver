/* Row label in the output of 'ojd status'. The state and version of the service follow. */
"cli.status.group.labelService" = "Servis";
/* Heading in the output of 'ojd status' above the list of connected devices that the driver does not support. %lld is the number of devices. */
"cli.status.group.labelUnbound" = "Desteklenmeyen Aygıtlar (%lld)";
/* Row label in the output of 'ojd status'. The state of the virtual gamepad follows. */
"cli.status.group.labelVirtualDevice" = "Sanal Oyun Kontrolcüsü";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is turned off. */
"cli.status.group.virtualOff" = "Kapalı";
/* Value of the 'Virtual gamepad' row of 'ojd status' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.status.group.virtualError" = "Hata: %@";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on and no connected controller has a virtual gamepad. */
"cli.status.group.virtualNonePublished" = "Açık, yayımlanan kontrolcü yok";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on. %@ is the comma-separated list of the names of the controllers that a virtual gamepad stands for. */
"cli.status.group.virtualPublished" = "Açık, yayımlanan: %@";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "Kontrolcüler ve izinler servis çalışırken görünür: “ojd service start”.";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "Uç noktayı açın ve hangi programların bu uç nokta üzerinden kontrolcüleri okuyabileceğini seçin.";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "Programın yolu veya bir istemci kimliği.";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "%@ konumunda program yok ve bu kimliğe sahip bir istemci de yok. Kimlikleri “ojd access list” ile görün.";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ imzalı bir program içermiyor. Programın uygulama paketine veya çalıştırılabilir dosyasına erişim verin.";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "Uç noktayı kapatır ve bağlantılarını sonlandırır; verilen erişimler korunur.";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "Uç nokta kapalı ve bağlantıları sonlandırıldı.";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "Uç nokta, erişim verilen programların kontrolcü olaylarını okuduğu yerel bir sokettir. “ojd access enable” komutunu çalıştırana kadar kapalıdır ve servis yalnızca imzasına erişim verdiğiniz programlara ya da erişim verdiğiniz bir token gönderen programlara yanıt verir. “ojd access web enable”, overlay sayfaları için 127.0.0.1 üzerine bir WebSocket ekler.";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "Uç noktayı açar.";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "Uç nokta açılsın mı? Erişim verdiğiniz programlar tüm kontrolcülerin girdisini okuyabilecek.";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "Önce onay ister. Uç noktayı yalnızca erişim verilen programlar kullanabilir; bunları “ojd access grant” ile ekleyin.";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "Uç nokta %@ üzerinde dinliyor.";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "İmzalı bir programın veya yeni bir token’ın uç noktayı kullanmasına izin verir.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ ad-hoc imzalı veya imzasız, bu yüzden herhangi bir yerel program imzasını üstlenebilir. Onu bir Developer ID veya Apple Development sertifikasıyla imzalayın, ardından erişim verin.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "Bu programı Apple imzaladı. Komut dosyaları çalıştırıyorsa, örneğin python3 veya osascript, çalıştırdığı her komut dosyası bu erişimi alır.";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "CLIENT veya --token NAME verin.";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "%1$@ programının (imza: %2$@) uç noktayı %3$@ ile kullanmasına izin verilsin mi?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
"cli.access.grant.controlWarning" = "control kapsamı, programın sanal bir oyun kontrolcüsündeki düğmelere basmasına izin verir; oyunlar ve uygulamalar bunu sizin girdiniz olarak değerlendirir.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT, programın yoludur veya “ojd access list” çıktısındaki bir kimliktir. Erişim programın imzasına verilir, bu yüzden program güncellendiğinde veya taşındığında da geçerli kalır. ad-hoc imzalı ve imzasız programlara erişim verilemez. CLIENT yerine --token kullanılırsa, bir istemcinin soket üzerinden, --origin değerlerinden birine ait bir sayfadan WebSocket üzerinden veya --origin içermeyen bir token için Origin üstbilgisi göndermeyen bir programdan (örneğin korumalı alandaki bir uygulamadan) WebSocket üzerinden hello iletisinde servisin sınama isteğini imzalamak için kullandığı bir token oluşturur. Bir sayfa control kapsamını kullanamaz. Token yalnızca bir kez gösterilir. Önce onay ister.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Sayfalarının WebSocket üzerinde token’ı kullanabileceği bir web kaynağı, örneğin http://127.0.0.1:8080. Daha fazlasını eklemek için tekrarlayın. WebSocket’in sunduğu kaplama sayfalarının kaynağı http://127.0.0.1:PORT olup bağlantı noktası “ojd access status” komutunun gösterdiği noktadır.";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin, control kapsamıyla birleştirilemez. Bir sayfa asla sanal bir oyun kontrolcüsünü yönetmez; control kapsamını --origin içermeyen bir token’a verin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin için --token gerekir.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Verilecek kapsam: read veya control. İkisi için de yineleyin.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "%1$@, %2$@ programına verildi (kimlik: %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Bir programa erişim vermek yerine bu adla bir token oluşturur.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "%1$@ token’ı, bu Mac’teki programlar için %2$@ ile oluşturulsun mu?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "%1$@ kapsamı %2$@ token’ına verildi (kimlik %3$@). Token’ı gizli tutun; bir daha gösterilmeyecek:";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "%1$@ token’ı, bu Mac’teki programlar ve %2$@ sayfaları için %3$@ ile oluşturulsun mu?";
/* One-line summary of 'ojd access list' in the command list and at the top of its help. */
"cli.access.list.abstract" = "Erişim verilen istemcileri ve token’ları, ayrıca son 24 saatte reddedilenleri listeler.";
/* Long description in the help of 'ojd access list'. It says that the printed IDs work with 'ojd access grant' and 'ojd access revoke'. token:NAME stays as written. */
"cli.access.list.discussion" = "Her istemcinin “ojd access grant” ve “ojd access revoke” tarafından kabul edilen bir kimliği vardır; bir token’ın kimliği token:NAME’dir.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Erişim verilenler:";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Yok";
/* Heading of the list of clients that connected and were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refused" = "Son 24 saatte reddedilenler:";
/* Heading of the list of tokens that were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refusedTokens" = "Son 24 saatte reddedilen token’lar:";
/* Heading of the list of granted tokens printed by 'ojd access list'. */
"cli.access.list.tokens" = "Erişim verilen token’lar:";
/* Lowercase placeholder printed in the token list when a refused token has no name. */
"cli.access.list.unknownToken" = "bilinmeyen token";
/* Error of 'ojd access' commands that change who may read the controllers, when the input is not a terminal and --force is missing. --force stays as written. */
"cli.access.group.needsForce" = "Bu değişiklik programlara kontrolcülerinize erişim verir. Onay sormadan onaylamak için --force ekleyin.";
/* One-line summary of 'ojd access revoke' in the command list and at the top of its help. */
"cli.access.revoke.abstract" = "Bir programın erişimini veya kapsamlarından bazılarını kaldırır.";
/* Help text of the CLIENT argument of 'ojd access revoke'. token:NAME stays as written. */
"cli.access.revoke.client" = "Programın yolu, bir istemci kimliği veya token:NAME.";
/* Long description in the help of 'ojd access revoke'. CLIENT, --scope, 'ojd access list' and token:NAME stay as written. */
"cli.access.revoke.discussion" = "CLIENT, programın yolu, “ojd access list” çıktısındaki bir kimlik veya bir token için token:NAME’dir. --scope olmadan erişimin tamamı kaldırılır. Bir kapsamı kaybeden bağlantılar kapatılır.";
/* Message printed after 'ojd access revoke --scope' removed some scopes. %1$@ is the client ID, %2$@ is the list of scopes it keeps and %3$@ is the number of connections that were closed. */
"cli.access.revoke.partial" = "%1$@ istemcisi %2$@ kapsamını koruyor. Sonlandırılan bağlantılar: %3$@.";
/* Help text of the --scope option of 'ojd access revoke'. The values read and control stay as written because the user types them. */
"cli.access.revoke.scope" = "Kaldırılacak kapsam: read veya control. İkisi için de yineleyin.";
/* Message printed after 'ojd access revoke' removed a whole grant. %1$@ is the client ID and %2$@ is the number of connections that were closed. */
"cli.access.revoke.success" = "%1$@ istemcisinin erişimi kaldırıldı. Sonlandırılan bağlantılar: %2$@.";
/* One-line summary of 'ojd access status' in the command list and at the top of its help. */
"cli.access.status.abstract" = "Uç noktanın açık olup olmadığını, soketini ve bağlı istemcilerini gösterir.";
/* Line of 'ojd access status' with three counts. %1$@ is the number of connected clients, %2$@ the number of granted clients and %3$@ the number of clients refused in the last 24 hours. */
"cli.access.status.counts" = "Bağlı istemciler: %1$@. Erişim verilen istemciler: %2$@. Son 24 saatte reddedilenler: %3$@.";
/* Line of 'ojd access status' when the endpoint is off. Keep the colon and the space after it. */
"cli.access.status.off" = "Uç nokta: kapalı";
/* Line of 'ojd access status' when the endpoint is on. Keep the colon and the space after it. */
"cli.access.status.on" = "Uç nokta: açık";
/* Line of 'ojd access status' that shows where the endpoint listens. %@ is the socket path. */
"cli.access.status.socket" = "Soket: %@";
/* Line of 'ojd access status' with two token counts. %1$@ is the number of granted tokens and %2$@ the number of tokens refused in the last 24 hours. */
"cli.access.status.tokenCounts" = "Erişim verilen token’lar: %1$@. Son 24 saatte reddedilen token’lar: %2$@.";
/* Line of 'ojd access status' when the WebSocket is turned on but its port could not be opened. %@ is the port number. */
"cli.access.status.webClosed" = "WebSocket: açık, ancak %@ bağlantı noktası açılamadı";
/* Line of 'ojd access status' when the WebSocket is off. Keep the colon and the space after it. */
"cli.access.status.webOff" = "WebSocket: kapalı";
/* Line of 'ojd access status' when the WebSocket is on. %1$@ is the WebSocket address, %2$@ is the address of the overlay pages and %3$@ is the folder they are served from. */
"cli.access.status.webOn" = "WebSocket: %1$@ üzerinde açık; overlay sayfaları %2$@ üzerinde, kaynak %3$@";
/* One-line summary of 'ojd access web' in the command list and at the top of its help. The WebSocket serves overlay pages. */
"cli.access.web.abstract" = "Overlay sayfaları için WebSocket’i açar veya kapatır.";
/* One-line summary of 'ojd access web disable' in the command list and at the top of its help. */
"cli.access.web.disableAbstract" = "WebSocket’i kapatır ve bağlantılarını sonlandırır; token’lar korunur.";
/* Message printed after 'ojd access web disable' turned the WebSocket off. */
"cli.access.web.disableSuccess" = "WebSocket kapalı ve bağlantıları kapatıldı.";
/* Long description in the help of 'ojd access web'. It names the address, the path /endpoint and the Overlays folder, which stay as written, and explains which pages may connect. */
"cli.access.web.discussion" = "WebSocket yalnızca 127.0.0.1 üzerinde, /endpoint adresinde dinler ve aynı bağlantı noktasında Overlays klasörünün dosyalarını sunar. Bir sayfa, token verilmiş bir kaynaktan gelmeli ve hello iletisinde servisin sınama isteğini bu token ile imzalamalıdır; birine erişim vermek için “ojd access grant --token NAME --origin URL” kullanın.";
/* One-line summary of 'ojd access web enable' in the command list and at the top of its help. */
"cli.access.web.enableAbstract" = "WebSocket’i açar.";
/* Yes or no question that 'ojd access web enable' asks on a terminal before it turns the WebSocket on. */
"cli.access.web.enableConfirm" = "Token verdiğiniz kaynaklardaki sayfaların uç noktayı kullanabilmesi için WebSocket açılsın mı?";
/* Long description in the help of 'ojd access web enable'. It says that a confirmation comes first and how the port is chosen. --port stays as written. */
"cli.access.web.enableDiscussion" = "Önce onay ister. --port olmadan kayıtlı bağlantı noktasını kullanır; ilk seferde sistem boş bir bağlantı noktası seçer ve servis onu kaydeder.";
/* Help text of the --port option of 'ojd access web enable'. The range is a fixed fact of the command. */
"cli.access.web.port" = "127.0.0.1 üzerindeki bağlantı noktası, 1024 ile 65535 arasında.";
/* Help text of the --automatic option of 'ojd access web enable'. */
"cli.access.web.automatic" = "Kayıtlı bağlantı noktası yerine sistemin boş bir bağlantı noktası seçmesini sağlar.";
/* Error of 'ojd access web enable' when --automatic and --port are both given. Both option names stay as written. */
"cli.access.web.automaticConflict" = "--automatic, --port ile birlikte kullanılamaz.";
/* Error of 'ojd access web enable' when --port is outside the allowed range. --port stays as written. */
"cli.access.web.portRange" = "--port, 1024 ile 65535 arasında olmalıdır.";
/* One-line summary of 'ojd diagnose' in the command list and at the top of its help. */
"cli.diagnose.group.abstract" = "Tüm denetimleri çalıştırır ve neyin yanlış olduğunu bildirir.";
/* Detail of the input mapping check of 'ojd diagnose' when no connected controller has a rejected database line. SDL_GameControllerDB is a project name and stays as written. */
"cli.diagnose.group.inputMappingApplied" = "reddedilen SDL_GameControllerDB satırı yok";
/* Detail of the input mapping check of 'ojd diagnose' for one controller whose database line was rejected. SDL_GameControllerDB is a project name and stays as written. %1$@ is the controller name, %2$@ is the reason in English and %3$@ is the error code, which stays as written. */
"cli.diagnose.group.inputMappingRejected" = "%1$@ için SDL_GameControllerDB satırı reddedildi: %2$@ (%3$@)";
/* Detail of the switch placeholder serial check of 'ojd diagnose' when no 057E:2009 controller is connected. 057E:2009 stays as written. */
"cli.diagnose.group.switchSerialNone" = "bağlı 057E:2009 denetleyicisi yok";
/* Detail of the switch placeholder serial check of 'ojd diagnose' when no connected 057E:2009 controller reports the serial 000000000001. 057E:2009 and the serial stay as written. */
"cli.diagnose.group.switchSerialOther" = "hiçbir 057E:2009 denetleyicisi 000000000001 seri numarasını bildirmiyor";
/* Detail of the switch placeholder serial check of 'ojd diagnose' for one controller. Nintendo Switch Pro Controller is a product name and stays as written. %1$@ is the controller name, %2$@ is the VID:PID and %3$@ is the serial number, both of which stay as written. */
"cli.diagnose.group.switchSerialPlaceholder" = "%1$@, bir Nintendo Switch Pro Controller’ın kimliği ve seri numarası olan %2$@ ve %3$@ seri numarasını bildiriyor; diğer denetleyiciler de aynı seri numarasını bildirebilir. OpenJoystickDriver bunu bir Pro Controller olarak ele alır.";
/* Help text of the --output option of 'ojd diagnose'. A support bundle is a file with the diagnostic report for a bug report. */
"cli.diagnose.group.output" = "Ayrıca bu dosyaya bir destek paketi yazar.";
/* Error of 'ojd diagnose --output' when the support bundle could not be written. %@ is the reason from the system. --output stays as written. */
"cli.diagnose.group.outputFailed" = "Destek paketi yazılamadı: %@. Başka bir --output yolu seçin.";
/* Error of 'ojd diagnose --output' when the folder of the path is missing. %@ is the folder path. --output stays as written. */
"cli.diagnose.group.outputParent" = "--output için var olan bir dizin gerekir; %@ yok.";
/* Progress line of 'ojd diagnose --output' while the support bundle is written. Keep the three dots. */
"cli.diagnose.group.outputProgress" = "Destek paketi yazılıyor…";
/* Message printed after 'ojd diagnose --output' wrote the support bundle. %@ is the file path. The bundle lists the names of the devices, so the user should read it first. */
"cli.diagnose.group.outputWritten" = "Destek paketi %@ konumuna yazıldı. Aygıt adlarını içerir; paylaşmadan önce gözden geçirin.";
/* Long description in the help of 'ojd diagnose'. pass, warn, fail and skip are the check results printed by the command and stay as written, as do --soak and the other option names. */
"cli.diagnose.group.discussion" = "Her denetim pass, warn, fail veya skip sonucunu bildirir. Servise ihtiyaç duyan denetimler, servis durdurulmuşken atlanır. Herhangi bir denetim fail olursa 1 koduyla çıkar. --soak, servisten verilen süre boyunca örnek alan bir çalışma zamanı sağlık denetimi ekler; kullanılmazsa bu denetim atlanır. --output ayrıca bir destek raporu yazar; paylaşmadan önce gözden geçirin.";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has no registration of the extension. The command in quotes stays as written. */
"platform.macos.cli.diagnose.group.transportExtensionAbsent" = "macOS’e kaydedilmemiş; “ojd transport-extension activate” komutunu çalıştırın";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has the extension active. */
"platform.macos.cli.diagnose.group.transportExtensionActive" = "macOS’te etkin";
/* Detail of the transport extension check of 'ojd diagnose' when the extension bundle has an unexpected identifier. %@ is that identifier. OpenJoystickDriver is the product name. */
"cli.diagnose.group.transportExtensionBundleInvalid" = "beklenmeyen paket tanımlayıcısı %@; OpenJoystickDriver’ı yeniden yükleyin";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is not inside the app. OpenJoystickDriver is the product name. */
"cli.diagnose.group.transportExtensionBundleMissing" = "uygulamaya gömülü değil; OpenJoystickDriver’ı yeniden yükleyin";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is inside the app. */
"cli.diagnose.group.transportExtensionBundlePresent" = "uygulamaya gömülü";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is registered but the user has not approved it. The command in quotes stays as written. */
"cli.diagnose.group.transportExtensionInactive" = "kayıtlı ama etkin değil; “ojd transport-extension activate” ile onaylayın";
/* Detail of the transport extension check of 'ojd diagnose' when macOS does not report the registration. %@ is the reason from macOS. */
"platform.macos.cli.diagnose.group.transportExtensionUnavailable" = "macOS kaydı bildirmedi: %@";
/* Last line of 'ojd diagnose' when checks failed. %lld is the number of failed checks. The command with <path> in quotes stays as written. */
"cli.diagnose.group.failed" = "Başarısız denetimler: %lld. Yukarıdaki ayrıntılarla düzeltin veya “ojd diagnose --output <path>” komutunu çalıştırıp dosyayı bir hata raporuna ekleyin.";
/* Help text of the --footprint-limit-mib option of 'ojd diagnose'. The physical footprint is the memory charged to the service in MiB, mebibytes. The range 0-65536 is fixed. */
"cli.diagnose.group.footprintLimit" = "--soak ile, MiB cinsinden bu fiziksel bellek ayak izini aşarsa başarısız olur; 0 devre dışı bırakır (0-65536).";
