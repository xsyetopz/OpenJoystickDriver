"cli.binding.option.double_tap" = "Invia un’altra destinazione quando la sorgente viene premuta due volte entro questo tempo, ad esempio 300:key:c.";
"cli.binding.option.gain" = "Sorgenti ad asse: la scala dell’output, da 0.1 a 10. Predefinito: 1.";
