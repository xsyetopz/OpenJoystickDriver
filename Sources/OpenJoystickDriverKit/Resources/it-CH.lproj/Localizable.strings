"cli.binding.option.pulse_ms" = "Per quanto tempo un impulso mantiene la destinazione, da 1 a 5000 ms. Predefinito: 100.";
"cli.binding.option.response_curve" = "Sorgenti ad asse: come cresce l’output con la corsa. Predefinito: linear.";
