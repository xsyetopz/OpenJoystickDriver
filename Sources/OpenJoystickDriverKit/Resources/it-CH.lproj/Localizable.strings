"cli.binding.option.behavior" = "Quando viene inviata la destinazione. Predefinito: il comportamento dell’assegnazione attuale, oppure hold.";
"cli.binding.option.deadzone" = "Sorgenti ad asse: la parte della corsa che viene ignorata, da 0 a 0.95. Predefinito: 0.1.";
