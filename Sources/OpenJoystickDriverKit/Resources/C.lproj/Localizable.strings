/* Long description in the help of 'ojd record test'. The command in quotes and the JSON terms stay as written. */
"cli.record.test.discussion" = "Replays the received packets of a capture through the parser of the record, then compares the controller state after the last input report with the expected state. The capture is the JSON lines of 'ojd controller capture --json'. The expected state is one JSON object in the shape of a line of 'ojd controller watch --json'. The command lists each field that differs and exits with code 1 when any does. It compares every field except connection, which the running service sets. It needs no running service.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "The expected controller state, as a JSON file.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ is not a controller state: %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "No report in %1$@ carried input for %2$@. Capture again while you press the controls.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "The family of %@ has no parser that runs without a controller.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "A packet capture, as the JSON lines of 'ojd controller capture --json'.";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "The parser of %1$@ rejected received packet %2$lld of %3$@.";
/* Note about a controller record whose raw USB family the USB extension cannot claim because Apple signs its product list. OJD is the short product name. */
"platform.macos.cli.record.group.usbNotClaimed" = "The family uses raw USB, and the USB extension cannot claim this controller, because its product list is signed by Apple. OJD reaches it only through direct USB access, when macOS allows it.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "USB only: add bluetoothLE.vibrationCharacteristic to this Switch 2 record to connect the controller over Bluetooth LE.";
/* One-line summary of 'ojd record validate' in the command list and at the top of its help. */
"cli.record.validate.abstract" = "Check a controller record without installing it.";
/* Long description in the help of 'ojd record validate'. It lists what the check covers and says that the exit status is 1 for an invalid record. The USB extension is the driver extension that gives raw USB access; the exit status 1 stays as written. */
"cli.record.validate.discussion" = "Checks the record's shape, its fields against each other, and its fit with the bundled catalog, and says whether the controller needs the USB extension. Exits 1 when the record is invalid.";
/* Message printed by 'ojd record validate' for a correct record. %1$@ is the file path, %2$@ is the operation in kebab case such as install, %3$@ is the controller model and %4$@ is the protocol family. The command in quotes stays as written. */
"cli.record.validate.valid" = "%1$@ is a valid %2$@ record for %3$@ (%4$@). Install it with 'ojd record install'.";
