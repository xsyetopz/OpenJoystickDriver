/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "Configure and inspect OpenJoystickDriver, the macOS gamepad driver.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Start here:\n  ojd status             Check the service, extension, and permissions.\n  ojd diagnose           Run every check and report what is wrong.\n  ojd controller list    List connected controllers.\n\nExamples:\n  # Print the input of one controller as it changes\n  ojd controller watch 045E:028E\n  # List connected controllers as JSON\n  ojd --json controller list\n\nEnvironment (a flag beats its variable):\n  OJD_NO_INPUT=1         Same as --no-input.\n  OJD_TIMEOUT=SECONDS    Same as --timeout.\n  OJD_COLOR=WHEN         auto, always (color even off a terminal), or never.\n\nShell completion:\n  ojd --generate-completion-script zsh|bash|fish\n\nExit codes:\n  0    Success.\n  1    The command failed.\n  64   Usage error.\n  69   The service is not running. Start it with 'ojd service start'.\n  77   A macOS permission is missing.\n  127  A repository build could not hand the command to the installed app.\n  130  Interrupted.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Every command also takes the global options; 'ojd --help' lists them.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT needs a number of seconds above 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR needs auto, always, or never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT needs 1, true, yes, 0, false, or no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain does not apply to 'virtual feed', which prints JSON lines. Leave out --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Examples:\n  # Print input for 10 seconds\n  ojd controller watch 045E:028E --duration 10\n  # Print the first control pressed, as JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Watch every controller and what its virtual gamepad sends\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Examples:\n  # Run both main motors at 180 for 0.45 seconds\n  ojd controller rumble 045E:028E\n  # Run both main motors at full strength for 2 seconds\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Examples:\n  # Set the lightbar to orange\n  ojd controller light 054C:09CC --color FF8000\n  # Set the color and a low brightness\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Examples:\n  # Create a profile for a controller model\n  ojd profile create Racing --controller 045E:028E\n  # Apply it only while Safari is in front\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Examples:\n  # Rename a profile\n  ojd profile set Racing name Rally\n  # Set the inner deadzone of the first stick mapping\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Examples:\n  # Hold Space while the south button is held\n  ojd binding set Racing button:south key:space\n  # Toggle J on each press\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Repeat J 10 times a second while held\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Examples:\n  # Install a record file\n  ojd record install 045e-028e.plist\n  # Read the record from stdin\n  ojd record install - < 045e-028e.plist";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Examples:\n  # Let a program use the service\n  ojd access grant /Applications/Example.app\n  # Create a token for pages served at one origin\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
