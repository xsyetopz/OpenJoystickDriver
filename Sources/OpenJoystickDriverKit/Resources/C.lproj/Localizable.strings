"error.E4001.message" = "The package manifest mod.plist is missing or invalid. Check it against the mod-package schema and run the command again.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "The package requires a different version of OpenJoystickDriver than the one that runs. Install a package version that supports this version, or update OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.plist stays as written. */
"error.E4003.message" = "A file of the package is invalid, missing, or not listed in mod.plist. Fix the file that the command names and run it again.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "The package covers a controller, persona, or profile that your own files or another installed package already hold. Remove the clashing file or package, or change the package, and run the command again.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "A package with this name is already installed. Run the command with --force to replace it.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "No installed package has this name. Run 'ojd mod list' to see the installed packages.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "The package folder could not be changed. Check the free disk space and the folder permissions.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "A document has no apiVersion, or its apiVersion is not supported by this version of OpenJoystickDriver. Change the document to the supported apiVersion that the message names, and run the command again.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "A protocol description is invalid. Check the file against the protocol-description schema and fix the field that the message names.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "A protocol description names a family that differs from its file name. Name the file after its family.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "A protocol description lists a variant that its family does not have. Use one of the variants of the family.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.plist is a file name and stays as written. */
"error.E5005.message" = "The access file AccessGrants.plist is damaged. Fix the file or delete it, then grant access again.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "The key file of the unit IDs, PortKeyInstallation.key, cannot be read or is not 32 bytes. Restore the file from a backup. If you delete it instead, OpenJoystickDriver creates a new key and every unit ID changes.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "A controller record or patch is invalid. Check the file against its schema and fix the field that the message names.";
/* Error E5007, in place of a file path when the message does not know which file failed. */
"error.E5007.thisFile" = "this record file";
/* Error E5007, shown when the bundled controller catalog holds no record file. */
"error.E5007.record.catalogEmpty" = "Controllers folder of the bundled catalog: the catalog has no record file. Rule: the catalog holds at least one controller record. Fix: reinstall OpenJoystickDriver.";
/* Error E5007, shown when a record file is not named after its own vendorID and productID. %1$@ is the file, %2$@ the name it must have. */
"error.E5007.record.fileName" = "%1$@, vendorID and productID: the file name must be %2$@, the two IDs in hex. Fix: rename the file to %2$@, or correct the IDs in it.";
/* Error E5007, shown when two record files give one controller model. %1$@ is the file, %2$@ the model, %3$@ the file that holds it first. */
"error.E5007.record.duplicateIdentity" = "%1$@, vendorID and productID: %2$@ is already the identity of the record in %3$@. Fix: delete one of the two files, or change the IDs of this one.";
/* Error E5007, shown when a value of a record cannot be written as JSON. %1$@ is the file, %2$@ the reason. */
"error.E5007.record.unwritableValue" = "%1$@, document: a value cannot be written as JSON (%2$@). Fix: replace the value that the reason names with a string, number, boolean, list or dictionary.";
/* Error E5007, shown when the vendorID or productID of a record is out of range. %1$@ is the file. */
"error.E5007.record.idRange" = "%1$@, vendorID and productID: vendorID must be 1...65535 and productID 0...65535. Fix: set each to a whole number in its range.";
/* Error E5007, shown when a patch file fails: the file is not a dictionary. %1$@ is the file. */
"error.E5007.patch.patchNotObject" = "%1$@, document: The file is not a JSON object. Fix: Make the file a dictionary with apiVersion, kind, selector, and patch or remove.";
/* Error E5007, shown when a patch file fails: the file lacks apiVersion, kind, selector, or patch and remove. %1$@ is the file. */
"error.E5007.patch.patchFields" = "%1$@, document: The file must hold apiVersion, kind, selector, and patch or remove. Fix: Add the missing member.";
/* Error E5007, shown when a record or protocol description breaks a rule: HID startup writes are in a raw-USB mode or family. %1$@ is the file. */
"error.E5007.session.hidStartup" = "%1$@, session.startup: HID startup writes apply only to HID controllers, so not to a raw-USB mode or family. Fix: Remove the HID startup writes, or use raw-USB packets.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode names a session keepAlive for a family that declares its own. %2$@ is the family. %1$@ is the file. */
"error.E5007.session.keepAliveFamily" = "%1$@, session.keepAlive: A session keepAlive needs a raw-USB family whose description declares none, and %2$@ declares one. Fix: Remove the session keepAlive, because %2$@ already runs its own.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names a session key that only raw-USB modes take. %2$@ is the key. %1$@ is the file. */
"error.E5007.session.rawUSBOnly" = "%1$@, session.%2$@: Session %2$@ applies only to raw-USB modes. Fix: Remove %2$@ from the session, or use a raw-USB protocol.";
/* Error E5007, shown when a record or protocol description breaks a rule: raw-USB startup writes are in a mode whose family does not read them or that lists initialization. %1$@ is the file. */
"error.E5007.session.usbStartup" = "%1$@, session.startup: Raw-USB startup writes need a family that reads them and a mode with no initialization list. Fix: Remove the raw-USB startup writes, or use a family that reads them and drop the initialization list.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is not the kind of packet its protocol uses. %1$@ is the file. */
"error.E5007.rumble.templateKind" = "%1$@, session.rumble: A rumble template is a usb packet for a raw-USB protocol and a HID report for a HID protocol. Fix: Write the template as the kind of packet that the protocol uses.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is in a family whose driver does not encode it. %1$@ is the file. */
"error.E5007.rumble.templateDriver" = "%1$@, session.rumble: Rumble templates need a driver that encodes them. Fix: Remove the rumble template, or use a family whose driver encodes it.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is beside a session keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: A rumble resendIntervalMilliseconds cannot be combined with a session keepAlive. Fix: Remove resendIntervalMilliseconds, or remove the session keepAlive.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is in a family that declares its own keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithFamilyKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: A rumble resendIntervalMilliseconds needs a family whose description declares no keepAlive. Fix: Remove resendIntervalMilliseconds, because the keep-alive of the family sets the timing.";
/* Error E5007, shown when a record or protocol description breaks a rule: a record has no mode. %1$@ is the file. */
"error.E5007.modes.empty" = "%1$@, modes: Modes must hold at least one mode. Fix: Add a mode.";
/* Error E5007, shown when a record or protocol description breaks a rule: more than one mode has the id default. %1$@ is the file. */
"error.E5007.modes.defaultCount" = "%1$@, modes: At most one mode has the id default. Fix: Give the id default to one mode only.";
/* Error E5007, shown when a record or protocol description breaks a rule: two modes share an id. %1$@ is the file. */
"error.E5007.modes.uniqueIDs" = "%1$@, modes: Each mode id must be unique. Fix: Rename the modes that repeat an id.";
/* Error E5007, shown when a record or protocol description breaks a rule: a raw-USB mode names an interface. %1$@ is the file. */
"error.E5007.modes.interfaceRawUSB" = "%1$@, modes[].interface: A raw-USB mode has no interface, because it claims the interface that its usb transport resolves. Fix: Remove interface from the mode.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names endpoints in its interfaceSignature. %1$@ is the file. */
"error.E5007.modes.endpointsHID" = "%1$@, modes[].match.interfaceSignature.endpoints: A HID mode's interfaceSignature has no endpoints, because only the raw-USB scanner reads an endpoint set. Fix: Remove endpoints from the interfaceSignature.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode that needs input layouts finds none in the record. %1$@ is the file. */
"error.E5007.modes.inputLayoutNeeded" = "%1$@, input: A HIDReportLayout mode needs the input layouts of the record. Fix: Add input with the layouts, or use another protocol.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HIDDescriptor mode finds input layouts in the record. %1$@ is the file. */
"error.E5007.modes.usageMapNotLayouts" = "%1$@, input: A HIDDescriptor mode reads a usage map, not input layouts. Fix: Replace the input layouts with a usage map.";
/* Error E5007, shown when a record or protocol description breaks a rule: a usage map is in a record whose modes include a driver that does not read one. %1$@ is the file. */
"error.E5007.modes.usageMapDriver" = "%1$@, input.usageMap: A HID usage map applies only if the driver of every mode reads one. Fix: Remove the usage map, or use only drivers that read one.";
/* Error E5007, shown when a record or protocol description breaks a rule: a capability is not declared by the driver of any mode. %1$@ is the file. */
"error.E5007.modes.capabilities" = "%1$@, capabilities: Capabilities must be deltas that the driver of some mode declares. Fix: Keep only capabilities that the driver of a mode declares.";
/* Error E5007, shown when a record or protocol description breaks a rule: a tuning key is not read by the driver. %2$@ is the key and %3$@ is the driver. %1$@ is the file. */
"error.E5007.tuning.keyNotRead" = "%1$@, tuning.%2$@: %2$@ is not read by the %3$@ driver. Fix: Remove %2$@ from tuning, or use a driver that reads it.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults of a protocol description hold input layouts for a family that reads none. %1$@ is the file. */
"error.E5007.protocolDescription.inputLayout" = "%1$@, defaults.input: An input layout applies only to a family that reads one. Fix: Remove the input layout from the defaults.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults of a protocol description hold a usage map for a family that reads none. %1$@ is the file. */
"error.E5007.protocolDescription.usageMap" = "%1$@, defaults.input.usageMap: A HID usage map applies only to a family that reads one. Fix: Remove the usage map from the defaults.";
/* Error E5007, shown when a record or protocol description breaks a rule: a protocol description sets receiverPowerOff for a family other than XboxXUSB. %1$@ is the file. */
"error.E5007.protocolDescription.receiverPowerOff" = "%1$@, defaults.receiverPowerOff: The receiverPowerOff default applies only to XboxXUSB. Fix: Remove receiverPowerOff from the defaults.";
/* Error E5007, shown when a record or protocol description breaks a rule: a protocol description lists session keys for a family that reads none. %2$@ is the family. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeysNone" = "%1$@, sessionKeys: %2$@ reads no session keys. Fix: Leave sessionKeys empty.";
/* Error E5007, shown when a record or protocol description breaks a rule: the session keys of a protocol description differ from those its family reads. %2$@ is the family and %3$@ are the keys it reads. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeysRead" = "%1$@, sessionKeys: %2$@ reads the session keys %3$@. Fix: Set sessionKeys to %3$@.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults set a session key that sessionKeys does not list. %2$@ is the key. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeyUnlisted" = "%1$@, defaults.session: The defaults set the session key %2$@, which sessionKeys does not list. Fix: Add %2$@ to sessionKeys, or remove it from the defaults.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family that is always raw USB has a HID keep-alive write. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveHID" = "%1$@, defaults.session.keepAlive.writes: A HID keep-alive write applies only to HID controllers. Fix: Remove the HID write, or use a raw-USB write.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family without a raw-USB variant has a raw-USB keep-alive write. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveUSB" = "%1$@, defaults.session.keepAlive.writes: A raw-USB keep-alive write applies only to a family with a raw-USB variant. Fix: Remove the raw-USB write, or use a HID write.";
/* Error E5007, shown when a record or protocol description breaks a rule: a keep-alive write names a resendTuning that the family does not read or default. %2$@ is the key. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveResendTuning" = "%1$@, defaults.session.keepAlive.writes[].resendTuning: The resendTuning of a keep-alive write names %2$@, which the family must read and give a default. Fix: Name a tuning key that the family reads and defaults, or remove resendTuning.";
/* Error E5007, shown when a record or protocol description breaks a rule: activation or deactivation names a transport that writeTransports does not list. %1$@ is the file. */
"error.E5007.protocolDescription.activationTransport" = "%1$@, activation: Activation and deactivation name only a transport that writeTransports lists. Fix: Name a transport from writeTransports, or add it there.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults leave out session fields that the family reads. %2$@ is the family and %3$@ are the fields. %1$@ is the file. */
"error.E5007.protocolDescription.sessionMissing" = "%1$@, defaults.session: %2$@ must set the session fields %3$@. Fix: Set %3$@ in the defaults.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults set session fields that the family does not read. %2$@ is the family and %3$@ are the fields. %1$@ is the file. */
"error.E5007.protocolDescription.sessionUnread" = "%1$@, defaults.session: %2$@ does not read the session fields %3$@. Fix: Remove %3$@ from the defaults.";
/* Error E5007, shown when a record or protocol description breaks a rule: a named packet id does not start with its family. %2$@ is the family. %1$@ is the file. */
"error.E5007.protocolDescription.namedPacketPrefix" = "%1$@, namedPackets: Each named packet id starts with %2$@/. Fix: Rename the packets so that each id starts with %2$@/.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family that is always raw USB lists tuningKeys. %1$@ is the file. */
"error.E5007.protocolDescription.tuningRawUSB" = "%1$@, tuningKeys: A family that is always raw USB reads its tuning through rawUSBTuningKeys. Fix: Move the keys from tuningKeys to rawUSBTuningKeys.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family without a raw-USB variant lists rawUSBTuningKeys. %1$@ is the file. */
"error.E5007.protocolDescription.rawUSBTuningKeys" = "%1$@, rawUSBTuningKeys: The rawUSBTuningKeys apply only to a family with a raw-USB variant. Fix: Remove rawUSBTuningKeys, or add a raw-USB variant.";
/* Error E5007, shown when a record or protocol description breaks a rule: bytes are not uppercase hex pairs. %2$@ is the field and %3$@ is what the bytes belong to. %1$@ is the file. */
"error.E5007.record.hexBytes" = "%1$@, %2$@: The %3$@ bytes must be uppercase hex pairs separated by single spaces. Fix: Write %2$@ as pairs such as 42 03 00, with uppercase digits and one space between pairs.";
/* Error E5007, shown when a patch file fails: patch is empty or names a section that does not exist. %1$@ is the file. */
"error.E5007.patch.patchSections" = "%1$@, patch: Patch must hold modes, usb, bluetoothLE, capabilities, server, route, heldByAppleDriver, input, or tuning. Fix: Keep only those sections and give at least one of them.";
/* Error E5007, shown when a virtual device file fails: a persona name is not a known persona. %2$@ is the known names. %1$@ is the file. */
"error.E5007.virtualDevice.persona" = "%1$@, persona: The persona must be one of %2$@. Fix: Set persona to one of them.";
/* Error E5007, shown when a virtual device file fails: a persona file selects no model, and a user file must. %1$@ is the file. */
"error.E5007.virtualDevice.matchRequired" = "%1$@, match: A file in the user folder must hold match. Fix: Add match with the vendorID and productID of the model.";
/* Error E5007, shown when a virtual device file fails: a layout is not a known layout. %2$@ is the known layouts. %1$@ is the file. */
"error.E5007.virtualDevice.layout" = "%1$@, layout: The layout must be one of %2$@. Fix: Set layout to one of them.";
/* Error E5007, shown when a virtual device file fails: a transport is not USB or Bluetooth. %1$@ is the file. */
"error.E5007.virtualDevice.transport" = "%1$@, transport: The transport must be USB or Bluetooth. Fix: Set transport to USB or Bluetooth.";
/* Error E5007, shown when a virtual device file fails: labels are not Xbox or Generic. %1$@ is the file. */
"error.E5007.virtualDevice.labels" = "%1$@, labels: The labels must be Xbox or Generic. Fix: Set labels to Xbox or Generic.";
/* Error E5007, shown when a virtual device file fails: a file with match also holds layout, transport or worksWithDefaultSDLHints. %1$@ is the file. */
"error.E5007.virtualDevice.matchExtras" = "%1$@, match: A file with match selects a persona, so it cannot hold layout, transport or worksWithDefaultSDLHints. Fix: Remove layout, transport and worksWithDefaultSDLHints, or remove match.";
/* Error E5007, shown when a virtual device file fails: a persona definition lacks layout, transport, labels, worksWithDefaultSDLHints or identity with version. %1$@ is the file. */
"error.E5007.virtualDevice.definition" = "%1$@, persona: A persona definition must hold layout, transport, labels, worksWithDefaultSDLHints, and identity with version. Fix: Add the missing keys, or add match to select a persona instead.";
/* Error E5007, shown when a virtual device file fails: a match unit is not a unit ID. %1$@ is the file. */
"error.E5007.virtualDevice.matchUnit" = "%1$@, match.unit: The match unit must be a unit ID. Fix: Set unit to the unit ID of a controller, or leave it out.";
/* Error E5007, shown when a virtual device file fails: an identity name is empty. %2$@ is the key, productName or manufacturer. %1$@ is the file. */
"error.E5007.virtualDevice.identityText" = "%1$@, identity.%2$@: A persona identity needs a nonempty %2$@. Fix: Give %2$@ a nonempty string.";
/* Error E5007, shown when a virtual device file fails: an ID is outside its range. %2$@ is the key path of the ID and %3$@ is its lowest value. %1$@ is the file. */
"error.E5007.virtualDevice.idRange" = "%1$@, %2$@: An ID must be %3$@...65535. Fix: Set %2$@ to %3$@...65535.";
/* Error E5007, shown when the subcommands of a record fail: a subcommand counterModulus is outside 2...256. %1$@ is the file. */
"error.E5007.subcommandPlan.counterModulus" = "%1$@, session.subcommands.counterModulus: A subcommand counterModulus must be 2...256. Fix: Set counterModulus to 2...256.";
/* Error E5007, shown when the subcommands of a record fail: subcommands name no request or more than 16. %1$@ is the file. */
"error.E5007.subcommandPlan.requestsCount" = "%1$@, session.subcommands.requests: Subcommands must name 1...16 requests. Fix: List 1...16 requests.";
/* Error E5007, shown when the subcommands of a record fail: two SPI reads share a purpose. %1$@ is the file. */
"error.E5007.subcommandPlan.spiPurpose" = "%1$@, session.subcommands.requests[].spiRead.purpose: Each SPI read purpose must appear at most once. Fix: Give each SPI read its own purpose.";
/* Error E5007, shown when the subcommands of a record fail: a player indicator lacks a pattern for one of its indicators. %1$@ is the file. */
"error.E5007.subcommandPlan.playerIndicator" = "%1$@, session.subcommands.playerIndicator.patterns: A player indicator must name a pattern for every indicator. Fix: Give patterns off, player1, player2, player3 and player4.";
/* Error E5007, shown when the subcommands of a record fail: a subcommand request holds no data byte or more than 16. %1$@ is the file. */
"error.E5007.subcommandPlan.dataCount" = "%1$@, session.subcommands.requests[].data: A subcommand request must name 1...16 data bytes. Fix: Give data 1...16 bytes.";
/* Error E5007, shown when the subcommands of a record fail: an SPI read length is outside 1...29. %1$@ is the file. */
"error.E5007.subcommandPlan.spiLength" = "%1$@, session.subcommands.requests[].spiRead.length: An SPI read length must be 1...29. Fix: Set length to 1...29.";
/* Error E5007, shown when the subcommands of a record fail: a subcommand request names both data and spiRead, or neither. %1$@ is the file. */
"error.E5007.subcommandPlan.dataOrSpiRead" = "%1$@, session.subcommands.requests[]: A subcommand request must name exactly one of data and spiRead. Fix: Keep data or spiRead, and remove the other.";
/* Error E5007, shown when the named packets of a record fail: the named packets are none or more than 16. %1$@ is the file. */
"error.E5007.namedPacketPlan.count" = "%1$@, session.namedPackets: Named packets must name 1...16 packets. Fix: List 1...16 packets.";
/* Error E5007, shown when the named packets of a record fail: two named packets share an id. %1$@ is the file. */
"error.E5007.namedPacketPlan.uniqueId" = "%1$@, session.namedPackets[].id: Each named packet id must appear at most once. Fix: Give each packet its own id.";
/* Error E5007, shown when the named packets of a record fail: a named packet id is not a family, a slash and lowercase words joined by hyphens. %1$@ is the file. */
"error.E5007.namedPacketPlan.idForm" = "%1$@, session.namedPackets[].id: A named packet id must be a family, a slash and lowercase words joined by hyphens. Fix: Write the id like xbox/start-input.";
/* Error E5007, shown when the named packets of a record fail: a named packet has fewer than 3 bytes or its session byte is not 2. %1$@ is the file. */
"error.E5007.namedPacketPlan.shape" = "%1$@, session.namedPackets[].sessionByte: A named packet must have at least 3 bytes and its session byte must be 2. Fix: Give bytes at least 3 bytes and set sessionByte to 2.";
/* Error E5007, shown when a startup write of a record fails: a startup packet reference sits in a record instead of a protocol description. %1$@ is the file. */
"error.E5007.startupWrite.packetReference" = "%1$@, session.startup[].packet: A startup packet reference is only for protocol descriptions. Fix: Write the bytes in the record instead of packet.";
/* Error E5007, shown when a startup write of a record fails: a startup phase is not Startup or Activation. %1$@ is the file. */
"error.E5007.startupWrite.phase" = "%1$@, session.startup[].phase: A startup phase must be Startup or Activation. Fix: Set phase to one of them, or leave it out.";
/* Error E5007, shown when a startup write of a record fails: a startup crc32Seed is outside 0...255. %1$@ is the file. */
"error.E5007.startupWrite.crcSeedRange" = "%1$@, session.startup[].crc32Seed: A startup crc32Seed must be 0...255. Fix: Set crc32Seed to 0...255, or leave it out.";
/* Error E5007, shown when a virtual device persona file fails: a persona file repeats the match of an earlier user file. %2$@ is the name of that file. %1$@ is the file. */
"error.E5007.virtualDevice.matchTakenByUserFile" = "%1$@, match: A persona file must not repeat the match of the user file %2$@. Fix: Give each model one persona file, or change match in one of the two.";
/* Error E5007, shown when a virtual device persona file fails: a persona file repeats the match of an earlier package file. %2$@ is the name of that file. %1$@ is the file. */
"error.E5007.virtualDevice.matchTakenByPackageFile" = "%1$@, match: A persona file must not repeat the match of the package file %2$@. Fix: Give each model one persona file, or change match in one of the two.";
/* Error E5007, shown when the keep-alive of a record fails: a keep-alive interval is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.keepAlive.interval" = "%1$@, session.keepAlive.intervalMilliseconds: A keep-alive interval must be 1...60000 ms. Fix: Set intervalMilliseconds to 1...60000.";
/* Error E5007, shown when the keep-alive of a record fails: a keep-alive lists no writes or more than 8. %1$@ is the file. */
"error.E5007.keepAlive.writesCount" = "%1$@, session.keepAlive.writes: A keep-alive must name no writes or 1...8 of them. Fix: List 1...8 writes, or leave writes out.";
/* Error E5007, shown when the keep-alive of a record fails: a keep-alive resendTuning is not lizardResendTicks. %1$@ is the file. */
"error.E5007.keepAlive.resendTuning" = "%1$@, session.keepAlive.writes[].resendTuning: A keep-alive resendTuning must be lizardResendTicks. Fix: Set resendTuning to lizardResendTicks, or leave it out.";
/* Error E5007, shown when a record file fails: the bundled virtual devices hold no record for a persona. %2$@ is the persona. %1$@ is the file. */
"error.E5007.virtualDevice.bundledMissing" = "%1$@, persona: The bundled records must hold a record for the persona %2$@. Fix: Reinstall OpenJoystickDriver.";
/* Error E5007, shown when a record file fails: a bundled virtual device record does not define its persona or holds a match. %2$@ is the persona. %1$@ is the file. */
"error.E5007.virtualDevice.bundledPersona" = "%1$@, persona: A bundled record must define the persona %2$@ and hold no match. Fix: Reinstall OpenJoystickDriver.";
/* Error E5007, shown when a record file fails: a package file is listed under the wrong list in mod.plist. %2$@ is the list, %3$@ the kind the file has and %4$@ the kind the list takes. %1$@ is the file. */
"error.E5007.modPackage.kindMismatch" = "%1$@, %2$@: A %3$@ file cannot be listed under %2$@ in mod.plist, which lists %4$@ files. Fix: List the file under the list that matches its kind.";
/* Error E5007, shown when a record file fails: a controller names a vendorID or productID outside its range. %1$@ is the file. */
"error.E5007.record.identityRange" = "%1$@, vendorID: A controller needs a vendorID of 1...65535 and a productID of 0...65535. Fix: Set vendorID and productID inside those ranges.";
/* Error E5007, shown when a record file fails: a controller names an unsupported USB configuration. %2$@ is the configuration. %1$@ is the file. */
"error.E5007.deviceCatalog.usbConfiguration" = "%1$@, usb.configuration: A USB configuration must be SetConfiguration1BeforeClaim, not %2$@. Fix: Set configuration to SetConfiguration1BeforeClaim, or leave it out.";
/* Error E5007, shown when a record file fails: a patch file sits at a path its selector does not give. %2$@ is the expected path. %1$@ is the file. */
"error.E5007.patch.path" = "%1$@, selector: A patch file must sit at %2$@. Fix: Move the file there, or change its selector.";
/* Error E5007, shown when a record file fails: the tuning defaults patch has a selector other than all. %1$@ is the file. */
"error.E5007.tuningDefaults.selector" = "%1$@, selector: The selector of the tuning defaults must be all. Fix: Set selector to all.";

/* Error E5007, shown when a patch file fails: an entry of patch.modes has no id or holds a key that a mode does not have. %1$@ is the file. */
"error.E5007.patch.patchModeEntries" = "%1$@, patch.modes: Each entry must hold an id and only id, protocol, match, interface, session, or idle. Fix: Give each entry an id and delete any other key.";
/* Error E5007, shown when a patch file fails: an all patch sets a section other than tuning. %1$@ is the file. */
"error.E5007.patch.patchAllOnlyTuning" = "%1$@, patch: An all patch may set only tuning. Fix: Move the other sections into a patch for one controller.";
/* Error E5007, shown when a patch file fails: remove is not a nonempty list. %1$@ is the file. */
"error.E5007.patch.removeNotList" = "%1$@, remove: Remove must be a nonempty list of dotted key paths. Fix: List the key paths to remove, or delete remove.";
/* Error E5007, shown when a patch file fails: a remove entry is not text. %1$@ is the file. */
"error.E5007.patch.removeNotText" = "%1$@, remove: Remove must hold dotted key paths as text. Fix: Write each entry as a string.";
/* Error E5007, shown when a patch file fails: a remove path is not in the record schema. %2$@ is the path. %1$@ is the file. */
"error.E5007.patch.removePathUnknown" = "%1$@, remove: The path %2$@ is not in the record schema. Fix: Use a key path that the record schema has, or delete the entry.";
/* Error E5007, shown when a patch file fails: a remove path is listed twice. %2$@ is the path. %1$@ is the file. */
"error.E5007.patch.removeDuplicate" = "%1$@, remove: The path %2$@ is listed twice. Fix: Delete one of the two entries.";
/* Error E5007, shown when a patch file fails: an all patch removes a key outside tuning. %2$@ is the path. %1$@ is the file. */
"error.E5007.patch.removeAllNotTuning" = "%1$@, remove: An all patch may remove only tuning keys, not %2$@. Fix: Remove only tuning keys here, or use a patch for one controller.";
/* Error E5007, shown when a patch file fails: the selector is not a dictionary. %1$@ is the file. */
"error.E5007.patch.selectorNotObject" = "%1$@, selector: Selector must be all, model, or vendorID with productID. Fix: Write selector as a dictionary of one of those forms.";
/* Error E5007, shown when a patch file fails: selector.all is not true. %1$@ is the file. */
"error.E5007.patch.selectorAllTrue" = "%1$@, selector.all: Selector.all must be true. Fix: Set all to true, or use model or vendorID with productID.";
/* Error E5007, shown when a patch file fails: a selector ID is out of range. %1$@ is the file. */
"error.E5007.patch.selectorIdRange" = "%1$@, selector.vendorID, selector.productID: VendorID must be 1...65535 and productID 0...65535. Fix: Set each to a whole number in its range.";
/* Error E5007, shown when a patch file fails: selector.model is not vvvv-pppp in lowercase hex. %1$@ is the file. */
"error.E5007.patch.selectorModel" = "%1$@, selector.model: Selector.model must be vvvv-pppp in lowercase hex. Fix: Write each ID as four lowercase hex digits.";
/* Error E5007, shown when a patch file fails: the selector has members of no form. %1$@ is the file. */
"error.E5007.patch.selectorShape" = "%1$@, selector: Selector must be all, model, or vendorID with productID. Fix: Keep exactly the members of one of those forms.";
/* Error E5007, shown when a user or package record file is skipped: a Controller file is not named after its IDs. %2$@ is the name it must have. %1$@ is the file. */
"error.E5007.userFile.fileNameRecord" = "%1$@, file name: The file name must be %2$@. Fix: Rename the file to %2$@, or correct the IDs in it.";
/* Error E5007, shown when a user or package record file is skipped: two packages give one controller. %2$@ is the other package. %1$@ is the file. */
"error.E5007.userFile.packageSameController" = "%1$@, vendorID, productID: The package %2$@ already gives this controller. Fix: Remove one of the two packages, or change the IDs of this record.";
/* Error E5007, shown when a user or package record file is skipped: a patch file is not named after its selector. %2$@ is the name it must have. %1$@ is the file. */
"error.E5007.userFile.fileNamePatch" = "%1$@, file name: The file name must be %2$@. Fix: Rename the file to %2$@, or correct the selector in it.";
/* Error E5007, shown when a user or package record file is skipped: the file is not a dictionary. %1$@ is the file. */
"error.E5007.userFile.notDictionary" = "%1$@, document: The file is not a dictionary. Fix: Make the root of the property list a dictionary.";
/* Error E5007, shown when a user or package record file is skipped: a Controller file names a bundled controller. %2$@ is the model. %1$@ is the file. */
"error.E5007.userFile.bundledController" = "%1$@, vendorID, productID: %2$@ is a bundled controller, so a Controller file cannot add it. Fix: Write a patch file for it instead.";
/* Error E5007, shown when a user or package record file is skipped: the file adds or patches a bootloader identity. %2$@ is the model. %1$@ is the file. */
"error.E5007.userFile.bootloaderController" = "%1$@, vendorID, productID: %2$@ is a bootloader identity, so no user or package file can add or patch it. Fix: Remove the file; OJD sends a controller in bootloader state no data.";
/* Error E5007, shown when a user or package record file is skipped: a patch selects no known controller. %2$@ is the selector. %1$@ is the file. */
"error.E5007.userFile.unknownController" = "%1$@, selector: The selector %2$@ matches no known controller. Fix: Use a Controller file to add a new controller, or correct the selector.";
/* Error E5007, shown when a user or package record file is skipped: the record that a patch applies to is not a dictionary. %1$@ is the file. */
"error.E5007.userFile.upstreamNotDictionary" = "%1$@, document: The record that the patch applies to is not a dictionary. Fix: Repair the record file that the patch applies to.";
/* Error E5007, shown when a user or package record file is skipped: a patch changes nothing in the record. %1$@ is the file. */
"error.E5007.userFile.patchNoChange" = "%1$@, patch: The patch changes nothing in the record. Fix: Delete the patch, or set a value that differs from the record.";
/* Error E5007, shown when an input layout of a record fails: input lists no layout. %1$@ is the file. */
"error.E5007.inputLayout.layoutsEmpty" = "%1$@, input.layouts: Input must list at least one layout. Fix: Add a layout, or delete input.";
/* Error E5007, shown when an input layout of a record fails: two layouts select one report. %2$@ and %3$@ are the layouts. %1$@ is the file. */
"error.E5007.inputLayout.layoutsSameReport" = "%1$@, input.layouts: Two layouts select the same report: %2$@ and %3$@. Fix: Give them different report IDs or lengths, or delete one.";
/* Error E5007, shown when an input layout of a record fails: a report ID is out of range. %1$@ is the file. */
"error.E5007.inputLayout.reportIdRange" = "%1$@, input.layouts[].report.id: A report ID is 1...255. Fix: Set the ID to a whole number from 1 to 255, or leave it out.";
/* Error E5007, shown when an input layout of a record fails: a report length is out of range. %2$@ is the longest length. %1$@ is the file. */
"error.E5007.inputLayout.reportLength" = "%1$@, input.layouts[].report.length: A report is 1...%2$@ bytes long, with its ID byte. Fix: Set the length inside that range.";
/* Error E5007, shown when an input layout of a record fails: an 8-way hat has a bad bit size. %1$@ is the file. */
"error.E5007.inputLayout.hatBits" = "%1$@, input.layouts[].hat: An 8-way hat is 3 to 8 bits. Fix: Set bitSize from 3 to 8.";
/* Error E5007, shown when an input layout of a record fails: a table hat names bad directions. %1$@ is the file. */
"error.E5007.inputLayout.hatTable" = "%1$@, input.layouts[].hat: A table hat names directions only for values its bits hold, and has no neutral entry. Fix: List only values the bits can hold and leave out neutral.";
/* Error E5007, shown when an input layout of a record fails: a field has a bad bit size. %2$@ is the largest bit size. %1$@ is the file. */
"error.E5007.inputLayout.fieldBits" = "%1$@, input.layouts[]: A field is 1 to %2$@ bits. Fix: Set each bitSize inside that range.";
/* Error E5007, shown when an input layout of a record fails: a field lies outside the report. %1$@ is the file. */
"error.E5007.inputLayout.fieldOutside" = "%1$@, input.layouts[]: Fields must lie after the report ID byte and inside the report length. Fix: Move the field, or raise the report length.";
/* Error E5007, shown when an input layout of a record fails: a BigEndian field is misplaced or has a bad size. %1$@ is the file. */
"error.E5007.inputLayout.bigEndian" = "%1$@, input.layouts[]: A BigEndian field starts on a byte boundary and is 16, 24 or 32 bits. Fix: Start it at a multiple of 8 with a bitSize of 16, 24 or 32, or use LittleEndian.";
/* Error E5007, shown when an input layout of a record fails: a button names a control that is not a button. %1$@ is the file. */
"error.E5007.inputLayout.buttonControl" = "%1$@, input.layouts[].buttons: A button names a digital control, not the D-pad or a stick axis. Fix: Name a button control, or move the entry to axes or hat.";
/* Error E5007, shown when an input layout of a record fails: axes repeat a control or name a control that is not a stick axis. %1$@ is the file. */
"error.E5007.inputLayout.axesDistinct" = "%1$@, input.layouts[].axes: Axes must name distinct stick axes. Fix: Name each stick axis once.";
/* Error E5007, shown when an input layout of a record fails: an axis has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.axisRange" = "%1$@, input.layouts[].axes: An axis has min below max, inside the range of its size. Fix: Set min below max, both inside the range of bitSize.";
/* Error E5007, shown when an input layout of a record fails: a trigger value has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.triggerRange" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: A trigger value has min below max, inside the range of its size. Fix: Set min below max, both inside the range of bitSize.";
/* Error E5007, shown when an input layout of a record fails: a symmetric axis is not signed around zero. %1$@ is the file. */
"error.E5007.inputLayout.axisSymmetric" = "%1$@, input.layouts[].axes: A symmetric axis is signed, with min below 0 and max above 0. Fix: Set signed to true with min below 0 and max above 0, or turn symmetric off.";
/* Error E5007, shown when an input layout of a record fails: a trigger has neither an analog value nor a button. %1$@ is the file. */
"error.E5007.inputLayout.triggerSources" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: A trigger names an analog value, a button, or both. Fix: Give the trigger an analog value or a button.";
/* Error E5007, shown when an input layout of a record fails: a layout decodes no control. %1$@ is the file. */
"error.E5007.inputLayout.noControls" = "%1$@, input.layouts[]: A layout must decode at least one control. Fix: Add a button, axis, hat or trigger.";
/* Error E5007, shown when the HID usage map of a record fails: a usage map lists no usage. %1$@ is the file. */
"error.E5007.usageMap.mapEmpty" = "%1$@, input.hidUsageMap.usages: A usage map must list at least one usage. Fix: Add a usage, or delete hidUsageMap.";
/* Error E5007, shown when the HID usage map of a record fails: two entries of one usage name the same half. %2$@ is the usage as page/usage, %3$@ the half. %1$@ is the file. */
"error.E5007.usageMap.halfTwice" = "%1$@, input.hidUsageMap.usages[].half: Usage %2$@ names the %3$@ half twice. Fix: Give each half of a usage one entry.";
/* Error E5007, shown when the HID usage map of a record fails: a usage is named twice. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.usageTwice" = "%1$@, input.hidUsageMap.usages[]: Usage %2$@ is named twice, and only entries for its two halves can share a usage. Fix: Name each usage once, or give the entries the Positive and Negative halves.";
/* Error E5007, shown when the HID usage map of a record fails: a Button entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ is a button, and %3$@ is not a button control. Fix: Name a button control, or use another kind of entry.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis entry names a control that is not a stick axis or trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ is an axis, and %3$@ is not a stick axis or trigger. Fix: Name a stick axis or trigger, or use another kind of entry.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis range has min at or above max. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.rangeOrder" = "%1$@, input.hidUsageMap.usages[].range: The range of usage %2$@ must have min below max. Fix: Set min below max.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis deadZone is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.deadZone" = "%1$@, input.hidUsageMap.usages[].deadZone: The deadZone of usage %2$@ must be above 0 and below 1. Fix: Set deadZone above 0 and below 1.";
/* Error E5007, shown when the HID usage map of a record fails: a Hat range is not 0...7 or 1...8. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.hatRange" = "%1$@, input.hidUsageMap.usages[].range: The hat range of usage %2$@ must be 0...7 or 1...8. Fix: Set range to 0...7 or 1...8, or leave it out.";
/* Error E5007, shown when the HID usage map of a record fails: a HalfAxis entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.halfAxisControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ is a half axis, and %3$@ is not a trigger. Fix: Name LeftTrigger or RightTrigger.";
/* Error E5007, shown when the HID usage map of a record fails: a ButtonTrigger entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonTriggerControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ is a button trigger, and %3$@ is not a trigger. Fix: Name LeftTrigger or RightTrigger, or use another kind of entry.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad entry names a control that is not a D-pad direction. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisDpadControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ is an axis D-pad, and %3$@ is not a D-pad direction. Fix: Name DpadUp, DpadDown, DpadLeft or DpadRight.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisButton entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisButtonControl" = "%1$@, input.hidUsageMap.usages[].control: Usage %2$@ is an axis button, and %3$@ is not a button control. Fix: Name a button control, or use another kind of entry for the axis.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad or AxisButton threshold is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.threshold" = "%1$@, input.hidUsageMap.usages[].threshold: The threshold of usage %2$@ must be above 0 and below 1. Fix: Set threshold above 0 and below 1.";
/* Error E5007, shown when a startup write of a record fails: a startup write names an input report. %1$@ is the file. */
"error.E5007.startupWrite.reportKind" = "%1$@, session.startup[].report: A startup write cannot send an input report. Fix: Set report to an output or feature report.";
/* Error E5007, shown when a startup write of a record fails: a startup report is not 2...128 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.reportLength" = "%1$@, session.startup[].report: A startup report must be 2...128 bytes long. Fix: Give the report a length of 2...128 bytes.";
/* Error E5007, shown when a startup write of a record fails: a startup write lists the wrong number of bytes. %2$@ is the number of bytes the report takes after its ID. %1$@ is the file. */
"error.E5007.startupWrite.bytesCount" = "%1$@, session.startup[].bytes: A startup write must list %2$@ bytes, every byte after the report ID. Fix: Give bytes %2$@ bytes.";
/* Error E5007, shown when a startup write of a record fails: a startup delay is outside 0...1000 ms. %1$@ is the file. */
"error.E5007.startupWrite.delay" = "%1$@, session.startup[].delayMilliseconds: A startup delay must be 0...1000 ms. Fix: Set delayMilliseconds to 0...1000, or leave it out.";
/* Error E5007, shown when a startup write of a record fails: a startup transport is not USB, BluetoothClassic or BluetoothLE. %1$@ is the file. */
"error.E5007.startupWrite.transport" = "%1$@, session.startup[].transport: A startup transport must be USB, BluetoothClassic or BluetoothLE. Fix: Set transport to one of them, or leave it out.";
/* Error E5007, shown when a startup write of a record fails: a startup report with crc32Seed has no room for its 4-byte trailer. %1$@ is the file. */
"error.E5007.startupWrite.crcRoom" = "%1$@, session.startup[].crc32Seed: A startup report with crc32Seed must have room for its 4-byte trailer. Fix: Make the report longer than 4 bytes, or remove crc32Seed.";
/* Error E5007, shown when a startup write of a record fails: a USB startup packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.usbLength" = "%1$@, session.startup[].bytes: A USB startup packet must be 1...64 bytes long. Fix: Give bytes a length of 1...64.";
/* Error E5007, shown when a startup write of a record fails: a USB startup endpoint is outside 1...127. %1$@ is the file. */
"error.E5007.startupWrite.usbEndpoint" = "%1$@, session.startup[].endpoint: A USB startup endpoint must be 1...127. Fix: Set endpoint to 1...127, or leave it out.";
/* Error E5007, shown when a startup write of a record fails: a USB startup timeout is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.startupWrite.usbTimeout" = "%1$@, session.startup[].timeoutMilliseconds: A USB startup timeout must be 1...60000 ms. Fix: Set timeoutMilliseconds to 1...60000, or leave it out.";
/* Error E5007, shown when a startup write of a record fails: a USB startup session byte does not index the packet. %1$@ is the file. */
"error.E5007.startupWrite.sessionByte" = "%1$@, session.startup[].sessionByte: A USB startup session byte must index a byte of the packet. Fix: Set sessionByte to a position inside bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names an input report. %1$@ is the file. */
"error.E5007.rumble.reportKind" = "%1$@, session.rumble.report.kind: A rumble template cannot write an input report. Fix: Set report to an output or feature report.";
/* Error E5007, shown when the rumble template of a record fails: a rumble HID report is not 2...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.reportLength" = "%1$@, session.rumble.report.length: A rumble HID report must be 2...64 bytes long. Fix: Give the report a length of 2...64 bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble USB packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.packetLength" = "%1$@, session.rumble.report.length: A rumble USB packet must be 1...64 bytes long. Fix: Give the packet a length of 1...64 bytes.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a rumble template do not cover the whole report. %1$@ is the file. */
"error.E5007.rumble.bytesCover" = "%1$@, session.rumble.bytes: The bytes of a rumble template must cover the whole report. Fix: List every byte of the report, report ID included.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a numbered rumble report do not start with its report ID. %1$@ is the file. */
"error.E5007.rumble.bytesReportId" = "%1$@, session.rumble.bytes: The bytes of a numbered rumble report must start with its report ID. Fix: Start bytes with the report ID.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names no motor it can drive. %1$@ is the file. */
"error.E5007.rumble.motors" = "%1$@, session.rumble: A rumble template must name at least one motor it can drive. Fix: Add lowFrequency, highFrequency, leftTrigger or rightTrigger.";
/* Error E5007, shown when the rumble template of a record fails: the motor and counter bytes of a rumble template overlap or fall outside the report. %1$@ is the file. */
"error.E5007.rumble.fields" = "%1$@, session.rumble: The motor and counter bytes of a rumble template must be distinct and follow the report ID inside the report. Fix: Give each motor and the counter its own byte after the report ID.";
/* Error E5007, shown when the rumble template of a record fails: a rumble resend interval is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.rumble.resendInterval" = "%1$@, session.rumble.resendIntervalMilliseconds: A rumble resend interval must be 1...60000 ms. Fix: Set resendIntervalMilliseconds to 1...60000, or leave it out.";
/* Error E5008, shown when the SDL_GameControllerDB line of a controller cannot drive it; the message names the reason. */
"error.E5008.message" = "The SDL_GameControllerDB line for a controller cannot drive it. The message names the reason. Write a controller record for the controller with ojd record draft.";
/* Error text with the error code. %1$@ is the message and %2$@ is the code, for example E2011. The code is in parentheses. */
"ui.error.withCode" = "%1$@ (%2$@)";

