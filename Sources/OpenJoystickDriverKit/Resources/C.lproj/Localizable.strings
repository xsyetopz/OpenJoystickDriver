"ui.library.details" = "Details";
/* Button of an error message in the Library area that hides the message. */
"ui.library.dismiss" = "Dismiss";
/* Button of the open panel in which the user picks a record file or a mod folder. It confirms the choice. */
"ui.library.choose" = "Choose";
/* Toolbar button in the Library area that checks a record file or mod folder without installing it. Keep the three dots. */
"ui.library.validate" = "Validate...";
/* Confirm button of the alert that installs a record or a mod. */
"ui.library.install" = "Install";
/* Confirm button of the alert that replaces an installed record or mod. */
"ui.library.replace" = "Replace";
/* Confirm button of the alert that removes a record or mod. */
"ui.library.remove" = "Remove";
/* Error in the Library area. %1$@ is the name of a file or folder and %2$@ is the reason it cannot be read. */
"ui.library.unreadable" = "%1$@ cannot be read: %2$@";
/* Name of the check in the diagnostics table that validates the controller records. */
"ui.library.records" = "Controller records";
/* Title of the empty state in the records list of the Library area. */
"ui.library.records.empty.title" = "No installed records";
/* Name of the source of a record: a file that the user installed. It is shown next to the record. */
"ui.library.layer.user" = "Your file";
/* Name of the source of a record: a mod package added it. */
"ui.library.layer.package" = "From a mod";
/* Notice after a record check passed. %1$@ is the file name and %2$@ is the controller model. */
"ui.library.record.valid" = "%1$@ is a valid record for %2$@.";
/* Error when a record is not valid. %@ is the reason. */
"ui.library.record.invalid" = "The record is not valid: %@";
/* Line in the records list for a record file that the app skipped. %@ is the reason. */
"ui.library.record.skipped" = "Skipped: %@";
