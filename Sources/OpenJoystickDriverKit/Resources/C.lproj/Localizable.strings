"platform.macos.cli.diagnose.group.usbFailed" = "USB scan failed: %@. Grant Input Monitoring to OpenJoystickDriver.";
/* Detail of the USB check of 'ojd diagnose'. %lld is the number of vendor-specific USB controllers that the system lists. */
