"cli.mod.validate.discussion" = "Verifica o manifesto, se o pacote funciona nesta versão, se seus arquivos são os listados e válidos e se nenhum entra em conflito com seus arquivos ou com outro pacote. Termina com 1 e o código E4xxx ou E5001 quando o pacote é recusado.";
/* Message printed by 'ojd mod validate' for a correct package. %1$@ is the folder path, %2$@ is the package name and %3$@ is its version. The command in quotes stays as written. */
"cli.mod.validate.valid" = "%1$@ é um pacote válido: %2$@ %3$@. Instale-o com “ojd mod install”.";
/* One-line summary of 'ojd mod install' in the command list and at the top of its help. */
"cli.mod.install.abstract" = "Verificar um pacote de mods e instalá-lo para o seu usuário.";
/* Long description in the help of 'ojd mod install'. Packages/NAME, --force and requires stay as written. */
"cli.mod.install.discussion" = "Copia o pacote para Packages/NAME e o troca de uma vez; o serviço em execução o aplica. Um pacote já instalado com o mesmo nome é recusado, a menos que você use --force. --force nunca ignora requires, um conflito de identidade nem um conflito de id ou nome de perfil. --dry-run verifica o pacote e não grava nada.";
/* Help text of the --force flag of 'ojd mod install'. */
"cli.mod.install.force" = "Substituir um pacote instalado com o mesmo nome.";
/* Message printed by 'ojd mod install --dry-run' instead of installing. %@ is the target folder. */
"cli.mod.install.dryRun" = "Instalaria %@.";
/* Message printed after 'ojd mod install'. %@ is the target folder. The service picks the package up without a restart. */
"cli.mod.install.success" = "%@ instalado. O serviço em execução o aplica agora.";
/* One-line summary of 'ojd mod list' in the command list and at the top of its help. */
"cli.mod.list.abstract" = "Listar os pacotes de mods instalados e os arquivos de cada um.";
/* Long description in the help of 'ojd mod list'. OJD is the short product name; requires and E4xxx and E5001 stay as written. */
"cli.mod.list.discussion" = "Lista cada pacote com versão, autor e arquivos. Um pacote que o OJD não usa, por exemplo um cujo requires exclui esta versão, mostra o motivo com seu código E4xxx ou E5001.";
/* Indented line below a package in 'ojd mod list' that the driver does not use. %@ is the reason with its error code. Keep the two leading spaces. */
"cli.mod.list.problem" = "  Não usado: %@";
/* One-line summary of 'ojd protocol' in the command list and at the top of its help. A protocol description defines a controller family. */
"cli.protocol.group.abstract" = "Valide, instale ou liste descrições de protocolo.";
/* Long description in the help of 'ojd protocol'. The folder name Protocols, the path, and .plist stay as written. */
"cli.protocol.group.discussion" = "Uma descrição de protocolo é um arquivo .plist que define uma família de controles que o OJD não embute. As descrições instaladas ficam em ~/Library/Application Support/OpenJoystickDriver/Protocols, e um pacote de mod também pode trazê-las. Estes comandos não precisam do serviço.";
/* Help text of the FILE argument of 'ojd protocol validate' and 'ojd protocol install'. VendorAcmePad.plist is an example file name and stays as written. */
"cli.protocol.group.file" = "Um arquivo de descrição com o nome da sua família, como VendorAcmePad.plist.";
/* One-line summary of 'ojd protocol validate' in the command list and at the top of its help. */
"cli.protocol.validate.abstract" = "Verifique um arquivo de descrição de protocolo sem instalá-lo.";
/* Long description in the help of 'ojd protocol validate'. UpperCamelCase describes the spelling of a family name. E5xxx stays as written. */
"cli.protocol.validate.discussion" = "Verifica se o arquivo é uma descrição válida, se o nome da família está em UpperCamelCase e coincide com o nome do arquivo, se não é uma família embutida e se define um nome de exibição e layouts de entrada. Sai com 1 e o código E5xxx quando o arquivo é recusado.";
/* Message printed by 'ojd protocol validate' for a valid file. %1$@ is the file, %2$@ is the family name and %3$@ is its display name. The command in quotes stays as written. */
"cli.protocol.validate.valid" = "%1$@ é uma descrição válida da família %2$@ (%3$@). Instale-a com 'ojd protocol install'.";
/* One-line summary of 'ojd protocol install' in the command list and at the top of its help. */
"cli.protocol.install.abstract" = "Verifique uma descrição de protocolo e instale-a para o seu usuário.";
/* Long description in the help of 'ojd protocol install'. Protocols/FAMILY.plist and --dry-run stay as written. */
"cli.protocol.install.discussion" = "Copia o arquivo para Protocols/FAMILY.plist. Uma descrição instalada da mesma família é substituída. --dry-run verifica o arquivo e não grava nada.";
/* Message printed after 'ojd protocol install' copied a description. %@ is the installed file. */
"cli.protocol.install.success" = "%@ instalado.";
/* One-line summary of 'ojd protocol list' in the command list and at the top of its help. */
"cli.protocol.list.abstract" = "Liste as famílias de protocolo embutidas e documentadas e a origem de cada uma.";
/* Long description in the help of 'ojd protocol list'. */
"cli.protocol.list.discussion" = "Lista cada família com o nome de exibição e a origem: embutida, sua pasta Protocols ou um pacote de mod. Uma descrição recusada não aparece.";
/* Source shown by 'ojd protocol list' for a family that OJD builds in. */
"cli.protocol.list.builtIn" = "embutida";
/* Source shown by 'ojd protocol list' for a family from a description in the user's Protocols folder. Protocols stays as written. */
"cli.protocol.list.user" = "sua pasta Protocols";
/* Source shown by 'ojd protocol list' for a family from a mod package. %@ is the package name. */
"cli.protocol.list.package" = "pacote %@";
/* One-line summary of 'ojd mod remove' in the command list and at the top of its help. */
"cli.mod.remove.abstract" = "Remover um pacote de mods instalado.";
/* Long description in the help of 'ojd mod remove'. Packages/NAME, --force, --dry-run and E4006 stay as written. */
"cli.mod.remove.discussion" = "Exclui somente Packages/NAME. Pede confirmação em um terminal; caso contrário, exige --force. --dry-run verifica se o pacote está instalado e não muda nada. Termina com 1 e E4006 se não estiver instalado.";
/* Yes or no question that 'ojd mod remove' asks on a terminal. %@ is the folder to delete. */
"cli.mod.remove.confirm" = "Excluir %@?";
/* Message printed by 'ojd mod remove --dry-run' instead of deleting. %@ is the folder. */
"cli.mod.remove.dryRun" = "Excluiria %@.";
/* Message printed after 'ojd mod remove'. %@ is the folder that is deleted. */
"cli.mod.remove.success" = "%@ excluído.";
/* Help text of the --dry-run flag of the commands that change data. */
"cli.shared.option.dryRun" = "Exibir o que mudaria, sem mudar nada.";
/* Help text of the --force flag of the commands that ask for confirmation. */
"cli.shared.option.force" = "Não pedir confirmação.";
/* One-line summary of 'ojd virtual' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.virtual.group.abstract" = "Mostrar e escolher o gamepad virtual que o OpenJoystickDriver publica para um controle.";
/* Message printed after 'ojd virtual set' or 'ojd virtual reset' changed the virtual gamepad. %1$@ is the controller name, %2$@ is the profile name and %3$@ is where the choice comes from. */
"cli.virtual.group.changed" = "%1$@ agora publica %2$@ (%3$@).";
/* Message printed after 'ojd virtual set' saved the choice while virtual output is off. %@ is the controller name. */
"cli.virtual.group.stored" = "A escolha para %@ foi salva. Ela será aplicada quando a saída virtual estiver ativada.";
/* Help text of the --unit option of 'ojd virtual set' and 'ojd virtual reset'. A unit ID names one controller by model and USB port. */
"cli.virtual.group.unit" = "Aplica-se somente a este controle, pelo ID da unidade, em vez de a todo o modelo.";
/* Long description in the help of 'ojd virtual'. reset stays as written because it is a command name. */
"cli.virtual.group.discussion" = "Uma escolha vale para todos os controles do mesmo modelo. “reset” devolve um modelo à seleção automática.";
/* Paragraph in the help of 'ojd virtual' about --unit. set and reset are command names and stay as written. */
"cli.virtual.group.discussionUnit" = "Com --unit, “set” se aplica a um único controle pelo ID da unidade dele, e “reset” devolve esse controle à escolha do modelo.";
/* Error of 'ojd virtual set' when the service could not apply the choice. %1$@ is the controller name and %2$@ is the reason. The command in quotes stays as written. */
"cli.virtual.group.errorFailed" = "O gamepad virtual de %1$@ não mudou (%2$@). Verifique com “ojd virtual show”.";
/* Error of 'ojd virtual' commands when --unit is used for a controller without a unit ID. %@ is the controller name. --unit stays as written. */
"cli.virtual.group.errorNoUnit" = "%@ não tem ID de unidade, então uma escolha só pode valer para todo o modelo. Execute o comando sem --unit.";
/* One-line summary of 'ojd virtual export-mapping' in the command list and at the top of its help. SDL is a game controller library and W3C names the web standard gamepad layout; both stay as written. */
"cli.virtual.exportMapping.abstract" = "Imprime o mapeamento SDL ou a descrição W3C que um perfil de gamepad virtual deriva.";
/* Long description in the help of 'ojd virtual export-mapping'. SDL, W3C and JSON stay as written. */
"cli.virtual.exportMapping.discussion" = "SDL imprime uma linha de mapeamento por perfil, que é um arquivo de mapeamento SDL válido. W3C imprime a descrição do layout padrão como JSON. Ambos são derivados do descritor de relatórios do perfil.";
/* Help text of the format option of 'ojd virtual export-mapping'. sdl and w3c are values the user types and stay as written. */
"cli.virtual.exportMapping.format" = "O formato a imprimir: sdl ou w3c.";
/* Help text of the profile argument of 'ojd virtual export-mapping'. */
"cli.virtual.exportMapping.profile" = "O perfil de gamepad virtual a imprimir. Omita para imprimir todos os perfis.";
/* One-line summary of 'ojd virtual feed' in the command list and at the top of its help. Standard input is the input stream of the program. */
"cli.virtual.feed.abstract" = "Publicar um gamepad virtual controlado pelo stdin.";
/* Long description in the help of 'ojd virtual feed'. The JSON field names buttons, dpad and axes and the control names stay as written. */
"cli.virtual.feed.discussion" = "Lê um objeto JSON por linha: “buttons” e “dpad” listam os controles pressionados, como South e DpadUp, e “axes” associa valores aos nomes dos eixos, como LeftStickX. Controles ausentes ficam neutros. Os analógicos vão de -1 a 1, com Y para baixo; os gatilhos vão de 0 a 1. Os quadros são reproduzidos em ordem, cada um por pelo menos 8 ms; “holdMilliseconds” mantém um quadro por mais tempo, até 60000. Imprime cada comando de saída que os jogos enviam ao gamepad, como vibração, como um objeto JSON por linha. Termina quando todos os quadros são reproduzidos após o fim da entrada.";
/* Error of 'ojd virtual feed' when the service closed the virtual gamepad. The command in quotes stays as written. */
"cli.virtual.feed.errorClosed" = "O serviço fechou o gamepad virtual. Verifique com “ojd status”.";
/* Error from `ojd virtual feed` when the service connection broke while the virtual gamepad was closing. */
"cli.virtual.feed.errorCloseInterrupted" = "O fechamento do gamepad virtual foi interrompido. Verifique com “ojd status”.";
/* Error of 'ojd virtual feed' for an input line that is not a valid frame. %@ is the line number. The command in quotes stays as written. */
"cli.virtual.feed.errorFrame" = "A linha %@ não é um quadro válido. “ojd virtual feed --help” mostra o formato.";
/* Help text of the profile argument of 'ojd virtual feed'. */
"cli.virtual.feed.profile" = "O perfil do gamepad virtual a publicar.";
/* First line of 'ojd virtual feed'. %@ is the profile name. Control-C is the key combination that stops a program in a terminal. */
"cli.virtual.feed.started" = "Publicando um gamepad virtual %@… Escreva quadros no stdin; encerre a entrada ou pressione Control-C para parar.";
/* One-line summary of 'ojd virtual launch' in the command list and at the top of its help. SDL is a game controller library and stays as written. */
"cli.virtual.launch.abstract" = "Executa um programa com o mapeamento SDL dos gamepads virtuais conectados.";
/* Help text of the program argument of 'ojd virtual launch'. PATH is the environment variable, .app is the app bundle extension, and -- stays as written. */
"cli.virtual.launch.command" = "O programa a executar e seus argumentos. Um programa é um caminho, um nome que o PATH encontra ou um .app. Coloque -- antes do programa quando os argumentos dele também forem opções do ojd.";
/* Long description in the help of 'ojd virtual launch'. SDL_GAMECONTROLLERCONFIG and .app stay as written. */
"cli.virtual.launch.discussion" = "Define SDL_GAMECONTROLLERCONFIG com o mapeamento do gamepad virtual de cada controle conectado, para que o SDL no programa os liste. Um valor já definido fica primeiro e os mapeamentos vêm depois. Um .app executa seu executável principal. O programa mantém este terminal. Parar o ojd para o programa, e o ojd termina com o status do programa.";
/* Error of 'ojd virtual launch' when the program does not start. %1$@ is the program the user gave and %2$@ is the reason, one of the short reasons for a missing executable, a path without a file and a name not on PATH. */
"cli.virtual.launch.errorFailed" = "%1$@ não iniciou (%2$@). Verifique se é um arquivo executável ou um app e se você pode executá-lo.";
/* Short reason inside the failure message of 'ojd virtual launch' when an app bundle holds no executable. It fills %2$@ of that message and starts in lowercase. */
"cli.virtual.launch.errorNoExecutable" = "o app não tem executável";
/* Error of 'ojd virtual launch' when no connected controller has a virtual gamepad. The command in quotes stays as written. */
"cli.virtual.launch.errorNoGamepad" = "Nenhum controle conectado tem um gamepad virtual, então não há mapeamento a definir. Conecte um controle e verifique «ojd virtual show».";
/* Error of 'ojd virtual launch' when no program is given. The example command in quotes stays as written. */
"cli.virtual.launch.errorNoProgram" = "Informe um programa a executar, como «ojd virtual launch ./game».";
/* Short reason inside the failure message of 'ojd virtual launch' when the path holds no executable file. It fills %2$@ of that message and starts in lowercase. */
"cli.virtual.launch.errorNotExecutable" = "nenhum arquivo executável nesse caminho";
/* Short reason inside the failure message of 'ojd virtual launch' when no program of the name is on PATH. It fills %2$@ of that message and starts in lowercase. PATH stays as written. */
"cli.virtual.launch.errorNotFound" = "nenhum programa com esse nome no PATH";
/* Error of 'ojd virtual launch' when --json or --plain is given. Both option names stay as written. */
"cli.virtual.launch.errorOutput" = "--json e --plain não se aplicam, porque o programa escreve a saída padrão.";
/* Help text of the SDL backend flag of 'ojd virtual launch'. The SDL hint names and values stay as written. */
"platform.macos.cli.virtual.launch.sdlGamecontrollerBackend" = "Também define as dicas do SDL que fazem o SDL ler controles somente pelo framework GameController da Apple: SDL_JOYSTICK_MFI=1, SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, SDL_JOYSTICK_IOKIT=0, SDL_JOYSTICK_HIDAPI=0. Elas valem apenas para o programa e substituem os valores já definidos.";
/* One-line summary of 'ojd virtual reset' in the command list and at the top of its help. */
"cli.virtual.reset.abstract" = "Devolver o modelo de um controle, ou todos os modelos, à seleção automática de gamepad virtual.";
/* Help text of the --all flag of 'ojd virtual reset'. */
"cli.virtual.reset.all" = "Redefinir todos os modelos de controle.";
/* Message printed after 'ojd virtual reset --all'. */
"cli.virtual.reset.allDone" = "Agora todos os modelos de controle selecionam o gamepad virtual automaticamente.";
/* Message printed by 'ojd virtual reset --all --dry-run' instead of resetting. */
"cli.virtual.reset.allDryRun" = "Devolveria todos os modelos de controle à seleção automática de gamepad virtual.";
/* Error of 'ojd virtual reset --all' when the service could not clear the choices, such as when a virtual device file sets its own identity. The folder name VirtualDevices and the command in quotes stay as written. */
"cli.virtual.reset.allFailed" = "O serviço não conseguiu limpar todas as escolhas de gamepad virtual. Um arquivo de dispositivo virtual na pasta VirtualDevices que define sua própria identidade permanece até você editá-lo ou apagá-lo. Verifique com “ojd status”.";
/* Yes or no question that 'ojd virtual reset --all' asks on a terminal. */
"cli.virtual.reset.allSummary" = "Devolver todos os modelos de controle à seleção automática de gamepad virtual?";
/* Long description in the help of 'ojd virtual reset'. --all and --force stay as written. */
"cli.virtual.reset.discussion" = "--all também limpa as escolhas de modelos que não estão conectados. Pergunta antes em um terminal e, caso contrário, precisa de --force.";
/* Message printed by 'ojd virtual reset --dry-run' instead of resetting. %@ is the controller name. */
"cli.virtual.reset.dryRun" = "Devolveria %@ à seleção automática de gamepad virtual.";
/* Error of 'ojd virtual reset' when neither or both of CONTROLLER and --all are given. CONTROLLER and --all stay as written. */
"cli.virtual.reset.errorTarget" = "Informe um CONTROLLER ou --all.";
/* Error of 'ojd virtual reset' when --unit and --all are combined. CONTROLLER, --unit and --all stay as written. */
"cli.virtual.reset.errorUnitAll" = "--unit precisa de um CONTROLLER, não de --all.";
/* One-line summary of 'ojd virtual set' in the command list and at the top of its help. */
"cli.virtual.set.abstract" = "Escolher o gamepad virtual para o modelo de um controle.";
/* Help text of the profile argument of 'ojd virtual set'. */
"cli.virtual.set.profile" = "O perfil do gamepad virtual.";
/* Note printed by 'ojd virtual export-mapping' for a profile that needs other SDL hints. %@ is the profile name in kebab case, which stays as written. SDL stays as written. */
"cli.virtual.group.sdlHintsNote" = "Nota: %@ não funciona com as dicas padrão do SDL.";
/* One-line summary of 'ojd virtual show' in the command list and at the top of its help. */
"cli.virtual.show.abstract" = "Mostrar o gamepad virtual de cada controle e os perfis que você pode escolher.";
/* Value shown by 'ojd virtual show' for a controller without a virtual gamepad. */
"cli.virtual.show.none" = "sem gamepad virtual";
/* Line of the output of 'ojd virtual show' with the profiles to choose from. %@ is the comma-separated list of profile names. */
"cli.virtual.show.profiles" = "Perfis: %@";
/* Value shown by 'ojd virtual show' for a controller that no virtual gamepad profile fits. */
"cli.virtual.show.unavailable" = "nenhum gamepad virtual serve";
/* Detail of the records check of 'ojd diagnose'. %lld is the number of the user's controller records that the driver applies. */
"cli.diagnose.group.recordsApplied" = "registros de usuário aplicados: %lld";
/* Detail of the records check of 'ojd diagnose' when the configuration files are valid. all.patch.plist is a file name that stays as written. */
"cli.diagnose.group.recordsConfigOk" = "all.patch.plist e os arquivos de persona são válidos";
/* Detail of the records check of 'ojd diagnose' when parts of the configuration are ignored or skipped. %@ is the list of those parts. The command in quotes stays as written. */
"cli.diagnose.group.recordsConfigProblems" = "ignorados ou pulados: %@; corrija-os e verifique com “ojd status”";
/* Detail of the records check of 'ojd diagnose' when records are skipped. %@ is the list of skipped records. The command in quotes stays as written. */
"cli.diagnose.group.recordsSkipped" = "%@ ignorado(s); verifique com “ojd record list”";
/* One line of the frame timings of 'ojd diagnose'. %1$lld is the frame number, %2$@ is the controller name, %3$@ is the controller ID and %4$@ is the timestamp of the frame from the monotonic clock in nanoseconds. */
"cli.diagnose.group.timingsFrame" = "Quadro %1$lld de %2$@ (%3$@), relógio monotônico em nanossegundos: %4$@";
/* One gap line in the timing summary of 'ojd diagnose'. %1$@ is the gap name such as read-to-parse, which stays as written, %2$@ is the median, %3$@ is the 99th percentile and %4$@ is the maximum of the gap in milliseconds, and %5$@ is the number of frames measured. The unit symbol ms may be localized. */
"cli.diagnose.group.timingsSummaryGap" = "%1$@: mediana %2$@ ms, percentil 99 %3$@ ms, máximo %4$@ ms, amostras: %5$@";
/* First line of the timing summary of one controller in 'ojd diagnose'. %1$@ is the controller name, %2$@ is the controller ID, %3$@ is the number of frames in the window and %4$@ is the time from the first to the last frame of the window in milliseconds. The unit symbol ms may be localized. */
"cli.diagnose.group.timingsSummaryHeader" = "Resumo de tempos de %1$@ (%2$@). Quadros na janela: %3$@. Intervalo de tempo: %4$@ ms.";
/* Stall line of the timing summary of 'ojd diagnose' when the window holds fewer than two frames, so it has no read interval. A stall is a read interval that is much longer than the usual one. */
"cli.diagnose.group.timingsSummaryNoStalls" = "Travamentos: não medidos, a janela tem menos de dois quadros";
/* Stall line of the timing summary of 'ojd diagnose'. A stall is a read interval that is much longer than the usual one. %1$@ is the number of read intervals in the window longer than the threshold, %2$@ is the threshold in milliseconds and %3$@ is the multiple of the median read interval that sets the threshold. The unit symbol ms may be localized. */
"cli.diagnose.group.timingsSummaryStalls" = "Travamentos (intervalos de leitura maiores que %2$@ ms, %3$@ vezes a mediana do intervalo de leitura): %1$@";
/* Stall line of the timing summary of 'ojd diagnose' when the summary covers the whole frame ring rather than a '--frames' window. Stalls are counted only during a '--frames' window, in which the user keeps the sticks moving. Keep '--frames' unchanged. */
"cli.diagnose.group.timingsSummaryStallsNeedFrames" = "Travamentos: medidos só com --frames, enquanto os analógicos continuam em movimento";
/* Line of 'ojd diagnose --frames' above the timing summaries. %@ is the length of the window, such as 10s. The frames are those the controller reported in that time. */
"cli.diagnose.group.timingsWindow" = "Janela de tempos: quadros lidos nos últimos %@.";
/* One-line summary of 'ojd record' in the command list and at the top of its help. */
"cli.record.group.abstract" = "Criar rascunhos, listar, verificar, instalar ou remover registros de controle.";
/* Long description in the help of 'ojd record'. The folder path stays as written. A controller record describes how the driver talks to one controller model. */
"cli.record.group.discussion" = "Um registro de controle diz ao OpenJoystickDriver como operar um modelo de controle. Seus registros ficam em ~/Library/Application Support/OpenJoystickDriver/Controllers e adicionam um modelo ou alteram um incluído. O serviço em execução os aplica quando a pasta muda. Só “ojd record draft” precisa do serviço.";
/* One-line summary of 'ojd record draft' in the command list and at the top of its help. */
"cli.record.draft.abstract" = "Criar um rascunho de registro de controle a partir de um controle conectado.";
/* Line printed by 'ojd record draft' with the number of input reports it captured. %lld is that number. */
"cli.record.draft.captured" = "Relatórios de entrada capturados: %lld.";
/* Line printed by 'ojd record draft' for a byte that changed between reports. %1$lld is the byte position, %2$lld is the value before and %3$lld is the value after. */
"cli.record.draft.changedByte" = "O byte %1$lld mudou: de %2$lld para %3$lld.";
/* Long description in the help of 'ojd record draft'. HID report descriptor and input report are terms of the USB HID standard. */
"cli.record.draft.discussion" = "Lê o descritor de relatórios HID do controle e captura seus relatórios de entrada enquanto você pressiona cada comando, depois imprime um registro para começar. O registro mapeia os botões, analógicos, gatilhos e direcional que o descritor indica claramente. Os bytes que mudaram durante a captura mostram onde ficam os outros comandos. Precisa do serviço.";
/* Help text of the duration option of 'ojd record draft'. */
"cli.record.draft.duration" = "Capturar relatórios de entrada por esta quantidade de segundos.";
/* Help text of the --from-sdl flag of 'ojd record draft'. SDL_GameControllerDB is a project name and stays as written. */
"cli.record.draft.fromSDL" = "Cria o rascunho a partir da linha do SDL_GameControllerDB do controle em vez de capturar relatórios de entrada.";
/* Note printed by 'ojd record draft' when the draft lacks the input section. The command in quotes stays as written, including FILE. */
"cli.record.draft.missingInput" = "O rascunho não tem a seção input porque os comandos deste dispositivo não são conhecidos. Adicione-a e depois execute “ojd record validate FILE”.";
/* Hint printed after 'ojd record draft'. The command in quotes stays as written, including FILE. */
"cli.record.draft.next" = "Salve o registro em um arquivo, confira cada comando e depois execute “ojd record validate FILE”.";
/* Message of 'ojd record draft' when the descriptor of the controller yields no controls and the bundled record names the family. %1$@ is the controller identity, VVVV:PPPP, and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.record.draft.noLayout" = "Nenhum comando de %1$@ pôde ser lido do seu descritor de relatórios HID, e o registro incluído já indica a família. “ojd record show %2$@” mostra esse registro.";
/* Message of 'ojd record draft --from-sdl' when the HID report descriptor of the controller fails the HIDDescriptor contract. SDL_GameControllerDB is a project name and HIDDescriptor is a protocol family name; both stay as written. %1$@ is the controller identity, VVVV:PPPP, and %2$@ is the name of the violated rule, which stays as written. */
"cli.record.draft.sdl.contract" = "O descritor de relatório HID de %1$@ viola o contrato do HIDDescriptor (%2$@); por isso nenhuma linha do SDL_GameControllerDB consegue associá-lo.";
