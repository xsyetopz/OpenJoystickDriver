"error.E3015.message" = "A resposta é maior do que o serviço pode enviar. Peça menos dados e tente novamente.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "O mecanismo de remapeamento não está disponível. Aguarde um momento e tente novamente, ou reinicie o serviço.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "A biblioteca de perfis e o mecanismo de remapeamento não estão disponíveis. Aguarde um momento e tente novamente, ou reinicie o serviço.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "A biblioteca de perfis não está disponível. Aguarde um momento e tente novamente, ou reinicie o serviço.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "O roteador de remapeamento foi encerrado. Reinicie o serviço e tente novamente.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "O serviço não conseguiu confirmar se a última alteração de perfil foi salva. Recarregue os perfis e verifique-os antes de alterá-los novamente.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "Não foi possível ler um arquivo de perfil. Verifique se o arquivo existe e se o serviço pode lê-lo.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "Arquivos de perfil danificados precisam ser reparados ou removidos antes que os perfis possam ser alterados. Repare ou remova-os e tente novamente.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "Não foi possível gravar um arquivo de perfil. Verifique o espaço livre em disco e as permissões da pasta.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "O serviço de remapeamento encontrou um erro que não reconhece. Execute “ojd diagnose” e relate o problema junto com a saída.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "O perfil não produz nenhuma saída. Adicione a ele uma atribuição ou uma cor de luz, ou ative-o com --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "O perfil do par de Joy-Con usa o giroscópio do outro Joy-Con. Calibre o movimento do controle que o perfil seleciona para o giroscópio.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Nenhum perfil de remapeamento está ativo para o controle, então ele não processa movimento. Ative um perfil para ele, traga o app de destino para a frente e tente novamente.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "A sessão de remapeamento do controle mudou enquanto a solicitação era executada. Tente novamente.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Um perfil de um pacote instalado não pode ser alterado. Duplique o perfil e altere a cópia.";
/* Text of error E3030, returned when an action needs Post Event access and it is not granted. */
"error.E3030.message" = "A ação não foi executada porque o acesso Post Event não foi concedido. Conceda-o ao OpenJoystickDriver e tente novamente.";
/* Text of error E3031, returned when an action needs Automation access and it is not granted. */
"error.E3031.message" = "A ação não foi executada porque o acesso de Automação não foi concedido. Conceda-o ao OpenJoystickDriver e tente novamente.";
/* Text of error E3032, returned when an action needs to send keys while Secure Input blocks them. */
"error.E3032.message" = "A ação não foi executada porque o Secure Input está ativado. Feche o app que o ativou, como um campo de senha, e tente novamente.";
/* Text of error E3033, returned when a system action fails. The action name and the reason follow it. */
"error.E3033.message" = "A ação falhou.";
/* Text of error E3034, returned when the system refuses to create the MIDI source of a MIDI action. */
"error.E3034.message" = "A ação MIDI não foi executada porque o sistema recusou criar a fonte MIDI OpenJoystickDriver. Tente novamente.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.plist stays as written. */
"error.E4001.message" = "O manifesto do pacote mod.plist está ausente ou é inválido. Verifique-o com o esquema mod-package e execute o comando novamente.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "O pacote exige uma versão do OpenJoystickDriver diferente da que está em execução. Instale uma versão do pacote compatível com esta versão ou atualize o OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.plist stays as written. */
"error.E4003.message" = "Um arquivo do pacote é inválido, está ausente ou não consta em mod.plist. Corrija o arquivo indicado pelo comando e execute-o novamente.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "O pacote abrange um controle, uma persona ou um perfil que seus próprios arquivos ou outro pacote instalado já possuem. Remova o arquivo ou pacote em conflito, ou altere o pacote, e execute o comando novamente.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Já existe um pacote instalado com este nome. Execute o comando com --force para substituí-lo.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Nenhum pacote instalado tem este nome. Execute ojd mod list para ver os pacotes instalados.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "Não foi possível alterar a pasta de pacotes. Verifique o espaço livre em disco e as permissões da pasta.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Um documento não tem apiVersion, ou sua apiVersion não é compatível com esta versão do OpenJoystickDriver. Altere o documento para a apiVersion compatível que a mensagem indica e execute o comando novamente.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Uma descrição de protocolo é inválida. Verifique o arquivo com o esquema protocol-description e corrija o campo que a mensagem indica.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Uma descrição de protocolo indica uma família diferente do nome do arquivo. Dê ao arquivo o nome da sua família.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Uma descrição de protocolo lista uma variante que a família não tem. Use uma das variantes da família.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.plist is a file name and stays as written. */
"error.E5005.message" = "O arquivo de acesso AccessGrants.plist está danificado. Corrija o arquivo ou exclua-o e conceda o acesso novamente.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Não é possível ler o arquivo de chave dos IDs da Unidade, PortKeyInstallation.key, ou ele não tem 32 bytes. Restaure o arquivo a partir de um backup. Se você o apagar, o OpenJoystickDriver cria uma nova chave e todos os IDs da Unidade mudam.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Um registro de controle ou um patch é inválido. Verifique o arquivo com o esquema dele e corrija o campo que a mensagem indica.";
/* Error E5007, in place of a file path when the message does not know which file failed. */
"error.E5007.thisFile" = "este arquivo de registro";
/* Error E5007, shown when the bundled controller catalog holds no record file. */
"error.E5007.record.catalogEmpty" = "Pasta Controllers do catálogo incluído: o catálogo não tem nenhum arquivo de registro. Regra: o catálogo contém ao menos um registro de controle. Correção: reinstale o OpenJoystickDriver.";
/* Error E5007, shown when a record file is not named after its own vendorID and productID. %1$@ is the file, %2$@ the name it must have. */
"error.E5007.record.fileName" = "%1$@, vendorID e productID: o nome do arquivo deve ser %2$@, os dois IDs em hexadecimal. Correção: renomeie o arquivo para %2$@ ou corrija os IDs nele.";
/* Error E5007, shown when two record files give one controller model. %1$@ is the file, %2$@ the model, %3$@ the file that holds it first. */
"error.E5007.record.duplicateIdentity" = "%1$@, vendorID e productID: %2$@ já é a identidade do registro em %3$@. Correção: exclua um dos dois arquivos ou mude os IDs deste.";
/* Error E5007, shown when a value of a record cannot be written as JSON. %1$@ is the file, %2$@ the reason. */
"error.E5007.record.unwritableValue" = "%1$@, document: um valor não pode ser escrito como JSON (%2$@). Correção: substitua o valor que o motivo cita por uma string, um número, um booleano, uma lista ou um dicionário.";
/* Error E5007, shown when the vendorID or productID of a record is out of range. %1$@ is the file. */
"error.E5007.record.idRange" = "%1$@, vendorID e productID: vendorID deve ser 1...65535 e productID 0...65535. Correção: defina cada um como um número inteiro dentro do seu intervalo.";
/* Error E5007, shown when a patch file fails: the file is not a dictionary. %1$@ is the file. */
"error.E5007.patch.patchNotObject" = "%1$@, document: o arquivo não é um objeto JSON. Correção: faça do arquivo um dicionário com apiVersion, kind, selector e patch ou remove.";
/* Error E5007, shown when a patch file fails: the file lacks apiVersion, kind, selector, or patch and remove. %1$@ is the file. */
"error.E5007.patch.patchFields" = "%1$@, document: o arquivo deve conter apiVersion, kind, selector e patch ou remove. Correção: adicione o membro que falta.";
/* Error E5007, shown when a record or protocol description breaks a rule: HID startup writes are in a raw-USB mode or family. %1$@ is the file. */
"error.E5007.session.hidStartup" = "%1$@, session.startup: as gravações de inicialização HID valem só para controles HID, não para um modo ou família raw-USB. Correção: remova as gravações de inicialização HID, ou use pacotes raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode names a session keepAlive for a family that declares its own. %2$@ is the family. %1$@ is the file. */
"error.E5007.session.keepAliveFamily" = "%1$@, session.keepAlive: um keepAlive de sessão exige uma família raw-USB cuja descrição não declare nenhum, e %2$@ declara um. Correção: remova o keepAlive de sessão, pois %2$@ já executa o seu.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names a session key that only raw-USB modes take. %2$@ is the key. %1$@ is the file. */
"error.E5007.session.rawUSBOnly" = "%1$@, session.%2$@: session %2$@ vale só para modos raw-USB. Correção: remova %2$@ da sessão, ou use um protocolo raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: raw-USB startup writes are in a mode whose family does not read them or that lists initialization. %1$@ is the file. */
"error.E5007.session.usbStartup" = "%1$@, session.startup: as gravações de inicialização raw-USB exigem uma família que as leia e um modo sem lista de inicialização. Correção: remova as gravações de inicialização raw-USB, ou use uma família que as leia e tire a lista de inicialização.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is not the kind of packet its protocol uses. %1$@ is the file. */
"error.E5007.rumble.templateKind" = "%1$@, session.rumble: um modelo de vibração é um pacote usb para um protocolo raw-USB e um relatório HID para um protocolo HID. Correção: escreva o modelo como o tipo de pacote que o protocolo usa.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is in a family whose driver does not encode it. %1$@ is the file. */
"error.E5007.rumble.templateDriver" = "%1$@, session.rumble: modelos de vibração exigem um driver que os codifique. Correção: remova o modelo de vibração, ou use uma família cujo driver o codifique.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is beside a session keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: um resendIntervalMilliseconds de vibração não pode ser combinado com um keepAlive de sessão. Correção: remova resendIntervalMilliseconds, ou o keepAlive de sessão.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is in a family that declares its own keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithFamilyKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: um resendIntervalMilliseconds de vibração exige uma família cuja descrição não declare keepAlive. Correção: remova resendIntervalMilliseconds, pois o keep-alive da família define o tempo.";
/* Error E5007, shown when a record or protocol description breaks a rule: a record has no mode. %1$@ is the file. */
"error.E5007.modes.empty" = "%1$@, modes: modes deve conter pelo menos um modo. Correção: adicione um modo.";
/* Error E5007, shown when a record or protocol description breaks a rule: more than one mode has the id default. %1$@ is the file. */
"error.E5007.modes.defaultCount" = "%1$@, modes: no máximo um modo tem o id default. Correção: dê o id default a um só modo.";
/* Error E5007, shown when a record or protocol description breaks a rule: two modes share an id. %1$@ is the file. */
"error.E5007.modes.uniqueIDs" = "%1$@, modes: cada id de modo deve ser único. Correção: renomeie os modos que repetem um id.";
/* Error E5007, shown when a record or protocol description breaks a rule: a raw-USB mode names an interface. %1$@ is the file. */
"error.E5007.modes.interfaceRawUSB" = "%1$@, modes[].interface: um modo raw-USB não tem interface, pois reivindica a interface que seu transporte usb resolve. Correção: remova interface do modo.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names endpoints in its interfaceSignature. %1$@ is the file. */
"error.E5007.modes.endpointsHID" = "%1$@, modes[].match.interfaceSignature.endpoints: a interfaceSignature de um modo HID não tem endpoints, pois só o scanner raw-USB lê um conjunto de endpoints. Correção: remova endpoints da interfaceSignature.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode that needs input layouts finds none in the record. %1$@ is the file. */
"error.E5007.modes.inputLayoutNeeded" = "%1$@, input: um modo HIDReportLayout exige os layouts de entrada do registro. Correção: adicione input com os layouts, ou use outro protocolo.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HIDDescriptor mode finds input layouts in the record. %1$@ is the file. */
"error.E5007.modes.usageMapNotLayouts" = "%1$@, input: um modo HIDDescriptor lê um mapa de usos, não layouts de entrada. Correção: troque os layouts de entrada por um mapa de usos.";
/* Error E5007, shown when a record or protocol description breaks a rule: a usage map is in a record whose modes include a driver that does not read one. %1$@ is the file. */
"error.E5007.modes.usageMapDriver" = "%1$@, input.usageMap: um mapa de usos HID só vale se o driver de todo modo o ler. Correção: remova o mapa de usos, ou use só drivers que o leiam.";
/* Error E5007, shown when a record or protocol description breaks a rule: a capability is not declared by the driver of any mode. %1$@ is the file. */
"error.E5007.modes.capabilities" = "%1$@, capabilities: capabilities devem ser deltas que o driver de algum modo declara. Correção: mantenha só as capabilities que o driver de um modo declara.";
/* Error E5007, shown when a record or protocol description breaks a rule: a tuning key is not read by the driver. %2$@ is the key and %3$@ is the driver. %1$@ is the file. */
"error.E5007.tuning.keyNotRead" = "%1$@, tuning.%2$@: %2$@ não é lido pelo driver %3$@. Correção: remova %2$@ de tuning, ou use um driver que o leia.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults of a protocol description hold input layouts for a family that reads none. %1$@ is the file. */
"error.E5007.protocolDescription.inputLayout" = "%1$@, defaults.input: um layout de entrada só vale para uma família que o leia. Correção: remova o layout de entrada dos valores padrão.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults of a protocol description hold a usage map for a family that reads none. %1$@ is the file. */
"error.E5007.protocolDescription.usageMap" = "%1$@, defaults.input.usageMap: um mapa de usos HID só vale para uma família que o leia. Correção: remova o mapa de usos dos valores padrão.";
/* Error E5007, shown when a record or protocol description breaks a rule: a protocol description sets receiverPowerOff for a family other than XboxXUSB. %1$@ is the file. */
"error.E5007.protocolDescription.receiverPowerOff" = "%1$@, defaults.receiverPowerOff: o valor padrão receiverPowerOff vale só para XboxXUSB. Correção: remova receiverPowerOff dos valores padrão.";
/* Error E5007, shown when a record or protocol description breaks a rule: a protocol description lists session keys for a family that reads none. %2$@ is the family. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeysNone" = "%1$@, sessionKeys: %2$@ não lê chaves de sessão. Correção: deixe sessionKeys vazio.";
/* Error E5007, shown when a record or protocol description breaks a rule: the session keys of a protocol description differ from those its family reads. %2$@ is the family and %3$@ are the keys it reads. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeysRead" = "%1$@, sessionKeys: %2$@ lê as chaves de sessão %3$@. Correção: defina sessionKeys como %3$@.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults set a session key that sessionKeys does not list. %2$@ is the key. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeyUnlisted" = "%1$@, defaults.session: os valores padrão definem a chave de sessão %2$@, que sessionKeys não lista. Correção: adicione %2$@ a sessionKeys, ou remova-a dos valores padrão.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family that is always raw USB has a HID keep-alive write. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveHID" = "%1$@, defaults.session.keepAlive.writes: uma gravação keep-alive HID vale só para controles HID. Correção: remova a gravação HID, ou use uma gravação raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family without a raw-USB variant has a raw-USB keep-alive write. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveUSB" = "%1$@, defaults.session.keepAlive.writes: uma gravação keep-alive raw-USB vale só para uma família com variante raw-USB. Correção: remova a gravação raw-USB, ou use uma gravação HID.";
/* Error E5007, shown when a record or protocol description breaks a rule: a keep-alive write names a resendTuning that the family does not read or default. %2$@ is the key. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveResendTuning" = "%1$@, defaults.session.keepAlive.writes[].resendTuning: o resendTuning de uma gravação keep-alive nomeia %2$@, que a família deve ler e ter como padrão. Correção: nomeie uma chave de tuning que a família leia e tenha como padrão, ou remova resendTuning.";
/* Error E5007, shown when a record or protocol description breaks a rule: activation or deactivation names a transport that writeTransports does not list. %1$@ is the file. */
"error.E5007.protocolDescription.activationTransport" = "%1$@, activation: activation e deactivation nomeiam só um transporte que writeTransports lista. Correção: nomeie um transporte de writeTransports, ou adicione-o lá.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults leave out session fields that the family reads. %2$@ is the family and %3$@ are the fields. %1$@ is the file. */
"error.E5007.protocolDescription.sessionMissing" = "%1$@, defaults.session: %2$@ deve definir os campos de sessão %3$@. Correção: defina %3$@ nos valores padrão.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults set session fields that the family does not read. %2$@ is the family and %3$@ are the fields. %1$@ is the file. */
"error.E5007.protocolDescription.sessionUnread" = "%1$@, defaults.session: %2$@ não lê os campos de sessão %3$@. Correção: remova %3$@ dos valores padrão.";
/* Error E5007, shown when a record or protocol description breaks a rule: a named packet id does not start with its family. %2$@ is the family. %1$@ is the file. */
"error.E5007.protocolDescription.namedPacketPrefix" = "%1$@, namedPackets: o id de cada pacote nomeado começa com %2$@/. Correção: renomeie os pacotes para que cada id comece com %2$@/.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family that is always raw USB lists tuningKeys. %1$@ is the file. */
"error.E5007.protocolDescription.tuningRawUSB" = "%1$@, tuningKeys: uma família sempre raw USB lê seus ajustes por rawUSBTuningKeys. Correção: mova as chaves de tuningKeys para rawUSBTuningKeys.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family without a raw-USB variant lists rawUSBTuningKeys. %1$@ is the file. */
"error.E5007.protocolDescription.rawUSBTuningKeys" = "%1$@, rawUSBTuningKeys: rawUSBTuningKeys vale só para uma família com variante raw-USB. Correção: remova rawUSBTuningKeys, ou adicione uma variante raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: bytes are not uppercase hex pairs. %2$@ is the field and %3$@ is what the bytes belong to. %1$@ is the file. */
"error.E5007.record.hexBytes" = "%1$@, %2$@: os bytes de %3$@ devem ser pares hexadecimais maiúsculos separados por um único espaço. Correção: escreva %2$@ como pares como 42 03 00, com dígitos maiúsculos e um espaço entre os pares.";
/* Error E5007, shown when a patch file fails: patch is empty or names a section that does not exist. %1$@ is the file. */
"error.E5007.patch.patchSections" = "%1$@, patch: patch deve conter modes, usb, bluetoothLE, capabilities, server, route, input ou tuning. Correção: mantenha só essas seções e informe ao menos uma.";
/* Error E5007, shown when a virtual device file fails: a persona name is not a known persona. %2$@ is the known names. %1$@ is the file. */
"error.E5007.virtualDevice.persona" = "%1$@, persona: persona deve ser uma de %2$@. Correção: defina persona como uma delas.";
/* Error E5007, shown when a virtual device file fails: a persona file selects no model, and a user file must. %1$@ is the file. */
"error.E5007.virtualDevice.matchRequired" = "%1$@, match: um arquivo na pasta do usuário deve conter match. Correção: adicione match com o vendorID e o productID do modelo.";
/* Error E5007, shown when a virtual device file fails: a layout is not a known layout. %2$@ is the known layouts. %1$@ is the file. */
"error.E5007.virtualDevice.layout" = "%1$@, layout: layout deve ser um de %2$@. Correção: defina layout como um deles.";
/* Error E5007, shown when a virtual device file fails: a transport is not USB or Bluetooth. %1$@ is the file. */
"error.E5007.virtualDevice.transport" = "%1$@, transport: transport deve ser USB ou Bluetooth. Correção: defina transport como USB ou Bluetooth.";
/* Error E5007, shown when a virtual device file fails: labels are not Xbox or Generic. %1$@ is the file. */
"error.E5007.virtualDevice.labels" = "%1$@, labels: labels deve ser Xbox ou Generic. Correção: defina labels como Xbox ou Generic.";
/* Error E5007, shown when a virtual device file fails: a file with match also holds layout, transport or worksWithDefaultSDLHints. %1$@ is the file. */
"error.E5007.virtualDevice.matchExtras" = "%1$@, match: um arquivo com match escolhe uma persona, então não pode conter layout, transport nem worksWithDefaultSDLHints. Correção: remova layout, transport e worksWithDefaultSDLHints, ou remova match.";
/* Error E5007, shown when a virtual device file fails: a persona definition lacks layout, transport, labels, worksWithDefaultSDLHints or identity with version. %1$@ is the file. */
"error.E5007.virtualDevice.definition" = "%1$@, persona: uma definição de persona deve conter layout, transport, labels, worksWithDefaultSDLHints e identity com version. Correção: adicione as chaves que faltam, ou adicione match para escolher uma persona.";
/* Error E5007, shown when a virtual device file fails: a match unit is not a unit ID. %1$@ is the file. */
"error.E5007.virtualDevice.matchUnit" = "%1$@, match.unit: match.unit deve ser um ID de unidade. Correção: defina unit como o ID de unidade de um controle, ou omita-o.";
