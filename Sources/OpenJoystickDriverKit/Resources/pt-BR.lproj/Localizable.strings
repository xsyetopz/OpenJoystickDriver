"cli.service.wait.timeout" = "O serviço não aceitou solicitações em %@. Inicie-o com “ojd service start” ou tente de novo com um --timeout maior.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Mostra o serviço, a extensão, as permissões e os controles conectados.";
