"cli.generate.group.unchanged" = "%@ sem alterações.";
/* One-line summary of 'ojd migrate' in the command list and at the top of its help. */
"cli.migrate.group.abstract" = "Converte os documentos salvos de uma versão anterior para a versão atual.";
