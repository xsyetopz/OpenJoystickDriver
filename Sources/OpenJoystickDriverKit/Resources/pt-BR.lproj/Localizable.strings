"cli.generate.group.scriptFailedAtLine" = "O script %1$@ falhou na linha %2$@: %3$@";
/* Error of 'ojd generate' when generate returns null, no value, or something that is not a document or a list of documents. generate stays as written. */
"cli.generate.group.notDocuments" = "generate deve retornar um documento ou uma lista de documentos.";
