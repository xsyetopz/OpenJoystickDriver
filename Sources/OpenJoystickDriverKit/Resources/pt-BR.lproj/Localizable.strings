"cli.shared.error.staleInstallation" = "O OpenJoystickDriver.app instalado é mais antigo que estas fontes do repositório. Execute “just install-fast-dev” ou defina OJD_RUN_REPOSITORY_CLI=1 para executar esta compilação.";
