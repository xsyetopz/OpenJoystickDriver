"error.E3007.message" = "A solicitação tem argumentos ausentes ou inválidos. Verifique os valores e tente novamente.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "O perfil é inválido. Verifique os mapeamentos e tente novamente.";
