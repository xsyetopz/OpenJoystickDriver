/* One-line summary of 'ojd generate' in the command list and at the top of its help. */
"cli.generate.group.abstract" = "Executa um script gerador e grava os documentos que ele retorna.";
/* Help text of 'ojd generate'. generate is the name of the function that the script defines, --timeout is an option, and .js is a file extension; all three stay as written. */
"cli.generate.group.discussion" = "Executa o script em um processo auxiliar sem acesso a arquivos nem à rede, verifica os documentos que a função generate retorna e grava cada um como arquivo de lista de propriedades em --output. Sem --output, imprime os documentos. --timeout define o limite de tempo em segundos (5 por padrão).";
/* Help text of the script argument of 'ojd generate'. .js is a file extension and stays as written. */
"cli.generate.group.script" = "O script gerador, um arquivo .js.";
/* Error of 'ojd generate' when the helper process cannot start. %@ is the reason. */
"cli.generate.group.helperFailed" = "Não foi possível iniciar o processo auxiliar do script: %@";
/* Error of 'ojd generate' when the script ran past the time limit and was ended. %1$@ is the script path and %2$@ is the limit in seconds. */
"cli.generate.group.timedOut" = "%1$@ não terminou em %2$@ segundos e foi encerrado.";
/* Help text of the --output option of 'ojd generate'. */
"cli.generate.group.output" = "A pasta que recebe os arquivos. Sem ela, o comando imprime os documentos e não grava nenhum arquivo.";
/* Help text of the --replace flag of 'ojd generate'. */
"cli.generate.group.replace" = "Substitui um arquivo cujo conteúdo difere do documento.";
/* Error of 'ojd generate' when the script file cannot be read. %@ is the script path. */
