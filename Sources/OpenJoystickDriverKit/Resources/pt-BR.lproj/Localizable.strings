"cli.profile.set.done" = "%1$@ definido em “%2$@”.";
/* Error of 'ojd profile set' when the key is the profile ID. The command in quotes stays as written. */
"cli.profile.set.idChanged" = "O ID do perfil não pode mudar. Use “ojd profile duplicate” para fazer uma cópia.";
/* Error of 'ojd profile set' when the given value makes the profile invalid. %1$@ is the key path and %2$@ is the description of the problem. */
"cli.profile.set.invalid" = "Definir %1$@ torna o perfil inválido: %2$@";
/* Error of 'ojd profile set' when the key has no place in the profile. %1$@ is the profile name, shown in quotes, and %2$@ is the key path. */
"cli.profile.set.missing" = "“%1$@” não tem lugar para %2$@. Defina uma chave que exista ou defina o item pai como um valor inteiro.";
/* Help text of the VALUE argument of 'ojd profile set'. JSON stays as written. */
"cli.profile.set.value" = "O novo valor, como JSON ou como string.";
/* One-line summary of 'ojd profile show' in the command list and at the top of its help. */
"cli.profile.show.abstract" = "Mostra os ajustes e as atribuições de um perfil.";
/* One-line summary of 'ojd profile validate' in the command list and at the top of its help. */
"cli.profile.validate.abstract" = "Verifica um arquivo de perfil sem importá-lo.";
/* Long description in the help of 'ojd profile validate'. The single hyphen means stdin and stays as written. */
"cli.profile.validate.discussion" = "Verifica o arquivo com o esquema de perfil e as regras que abrangem vários campos, como origens duplicadas. Use - para ler o perfil de stdin. Não precisa de um serviço em execução. Sai com o código 1 quando o perfil é inválido.";
/* Help text of the FILE argument of 'ojd profile validate'. The single hyphen means stdin and stays as written. */
"cli.profile.validate.file" = "O arquivo do perfil, ou - para stdin.";
/* Message printed by 'ojd profile validate' for a correct profile. %1$@ is the file path or the word stdin, %2$@ is the profile name, shown in quotes, %3$@ is the controller model and %4$@ is the app scope. The command in quotes stays as written. */
"cli.profile.validate.valid" = "%1$@ é um perfil válido: “%2$@” para %3$@ (%4$@). Adicione-o com “ojd profile import”.";
/* Error when the service accepted a profile and does not list it afterwards. The command in quotes stays as written. */
"cli.profile.group.vanished" = "O serviço não manteve o perfil. Verifique-o com “ojd profile list”.";
/* Text of error E1001, sent to a client that connects to the endpoint while the endpoint is off, and printed by 'ojd explain'. The command in quotes stays as written. */
"error.E1001.message" = "O ponto de acesso está desativado. Ative-o com “ojd access enable” e conecte de novo.";
/* Text of error E1002, sent to an endpoint client that has no grant for the scopes it asked for or whose signature or proof is not valid. The two commands in quotes stay as written. */
"error.E1002.message" = "O serviço recusou este cliente. Ele não tem permissão para os escopos que pediu, ou a assinatura ou a prova dele não é válida. Execute “ojd access list”, conceda permissão ao cliente com “ojd access grant” e conecte de novo.";
/* Text of error E1003, sent when a line on the endpoint is invalid or arrives at the wrong time. Hello is the name of the first line kind and stays as written. */
"error.E1003.message" = "O serviço não conseguiu aceitar a linha. Ela não é válida ou chegou no momento errado. Envie primeiro hello, depois uma solicitação, e verifique cada linha com o esquema do ponto de acesso.";
/* Text of error E1004, sent when the endpoint refuses a ninth connection on one transport. The number 8 is the fixed limit; the socket and the WebSocket are the two transports. */
"error.E1004.message" = "O ponto de acesso já atende 8 conexões por transporte (soquete e WebSocket cada um). Feche uma conexão de que você não precisa e conecte de novo.";
/* Text of error E1005, sent to an endpoint client whose grant is removed while it is connected. The command in quotes stays as written. */
"error.E1005.message" = "A permissão deste cliente foi removida enquanto ele estava conectado. Conceda a permissão de novo com “ojd access grant” e conecte de novo.";
/* Text of error E1006, sent to an endpoint client that reads lines too slowly, so that 256 lines wait for it. 256 is the fixed limit. */
"error.E1006.message" = "O cliente leu as linhas devagar demais e 256 linhas ficaram esperando. Leia as linhas tão rápido quanto chegam e conecte de novo.";
/* Text of error E1007, sent when the service runs four virtual gamepads and a feed asks for another one. feed is a request kind of the endpoint and stays as written. */
"error.E1007.message" = "O serviço já executa 4 gamepads virtuais. Feche um feed de que você não precisa e envie feed de novo.";
/* Text of error E1008, sent when the virtual gamepad of a feed is closed. feed is a request kind of the endpoint and stays as written. */
"error.E1008.message" = "O gamepad virtual foi fechado, ou o serviço não executa nenhum. Conecte de novo e envie feed.";
/* Text of error E1009, sent when a line names an API version that the service does not speak. apiVersion and details.supportedAPIVersions are field names and stay as written. */
"error.E1009.message" = "O serviço não oferece suporte à apiVersion de uma linha. Envie uma das versões em details.supportedAPIVersions e conecte novamente.";
/* Text of error E1010, sent when a line has a kind that the service does not know or does not accept at this point. Hello, Subscription, FeedRequest and Frame are kinds of lines and stay as written. */
"error.E1010.message" = "Uma linha tem um kind que o serviço não conhece ou não aceita neste ponto. Envie primeiro Hello, depois Subscription ou FeedRequest, depois linhas Frame, e conecte novamente.";
/* Text of error E1011, sent when a line has no apiVersion or no kind. apiVersion and kind are field names and stay as written. */
"error.E1011.message" = "Falta apiVersion ou kind em uma linha. Toda linha traz os dois. Adicione-os e conecte novamente.";
