<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d controle conectado</string>
			<key>zero</key>
			<string>%d controles conectados</string>
			<key>two</key>
			<string>%d controles conectados</string>
			<key>few</key>
			<string>%d controles conectados</string>
			<key>many</key>
			<string>%d de controles conectados</string>
			<key>other</key>
			<string>%d controles conectados</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d atribuição</string>
			<key>zero</key>
			<string>%d atribuições</string>
			<key>two</key>
			<string>%d atribuições</string>
			<key>few</key>
			<string>%d atribuições</string>
			<key>many</key>
			<string>%d de atribuições</string>
			<key>other</key>
			<string>%d atribuições</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Nenhum dispositivo de saída de controle detectado</string>
			<key>one</key>
			<string>%d dispositivo de saída de controle detectado</string>
			<key>two</key>
			<string>%d dispositivos de saída de controle detectados</string>
			<key>few</key>
			<string>%d dispositivos de saída de controle detectados</string>
			<key>many</key>
			<string>%d de dispositivos de saída de controle detectados</string>
			<key>other</key>
			<string>%d dispositivos de saída de controle detectados</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>“%1$@” corresponde a %2$lld controle. Use um destes IDs:</string>
			<key>many</key>
			<string>“%1$@” corresponde a %2$lld de controles. Use um destes IDs:</string>
			<key>other</key>
			<string>“%1$@” corresponde a %2$lld controles. Use um destes IDs:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>“%1$@” nomeia %2$lld perfil. Use um destes IDs:</string>
			<key>many</key>
			<string>“%1$@” nomeia %2$lld de perfis. Use um destes IDs:</string>
			<key>other</key>
			<string>“%1$@” nomeia %2$lld perfis. Use um destes IDs:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>--soak com este --interval-ms coletaria %lld amostra; aumente --interval-ms.</string>
			<key>many</key>
			<string>--soak com este --interval-ms coletaria %lld de amostras; aumente --interval-ms.</string>
			<key>other</key>
			<string>--soak com este --interval-ms coletaria %lld amostras; aumente --interval-ms.</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>A amostragem coletaria %lld amostra. Aumente o intervalo de amostragem.</string>
			<key>many</key>
			<string>A amostragem coletaria %lld de amostras. Aumente o intervalo de amostragem.</string>
			<key>other</key>
			<string>A amostragem coletaria %lld amostras. Aumente o intervalo de amostragem.</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Esta execução coletaria %lld amostra. Aumente o intervalo de amostragem.</string>
			<key>many</key>
			<string>Esta execução coletaria %lld de amostras. Aumente o intervalo de amostragem.</string>
			<key>other</key>
			<string>Esta execução coletaria %lld amostras. Aumente o intervalo de amostragem.</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ corresponde ao estado esperado: %2$lld relatório de entrada reproduzido.</string>
			<key>many</key>
			<string>%1$@ corresponde ao estado esperado: %2$lld de relatórios de entrada reproduzidos.</string>
			<key>other</key>
			<string>%1$@ corresponde ao estado esperado: %2$lld relatórios de entrada reproduzidos.</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>O estado que o analisador de %1$@ produziu difere de %2$@ em %3$lld campo.</string>
			<key>many</key>
			<string>O estado que o analisador de %1$@ produziu difere de %2$@ em %3$lld de campos.</string>
			<key>other</key>
			<string>O estado que o analisador de %1$@ produziu difere de %2$@ em %3$lld campos.</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pacote inativo oculto (ainda incluído na exportação).</string>
			<key>many</key>
			<string>%lld de pacotes inativos ocultos (ainda incluídos na exportação).</string>
			<key>other</key>
			<string>%lld pacotes inativos ocultos (ainda incluídos na exportação).</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Parado · %lld pacote</string>
			<key>many</key>
			<string>Parado · %lld de pacotes</string>
			<key>other</key>
			<string>Parado · %lld pacotes</string>
		</dict>
	</dict>
	<!-- Choice of the idle disconnect picker in the General pane of the settings window. %d is a number of minutes, such as 15. -->
	<key>ui.settings.general.idleDisconnectMinutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d minutos</string>
			<key>one</key>
			<string>%d minuto</string>
			<key>two</key>
			<string>%d minutos</string>
			<key>few</key>
			<string>%d minutos</string>
			<key>many</key>
			<string>%d minutos</string>
			<key>other</key>
			<string>%d minutos</string>
		</dict>
	</dict>
	<!-- Row of the Simple interface in the controller detail and the profile editor: how many hidden settings that Simple hides hold a value other than their default. %d is the number of changed hidden settings. The Portuguese (Brazil) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.interface.hiddenChanges</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d ajustes ocultos alterados</string>
			<key>one</key>
			<string>%d ajuste oculto alterado</string>
			<key>two</key>
			<string>%d ajustes ocultos alterados</string>
			<key>few</key>
			<string>%d ajustes ocultos alterados</string>
			<key>many</key>
			<string>%d ajustes ocultos alterados</string>
			<key>other</key>
			<string>%d ajustes ocultos alterados</string>
		</dict>
	</dict>
</dict>
</plist>
