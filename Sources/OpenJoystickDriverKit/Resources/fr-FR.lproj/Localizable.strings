/* Error of the profile commands when another profile has the name. The command in quotes stays as written. */
"cli.shared.error.duplicateProfileName" = "Un profil portant ce nom existe déjà. « ojd profile list » affiche tous les profils.";
/* Error of every command that talks to the service when it did not reply in time and the wait is not named. The command in quotes stays as written. */
"cli.shared.error.serviceTimeout" = "Le service n’a pas répondu à temps. Réessayez ou vérifiez-le avec « ojd status ».";
/* Error of every command that needs the service when it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"cli.shared.error.serviceUnavailable" = "Le service OpenJoystickDriver n’est pas en cours d’exécution. Démarrez-le avec « ojd service start ».";
/* Error of every command when --timeout is not a number above 0. --timeout stays as written. */
"cli.shared.error.timeoutValue" = "--timeout requiert un nombre de secondes supérieur à 0.";
/* Error printed for a failure that no other message covers. %@ is the description of the failure. The command with PATH in quotes stays as written. */
"cli.shared.error.unexpected" = "Erreur inattendue : %@. Exécutez « ojd diagnose --output PATH » et joignez l’archive à un rapport de bogue.";
/* Error of ojd for a command that does not exist. %1$@ is the text the user typed and %2$@ is the closest command name. */
"cli.shared.error.unknownCommand" = "Commande inconnue « %1$@ ». Vouliez-vous dire « %2$@ » ?";
/* Help text of the --json flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.json" = "Afficher du JSON sur stdout.";
/* Help text of the --no-color flag that every command takes. */
"cli.shared.option.noColor" = "Ne pas utiliser de couleur.";
/* Help text of the --no-input flag that every command takes. */
"cli.shared.option.noInput" = "Ne jamais demander de saisie ; échouer si une valeur manque.";
/* Help text of the --plain flag that every command takes. stdout is the standard output stream and stays as written. */
"cli.shared.option.plain" = "Afficher des enregistrements séparés par des tabulations sur stdout.";
/* Help text of the --quiet flag that every command takes. stderr is the standard error stream and stays as written. */
"cli.shared.option.quiet" = "Ne pas afficher de messages de succès sur stderr.";
/* Help text of the --timeout option that every command takes. %1$g is the default number of seconds for a service request and %2$g is the default for the service, virtual set and virtual reset commands, which stay as written in quotes. */
"cli.shared.option.timeout" = "Secondes d’attente pour chaque requête au service (par défaut : %1$g), ou jusqu’à la fin des commandes « service », « virtual set » et « virtual reset » (par défaut : %2$g).";
/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "Configurer et inspecter OpenJoystickDriver, le pilote de manettes pour macOS.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Pour commencer :\n  ojd status             Vérifier le service, l’extension et les autorisations.\n  ojd diagnose           Lancer toutes les vérifications et signaler les erreurs.\n  ojd controller list    Lister les manettes connectées.\n\nExemples :\n  # Afficher l’entrée d’une manette à chaque changement\n  ojd controller watch 045E:028E\n  # Lister les manettes connectées en JSON\n  ojd --json controller list\n\nEnvironnement (une option l’emporte sur sa variable) :\n  OJD_NO_INPUT=1         Équivaut à --no-input.\n  OJD_TIMEOUT=SECONDS    Équivaut à --timeout.\n  OJD_COLOR=WHEN         auto, always (couleur même hors terminal) ou never.\n\nComplétion du shell :\n  ojd --generate-completion-script zsh|bash|fish\n\nCodes de sortie :\n  0    Succès.\n  1    La commande a échoué.\n  64   Erreur d’utilisation.\n  69   Le service n’est pas en cours d’exécution. Démarrez-le avec « ojd service start ».\n  77   Une autorisation macOS est manquante.\n  127  Une compilation du dépôt n’a pas pu transmettre la commande à l’app installée.\n  130  Interrompu.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Chaque commande accepte aussi les options globales ; « ojd --help » les liste.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT attend un nombre de secondes supérieur à 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR attend auto, always ou never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT attend 1, true, yes, 0, false ou no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain ne s’applique pas à « virtual feed », qui affiche des lignes JSON. Retirez --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Exemples :\n  # Afficher l’entrée pendant 10 secondes\n  ojd controller watch 045E:028E --duration 10\n  # Afficher la première commande actionnée, en JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Surveiller toutes les manettes et ce qu’envoie leur manette virtuelle\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Exemples :\n  # Faire tourner les deux moteurs principaux à 180 pendant 0,45 seconde\n  ojd controller rumble 045E:028E\n  # Faire tourner les deux moteurs principaux à pleine puissance pendant 2 secondes\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Exemples :\n  # Régler la barre lumineuse sur orange\n  ojd controller light 054C:09CC --color FF8000\n  # Régler la couleur et une faible luminosité\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Exemples :\n  # Créer un profil pour un modèle de manette\n  ojd profile create Racing --controller 045E:028E\n  # Ne l’appliquer que lorsque Safari est au premier plan\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Exemples :\n  # Renommer un profil\n  ojd profile set Racing name Rally\n  # Régler la zone morte intérieure de la première affectation de stick\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Exemples :\n  # Maintenir Espace tant que le bouton sud est maintenu\n  ojd binding set Racing button:south key:space\n  # Basculer J à chaque appui\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Répéter J 10 fois par seconde tant que le bouton est maintenu\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Exemples :\n  # Installer un fichier de fiche\n  ojd record install 045e-028e.plist\n  # Lire la fiche depuis stdin\n  ojd record install - < 045e-028e.plist";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Exemples :\n  # Autoriser un programme à utiliser le service\n  ojd access grant /Applications/Example.app\n  # Créer un jeton pour les pages servies depuis une origine\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "Démarrer ou arrêter le service OpenJoystickDriver, ou attendre qu’il accepte les requêtes.";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "Le service est en cours d’exécution.";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "Ouvrir l’application en arrière-plan et attendre que son service accepte les requêtes.";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "Ce ojd n’est pas dans OpenJoystickDriver.app ; il ne peut donc pas démarrer le service. Ouvrez l’application installée ou exécutez le ojd qu’elle contient.";
/* Error of 'ojd service start' when macOS cannot open the app. %@ is the path of the app. Finder is the macOS file manager. */
"platform.macos.cli.service.start.openFailed" = "macOS n’a pas pu ouvrir %@. Ouvrez-le depuis le Finder pour en voir la raison.";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "Arrêter le service et attendre qu’il se termine. Les manettes connectées reviennent à macOS.";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "Impossible d’arrêter le service : %@. Quittez OpenJoystickDriver depuis son menu.";
/* Error of 'ojd service stop' when the service keeps running. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.service.stop.timeout" = "Le service ne s’est pas arrêté en %@. Réessayez avec un --timeout plus grand.";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "Le service est arrêté.";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "Attendre que le service accepte les requêtes. --timeout limite l’attente (5 secondes par défaut).";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "Le service n’a pas accepté de requêtes en %@. Démarrez-le avec « ojd service start » ou réessayez avec un --timeout plus grand.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Afficher le service, l’extension, les autorisations et les manettes connectées.";
/* Long description in the help of 'ojd status'. It says that the command also works while the service is stopped. The exit status 0 stays as written. */
"cli.status.group.discussion" = "Fonctionne quand le service est arrêté : il le signale comme arrêté et se termine avec le code 0.";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "Accessibilité";
/* Row label in the output of 'ojd status'. The version of this command line tool follows. */
"cli.status.group.labelCommandLineTool" = "Outil en ligne de commande";
/* Heading in the output of 'ojd status' above the list of connected controllers. %lld is the number of controllers. */
"cli.status.group.labelControllers" = "Manettes (%lld)";
/* Row label in the output of 'ojd status'. The state of the driver extension follows. */
"cli.status.group.labelTransportExtension" = "Extension";
/* Row label in the output of 'ojd status' for the Input Monitoring permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputRead" = "Surveillance de l’entrée";
/* Row label in the output of 'ojd status'. The reason why the stored profile overrides could not be read follows. */
"cli.status.group.labelOverrideError" = "Erreur de remplacement";
/* Heading in the output of 'ojd status' above the list of controllers that macOS handles natively. %lld is the number of controllers. */
"platform.macos.cli.status.group.labelPassThrough" = "Prises en charge par macOS (%lld)";
/* Row label in the output of 'ojd status'. The state and version of the service follow. */
"cli.status.group.labelService" = "Service";
/* Heading in the output of 'ojd status' above the list of connected devices that the driver does not support. %lld is the number of devices. */
"cli.status.group.labelUnbound" = "Appareils non pris en charge (%lld)";
/* Row label in the output of 'ojd status'. The state of the virtual gamepad follows. */
"cli.status.group.labelVirtualDevice" = "Manette virtuelle";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is turned off. */
"cli.status.group.virtualOff" = "Désactivé";
/* Value of the 'Virtual gamepad' row of 'ojd status' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.status.group.virtualError" = "Erreur : %@";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on and no connected controller has a virtual gamepad. */
"cli.status.group.virtualNonePublished" = "Activé, aucune manette publiée";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on. %@ is the comma-separated list of the names of the controllers that a virtual gamepad stands for. */
"cli.status.group.virtualPublished" = "Activé, publie %@";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "Les manettes et les autorisations apparaissent quand le service s’exécute : « ojd service start ».";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "Activez le point d’accès et choisissez les programmes qui peuvent lire les manettes par son intermédiaire.";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "Le chemin du programme, ou un identifiant de client.";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "Aucun programme à l’emplacement %@ et aucun client avec cet identifiant. Affichez les identifiants avec « ojd access list ».";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ ne contient aucun programme signé. Autorisez le bundle d’app ou l’exécutable du programme.";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "Désactive le point d’accès et ferme ses connexions ; les autorisations sont conservées.";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "Le point d’accès est désactivé et ses connexions sont fermées.";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "Le point d’accès est un socket local depuis lequel les programmes autorisés lisent les événements des manettes. Il est désactivé tant que vous n’exécutez pas « ojd access enable », et le service ne dessert que les programmes dont vous avez autorisé la signature, ou qui envoient un jeton que vous avez autorisé. « ojd access web enable » ajoute un WebSocket sur 127.0.0.1 pour les pages d’overlay.";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "Active le point d’accès.";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "Activer le point d’accès, afin que les programmes que vous autorisez puissent lire l’entrée de toutes les manettes ?";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "Demande d’abord une confirmation. Seuls les programmes autorisés peuvent utiliser le point d’accès ; ajoutez-les avec « ojd access grant ».";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "Le point d’accès écoute sur %@.";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "Autorise un programme signé, ou un nouveau jeton, à utiliser le point d’accès.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ est signé ad hoc ou non signé, donc n’importe quel programme local peut revendiquer sa signature. Signez-le avec un certificat Developer ID ou Apple Development, puis autorisez-le.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "Apple a signé ce programme. S’il exécute des scripts, comme python3 ou osascript, chaque script qu’il exécute obtient cet accès.";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "Indiquez soit CLIENT, soit --token NAME.";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "Autoriser %1$@, signé %2$@, à utiliser le point d’accès avec %3$@ ?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
"cli.access.grant.controlWarning" = "La portée control permet au programme d’appuyer sur les boutons d’une manette virtuelle, que les jeux et les apps traitent comme votre saisie.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT est le chemin du programme ou un identifiant issu de « ojd access list ». L’autorisation désigne la signature du programme ; elle reste donc valide quand le programme est mis à jour ou déplacé. Les programmes signés ad hoc et non signés ne peuvent pas être autorisés. Avec --token à la place de CLIENT, crée un jeton avec lequel un client signe le défi du service dans son hello, sur le socket, sur le WebSocket depuis une page de l’une des valeurs de --origin ou, pour un jeton sans --origin, sur le WebSocket depuis un programme qui n’envoie aucun en-tête Origin, comme une app en bac à sable. Une page ne peut pas utiliser la portée control. Le jeton n’est affiché qu’une seule fois. Demande d’abord une confirmation.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Une origine web, comme http://127.0.0.1:8080, dont les pages peuvent utiliser le jeton sur le WebSocket. À répéter pour en ajouter. Les pages d’overlay que sert le WebSocket ont pour origine http://127.0.0.1:PORT, avec le port qu’affiche « ojd access status ».";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin ne peut pas être combiné avec la portée control. Une page ne pilote jamais une manette virtuelle ; accordez control à un jeton sans --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin nécessite --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Une portée à accorder : read ou control. Répétez pour les deux.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "%1$@ accordé à %2$@ (ID %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Crée un jeton portant ce nom au lieu d’autoriser un programme.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "Créer le jeton %1$@ avec %2$@, pour les programmes de ce Mac ?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "Portée %1$@ accordée au jeton %2$@ (ID %3$@). Gardez le jeton secret ; il ne sera plus affiché :";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "Créer le jeton %1$@ avec %2$@, pour les programmes de ce Mac et pour les pages de %3$@ ?";
/* One-line summary of 'ojd access list' in the command list and at the top of its help. */
"cli.access.list.abstract" = "Liste les clients et les jetons autorisés, ainsi que ceux refusés au cours des dernières 24 heures.";
/* Long description in the help of 'ojd access list'. It says that the printed IDs work with 'ojd access grant' and 'ojd access revoke'. token:NAME stays as written. */
"cli.access.list.discussion" = "Chaque client a un identifiant que « ojd access grant » et « ojd access revoke » acceptent ; l’identifiant d’un jeton est token:NAME.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Autorisés :";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Aucun";
/* Heading of the list of clients that connected and were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refused" = "Refusés au cours des dernières 24 heures :";
/* Heading of the list of tokens that were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refusedTokens" = "Jetons refusés au cours des dernières 24 heures :";
/* Heading of the list of granted tokens printed by 'ojd access list'. */
"cli.access.list.tokens" = "Jetons autorisés :";
/* Lowercase placeholder printed in the token list when a refused token has no name. */
"cli.access.list.unknownToken" = "jeton inconnu";
/* Error of 'ojd access' commands that change who may read the controllers, when the input is not a terminal and --force is missing. --force stays as written. */
"cli.access.group.needsForce" = "Cette modification donne aux programmes accès à vos manettes. Ajoutez --force pour la confirmer sans invite.";
/* One-line summary of 'ojd access revoke' in the command list and at the top of its help. */
"cli.access.revoke.abstract" = "Retire l’autorisation d’un programme, ou certaines de ses portées.";
/* Help text of the CLIENT argument of 'ojd access revoke'. token:NAME stays as written. */
"cli.access.revoke.client" = "Le chemin du programme, un identifiant de client ou token:NAME.";
/* Long description in the help of 'ojd access revoke'. CLIENT, --scope, 'ojd access list' and token:NAME stay as written. */
"cli.access.revoke.discussion" = "CLIENT est le chemin du programme, un identifiant issu de « ojd access list » ou token:NAME pour un jeton. Sans --scope, toute l’autorisation est retirée. Les connexions qui perdent une portée sont fermées.";
/* Message printed after 'ojd access revoke --scope' removed some scopes. %1$@ is the client ID, %2$@ is the list of scopes it keeps and %3$@ is the number of connections that were closed. */
"cli.access.revoke.partial" = "Le client %1$@ conserve %2$@. Connexions fermées : %3$@.";
/* Help text of the --scope option of 'ojd access revoke'. The values read and control stay as written because the user types them. */
"cli.access.revoke.scope" = "Une portée à retirer : read ou control. Répétez pour les deux.";
/* Message printed after 'ojd access revoke' removed a whole grant. %1$@ is the client ID and %2$@ is the number of connections that were closed. */
"cli.access.revoke.success" = "L’autorisation du client %1$@ a été retirée. Connexions fermées : %2$@.";
/* One-line summary of 'ojd access status' in the command list and at the top of its help. */
"cli.access.status.abstract" = "Indique si le point d’accès est activé, son socket et ses clients connectés.";
/* Line of 'ojd access status' with three counts. %1$@ is the number of connected clients, %2$@ the number of granted clients and %3$@ the number of clients refused in the last 24 hours. */
"cli.access.status.counts" = "Clients connectés : %1$@. Clients autorisés : %2$@. Refusés au cours des dernières 24 heures : %3$@.";
/* Line of 'ojd access status' when the endpoint is off. Keep the colon and the space after it. */
"cli.access.status.off" = "Point d’accès : désactivé";
/* Line of 'ojd access status' when the endpoint is on. Keep the colon and the space after it. */
"cli.access.status.on" = "Point d’accès : activé";
/* Line of 'ojd access status' that shows where the endpoint listens. %@ is the socket path. */
"cli.access.status.socket" = "Socket : %@";
/* Line of 'ojd access status' with two token counts. %1$@ is the number of granted tokens and %2$@ the number of tokens refused in the last 24 hours. */
"cli.access.status.tokenCounts" = "Jetons autorisés : %1$@. Jetons refusés au cours des dernières 24 heures : %2$@.";
/* Line of 'ojd access status' when the WebSocket is turned on but its port could not be opened. %@ is the port number. */
"cli.access.status.webClosed" = "WebSocket : activé, mais le port %@ n’a pas pu être ouvert";
/* Line of 'ojd access status' when the WebSocket is off. Keep the colon and the space after it. */
"cli.access.status.webOff" = "WebSocket : désactivé";
/* Line of 'ojd access status' when the WebSocket is on. %1$@ is the WebSocket address, %2$@ is the address of the overlay pages and %3$@ is the folder they are served from. */
"cli.access.status.webOn" = "WebSocket : activé sur %1$@ ; pages d’overlay sur %2$@ depuis %3$@";
/* One-line summary of 'ojd access web' in the command list and at the top of its help. The WebSocket serves overlay pages. */
"cli.access.web.abstract" = "Active ou désactive le WebSocket pour les pages d’overlay.";
/* One-line summary of 'ojd access web disable' in the command list and at the top of its help. */
"cli.access.web.disableAbstract" = "Désactive le WebSocket et ferme ses connexions ; les jetons sont conservés.";
/* Message printed after 'ojd access web disable' turned the WebSocket off. */
"cli.access.web.disableSuccess" = "Le WebSocket est désactivé, et ses connexions sont fermées.";
/* Long description in the help of 'ojd access web'. It names the address, the path /endpoint and the Overlays folder, which stay as written, and explains which pages may connect. */
"cli.access.web.discussion" = "Le WebSocket écoute uniquement sur 127.0.0.1, sur /endpoint, et sert les fichiers de son dossier Overlays sur le même port. Une page doit provenir d’une origine pour laquelle un jeton est autorisé, et doit signer le défi du service avec ce jeton dans son hello ; autorisez-en un avec « ojd access grant --token NAME --origin URL ».";
/* One-line summary of 'ojd access web enable' in the command list and at the top of its help. */
"cli.access.web.enableAbstract" = "Active le WebSocket.";
/* Yes or no question that 'ojd access web enable' asks on a terminal before it turns the WebSocket on. */
"cli.access.web.enableConfirm" = "Activer le WebSocket, afin que les pages des origines pour lesquelles vous autorisez des jetons puissent utiliser le point d’accès ?";
/* Long description in the help of 'ojd access web enable'. It says that a confirmation comes first and how the port is chosen. --port stays as written. */
"cli.access.web.enableDiscussion" = "Demande d’abord une confirmation. Sans --port, utilise le port enregistré ; la première fois, le système choisit un port libre et le service l’enregistre.";
/* Help text of the --port option of 'ojd access web enable'. The range is a fixed fact of the command. */
"cli.access.web.port" = "Le port sur 127.0.0.1, de 1024 à 65535.";
/* Help text of the --automatic option of 'ojd access web enable'. */
"cli.access.web.automatic" = "Laisser le système choisir un port libre au lieu du port enregistré.";
/* Error of 'ojd access web enable' when --automatic and --port are both given. Both option names stay as written. */
"cli.access.web.automaticConflict" = "--automatic ne peut pas être utilisé avec --port.";
/* Error of 'ojd access web enable' when --port is outside the allowed range. --port stays as written. */
"cli.access.web.portRange" = "--port doit être compris entre 1024 et 65535.";
/* One-line summary of 'ojd diagnose' in the command list and at the top of its help. */
"cli.diagnose.group.abstract" = "Lance toutes les vérifications et signale ce qui ne va pas.";
/* Detail of the input mapping check of 'ojd diagnose' when no connected controller has a rejected database line. SDL_GameControllerDB is a project name and stays as written. */
"cli.diagnose.group.inputMappingApplied" = "aucune ligne SDL_GameControllerDB rejetée";
/* Detail of the input mapping check of 'ojd diagnose' for one controller whose database line was rejected. SDL_GameControllerDB is a project name and stays as written. %1$@ is the controller name, %2$@ is the reason in English and %3$@ is the error code, which stays as written. */
"cli.diagnose.group.inputMappingRejected" = "ligne SDL_GameControllerDB rejetée pour %1$@ : %2$@ (%3$@)";
/* Detail of the switch placeholder serial check of 'ojd diagnose' when no 057E:2009 controller is connected. 057E:2009 stays as written. */
"cli.diagnose.group.switchSerialNone" = "aucune manette 057E:2009 connectée";
/* Detail of the switch placeholder serial check of 'ojd diagnose' when no connected 057E:2009 controller reports the serial 000000000001. 057E:2009 and the serial stay as written. */
"cli.diagnose.group.switchSerialOther" = "aucune manette 057E:2009 ne signale le numéro de série 000000000001";
/* Detail of the switch placeholder serial check of 'ojd diagnose' for one controller. Nintendo Switch Pro Controller is a product name and stays as written. %1$@ is the controller name, %2$@ is the VID:PID and %3$@ is the serial number, both of which stay as written. */
"cli.diagnose.group.switchSerialPlaceholder" = "%1$@ signale %2$@ avec le numéro de série %3$@, l’identité et le numéro de série d’une Nintendo Switch Pro Controller ; d’autres manettes peuvent signaler le même numéro de série. OpenJoystickDriver la traite comme une Pro Controller.";
/* Help text of the --output option of 'ojd diagnose'. A support bundle is a file with the diagnostic report for a bug report. */
"cli.diagnose.group.output" = "Écrit aussi un lot d’assistance dans ce fichier.";
/* Error of 'ojd diagnose --output' when the support bundle could not be written. %@ is the reason from the system. --output stays as written. */
"cli.diagnose.group.outputFailed" = "Le lot d’assistance n’a pas été écrit : %@. Choisissez un autre chemin pour --output.";
/* Error of 'ojd diagnose --output' when the folder of the path is missing. %@ is the folder path. --output stays as written. */
"cli.diagnose.group.outputParent" = "--output exige un dossier existant ; %@ n’existe pas.";
/* Progress line of 'ojd diagnose --output' while the support bundle is written. Keep the three dots. */
"cli.diagnose.group.outputProgress" = "Écriture du lot d’assistance…";
/* Message printed after 'ojd diagnose --output' wrote the support bundle. %@ is the file path. The bundle lists the names of the devices, so the user should read it first. */
"cli.diagnose.group.outputWritten" = "Lot d’assistance écrit dans %@. Relisez-le avant de le partager ; les noms des appareils y figurent.";
/* Long description in the help of 'ojd diagnose'. pass, warn, fail and skip are the check results printed by the command and stay as written, as do --soak and the other option names. */
"cli.diagnose.group.discussion" = "Chaque vérification renvoie pass, warn, fail ou skip. Les vérifications qui ont besoin du service sont ignorées tant qu’il est arrêté. Se termine avec le code 1 si une vérification échoue. --soak ajoute une vérification de santé d’exécution qui échantillonne le service pendant la durée indiquée ; sans cette option, elle est ignorée. --output écrit aussi un rapport d’assistance ; relisez-le avant de le partager.";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has no registration of the extension. The command in quotes stays as written. */
"platform.macos.cli.diagnose.group.transportExtensionAbsent" = "non enregistrée dans macOS ; exécutez « ojd transport-extension activate »";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has the extension active. */
"platform.macos.cli.diagnose.group.transportExtensionActive" = "active dans macOS";
/* Detail of the transport extension check of 'ojd diagnose' when the extension bundle has an unexpected identifier. %@ is that identifier. OpenJoystickDriver is the product name. */
"cli.diagnose.group.transportExtensionBundleInvalid" = "identifiant de bundle inattendu %@ ; réinstallez OpenJoystickDriver";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is not inside the app. OpenJoystickDriver is the product name. */
"cli.diagnose.group.transportExtensionBundleMissing" = "non intégrée à l’app ; réinstallez OpenJoystickDriver";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is inside the app. */
"cli.diagnose.group.transportExtensionBundlePresent" = "intégrée à l’app";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is registered but the user has not approved it. The command in quotes stays as written. */
"cli.diagnose.group.transportExtensionInactive" = "enregistrée mais inactive ; approuvez-la avec « ojd transport-extension activate »";
/* Detail of the transport extension check of 'ojd diagnose' when macOS does not report the registration. %@ is the reason from macOS. */
"platform.macos.cli.diagnose.group.transportExtensionUnavailable" = "macOS n’a pas signalé l’enregistrement : %@";
/* Last line of 'ojd diagnose' when checks failed. %lld is the number of failed checks. The command with <path> in quotes stays as written. */
"cli.diagnose.group.failed" = "Vérifications en échec : %lld. Corrigez-les à l’aide des détails ci-dessus, ou exécutez « ojd diagnose --output <path> » et joignez le fichier à un rapport de bogue.";
/* Help text of the --footprint-limit-mib option of 'ojd diagnose'. The physical footprint is the memory charged to the service in MiB, mebibytes. The range 0-65536 is fixed. */
"cli.diagnose.group.footprintLimit" = "Avec --soak, échoue au-delà de cette empreinte physique en MiB ; 0 désactive (0-65536).";
/* Help text of the --frames option of 'ojd diagnose'. The number is a count of seconds from 1 to 15. A stall is a read interval that is much longer than the usual one. */
"cli.diagnose.group.frames" = "Gardez les sticks en mouvement pendant cette durée, puis résumez uniquement les trames lues pendant ce temps (1-15). Avec une manette qui ne transmet que lorsqu’une entrée change, chaque pause de l’entrée compte comme un blocage.";
/* Error of the service when a request for frame timings asks for a frame window outside the 1 to 15 seconds the service keeps. Shown by 'ojd diagnose' if the request reaches the service. */
"cli.diagnose.group.framesInvalidRequest" = "La fenêtre de trames de la requête sort de l’intervalle de 1 à 15 secondes que conserve le service.";
/* Progress line of 'ojd diagnose --frames', written to the error output while the command waits. %@ is the wait, such as 10s. The sticks are the thumbsticks of the controller. Keep the three dots. */
"cli.diagnose.group.framesProgress" = "Gardez les sticks en mouvement pendant %@…";
/* Error of 'ojd diagnose' when --frames is out of range. --frames stays as written. The range is fixed. */
"cli.diagnose.group.framesRange" = "--frames doit être compris entre 1 et 15 secondes.";
/* Help text of the --interval-ms option of 'ojd diagnose'. The range 100-60000 is fixed. */
"cli.diagnose.group.interval" = "Avec --soak, millisecondes entre deux échantillons (100-60000).";
/* Error of 'ojd diagnose' when --interval-ms is out of range. --interval-ms stays as written. */
"cli.diagnose.group.intervalRange" = "--interval-ms doit être compris entre 100 et 60000.";
/* Error of 'ojd diagnose' when a memory limit option is out of range. Both option names stay as written. */
"cli.diagnose.group.limitRange" = "--rss-limit-mib et --footprint-limit-mib doivent être compris entre 0 et 65536.";
/* Detail of a permission check of 'ojd diagnose' when macOS denied the permission. The command in quotes stays as written. */
"cli.diagnose.group.permissionDenied" = "refusée ; accordez-la avec « ojd permission request »";
/* Detail of a permission check of 'ojd diagnose' when the state of the permission cannot be read. */
"cli.diagnose.group.permissionUnknown" = "état inconnu";
/* Help text of the --rss-limit-mib option of 'ojd diagnose'. The resident size is the memory of the service held in RAM, in MiB, mebibytes. The range 0-65536 is fixed. */
"cli.diagnose.group.rssLimit" = "Avec --soak, échoue au-delà de cette taille résidente en MiB ; 0 désactive (0-65536).";
/* Detail of the service check of 'ojd diagnose' when the service runs. %@ is the version of the service. */
"cli.diagnose.group.serviceRunning" = "en cours d’exécution %@";
/* Detail of the service check of 'ojd diagnose' when the service is stopped. The command in quotes stays as written. */
"cli.diagnose.group.serviceStopped" = "arrêté ; démarrez-le avec « ojd service start »";
/* Reason shown for a skipped check of 'ojd diagnose' when the service did not answer. */
"cli.diagnose.group.skipServiceFailed" = "le service n’a pas répondu";
/* Reason shown for a skipped check of 'ojd diagnose' when the service is not running. */
"cli.diagnose.group.skipServiceStopped" = "service arrêté";
/* Help text of the --soak option of 'ojd diagnose'. The number is a count of seconds from 1 to 86400. */
"cli.diagnose.group.soak" = "Échantillonne aussi la mémoire, les descripteurs de fichier et le CPU du service pendant cette durée (1-86400).";
/* Error of the runtime sampling in 'ojd diagnose --soak' when the settings are out of range. %1$lld and %2$lld are the lowest and highest duration in seconds; %3$lld and %4$lld are the lowest and highest interval in ms, milliseconds. The three dots between two numbers mean a range. */
"cli.diagnose.group.soakErrorInvalidConfiguration" = "L’échantillonnage requiert %1$lld...%2$lld secondes et un intervalle d’échantillonnage de %3$lld...%4$lld ms.";
/* Error of the runtime sampling in 'ojd diagnose --soak' when the service returned no sample. */
"cli.diagnose.group.soakErrorNoSamples" = "Le service n’a produit aucun échantillon d’exécution.";
/* Error of the runtime sampling in 'ojd diagnose --soak' when the system does not report the service process. %d is the process ID. */
"cli.diagnose.group.soakErrorProcessUnavailable" = "Impossible de lire les informations d’exécution du processus du service %d.";
/* Detail of the runtime health check of 'ojd diagnose' when --soak is not given. --soak SECONDS stays as written. */
"cli.diagnose.group.soakNotRequested" = "non demandé ; utilisez --soak SECONDS";
/* Progress line of 'ojd diagnose --soak'. %@ is the sampling duration, such as 30 seconds. Keep the three dots. */
"cli.diagnose.group.soakProgress" = "Échantillonnage du service pendant %@…";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when the physical footprint passed its limit. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictFootprintLimit" = "Limite d’empreinte mémoire dépassée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when too few samples were taken. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictInsufficientData" = "Données insuffisantes : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when the memory of the service grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictMemoryGrowth" = "Croissance de la mémoire observée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when the resident size passed its limit. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictResidentLimit" = "Limite de taille résidente dépassée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when resources such as file descriptors grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictResourceGrowth" = "Croissance des ressources observée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when nothing grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictStable" = "Stable : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Error of 'ojd diagnose' when --soak is out of range. --soak stays as written. The range is fixed. */
"cli.diagnose.group.soakRange" = "--soak doit être compris entre 1 et 86400 secondes.";
/* Detail of the USB check of 'ojd diagnose' when the scan fails. %@ is the reason from macOS. Input Monitoring is written as macOS names it. OpenJoystickDriver is the product name. */
"platform.macos.cli.diagnose.group.usbFailed" = "L’analyse USB a échoué : %@. Accordez la surveillance des entrées à OpenJoystickDriver.";
/* Detail of the USB check of 'ojd diagnose'. %lld is the number of vendor-specific USB controllers that the system lists. */
"cli.diagnose.group.usbOk" = "Manettes USB propriétaires visibles : %lld";
/* Detail of the hid-input-drops check of 'ojd diagnose' when the system dropped no input report of any controller. HID is a term of the USB HID standard. */
"cli.diagnose.group.hidInputDropsNone" = "Aucun rapport d’entrée HID n’a été perdu";
/* Detail of the hid-input-drops check of 'ojd diagnose', one entry per controller that lost input reports. %1$@ is the controller name, or its vendor and product ID when it has no name. %2$lld is the number of input reports the system dropped because the queue between the controller and the service was full. */
"cli.diagnose.group.hidInputDropsFound" = "Rapports d’entrée perdus pour %1$@ : %2$lld";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the user turned the virtual gamepad off. */
"cli.diagnose.group.virtualDisabled" = "manette virtuelle désactivée";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.diagnose.group.virtualError" = "erreur de la manette virtuelle : %@";
/* Detail of the virtual gamepad check of 'ojd diagnose' when the stored profile overrides cannot be read. %@ is the error message. */
"cli.diagnose.group.virtualOverride" = "les remplacements de profil enregistrés sont illisibles : %@";
/* Error of the commands that need a macOS permission. %@ is the permission name. The command in quotes stays as written. */
"cli.shared.error.permissionMissing" = "L’accès %@ est manquant. Accordez-le avec « ojd permission request ».";
/* Error of 'ojd permission request' when a permission is missing after the request. %1$@ is the permission name and %2$@ is the path of the pane in System Settings. The command in quotes stays as written. */
"platform.macos.cli.shared.error.permissionStillMissing" = "L’accès %1$@ est toujours manquant. Autorisez OpenJoystickDriver dans Réglages Système > %2$@, puis relancez « ojd permission request ».";
/* One-line summary of 'ojd transport-extension' in the command list and at the top of its help. */
"platform.macos.cli.transportExtension.group.abstract" = "Affiche, active ou désactive le pilote USB Xbox.";
/* One-line summary of 'ojd transport-extension activate' in the command list and at the top of its help. System Settings is the name of the macOS app. */
"platform.macos.cli.transportExtension.activate.abstract" = "Demande à macOS d’activer l’extension. Une approbation dans Réglages Système peut être nécessaire.";
/* Long description in the help of 'ojd transport-extension activate'. The ojd program and the path stay as written. */
"cli.transportExtension.activate.discussion" = "Lancez le ojd se trouvant dans /Applications/OpenJoystickDriver.app. L’attente de l’approbation se termine avec le code 0.";
