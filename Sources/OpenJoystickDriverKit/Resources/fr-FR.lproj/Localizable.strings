/* Error of 'ojd binding clear' when neither sources nor --all are given. --all stays as written. */
"cli.binding.clear.usage" = "Indiquez une ou plusieurs sources, ou --all.";
/* Long description in the help of 'ojd binding'. It lists the SOURCE and TARGET forms. Words in capitals, forms such as button:NAME and all option names stay as written. */
"cli.binding.group.discussion" = "Une affectation envoie une TARGET lorsqu’une SOURCE de la manette est utilisée.\n\nSOURCE : button:NAME, dpad:DIRECTION, axis:NAME[:negative|positive], trigger:NAME:STAGE, motion:lean:DIRECTION, touch:SURFACE:contact, touch:SURFACE:grid:COLUMNS:ROWS:COLUMN:ROW ou touch:SURFACE:swipe:DIRECTION:DISTANCE.\n\nTARGET : key:KEY[:mods=meta,control,alt,shift], mouse:BUTTON, move:x|y, position:x|y, scroll:x|y, gamepad:button:NAME, gamepad:dpad:DIRECTION, gamepad:axis:NAME, midi-note:CHANNEL:NOTE[:VELOCITY], midi-cc:CHANNEL:CONTROLLER ou physical:... pour la vibration, les lumières et les gâchettes adaptatives.\n\n« ojd profile show » affiche les affectations sous ces formes. Modifiez les accords, les séquences et les couches avec « ojd profile edit ».";
/* One-line summary of 'ojd binding list' in the command list and at the top of its help. */
"cli.binding.list.abstract" = "Lister les affectations d’un profil.";
/* Message of 'ojd binding list' when the profile has no bindings. %@ is the profile name. The command in quotes stays as written. */
"cli.binding.list.empty" = "« %@ » n’a aucune affectation. Ajoutez-en une avec « ojd binding set ».";
/* Error of 'ojd binding set' when a value of --multi-tap does not have the form COUNT:MS:TARGET. COUNT:MS:TARGET and the example stay as written. */
"cli.binding.group.multiTapFormat" = "--multi-tap attend COUNT:MS:TARGET, par exemple 2:300:key:key-c.";
/* Help text of the --actions-json option of 'ojd binding set'. 'ojd profile export' stays as written. */
"cli.binding.group.optionActionsJson" = "Actions supplémentaires sous forme de tableau JSON, dans le format qu’écrit « ojd profile export ».";
/* Help text of the --behavior option of 'ojd binding set'. The behavior hold is a value the user types. */
"cli.binding.group.optionBehavior" = "Quand la cible se déclenche. Par défaut : le comportement de l’affectation actuelle, ou hold.";
/* Help text of the --deadzone option of 'ojd binding set'. The dead zone is the part of an axis travel that is ignored. */
"cli.binding.group.optionDeadzone" = "Sources d’axe : la part de la course qui est ignorée, de 0 à 0.95. Par défaut : 0.1.";
/* Help text of the --digital-threshold option of 'ojd binding set'. It sets the axis travel that counts as a press. */
"cli.binding.group.optionDigitalThreshold" = "Sources d’axe : la course qui compte comme un appui pour les cibles de type bouton. Par défaut : 0.5.";
/* Help text of the --gain option of 'ojd binding set'. Gain scales the axis output. */
"cli.binding.group.optionGain" = "Sources d’axe : l’échelle de sortie, de 0.1 à 10. Par défaut : 1.";
/* Help text of the --invert flag of 'ojd binding set'. */
"cli.binding.group.optionInvert" = "Sources d’axe : inverser la direction.";
/* Help text of the --long-hold option of 'ojd binding set'. The example 500:key:key-b stays as written. */
"cli.binding.group.optionLongHold" = "Envoyer une autre cible quand la source est maintenue aussi longtemps, par exemple 500:key:key-b.";
/* Help text of the --multi-tap option of 'ojd binding set'. COUNT is the number of taps, MS the milliseconds allowed after the last release. COUNT:MS:TARGET and the example stay as written. */
"cli.binding.group.optionMultiTap" = "Envoyer une autre cible quand la source est pressée COUNT fois, chaque pression dans les MS suivant le dernier relâchement, par exemple 2:300:key:key-c. Répéter l’option pour d’autres nombres.";
