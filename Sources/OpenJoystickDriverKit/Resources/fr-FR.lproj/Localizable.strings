"cli.binding.group.voiceNeedsSpeak" = "--voice nécessite une cible speak:TEXT.";
/* Help text of the --response-curve option of 'ojd binding set'. linear is a value the user types. */
"cli.binding.group.optionResponseCurve" = "Sources d’axe : la façon dont la sortie croît avec la course. Par défaut : linear.";
