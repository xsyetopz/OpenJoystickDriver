"cli.controller.group.outputSent" = "%1$@ envoyé à %2$@.";
/* Error of the controller output commands when the controller lacks the feature. %1$@ is the controller name, %2$@ is the missing feature as a noun phrase and %3$@ is the session token for 'ojd controller show'. */
"cli.controller.group.outputUnsupported" = "%1$@ ne prend pas en charge %2$@. Exécutez « ojd controller show %3$@ » pour voir ce qu’elle prend en charge.";
/* One-line summary of 'ojd controller claim' in the command list and at the top of its help. OpenJoystickDriver is the product name. To handle a model means to read its input and publish it as a virtual gamepad. */
"cli.controller.claim.abstract" = "Faire prendre en charge un modèle de manette par OpenJoystickDriver.";
/* Long description in the help of 'ojd controller claim'. server, ojd, vvvv-pppp.plist and the record terms stay as written. */
"platform.macos.cli.controller.claim.discussion" = "Définit server sur ojd dans votre fiche du modèle, vvvv-pppp.plist dans votre dossier de fiches, et conserve les autres champs de la fiche. S’applique à toutes les manettes du modèle. Le service en cours l’applique sans rebranchement. A besoin du service pour trouver la manette. --dry-run n’écrit rien. Se termine par 1 avec E2023 pour une manette qui utilise l’USB brut, qu’OpenJoystickDriver prend toujours en charge, ou que macOS ne prend pas en charge nativement.";
/* One-line summary of 'ojd controller release' in the command list and at the top of its help. */
"platform.macos.cli.controller.release.abstract" = "Rendre un modèle de manette à macOS.";
/* Long description in the help of 'ojd controller release'. server, system and vvvv-pppp.plist stay as written. */
"platform.macos.cli.controller.release.discussion" = "Définit server sur system dans votre fiche du modèle, vvvv-pppp.plist dans votre dossier de fiches, et conserve les autres champs de la fiche. S’applique à toutes les manettes du modèle. Le service en cours l’applique sans rebranchement. A besoin du service pour trouver la manette. --dry-run n’écrit rien. Se termine par 1 avec E2023 pour une manette qui utilise l’USB brut, qu’OpenJoystickDriver prend toujours en charge, ou que macOS ne prend pas en charge nativement.";
/* Message printed by 'ojd controller claim' and related commands with --dry-run instead of writing the record. %1$@ is the controller identity, %2$@ is the server name in kebab case and %3$@ is the record file. */
"cli.controller.group.serverDryRun" = "Définirait %1$@ sur %2$@ dans %3$@.";
/* Error when the record file of a controller cannot be changed. %1$@ is the path of the record file and %2$@ is the description of the problem. */
"cli.controller.group.serverInvalid" = "Impossible de modifier %1$@ : %2$@";
/* Error when a controller has no record to change. %1$@ is the controller identity and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.controller.group.serverNoRecord" = "%1$@ n’a aucune fiche de manette à modifier. Créez-en une avec « ojd record draft %2$@ ».";
/* Message when a controller cannot be released to macOS because macOS does not handle it natively. %@ is the controller identity. OpenJoystickDriver is the product name. */
"platform.macos.cli.controller.group.serverNotNative" = "macOS ne prend pas en charge %@ nativement, donc OpenJoystickDriver la prend toujours en charge.";
/* Message when the server of a controller cannot be changed because it uses raw USB. %@ is the controller identity. OpenJoystickDriver is the product name. */
"cli.controller.group.serverRawUsb" = "%@ utilise l’USB brut, donc OpenJoystickDriver la prend toujours en charge.";
