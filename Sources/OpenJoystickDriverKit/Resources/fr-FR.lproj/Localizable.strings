"cli.generate.group.scriptFailedAtLine" = "Le script %1$@ a échoué à la ligne %2$@ : %3$@";
/* Error of 'ojd generate' when generate returns null, no value, or something that is not a document or a list of documents. generate stays as written. */
"cli.generate.group.notDocuments" = "generate doit renvoyer un document ou une liste de documents.";
