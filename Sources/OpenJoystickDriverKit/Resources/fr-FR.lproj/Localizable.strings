"cli.binding.clear.blocksInput" = "« %@ » est actif sur une manette connectée et bloque désormais toute son entrée. Ajoutez une affectation avec « ojd binding set », ou arrêtez le profil avec « ojd profile deactivate ».";
/* Yes or no question that 'ojd binding clear --all' asks on a terminal. %@ is the profile name. */
"cli.binding.clear.confirm" = "Supprimer toutes les affectations, tous les accords, séquences et couches de « %@ » ?";
/* Long description in the help of 'ojd binding clear'. --all and --force stay as written. */
"cli.binding.clear.discussion" = "--all supprime aussi les accords, séquences et couches du profil, et demande confirmation dans un terminal ; sinon, il exige --force. Les réglages des sticks, des gâchettes, du tactile, du mouvement et de la sortie sont conservés.";
/* Message printed after 'ojd binding clear' removed bindings. %1$@ is the profile name and %2$lld is the number of removed bindings, shown after a colon. */
"cli.binding.clear.done" = "Affectations supprimées de « %1$@ » : %2$lld.";
/* Message printed by 'ojd binding clear --dry-run' instead of changing the profile. %1$@ is the profile name and %2$lld is the number of bindings that would be removed, shown after a colon. */
"cli.binding.clear.dryRun" = "Affectations qui seraient supprimées de « %1$@ » : %2$lld.";
/* Message of 'ojd binding clear' when a source has no binding. %1$@ is the profile name and %2$@ is the source the user gave. */
"cli.binding.clear.missing" = "« %1$@ » n’a aucune affectation pour %2$@. Rien n’a changé.";
/* Help text of the SOURCES argument of 'ojd binding clear'. */
