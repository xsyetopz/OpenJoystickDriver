"cli.virtual.reset.errorTarget" = "Indiquez soit un CONTROLLER, soit --all.";
/* Error of 'ojd virtual reset' when --unit and --all are combined. CONTROLLER, --unit and --all stay as written. */
"cli.virtual.reset.errorUnitAll" = "--unit exige un CONTROLLER, pas --all.";
