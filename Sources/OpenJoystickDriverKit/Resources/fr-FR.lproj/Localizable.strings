"cli.virtual.set.profile" = "Le profil de la manette virtuelle.";
/* Note printed by 'ojd virtual export-mapping' for a profile that needs other SDL hints. %@ is the profile name in kebab case, which stays as written. SDL stays as written. */
"cli.virtual.group.sdlHintsNote" = "Remarque : %@ ne fonctionne pas avec les indicateurs SDL par défaut.";
/* One-line summary of 'ojd virtual show' in the command list and at the top of its help. */
"cli.virtual.show.abstract" = "Afficher la manette virtuelle de chaque manette et les profils disponibles.";
/* Value shown by 'ojd virtual show' for a controller without a virtual gamepad. */
"cli.virtual.show.none" = "aucune manette virtuelle";
/* Line of the output of 'ojd virtual show' with the profiles to choose from. %@ is the comma-separated list of profile names. */
"cli.virtual.show.profiles" = "Profils : %@";
/* Value shown by 'ojd virtual show' for a controller that no virtual gamepad profile fits. */
"cli.virtual.show.unavailable" = "aucune manette virtuelle adaptée";
/* Detail of the records check of 'ojd diagnose'. %lld is the number of the user's controller records that the driver applies. */
"cli.diagnose.group.recordsApplied" = "fiches utilisateur appliquées : %lld";
/* Detail of the records check of 'ojd diagnose' when the configuration files are valid. all.patch.plist is a file name that stays as written. */
"cli.diagnose.group.recordsConfigOk" = "all.patch.plist et les fichiers de manette virtuelle sont valides";
/* Detail of the records check of 'ojd diagnose' when parts of the configuration are ignored or skipped. %@ is the list of those parts. The command in quotes stays as written. */
"cli.diagnose.group.recordsConfigProblems" = "ignorés ou omis : %@ ; corrigez-les et vérifiez avec « ojd status »";
/* Detail of the records check of 'ojd diagnose' when records are skipped. %@ is the list of skipped records. The command in quotes stays as written. */
"cli.diagnose.group.recordsSkipped" = "ignorés : %@ ; vérifiez-les avec « ojd record list »";
/* One line of the frame timings of 'ojd diagnose'. %1$lld is the frame number, %2$@ is the controller name, %3$@ is the controller ID and %4$@ is the timestamp of the frame from the monotonic clock in nanoseconds. */
"cli.diagnose.group.timingsFrame" = "Trame %1$lld de %2$@ (%3$@), horloge monotone en nanosecondes : %4$@";
/* One gap line in the timing summary of 'ojd diagnose'. %1$@ is the gap name such as read-to-parse, which stays as written, %2$@ is the median, %3$@ is the 99th percentile and %4$@ is the maximum of the gap in milliseconds, and %5$@ is the number of frames measured. The unit symbol ms may be localized. */
"cli.diagnose.group.timingsSummaryGap" = "%1$@ : médiane %2$@ ms, 99e centile %3$@ ms, maximum %4$@ ms, échantillons : %5$@";
/* First line of the timing summary of one controller in 'ojd diagnose'. %1$@ is the controller name, %2$@ is the controller ID, %3$@ is the number of frames in the window and %4$@ is the time from the first to the last frame of the window in milliseconds. The unit symbol ms may be localized. */
"cli.diagnose.group.timingsSummaryHeader" = "Résumé des temps de %1$@ (%2$@). Trames dans la fenêtre : %3$@. Durée : %4$@ ms.";
/* Stall line of the timing summary of 'ojd diagnose' when the window holds fewer than two frames, so it has no read interval. A stall is a read interval that is much longer than the usual one. */
"cli.diagnose.group.timingsSummaryNoStalls" = "Blocages : non mesurés, la fenêtre contient moins de deux trames";
/* Stall line of the timing summary of 'ojd diagnose'. A stall is a read interval that is much longer than the usual one. %1$@ is the number of read intervals in the window longer than the threshold, %2$@ is the threshold in milliseconds and %3$@ is the multiple of the median read interval that sets the threshold. The unit symbol ms may be localized. */
"cli.diagnose.group.timingsSummaryStalls" = "Blocages (intervalles de lecture supérieurs à %2$@ ms, soit %3$@ fois la médiane des intervalles de lecture) : %1$@";
/* Stall line of the timing summary of 'ojd diagnose' when the summary covers the whole frame ring rather than a '--frames' window. Stalls are counted only during a '--frames' window, in which the user keeps the sticks moving. Keep '--frames' unchanged. */
"cli.diagnose.group.timingsSummaryStallsNeedFrames" = "Blocages : mesurés seulement avec --frames, pendant que les sticks restent en mouvement";
/* Line of 'ojd diagnose --frames' above the timing summaries. %@ is the length of the window, such as 10s. The frames are those the controller reported in that time. */
"cli.diagnose.group.timingsWindow" = "Fenêtre de temps : trames lues durant les %@ écoulées.";
/* One-line summary of 'ojd record' in the command list and at the top of its help. */
"cli.record.group.abstract" = "Ébaucher, lister, vérifier, installer ou supprimer des fiches de manette.";
/* Long description in the help of 'ojd record'. The folder path stays as written. A controller record describes how the driver talks to one controller model. */
"cli.record.group.discussion" = "Une fiche de manette indique à OpenJoystickDriver comment piloter un modèle de manette. Vos fiches se trouvent dans ~/Library/Application Support/OpenJoystickDriver/Controllers et ajoutent un modèle ou modifient un modèle intégré. Le service en cours d’exécution les applique quand le dossier change. Seule « ojd record draft » a besoin du service.";
/* One-line summary of 'ojd record draft' in the command list and at the top of its help. */
"cli.record.draft.abstract" = "Ébaucher une fiche de manette à partir d’une manette connectée.";
/* Line printed by 'ojd record draft' with the number of input reports it captured. %lld is that number. */
"cli.record.draft.captured" = "Rapports d’entrée capturés : %lld.";
/* Line printed by 'ojd record draft' for a byte that changed between reports. %1$lld is the byte position, %2$lld is the value before and %3$lld is the value after. */
"cli.record.draft.changedByte" = "L’octet %1$lld a changé : de %2$lld à %3$lld.";
/* Long description in the help of 'ojd record draft'. HID report descriptor and input report are terms of the USB HID standard. */
"cli.record.draft.discussion" = "Lit le descripteur de rapport HID de la manette et capture ses rapports d’entrée pendant que vous appuyez sur chaque commande, puis affiche une fiche de départ. La fiche associe les boutons, les sticks, les gâchettes et la croix directionnelle que le descripteur indique clairement. Les octets qui ont changé pendant la capture montrent où se trouvent les autres commandes. Nécessite le service.";
/* Help text of the duration option of 'ojd record draft'. */
"cli.record.draft.duration" = "Capturer les rapports d’entrée pendant ce nombre de secondes.";
/* Help text of the --from-sdl flag of 'ojd record draft'. SDL_GameControllerDB is a project name and stays as written. */
"cli.record.draft.fromSDL" = "Rédige le brouillon à partir de la ligne SDL_GameControllerDB de la manette au lieu de capturer des rapports d’entrée.";
/* Note printed by 'ojd record draft' when the draft lacks the input section. The command in quotes stays as written, including FILE. */
"cli.record.draft.missingInput" = "Le brouillon n’a pas de section input, car les commandes de cet appareil sont inconnues. Ajoutez-la, puis exécutez « ojd record validate FILE ».";
/* Hint printed after 'ojd record draft'. The command in quotes stays as written, including FILE. */
"cli.record.draft.next" = "Enregistrez la fiche dans un fichier, vérifiez chaque commande, puis exécutez « ojd record validate FILE ».";
/* Message of 'ojd record draft' when the descriptor of the controller yields no controls and the bundled record names the family. %1$@ is the controller identity, VVVV:PPPP, and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.record.draft.noLayout" = "Aucune commande de %1$@ n’a pu être lue depuis son descripteur de rapport HID, et sa fiche intégrée en nomme déjà la famille. « ojd record show %2$@ » affiche cette fiche.";
/* Message of 'ojd record draft --from-sdl' when the HID report descriptor of the controller fails the HIDDescriptor contract. SDL_GameControllerDB is a project name and HIDDescriptor is a protocol family name; both stay as written. %1$@ is the controller identity, VVVV:PPPP, and %2$@ is the name of the violated rule, which stays as written. */
"cli.record.draft.sdl.contract" = "Le descripteur de rapport HID de %1$@ ne respecte pas le contrat HIDDescriptor (%2$@) ; aucune ligne SDL_GameControllerDB ne peut donc la lier.";
/* Message of 'ojd record draft --from-sdl' when the controller model already has a bundled record. SDL_GameControllerDB is a project name and stays as written. %@ is the controller identity, VVVV:PPPP. */
"cli.record.draft.sdl.hasRecord" = "%@ a une fiche fournie, qu’aucune ligne SDL_GameControllerDB ne remplace.";
/* Message of 'ojd record draft --from-sdl' when the database has no line for the controller. SDL_GameControllerDB is a project name and stays as written. GUID is the SDL controller identifier. %1$@ is the controller identity, VVVV:PPPP, and %2$@ is its GUID, which stays as written. */
"cli.record.draft.sdl.noLine" = "SDL_GameControllerDB n’a aucune ligne pour %1$@ (GUID %2$@).";
/* Message of 'ojd record draft --from-sdl' when the controller is not connected as a HID device that the command can read. %@ is the controller identity, VVVV:PPPP. */
"cli.record.draft.sdl.noPad" = "%@ n’est pas connectée comme un périphérique HID que cette commande peut lire.";
/* Message of 'ojd record draft --from-sdl' when the database line of the controller cannot drive it. SDL_GameControllerDB is a project name and stays as written. %1$@ is the controller identity, VVVV:PPPP, and %2$@ is the reason in English. */
"cli.record.draft.sdl.rejected" = "Ligne SDL_GameControllerDB rejetée pour %1$@ : %2$@";
/* Prompt of 'ojd record draft' while it captures reports. %1$@ is the controller name and %2$@ is its vendor and product ID. */
"cli.record.draft.started" = "Appuyez sur chaque commande de %1$@ (%2$@), puis déplacez chaque stick et chaque gâchette.";
/* Note printed by 'ojd record draft' before a draft of a controller the service does not serve. %1$@ is the controller name, %2$@ is its vendor and product ID. */
"cli.record.draft.unserved" = "%1$@ (%2$@) n’est pas pris en charge par OpenJoystickDriver, donc rien n’a été capturé. Le brouillon provient de ses interfaces USB.";
/* Error of the 'ojd record' commands when a record file cannot be read. %1$@ is the file path and %2$@ is the reason from the system. */
"cli.record.group.errorUnreadable" = "Impossible de lire %1$@ : %2$@";
/* Help text of the file argument of the 'ojd record' commands. The single hyphen means stdin and stays as written. */
"cli.record.group.file" = "Un fichier de fiche, ou - pour lire la fiche depuis l’entrée standard.";
/* Help text of the controller model argument of the 'ojd record' commands. VVVV:PPPP is the vendor ID and product ID in hexadecimal and stays as written. */
"cli.record.group.identity" = "Le modèle de manette, sous la forme VVVV:PPPP.";
/* One-line summary of 'ojd record install' in the command list and at the top of its help. */
"cli.record.install.abstract" = "Vérifier une fiche de manette et l’installer pour votre utilisateur.";
/* Yes or no question that 'ojd record install' asks on a terminal before it replaces an installed record. %@ is the path of the installed file. */
"cli.record.install.confirm" = "Remplacer %@ ?";
/* Long description in the help of 'ojd record install'. vvvv-pppp.plist and --force stay as written. */
"cli.record.install.discussion" = "Écrit la fiche sous le nom vvvv-pppp.plist dans votre dossier de fiches. Le service en cours d’exécution l’applique immédiatement. Remplacer la fiche déjà installée pour ce modèle demande confirmation dans un terminal ; exige --force sinon. --dry-run vérifie la fiche et n’écrit rien. Se termine avec le code 1 et n’écrit rien lorsque la fiche est invalide.";
/* Message printed by 'ojd record install --dry-run' instead of installing. %@ is the target file path. */
"cli.record.install.dryRun" = "Installerait %@.";
/* Error when the record file cannot be written. %1$@ is the target file path and %2$@ is the reason from the system. */
"cli.record.install.failed" = "Impossible d’écrire %1$@ : %2$@";
/* Message printed after 'ojd record install'. %@ is the target file path. The service picks the record up without a restart. */
"cli.record.install.success" = "Installation de %@ terminée. Le service en cours d’exécution l’applique maintenant.";
/* Error of the 'ojd record' commands when a record is invalid. %1$@ is the file path or the word stdin and %2$@ is the description of the problem. */
"cli.record.group.invalid" = "%1$@ n’est pas une fiche valide : %2$@";
/* One-line summary of 'ojd record list' in the command list and at the top of its help. */
"cli.record.list.abstract" = "Lister chaque fiche de manette et la couche dont elle provient.";
/* Help text of the flag of 'ojd record list' that limits the list to the bundled catalog. The bundled catalog is the set of records inside the app. */
"cli.record.list.bundled" = "Lister uniquement le catalogue intégré.";
/* Long description in the help of 'ojd record list'. OJD is the short product name. */
"cli.record.list.discussion" = "Liste les fiches intégrées avec vos fiches appliquées, et nomme chaque fichier que OJD a ignoré, avec la raison.";
/* One-line summary of 'ojd record remove' in the command list and at the top of its help. */
"cli.record.remove.abstract" = "Supprimer votre fiche pour un modèle de manette.";
/* Yes or no question that 'ojd record remove' asks on a terminal. %@ is the list of files to delete. */
"cli.record.remove.confirm" = "Supprimer %@ ?";
/* Long description in the help of 'ojd record remove'. --force stays as written. */
"cli.record.remove.discussion" = "Un modèle intégré revient à sa fiche intégrée. Demande confirmation dans un terminal ; exige --force sinon.";
/* Message printed by 'ojd record remove --dry-run' instead of deleting. %@ is the list of files. */
"cli.record.remove.dryRun" = "Supprimerait %@.";
/* Error of 'ojd record remove' when a file cannot be deleted. %1$@ is the file path and %2$@ is the reason from the system. */
"cli.record.remove.failed" = "Impossible de supprimer %1$@ : %2$@";
/* Error of 'ojd record remove' when the user has no record for the model. %@ is the model, VVVV:PPPP. The command in quotes stays as written. */
"cli.record.remove.notFound" = "Vous n’avez pas de fiche pour %@. « ojd record list » affiche vos fiches.";
/* Message printed after 'ojd record remove'. %@ is the list of deleted files. */
"cli.record.remove.success" = "Suppression de %@ terminée.";
/* One-line summary of 'ojd record show' in the command list and at the top of its help. */
"cli.record.show.abstract" = "Afficher la fiche effective d’un modèle de manette et la couche de chaque partie.";
/* Error of 'ojd record show' and 'ojd config show' when no record matches the model. %@ is the model, VVVV:PPPP. The command in quotes stays as written. */
"cli.record.show.notFound" = "Aucune fiche de manette pour %@. « ojd record list » affiche toutes les fiches.";
/* Line of the output of 'ojd record list' for a record file the driver skipped. %1$@ is the file name and %2$@ is the reason. */
"cli.record.group.skipped" = "Ignoré %1$@ : %2$@";
/* One-line summary of 'ojd record test' in the command list and at the top of its help. A parser turns the packets of a controller into its state. */
"cli.record.test.abstract" = "Rejouer des rapports capturés avec l’analyseur d’une fiche et comparer l’état analysé.";
/* Error of 'ojd record test' when the capture file is not a packet capture. %1$@ is the file path and %2$@ is the line number and the problem found on that line. */
"cli.record.test.captureInvalid" = "%1$@ n’est pas une capture de paquets : %2$@";
/* Line of the output of 'ojd record test' for each field of the controller state that differs. %1$@ is the field name, %2$@ is the expected value and %3$@ is the value found. */
"cli.record.test.difference" = "%1$@ : attendu %2$@, obtenu %3$@";
/* Long description in the help of 'ojd record test'. The command in quotes and the JSON terms stay as written. */
"cli.record.test.discussion" = "Rejoue les paquets reçus d’une capture avec l’analyseur de la fiche, puis compare l’état de la manette après le dernier rapport d’entrée avec l’état attendu. La capture est constituée des lignes JSON de « ojd controller capture --json ». L’état attendu est un objet JSON de la forme d’une ligne de « ojd controller watch --json ». La commande liste chaque champ qui diffère et se termine avec le code 1 si l’un d’eux diffère. Elle compare tous les champs sauf connection, que définit le service en cours d’exécution. Elle n’a pas besoin du service.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "L’état attendu de la manette, sous forme de fichier JSON.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ n’est pas un état de manette : %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "Aucun rapport de %1$@ ne contenait d’entrée pour %2$@. Capturez de nouveau en appuyant sur les commandes.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "La famille de %@ n’a pas d’analyseur qui fonctionne sans manette.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "Une capture de paquets, sous forme de lignes JSON de « ojd controller capture --json ».";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "L’analyseur de %1$@ a rejeté le paquet reçu %2$lld de %3$@.";
/* Text of error E2022, printed when the controller state that a record parser produces from a capture differs from the expected state. */
"error.E2022.message" = "L’état que l’analyseur de la fiche a produit à partir des rapports capturés diffère de l’état attendu. Lisez les champs que la commande liste.";
/* Text of error E2023, printed when a controller cannot be claimed or released because its protocol family uses raw USB or the system does not serve it natively. The settings window shows it too. */
"error.E2023.message" = "Cette manette ne peut pas être réclamée ni rendue : sa famille de protocole utilise l’USB brut, ou le système ne la prend pas en charge nativement. Le message en indique la raison.";
/* Text of error E2024, printed when no endpoint client or token has the given ID. ojd access is the command that lists the IDs and stays as written. */
"error.E2024.message" = "Aucun client ni jeton du point d’accès n’a cet ID. Exécutez ojd access pour lister les ID, puis utilisez-en un.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "Un client avec ce type de signature ne peut pas recevoir d’accès, car n’importe quel programme local peut revendiquer sa signature.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Choisissez au moins une portée à accorder.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "Le service est en cours d’arrêt. Démarrez-le, puis réessayez.";
/* Text of error E2028, printed when a token with the chosen name exists. */
"error.E2028.message" = "Un jeton portant ce nom existe. Révoquez-le d’abord ou choisissez un autre nom.";
/* Text of error E2029, printed when a token name has characters that are not allowed. The limit of 64 characters is fixed. */
"error.E2029.message" = "Ce n’est pas un nom de jeton. Utilisez de 1 à 64 lettres, chiffres, points, tirets ou tirets bas.";
/* Text of error E2030, printed when a web origin is not valid. scheme://host[:port], http, https and the example in backticks stay as written. */
"error.E2030.message" = "Ce n’est pas une origine web. Utilisez scheme://host[:port] avec http ou https, par exemple `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Ce port sur 127.0.0.1 est utilisé ou ne peut pas être ouvert. Choisissez-en un autre avec --port.";
/* Text of error E2032, printed when the control scope is granted to a token that has origins. */
"error.E2032.message" = "Un jeton avec des origines ne peut pas avoir la portée control, car une page ne doit jamais piloter une manette virtuelle. Accordez control à un jeton sans origines.";
/* Text of error E2033, printed when 'ojd virtual launch' cannot start the program. */
"error.E2033.message" = "Le programme n’a pas pu être lancé. Vérifiez que son chemin désigne un fichier exécutable ou une app, et que vous avez le droit de l’exécuter.";
/* Error E2034, shown in the app or the CLI when the service no longer accepts requests. */
"error.E2034.message" = "Le service n’accepte plus de requêtes. Quittez OpenJoystickDriver, rouvrez-le, puis réessayez.";
/* Error E2035, shown in the app or the CLI when the file that records why the request listener stopped is unusable. */
"error.E2035.message" = "Le fichier qui indique pourquoi l’écoute des requêtes s’est arrêtée est inutilisable. Supprimez le fichier, puis rouvrez OpenJoystickDriver.";
/* Error E2036, shown by ojd and the app when no OpenJoystickDriver app took the test notification or reported on it before the deadline. */
"error.E2036.message" = "Aucune app OpenJoystickDriver n’a répondu à temps à la notification de test. Vérifiez que l’app est en cours d’exécution, puis réessayez.";
/* Error E2037, shown by ojd and the app when notifications are not allowed for the app, so the test notification could not be shown. */
"error.E2037.message" = "Les notifications ne sont pas autorisées pour OpenJoystickDriver. Autorisez-les dans les réglages de notifications du système, puis réessayez.";
/* Error E2038, shown by ojd and the app when the selected controller has no speaker to play sound on. */
"error.E2038.message" = "La manette n’a pas de haut-parleur. Choisissez une manette qui peut lire du son, puis réessayez.";
/* Error E2039, shown by ojd when the audio file given to the speaker command is not an uncompressed PCM WAV file. */
"error.E2039.message" = "Le fichier audio n’est pas pris en charge. Utilisez un fichier WAV PCM non compressé, puis réessayez.";
/* Error E2040, shown by ojd and the app when the extension plugged into the controller did not answer its setup. */
"error.E2040.message" = "L’extension de la manette n’a pas répondu à sa configuration. Reconnectez l’extension, puis réessayez.";
/* Note about a controller record whose raw USB family the USB extension cannot claim because Apple signs its product list. OJD is the short product name. */
"platform.macos.cli.record.group.usbNotClaimed" = "La famille utilise l’USB brut, et l’extension USB ne peut pas prendre en charge cette manette, car sa liste de produits est signée par Apple. OJD ne l’atteint que par un accès USB direct, lorsque macOS l’autorise.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "USB uniquement. Ajoutez bluetoothLE.vibrationCharacteristic à cette fiche Switch 2 pour connecter la manette en Bluetooth LE.";
/* One-line summary of 'ojd record validate' in the command list and at the top of its help. */
"cli.record.validate.abstract" = "Vérifier une fiche de manette sans l’installer.";
/* Long description in the help of 'ojd record validate'. It lists what the check covers and says that the exit status is 1 for an invalid record. The USB extension is the driver extension that gives raw USB access; the exit status 1 stays as written. */
"cli.record.validate.discussion" = "Vérifie la forme de la fiche, la cohérence de ses champs entre eux et son adéquation au catalogue intégré, et indique si la manette a besoin de l’extension USB. Se termine avec le code 1 lorsque la fiche est invalide.";
/* Message printed by 'ojd record validate' for a correct record. %1$@ is the file path, %2$@ is the operation in kebab case such as install, %3$@ is the controller model and %4$@ is the protocol family. The command in quotes stays as written. */
"cli.record.validate.valid" = "%1$@ est une fiche %2$@ valide pour %3$@ (%4$@). Installez-la avec « ojd record install ».";
