"cli.controller.group.outputFailed" = "%1$@ n’a pas accepté la commande %2$@ (%3$@). Vérifiez avec « ojd log show ».";
/* Error of the controller output commands when the controller disconnects before the command is sent. %@ is the controller name. */
"cli.controller.group.outputGone" = "%@ s’est déconnectée avant l’envoi de la commande. Reconnectez-la et réessayez.";
