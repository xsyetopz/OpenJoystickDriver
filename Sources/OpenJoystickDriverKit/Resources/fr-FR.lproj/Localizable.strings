"cli.virtual.reset.discussion" = "--all efface aussi les choix des modèles non connectés. Demande d’abord confirmation dans un terminal, sinon --force est nécessaire.";
/* Message printed by 'ojd virtual reset --dry-run' instead of resetting. %@ is the controller name. */
"cli.virtual.reset.dryRun" = "Remettrait %@ en sélection automatique de la manette virtuelle.";
