"platform.macos.cli.controller.disconnect.discussion" = "Ferme la connexion Bluetooth classique. La manette reste jumelée et se reconnecte quand vous la rallumez. Attend au moins 6 secondes la confirmation de Bluetooth. Le service ne peut pas déconnecter une manette Bluetooth Low Energy. Éteignez-la ou déconnectez-la dans Réglages Système > Bluetooth.";
/* Message printed after 'ojd controller disconnect' disconnected the controller. %@ is the controller name. */
"cli.controller.disconnect.done" = "%@ déconnectée.";
/* Error of 'ojd controller disconnect' for a Bluetooth Low Energy controller. %@ is the controller name. System Settings and Bluetooth are macOS names. */
"platform.macos.cli.controller.disconnect.bluetoothLe" = "%@ est connectée en Bluetooth Low Energy, et le service ne peut pas la déconnecter. Éteignez la manette ou déconnectez-la dans Réglages Système > Bluetooth.";
