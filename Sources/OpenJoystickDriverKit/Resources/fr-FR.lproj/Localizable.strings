"cli.generate.group.output" = "Le dossier qui reçoit les fichiers. Sans lui, la commande affiche les documents et n’écrit aucun fichier.";
/* Help text of the --replace flag of 'ojd generate'. */
"cli.generate.group.replace" = "Remplace un fichier dont le contenu diffère du document.";
/* Error of 'ojd generate' when the script file cannot be read. %@ is the script path. */
"cli.generate.group.unreadable" = "Impossible de lire %@.";
/* Error of 'ojd generate' when the script defines no function named generate. %@ is the script path; generate stays as written. */
"cli.generate.group.missingGenerate" = "%@ ne définit aucune fonction generate.";
/* Error of 'ojd generate' when the script throws a value that has no line number. %1$@ is the script path and %2$@ is the message. */
"cli.generate.group.scriptFailed" = "Le script %1$@ a échoué : %2$@";
