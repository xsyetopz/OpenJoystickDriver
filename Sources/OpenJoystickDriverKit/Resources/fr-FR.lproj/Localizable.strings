/* Error of every command when --json and --plain are both given. Both option names stay as written. */
"cli.shared.error.jsonPlain" = "Utilisez --json ou --plain, mais pas les deux.";
/* Error of every command that talks to the service when the service refuses this ojd because its code signature differs from the app. ojd and OpenJoystickDriver.app stay as written. */
"cli.shared.error.peerRejected" = "Le service a rejeté ce ojd, car il n’est pas signé comme l’application. Exécutez le ojd fourni dans OpenJoystickDriver.app.";
/* Error of every command that talks to the service when it does not reply in time. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.shared.error.requestTimeout" = "Le service n’a pas répondu en %@. Réessayez avec un --timeout plus grand.";
/* Error of every command that talks to the service when the service reports a failure. %@ is the reason from the service. The command in quotes stays as written. */
