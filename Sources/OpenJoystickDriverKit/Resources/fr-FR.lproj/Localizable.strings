"cli.generate.group.duplicate" = "Les documents %1$@ et %2$@ seraient tous deux écrits dans %3$@, donc aucun fichier n’a été écrit.";
/* Error of 'ojd generate' when a file holds other content than the generated document. %@ is the file path; --replace stays as written. */
"cli.generate.group.conflict" = "%@ contient un autre contenu, donc aucun fichier n’a été écrit. Utilisez --replace pour l’écraser.";
/* Error of 'ojd generate' when a file cannot be written. %1$@ is the file path and %2$@ is the reason. */
"cli.generate.group.writeFailed" = "Impossible d’écrire %1$@ : %2$@";
/* Line of 'ojd generate' for a file that it wrote anew. %@ is the file path. */
"cli.generate.group.created" = "%@ a été créé.";
/* Line of 'ojd generate' for a file whose other content it replaced. %@ is the file path. */
"cli.generate.group.replaced" = "%@ a été remplacé.";
/* Line of 'ojd generate' for a file that already held the generated document. %@ is the file path. */
"cli.generate.group.unchanged" = "%@ est inchangé.";
/* One-line summary of 'ojd migrate' in the command list and at the top of its help. */
"cli.migrate.group.abstract" = "Convertit les documents enregistrés d'une version plus ancienne vers la version actuelle.";
/* Help text of 'ojd migrate'. Settings.plist, AccessGrants.plist, apiVersion and Migrated are file, field and folder names and stay as written. */
"cli.migrate.group.discussion" = "Convertit Settings.plist, AccessGrants.plist, les profils, vos fiches et correctifs de manettes et les fichiers de manettes virtuelles qui ont une apiVersion plus ancienne. Chaque original est conservé dans le dossier Migrated du dossier de support. Les paquets de mods sont aussi convertis. Indiquez un dossier pour l’analyser à la place du dossier de support. Chaque fichier reçoit un verdict : Migrated, Current, Failed ou Foreign.";
/* Help text of the --dry-run option of 'ojd migrate'. */
"cli.migrate.group.dryRun" = "Liste les documents qui seraient convertis sans rien modifier.";
/* Message printed by 'ojd migrate' when no stored document has an older version. */
"cli.migrate.group.none" = "Aucun document ne nécessite de migration.";
/* Line printed by 'ojd migrate' for a converted document. %@ is the path of the document in the support folder. Migrated is a folder name and stays as written. */
"cli.migrate.group.converted" = "%@ converti. L'original se trouve dans le dossier Migrated.";
/* Line printed by 'ojd migrate --dry-run' for a document it would convert. %@ is the path of the document in the support folder. */
"cli.migrate.group.wouldConvert" = "%@ serait converti.";
/* Line printed by 'ojd migrate' for a document it cannot convert. %1$@ is the path of the document, %2$@ is the reason. */
"cli.migrate.group.failed" = "%1$@ reste inchangé : %2$@";
/* Error text of 'ojd migrate' when at least one document could not be converted. */
"cli.migrate.group.failedSummary" = "Certains documents n'ont pas pu être convertis et restent inchangés. La sortie les nomme un par un.";
/* Help text of the folder argument of 'ojd migrate'. */
"cli.migrate.group.folder" = "Un dossier à analyser à la place du dossier de support.";
/* Line printed by 'ojd migrate' for a file that is in the current format. %@ is the path of the file. */
"cli.migrate.group.current" = "%@ est déjà à jour.";
/* Line printed by 'ojd migrate' for a file that is not an OpenJoystickDriver document. %@ is the path of the file. OpenJoystickDriver is a product name and stays as written. */
"cli.migrate.group.foreign" = "%@ n’est pas un document d’OpenJoystickDriver et reste inchangé.";
