"error.E5007.patch.selectorAllTrue" = "%1$@, selector.all : selector.all doit être true. Correction : mettez all à true ou utilisez model ou vendorID avec productID.";
/* Error E5007, shown when a patch file fails: a selector ID is out of range. %1$@ is the file. */
"error.E5007.patch.selectorIdRange" = "%1$@, selector.vendorID, selector.productID : vendorID doit valoir 1...65535 et productID 0...65535. Correction : donnez à chacun un nombre entier de sa plage.";
/* Error E5007, shown when a patch file fails: selector.model is not vvvv-pppp in lowercase hex. %1$@ is the file. */
"error.E5007.patch.selectorModel" = "%1$@, selector.model : selector.model doit être vvvv-pppp en hexadécimal minuscule. Correction : écrivez chaque ID avec quatre chiffres hexadécimaux minuscules.";
/* Error E5007, shown when a patch file fails: the selector has members of no form. %1$@ is the file. */
"error.E5007.patch.selectorShape" = "%1$@, selector : selector doit être all, model ou vendorID avec productID. Correction : gardez exactement les membres d’une de ces formes.";
/* Error E5007, shown when a user or package record file is skipped: a Controller file is not named after its IDs. %2$@ is the name it must have. %1$@ is the file. */
"error.E5007.userFile.fileNameRecord" = "%1$@, file name: le nom du fichier doit être %2$@. Correction : renommez le fichier en %2$@ ou corrigez les ID qu’il contient.";
/* Error E5007, shown when a user or package record file is skipped: two packages give one controller. %2$@ is the other package. %1$@ is the file. */
"error.E5007.userFile.packageSameController" = "%1$@, vendorID, productID: le paquet %2$@ fournit déjà cette manette. Correction : retirez l’un des deux paquets ou changez les ID de cette fiche.";
/* Error E5007, shown when a user or package record file is skipped: a patch file is not named after its selector. %2$@ is the name it must have. %1$@ is the file. */
"error.E5007.userFile.fileNamePatch" = "%1$@, file name: le nom du fichier doit être %2$@. Correction : renommez le fichier en %2$@ ou corrigez le sélecteur qu’il contient.";
/* Error E5007, shown when a user or package record file is skipped: the file is not a dictionary. %1$@ is the file. */
"error.E5007.userFile.notDictionary" = "%1$@, document: le fichier n’est pas un dictionnaire. Correction : faites de la racine de la liste de propriétés un dictionnaire.";
/* Error E5007, shown when a user or package record file is skipped: a Controller file names a bundled controller. %2$@ is the model. %1$@ is the file. */
"error.E5007.userFile.bundledController" = "%1$@, vendorID, productID: %2$@ est une manette intégrée, qu’un fichier Controller ne peut pas ajouter. Correction : écrivez à la place un fichier de correctif.";
/* Error E5007, shown when a user or package record file is skipped: the file adds or patches a bootloader identity. %2$@ is the model. %1$@ is the file. */
"error.E5007.userFile.bootloaderController" = "%1$@, vendorID, productID : %2$@ est une identité de bootloader, donc aucun fichier utilisateur ou de paquet ne peut l’ajouter ni la corriger. Correction : supprimez le fichier ; OJD n’envoie aucune donnée à une manette en état de bootloader.";
/* Error E5007, shown when a user or package record file is skipped: a patch selects no known controller. %2$@ is the selector. %1$@ is the file. */
"error.E5007.userFile.unknownController" = "%1$@, selector: le sélecteur %2$@ ne correspond à aucune manette connue. Correction : utilisez un fichier Controller pour ajouter une nouvelle manette ou corrigez le sélecteur.";
/* Error E5007, shown when a user or package record file is skipped: the record that a patch applies to is not a dictionary. %1$@ is the file. */
"error.E5007.userFile.upstreamNotDictionary" = "%1$@, document: la fiche à laquelle le correctif s’applique n’est pas un dictionnaire. Correction : réparez le fichier de fiche auquel le correctif s’applique.";
/* Error E5007, shown when a user or package record file is skipped: a patch changes nothing in the record. %1$@ is the file. */
"error.E5007.userFile.patchNoChange" = "%1$@, patch: le correctif ne change rien dans la fiche. Correction : supprimez le correctif ou donnez une valeur différente de celle de la fiche.";
/* Error E5007, shown when an input layout of a record fails: input lists no layout. %1$@ is the file. */
"error.E5007.inputLayout.layoutsEmpty" = "%1$@, input.layouts: input doit lister au moins une disposition. Correction : ajoutez une disposition ou supprimez input.";
/* Error E5007, shown when an input layout of a record fails: two layouts select one report. %2$@ and %3$@ are the layouts. %1$@ is the file. */
"error.E5007.inputLayout.layoutsSameReport" = "%1$@, input.layouts: deux dispositions sélectionnent le même rapport : %2$@ et %3$@. Correction : donnez-leur des ID ou des longueurs de rapport différents, ou supprimez-en une.";
/* Error E5007, shown when an input layout of a record fails: a report ID is out of range. %1$@ is the file. */
"error.E5007.inputLayout.reportIdRange" = "%1$@, input.layouts[].report.id: un ID de rapport va de 1...255. Correction : donnez un nombre entier de 1 à 255 ou omettez-le.";
/* Error E5007, shown when an input layout of a record fails: a report length is out of range. %2$@ is the longest length. %1$@ is the file. */
"error.E5007.inputLayout.reportLength" = "%1$@, input.layouts[].report.length: un rapport fait 1...%2$@ octets, avec son octet d’ID. Correction : donnez une longueur dans cette plage.";
/* Error E5007, shown when an input layout of a record fails: an 8-way hat has a bad bit size. %1$@ is the file. */
"error.E5007.inputLayout.hatBits" = "%1$@, input.layouts[].hat: un hat à 8 directions fait de 3 à 8 bits. Correction : donnez à bitSize une valeur de 3 à 8.";
/* Error E5007, shown when an input layout of a record fails: a table hat names bad directions. %1$@ is the file. */
"error.E5007.inputLayout.hatTable" = "%1$@, input.layouts[].hat: un hat à table ne nomme des directions que pour les valeurs que ses bits peuvent contenir et n’a pas d’entrée neutre. Correction : ne listez que des valeurs que les bits peuvent contenir et omettez neutral.";
/* Error E5007, shown when an input layout of a record fails: a field has a bad bit size. %2$@ is the largest bit size. %1$@ is the file. */
"error.E5007.inputLayout.fieldBits" = "%1$@, input.layouts[]: un champ fait de 1 à %2$@ bits. Correction : donnez chaque bitSize dans cette plage.";
/* Error E5007, shown when an input layout of a record fails: a field lies outside the report. %1$@ is the file. */
"error.E5007.inputLayout.fieldOutside" = "%1$@, input.layouts[]: les champs doivent se trouver après l’octet d’ID du rapport et dans sa longueur. Correction : déplacez le champ ou allongez le rapport.";
/* Error E5007, shown when an input layout of a record fails: a BigEndian field is misplaced or has a bad size. %1$@ is the file. */
"error.E5007.inputLayout.bigEndian" = "%1$@, input.layouts[]: un champ BigEndian commence sur une limite d’octet et fait 16, 24 ou 32 bits. Correction : commencez à un multiple de 8 avec un bitSize de 16, 24 ou 32, ou utilisez LittleEndian.";
/* Error E5007, shown when an input layout of a record fails: a button names a control that is not a button. %1$@ is the file. */
"error.E5007.inputLayout.buttonControl" = "%1$@, input.layouts[].buttons: un bouton nomme un contrôle numérique, pas la croix directionnelle ni un axe de stick. Correction : nommez un contrôle de bouton ou déplacez l’entrée vers axes ou hat.";
/* Error E5007, shown when an input layout of a record fails: axes repeat a control or name a control that is not a stick axis. %1$@ is the file. */
"error.E5007.inputLayout.axesDistinct" = "%1$@, input.layouts[].axes: axes doit nommer des axes de stick distincts. Correction : nommez chaque axe de stick une seule fois.";
/* Error E5007, shown when an input layout of a record fails: an axis has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.axisRange" = "%1$@, input.layouts[].axes: un axe a min sous max, dans la plage de sa taille. Correction : donnez min sous max, tous deux dans la plage de bitSize.";
/* Error E5007, shown when an input layout of a record fails: a trigger value has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.triggerRange" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: une valeur de gâchette a min sous max, dans la plage de sa taille. Correction : donnez min sous max, tous deux dans la plage de bitSize.";
/* Error E5007, shown when an input layout of a record fails: a symmetric axis is not signed around zero. %1$@ is the file. */
"error.E5007.inputLayout.axisSymmetric" = "%1$@, input.layouts[].axes: un axe symétrique est signé, avec min sous 0 et max au-dessus de 0. Correction : mettez signed à true avec min sous 0 et max au-dessus de 0, ou désactivez symmetric.";
/* Error E5007, shown when an input layout of a record fails: a trigger has neither an analog value nor a button. %1$@ is the file. */
"error.E5007.inputLayout.triggerSources" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: une gâchette nomme une valeur analogique, un bouton, ou les deux. Correction : donnez à la gâchette une valeur analogique ou un bouton.";
/* Error E5007, shown when an input layout of a record fails: a layout decodes no control. %1$@ is the file. */
"error.E5007.inputLayout.noControls" = "%1$@, input.layouts[]: une disposition doit décoder au moins un contrôle. Correction : ajoutez un bouton, un axe, un hat ou une gâchette.";
/* Error E5007, shown when the HID usage map of a record fails: a usage map lists no usage. %1$@ is the file. */
"error.E5007.usageMap.mapEmpty" = "%1$@, input.hidUsageMap.usages: une table d’usages doit lister au moins un usage. Correction : ajoutez un usage ou supprimez hidUsageMap.";
/* Error E5007, shown when the HID usage map of a record fails: two entries of one usage name the same half. %2$@ is the usage as page/usage, %3$@ the half. %1$@ is the file. */
"error.E5007.usageMap.halfTwice" = "%1$@, input.hidUsageMap.usages[].half: l’usage %2$@ nomme deux fois la moitié %3$@. Correction : donnez une seule entrée à chaque moitié d’un usage.";
/* Error E5007, shown when the HID usage map of a record fails: a usage is named twice. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.usageTwice" = "%1$@, input.hidUsageMap.usages[]: l’usage %2$@ est nommé deux fois, et seules les entrées de ses deux moitiés peuvent partager un usage. Correction : nommez chaque usage une fois ou donnez aux entrées les moitiés Positive et Negative.";
/* Error E5007, shown when the HID usage map of a record fails: a Button entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonControl" = "%1$@, input.hidUsageMap.usages[].control: l’usage %2$@ est un bouton, et %3$@ n’est pas un contrôle de bouton. Correction : nommez un contrôle de bouton ou utilisez un autre type d’entrée.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis entry names a control that is not a stick axis or trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisControl" = "%1$@, input.hidUsageMap.usages[].control: l’usage %2$@ est un axe, et %3$@ n’est ni un axe de stick ni une gâchette. Correction : nommez un axe de stick ou une gâchette, ou utilisez un autre type d’entrée.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis range has min at or above max. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.rangeOrder" = "%1$@, input.hidUsageMap.usages[].range: la plage de l’usage %2$@ doit avoir min sous max. Correction : donnez min sous max.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis deadZone is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.deadZone" = "%1$@, input.hidUsageMap.usages[].deadZone: la deadZone de l’usage %2$@ doit être au-dessus de 0 et sous 1. Correction : donnez deadZone au-dessus de 0 et sous 1.";
/* Error E5007, shown when the HID usage map of a record fails: a Hat range is not 0...7 or 1...8. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.hatRange" = "%1$@, input.hidUsageMap.usages[].range: la plage de hat de l’usage %2$@ doit être 0...7 ou 1...8. Correction : donnez range 0...7 ou 1...8, ou omettez-le.";
/* Error E5007, shown when the HID usage map of a record fails: a HalfAxis entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.halfAxisControl" = "%1$@, input.hidUsageMap.usages[].control: l’usage %2$@ est un demi-axe, et %3$@ n’est pas une gâchette. Correction : nommez LeftTrigger ou RightTrigger.";
/* Error E5007, shown when the HID usage map of a record fails: a ButtonTrigger entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonTriggerControl" = "%1$@, input.hidUsageMap.usages[].control: l’usage %2$@ est une gâchette à bouton, et %3$@ n’est pas une gâchette. Correction : nommez LeftTrigger ou RightTrigger, ou utilisez un autre type d’entrée.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad entry names a control that is not a D-pad direction. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisDpadControl" = "%1$@, input.hidUsageMap.usages[].control: l’usage %2$@ est une croix à axe, et %3$@ n’est pas une direction de la croix. Correction : nommez DpadUp, DpadDown, DpadLeft ou DpadRight.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisButton entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisButtonControl" = "%1$@, input.hidUsageMap.usages[].control: l’usage %2$@ est un bouton à axe, et %3$@ n’est pas un contrôle de bouton. Correction : nommez un contrôle de bouton ou utilisez un autre type d’entrée pour l’axe.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad or AxisButton threshold is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.threshold" = "%1$@, input.hidUsageMap.usages[].threshold: le threshold de l’usage %2$@ doit être au-dessus de 0 et sous 1. Correction : donnez threshold au-dessus de 0 et sous 1.";
/* Error E5007, shown when a startup write of a record fails: a startup write names an input report. %1$@ is the file. */
"error.E5007.startupWrite.reportKind" = "%1$@, session.startup[].report: une écriture de démarrage ne peut pas envoyer de rapport d’entrée. Correction : donnez à report un rapport de sortie ou de fonctionnalité.";
/* Error E5007, shown when a startup write of a record fails: a startup report is not 2...128 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.reportLength" = "%1$@, session.startup[].report: un rapport de démarrage doit faire 2...128 octets. Correction : donnez au rapport une longueur de 2...128 octets.";
/* Error E5007, shown when a startup write of a record fails: a startup write lists the wrong number of bytes. %2$@ is the number of bytes the report takes after its ID. %1$@ is the file. */
"error.E5007.startupWrite.bytesCount" = "%1$@, session.startup[].bytes: une écriture de démarrage doit lister %2$@ octets, tous ceux après l’ID du rapport. Correction : donnez exactement %2$@ octets à bytes.";
/* Error E5007, shown when a startup write of a record fails: a startup delay is outside 0...1000 ms. %1$@ is the file. */
"error.E5007.startupWrite.delay" = "%1$@, session.startup[].delayMilliseconds: un délai de démarrage doit être de 0...1000 ms. Correction : donnez à delayMilliseconds une valeur de 0...1000, ou omettez-le.";
/* Error E5007, shown when a startup write of a record fails: a startup transport is not USB, BluetoothClassic or BluetoothLE. %1$@ is the file. */
"error.E5007.startupWrite.transport" = "%1$@, session.startup[].transport: un transport de démarrage doit être USB, BluetoothClassic ou BluetoothLE. Correction : donnez à transport l’une de ces valeurs, ou omettez-le.";
/* Error E5007, shown when a startup write of a record fails: a startup report with crc32Seed has no room for its 4-byte trailer. %1$@ is the file. */
"error.E5007.startupWrite.crcRoom" = "%1$@, session.startup[].crc32Seed: un rapport de démarrage avec crc32Seed doit avoir de la place pour sa fin de 4 octets. Correction : allongez le rapport au-delà de 4 octets, ou retirez crc32Seed.";
/* Error E5007, shown when a startup write of a record fails: a USB startup packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.usbLength" = "%1$@, session.startup[].bytes: un paquet de démarrage USB doit faire 1...64 octets. Correction : donnez à bytes une longueur de 1...64.";
/* Error E5007, shown when a startup write of a record fails: a USB startup endpoint is outside 1...127. %1$@ is the file. */
"error.E5007.startupWrite.usbEndpoint" = "%1$@, session.startup[].endpoint: un point de terminaison de démarrage USB doit être 1...127. Correction : donnez à endpoint une valeur de 1...127, ou omettez-le.";
/* Error E5007, shown when a startup write of a record fails: a USB startup timeout is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.startupWrite.usbTimeout" = "%1$@, session.startup[].timeoutMilliseconds: un délai d’attente de démarrage USB doit être de 1...60000 ms. Correction : donnez à timeoutMilliseconds une valeur de 1...60000, ou omettez-le.";
/* Error E5007, shown when a startup write of a record fails: a USB startup session byte does not index the packet. %1$@ is the file. */
"error.E5007.startupWrite.sessionByte" = "%1$@, session.startup[].sessionByte: un octet de session de démarrage USB doit indexer un octet du paquet. Correction : donnez à sessionByte une position dans bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names an input report. %1$@ is the file. */
"error.E5007.rumble.reportKind" = "%1$@, session.rumble.report.kind: un modèle de vibration ne peut pas écrire de rapport d’entrée. Correction : donnez à report un rapport de sortie ou de fonctionnalité.";
/* Error E5007, shown when the rumble template of a record fails: a rumble HID report is not 2...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.reportLength" = "%1$@, session.rumble.report.length: un rapport HID de vibration doit faire 2...64 octets. Correction : donnez au rapport une longueur de 2...64 octets.";
/* Error E5007, shown when the rumble template of a record fails: a rumble USB packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.packetLength" = "%1$@, session.rumble.report.length: un paquet USB de vibration doit faire 1...64 octets. Correction : donnez au paquet une longueur de 1...64 octets.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a rumble template do not cover the whole report. %1$@ is the file. */
"error.E5007.rumble.bytesCover" = "%1$@, session.rumble.bytes: les octets d’un modèle de vibration doivent couvrir tout le rapport. Correction : listez chaque octet du rapport, ID du rapport compris.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a numbered rumble report do not start with its report ID. %1$@ is the file. */
"error.E5007.rumble.bytesReportId" = "%1$@, session.rumble.bytes: les octets d’un rapport de vibration numéroté doivent commencer par son ID de rapport. Correction : commencez bytes par l’ID du rapport.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names no motor it can drive. %1$@ is the file. */
"error.E5007.rumble.motors" = "%1$@, session.rumble: un modèle de vibration doit nommer au moins un moteur qu’il peut piloter. Correction : ajoutez lowFrequency, highFrequency, leftTrigger ou rightTrigger.";
/* Error E5007, shown when the rumble template of a record fails: the motor and counter bytes of a rumble template overlap or fall outside the report. %1$@ is the file. */
"error.E5007.rumble.fields" = "%1$@, session.rumble: les octets de moteur et de compteur d’un modèle de vibration doivent être distincts et suivre l’ID du rapport dans le rapport. Correction : donnez à chaque moteur et au compteur son propre octet après l’ID du rapport.";
/* Error E5007, shown when the rumble template of a record fails: a rumble resend interval is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.rumble.resendInterval" = "%1$@, session.rumble.resendIntervalMilliseconds: un intervalle de renvoi de vibration doit être de 1...60000 ms. Correction : donnez à resendIntervalMilliseconds une valeur de 1...60000, ou omettez-le.";
/* Error E5008, shown when the SDL_GameControllerDB line of a controller cannot drive it; the message names the reason. */
"error.E5008.message" = "La ligne SDL_GameControllerDB d’une manette ne peut pas la piloter. Le message nomme la raison. Écrivez une fiche de manette pour elle avec ojd record draft.";
/* Error text with the error code. %1$@ is the message and %2$@ is the code, for example E2011. The code is in parentheses. */
"ui.error.withCode" = "%1$@ (%2$@)";

