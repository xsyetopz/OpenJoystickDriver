"cli.controller.group.featureColor" = "la couleur programmable du voyant";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featurePlayer" = "les voyants d’indicateur de joueur";
