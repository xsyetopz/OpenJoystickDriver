/* One-line summary of 'ojd transport-extension deactivate' in the command list and at the top of its help. */
"platform.macos.cli.transportExtension.deactivate.abstract" = "Demande à macOS de désactiver l’extension. Les manettes retournent à macOS.";
/* Long description in the help of 'ojd transport-extension deactivate'. The ojd program and the path stay as written. */
"cli.transportExtension.deactivate.discussion" = "Lancez le ojd se trouvant dans /Applications/OpenJoystickDriver.app.";
/* Message printed after 'ojd transport-extension deactivate' when the driver extension is inactive. */
"cli.transportExtension.group.deactivated" = "L’extension est inactive.";
/* Error of 'ojd transport-extension' commands when ojd runs from a folder other than Applications. %@ is the path of this ojd. The path of the installed app stays as written. */
"cli.transportExtension.group.notInstalled" = "Ce ojd s’exécute depuis %@ et non depuis /Applications. Lancez le ojd se trouvant dans /Applications/OpenJoystickDriver.app.";
/* Error of 'ojd transport-extension' commands when the app code signature is not valid. %@ is the description of the signature problem. The build command stays as written. */
"cli.transportExtension.group.signatureInvalid" = "La signature de l’app n’est pas valide (%@). Reconstruisez-la avec « just install-fast-dev », puis réessayez.";
/* One-line summary of 'ojd transport-extension status' in the command list and at the top of its help. */
"platform.macos.cli.transportExtension.status.abstract" = "Indique si l’extension est dans l’app et enregistrée dans macOS.";
/* Row of 'ojd transport-extension status'. %@ is the state of the extension inside the app: present, missing or invalid. Keep the two spaces after the colon. */
"cli.transportExtension.status.bundle" = "Extension intégrée :  %@";
