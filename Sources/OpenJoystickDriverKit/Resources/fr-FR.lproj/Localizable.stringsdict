<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d manette connectée</string>
			<key>zero</key>
			<string>%d manette connectée</string>
			<key>two</key>
			<string>%d manettes connectées</string>
			<key>few</key>
			<string>%d manettes connectées</string>
			<key>many</key>
			<string>%d de manettes connectées</string>
			<key>other</key>
			<string>%d manettes connectées</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d attribution</string>
			<key>zero</key>
			<string>%d attribution</string>
			<key>two</key>
			<string>%d attributions</string>
			<key>few</key>
			<string>%d attributions</string>
			<key>many</key>
			<string>%d d’attributions</string>
			<key>other</key>
			<string>%d attributions</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Aucun périphérique de sortie de manette détecté</string>
			<key>one</key>
			<string>%d périphérique de sortie de manette détecté</string>
			<key>two</key>
			<string>%d périphériques de sortie de manette détectés</string>
			<key>few</key>
			<string>%d périphériques de sortie de manette détectés</string>
			<key>many</key>
			<string>%d de périphériques de sortie de manette détectés</string>
			<key>other</key>
			<string>%d périphériques de sortie de manette détectés</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>« %1$@ » correspond à %2$lld manette. Utilisez l’un de ces identifiants :</string>
			<key>many</key>
			<string>« %1$@ » correspond à %2$lld de manettes. Utilisez l’un de ces identifiants :</string>
			<key>other</key>
			<string>« %1$@ » correspond à %2$lld manettes. Utilisez l’un de ces identifiants :</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>« %1$@ » désigne %2$lld profil. Utilisez l’un de ces ID :</string>
			<key>many</key>
			<string>« %1$@ » désigne %2$lld de profils. Utilisez l’un de ces ID :</string>
			<key>other</key>
			<string>« %1$@ » désigne %2$lld profils. Utilisez l’un de ces ID :</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>--soak avec cet --interval-ms prendrait %lld échantillon ; augmentez --interval-ms.</string>
			<key>many</key>
			<string>--soak avec cet --interval-ms prendrait %lld d’échantillons ; augmentez --interval-ms.</string>
			<key>other</key>
			<string>--soak avec cet --interval-ms prendrait %lld échantillons ; augmentez --interval-ms.</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>L’échantillonnage prélèverait %lld échantillon. Augmentez l’intervalle d’échantillonnage.</string>
			<key>many</key>
			<string>L’échantillonnage prélèverait %lld d’échantillons. Augmentez l’intervalle d’échantillonnage.</string>
			<key>other</key>
			<string>L’échantillonnage prélèverait %lld échantillons. Augmentez l’intervalle d’échantillonnage.</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Cette exécution prélèverait %lld échantillon. Augmentez l’intervalle d’échantillonnage.</string>
			<key>many</key>
			<string>Cette exécution prélèverait %lld d’échantillons. Augmentez l’intervalle d’échantillonnage.</string>
			<key>other</key>
			<string>Cette exécution prélèverait %lld échantillons. Augmentez l’intervalle d’échantillonnage.</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ correspond à l’état attendu : %2$lld rapport d’entrée rejoué.</string>
			<key>many</key>
			<string>%1$@ correspond à l’état attendu : %2$lld de rapports d’entrée rejoués.</string>
			<key>other</key>
			<string>%1$@ correspond à l’état attendu : %2$lld rapports d’entrée rejoués.</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>L’état produit par l’analyseur de %1$@ diffère de %2$@ dans %3$lld champ.</string>
			<key>many</key>
			<string>L’état produit par l’analyseur de %1$@ diffère de %2$@ dans %3$lld de champs.</string>
			<key>other</key>
			<string>L’état produit par l’analyseur de %1$@ diffère de %2$@ dans %3$lld champs.</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld paquet inactif masqué (toujours inclus dans l’exportation).</string>
			<key>many</key>
			<string>%lld de paquets inactifs masqués (toujours inclus dans l’exportation).</string>
			<key>other</key>
			<string>%lld paquets inactifs masqués (toujours inclus dans l’exportation).</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The French (France) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Arrêté · %lld paquet</string>
			<key>many</key>
			<string>Arrêté · %lld de paquets</string>
			<key>other</key>
			<string>Arrêté · %lld paquets</string>
		</dict>
	</dict>
</dict>
</plist>
