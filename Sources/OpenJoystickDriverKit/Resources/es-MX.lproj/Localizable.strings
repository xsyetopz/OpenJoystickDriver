/* Help text of the --unit option of 'ojd virtual set' and 'ojd virtual reset'. A unit ID names one controller by model and USB port. */
"cli.virtual.group.unit" = "Se aplica solo a este control, según su ID de unidad, en lugar de a todo su modelo.";
/* Long description in the help of 'ojd virtual'. reset stays as written because it is a command name. */
"cli.virtual.group.discussion" = "Una elección se aplica a todos los controles del mismo modelo. “reset” devuelve un modelo a la selección automática.";
/* Paragraph in the help of 'ojd virtual' about --unit. set and reset are command names and stay as written. */
"cli.virtual.group.discussionUnit" = "Con --unit, “set” se aplica a un solo control según su ID de unidad, y “reset” devuelve ese control a la elección de su modelo.";
/* Error of 'ojd virtual set' when the service could not apply the choice. %1$@ is the controller name and %2$@ is the reason. The command in quotes stays as written. */
"cli.virtual.group.errorFailed" = "El control virtual de %1$@ no cambió (%2$@). Revísalo con “ojd virtual show”.";
/* Error of 'ojd virtual' commands when --unit is used for a controller without a unit ID. %@ is the controller name. --unit stays as written. */
"cli.virtual.group.errorNoUnit" = "%@ no tiene ID de unidad, así que una elección solo puede aplicarse a todo su modelo. Ejecuta el comando sin --unit.";
/* One-line summary of 'ojd virtual export-mapping' in the command list and at the top of its help. SDL is a game controller library and W3C names the web standard gamepad layout; both stay as written. */
"cli.virtual.exportMapping.abstract" = "Imprime la asignación SDL o la descripción W3C que deriva un perfil de control virtual.";
/* Long description in the help of 'ojd virtual export-mapping'. SDL, W3C and JSON stay as written. */
"cli.virtual.exportMapping.discussion" = "SDL imprime una línea de asignación por perfil, que es un archivo de asignaciones SDL válido. W3C imprime la descripción del diseño estándar como JSON. Ambas se derivan del descriptor de reportes del perfil.";
/* Help text of the format option of 'ojd virtual export-mapping'. sdl and w3c are values the user types and stay as written. */
"cli.virtual.exportMapping.format" = "El formato que se imprimirá: sdl o w3c.";
/* Help text of the profile argument of 'ojd virtual export-mapping'. */
"cli.virtual.exportMapping.profile" = "El perfil de control virtual que se imprimirá. Omítelo para imprimir todos los perfiles.";
/* One-line summary of 'ojd virtual feed' in the command list and at the top of its help. Standard input is the input stream of the program. */
"cli.virtual.feed.abstract" = "Publicar un control virtual controlado por stdin.";
/* Long description in the help of 'ojd virtual feed'. The JSON field names buttons, dpad and axes and the control names stay as written. */
"cli.virtual.feed.discussion" = "Lee un objeto JSON por línea: “buttons” y “dpad” enumeran los controles presionados, como South y DpadUp, y “axes” asigna valores a los nombres de los ejes, como LeftStickX. Los controles que faltan quedan en neutro. Los sticks van de -1 a 1, con Y hacia abajo; los gatillos van de 0 a 1. Los fotogramas se reproducen en orden, cada uno durante al menos 8 ms; “holdMilliseconds” mantiene un fotograma más tiempo, hasta 60000. Imprime cada cocontrol de salida que los juegos envían al control, como la vibración, como un objeto JSON por línea. Termina cuando se han reproducido todos los fotogramas después de que termine la entrada.";
/* Error of 'ojd virtual feed' when the service closed the virtual gamepad. The command in quotes stays as written. */
"cli.virtual.feed.errorClosed" = "El servicio cerró el control virtual. Compruébalo con “ojd status”.";
/* Error from `ojd virtual feed` when the service connection broke while the virtual gamepad was closing. */
"cli.virtual.feed.errorCloseInterrupted" = "Se interrumpió el cierre del control virtual. Compruébalo con “ojd status”.";
/* Error of 'ojd virtual feed' for an input line that is not a valid frame. %@ is the line number. The command in quotes stays as written. */
"cli.virtual.feed.errorFrame" = "La línea %@ no es un fotograma válido. “ojd virtual feed --help” muestra el formato.";
/* Help text of the profile argument of 'ojd virtual feed'. */
"cli.virtual.feed.profile" = "El perfil del control virtual que se va a publicar.";
/* First line of 'ojd virtual feed'. %@ is the profile name. Control-C is the key combination that stops a program in a terminal. */
"cli.virtual.feed.started" = "Publicando un control virtual %@. Escribe fotogramas en stdin; termina la entrada o presiona Control-C para detener.";
/* One-line summary of 'ojd virtual launch' in the command list and at the top of its help. SDL is a game controller library and stays as written. */
"cli.virtual.launch.abstract" = "Ejecuta un programa con la asignación SDL de los mandos virtuales conectados.";
/* Help text of the program argument of 'ojd virtual launch'. PATH is the environment variable, .app is the app bundle extension, and -- stays as written. */
"cli.virtual.launch.command" = "El programa que se ejecuta y sus argumentos. Un programa es una ruta, un nombre que PATH encuentra o una .app. Escribe -- antes del programa si sus argumentos también son opciones de ojd.";
/* Long description in the help of 'ojd virtual launch'. SDL_GAMECONTROLLERCONFIG and .app stay as written. */
"cli.virtual.launch.discussion" = "Establece SDL_GAMECONTROLLERCONFIG con la asignación del mando virtual de cada controlador conectado, para que SDL en el programa los liste. Un valor ya establecido queda primero y las asignaciones lo siguen. Una .app ejecuta su ejecutable principal. El programa conserva este terminal. Si detienes ojd, se detiene el programa, y ojd termina con el estado del programa.";
/* Error of 'ojd virtual launch' when the program does not start. %1$@ is the program the user gave and %2$@ is the reason, one of the short reasons for a missing executable, a path without a file and a name not on PATH. */
"cli.virtual.launch.errorFailed" = "%1$@ no se inició (%2$@). Comprueba que sea un archivo ejecutable o una app y que tengas permiso para ejecutarlo.";
/* Short reason inside the failure message of 'ojd virtual launch' when an app bundle holds no executable. It fills %2$@ of that message and starts in lowercase. */
"cli.virtual.launch.errorNoExecutable" = "la app no tiene ejecutable";
/* Error of 'ojd virtual launch' when no connected controller has a virtual gamepad. The command in quotes stays as written. */
"cli.virtual.launch.errorNoGamepad" = "Ningún controlador conectado tiene un mando virtual, así que no hay asignación que establecer. Conecta un controlador y revisa «ojd virtual show».";
/* Error of 'ojd virtual launch' when no program is given. The example command in quotes stays as written. */
"cli.virtual.launch.errorNoProgram" = "Indica un programa que ejecutar, como «ojd virtual launch ./game».";
/* Short reason inside the failure message of 'ojd virtual launch' when the path holds no executable file. It fills %2$@ of that message and starts in lowercase. */
"cli.virtual.launch.errorNotExecutable" = "no hay ningún archivo ejecutable en esa ruta";
/* Short reason inside the failure message of 'ojd virtual launch' when no program of the name is on PATH. It fills %2$@ of that message and starts in lowercase. PATH stays as written. */
"cli.virtual.launch.errorNotFound" = "no hay ningún programa con ese nombre en PATH";
/* Error of 'ojd virtual launch' when --json or --plain is given. Both option names stay as written. */
"cli.virtual.launch.errorOutput" = "--json y --plain no se aplican, porque el programa escribe la salida estándar.";
/* Help text of the SDL backend flag of 'ojd virtual launch'. The SDL hint names and values stay as written. */
"platform.macos.cli.virtual.launch.sdlGamecontrollerBackend" = "Establece además las sugerencias de SDL que hacen que SDL lea los controles solo a través del framework GameController de Apple: SDL_JOYSTICK_MFI=1, SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, SDL_JOYSTICK_IOKIT=0, SDL_JOYSTICK_HIDAPI=0. Se aplican solo al programa y sustituyen los valores ya establecidos.";
/* One-line summary of 'ojd virtual reset' in the command list and at the top of its help. */
"cli.virtual.reset.abstract" = "Devuelve el modelo de un control, o todos los modelos, a la selección automática de control virtual.";
