/* Notice after a record is installed. %@ is the controller model. */
"ui.library.record.installed" = "Se instaló el registro de %@.";
/* Error when a record file cannot be written. %1$@ is the file name and %2$@ is the reason. */
"ui.library.record.installFailed" = "No se puede escribir %1$@: %2$@";
/* Title of the alert that installs a record. %@ is the controller model. */
"ui.library.record.install.title" = "¿Instalar el registro de %@?";
/* Message of the alert that installs a record. %@ is the file name. OpenJoystickDriver is the product name. */
"ui.library.record.install.message" = "OpenJoystickDriver guarda el registro como %@ en tu carpeta de registros de controles.";
/* Title of the alert that replaces an installed record. %@ is the controller model. */
"ui.library.record.replace.title" = "¿Reemplazar el registro de %@?";
/* Message of the alert that replaces an installed record. %@ is the file name. */
"ui.library.record.replace.message" = "Ya hay instalado un archivo de registro llamado %@. Al reemplazarlo se sobrescribe ese archivo.";
/* Title of the alert that removes an installed record. %@ is the controller model. */
"ui.library.record.remove.title" = "¿Quitar el registro de %@?";
/* Message of the alert that removes an installed record. OpenJoystickDriver is the product name. */
"ui.library.record.remove.message" = "OpenJoystickDriver elimina el archivo de registro de tu carpeta de registros de controles. Los controles que usan el registro dejan de ser reconocidos por él.";
/* Notice after a record is removed. %@ is the controller model. */
"ui.library.record.removed" = "Se quitó el registro de %@.";
/* Error when a record file cannot be removed. %1$@ is the file name and %2$@ is the reason. */
"ui.library.record.removeFailed" = "No se puede quitar %1$@: %2$@";
/* Heading of the mods list in the Library area. A mod is a package of records, profiles and personas. */
"ui.library.mods" = "Mods";
/* Title of the empty state in the mods list of the Library area. */
"ui.library.mods.empty.title" = "Ningún mod instalado";
/* Notice after a mod check passed. %1$@ is the folder name and %2$@ is the mod name. */
"ui.library.mod.valid" = "%1$@ es un mod válido: %2$@.";
/* Error when a mod is refused. %1$@ is the folder name or mod name and %2$@ is the reason. */
"ui.library.mod.refused" = "%1$@ se rechazó: %2$@";
/* Line in the mod detail for a part of a mod that the app does not use. %@ is the reason. */
"ui.library.mod.unused" = "Sin usar: %@";
/* Notice after a mod is installed. %@ is the mod name. */
"ui.library.mod.installed" = "Se instaló el mod %@.";
/* Title of the alert that installs a mod. %@ is the mod name. */
"ui.library.mod.install.title" = "¿Instalar el mod %@?";
/* Message of the alert that installs a mod. %1$@ is the mod name, %2$@ is its version and %3$@ is its author. OpenJoystickDriver is the product name. */
"ui.library.mod.install.message" = "OpenJoystickDriver añade %1$@ %2$@ de %3$@ a tus mods instalados.";
/* Title of the alert that replaces an installed mod. %@ is the mod name. */
"ui.library.mod.replace.title" = "¿Reemplazar el mod %@?";
/* Message of the alert that replaces an installed mod. %1$@ is the mod name and %2$@ is the version that will be installed. */
"ui.library.mod.replace.message" = "%1$@ ya está instalado. Al reemplazarlo se quitan los archivos instalados y se instala la versión %2$@.";
/* Title of the alert that removes a mod. %@ is the mod name. */
"ui.library.mod.remove.title" = "¿Quitar el mod %@?";
/* Message of the alert that removes a mod. OpenJoystickDriver is the product name. Personas are the identities that a virtual gamepad can show. */
"ui.library.mod.remove.message" = "OpenJoystickDriver elimina el mod y los registros, perfiles y personas que añadió.";
/* Notice after a mod is removed. %@ is the mod name. */
"ui.library.mod.removed" = "Se quitó el mod %@.";
/* Line in the records list for a record that a mod changes. %@ is the name of the mod. */
"ui.library.record.patchedBy" = "Modificado por %@";
