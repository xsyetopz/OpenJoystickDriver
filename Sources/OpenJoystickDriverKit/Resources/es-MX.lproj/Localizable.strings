"ui.library.claim.claimed" = "Maneja este control";
/* Value of the USB extension field: the extension does not claim the controller. */
"ui.library.claim.unclaimed" = "No maneja este control";
/* Placeholder of the search field in the toolbar of the Library area. */
"ui.library.search" = "Buscar";
