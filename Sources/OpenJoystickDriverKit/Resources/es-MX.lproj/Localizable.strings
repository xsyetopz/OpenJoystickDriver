"ui.library.layer.driver" = "Predeterminado";
/* Name of the source of a record: a global file of the user. */
"ui.library.layer.global" = "Tu archivo global";
/* Message in the detail pane of the Library area before an item is selected. */
"ui.library.detail.empty" = "Elige un registro o un mod.";
