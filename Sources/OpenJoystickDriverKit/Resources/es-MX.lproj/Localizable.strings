"cli.record.test.discussion" = "Reproduce los paquetes recibidos de una captura con el analizador del registro y compara el estado del control después del último reporte de entrada con el estado esperado. La captura son las líneas JSON de “ojd controller capture --json”. El estado esperado es un objeto JSON con la forma de una línea de “ojd controller watch --json”. El comando enumera cada campo que difiere y termina con el código 1 si alguno difiere. Compara todos los campos excepto connection, que establece el servicio en ejecución. No necesita un servicio en ejecución.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "El estado esperado del control, como archivo JSON.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ no es un estado de control: %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "Ningún reporte de %1$@ contenía entrada para %2$@. Captura de nuevo mientras presionas los controles.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "La familia de %@ no tiene un analizador que funcione sin un control.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "Una captura de paquetes, como las líneas JSON de “ojd controller capture --json”.";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "El analizador de %1$@ rechazó el paquete recibido %2$lld de %3$@.";
/* Text of error E2022, printed when the controller state that a record parser produces from a capture differs from the expected state. */
"error.E2022.message" = "El estado que el analizador del registro produjo a partir de los reportes capturados difiere del estado esperado. Lee los campos que enumera el comando.";
/* Text of error E2023, printed when a controller cannot be claimed or released because its protocol family uses raw USB or the system does not serve it natively. The settings window shows it too. */
"error.E2023.message" = "Este control no se puede reclamar ni devolver: su familia de protocolo usa USB sin procesar, o el sistema no lo admite de forma nativa. El mensaje indica el motivo.";
/* Text of error E2024, printed when no endpoint client or token has the given ID. ojd access is the command that lists the IDs and stays as written. */
"error.E2024.message" = "Ningún cliente ni token del endpoint tiene este ID. Ejecuta ojd access para ver los ID y usa uno de ellos.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "No se puede conceder acceso a un cliente con este tipo de firma, porque cualquier programa local puede reclamar su firma.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Elige al menos un alcance que conceder.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "El servicio se está deteniendo. Inícialo y vuelve a intentarlo.";
/* Text of error E2028, printed when a token with the chosen name exists. */
"error.E2028.message" = "Ya existe un token con este nombre. Revócalo primero o elige otro nombre.";
/* Text of error E2029, printed when a token name has characters that are not allowed. The limit of 64 characters is fixed. */
"error.E2029.message" = "Esto no es un nombre de token. Usa de 1 a 64 letras, dígitos, puntos, guiones o guiones bajos.";
/* Text of error E2030, printed when a web origin is not valid. scheme://host[:port], http, https and the example in backticks stay as written. */
"error.E2030.message" = "Esto no es un origen web. Usa scheme://host[:port] con http o https, por ejemplo `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Este puerto en 127.0.0.1 está en uso o no se puede abrir. Elige otro con --port.";
/* Text of error E2032, printed when the control scope is granted to a token that has origins. */
"error.E2032.message" = "Un token con orígenes no puede tener el alcance control, porque una página nunca debe manejar un control virtual. Concede control a un token sin orígenes.";
/* Text of error E2033, printed when 'ojd virtual launch' cannot start the program. */
"error.E2033.message" = "No se pudo iniciar el programa. Comprueba que su ruta indique un archivo ejecutable o una app y que tengas permiso para ejecutarlo.";
/* Error E2034, shown in the app or the CLI when the service no longer accepts requests. */
"error.E2034.message" = "El servicio dejó de aceptar solicitudes. Cierra OpenJoystickDriver, ábrelo de nuevo y vuelve a intentarlo.";
/* Error E2035, shown in the app or the CLI when the file that records why the request listener stopped is unusable. */
"error.E2035.message" = "No se puede usar el archivo que registra por qué se detuvo la escucha de solicitudes. Elimina el archivo y abre OpenJoystickDriver de nuevo.";
/* Error E2036, shown by ojd and the app when no OpenJoystickDriver app took the test notification or reported on it before the deadline. */
"error.E2036.message" = "Ninguna app de OpenJoystickDriver respondió a tiempo a la notificación de prueba. Verifica que la app esté en ejecución e inténtalo de nuevo.";
/* Error E2037, shown by ojd and the app when notifications are not allowed for the app, so the test notification could not be shown. */
"error.E2037.message" = "Las notificaciones no están permitidas para OpenJoystickDriver. Permítelas en la configuración de notificaciones del sistema e inténtalo de nuevo.";
/* Note about a controller record whose raw USB family the USB extension cannot claim because Apple signs its product list. OJD is the short product name. */
"platform.macos.cli.record.group.usbNotClaimed" = "La familia usa USB sin procesar, y la extensión USB no puede reclamar este control, porque su lista de productos está firmada por Apple. OJD solo llega a él mediante acceso USB directo, cuando macOS lo permite.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "Solo USB: agrega bluetoothLE.vibrationCharacteristic a este registro de Switch 2 para conectar el control por Bluetooth LE.";
/* One-line summary of 'ojd record validate' in the command list and at the top of its help. */
"cli.record.validate.abstract" = "Comprueba un registro de control sin instalarlo.";
/* Long description in the help of 'ojd record validate'. It lists what the check covers and says that the exit status is 1 for an invalid record. The USB extension is the driver extension that gives raw USB access; the exit status 1 stays as written. */
"cli.record.validate.discussion" = "Comprueba la forma del registro, sus campos entre sí y su encaje con el catálogo incluido, e indica si el control necesita la extensión USB. Termina con 1 cuando el registro no es válido.";
/* Message printed by 'ojd record validate' for a correct record. %1$@ is the file path, %2$@ is the operation in kebab case such as install, %3$@ is the controller model and %4$@ is the protocol family. The command in quotes stays as written. */
"cli.record.validate.valid" = "%1$@ es un registro %2$@ válido para %3$@ (%4$@). Instálalo con “ojd record install”.";
/* Heading in the output of 'ojd status' above the defaults file that the driver ignores. */
"cli.status.group.labelIgnoredDefaults" = "Archivo de valores predeterminados ignorado";
/* Heading in the output of 'ojd status' above the list of skipped virtual device files. %lld is the number of entries. */
"cli.status.group.labelSkippedVirtualDevices" = "Archivos de dispositivo virtual omitidos (%lld)";
/* Reason beside a folder named Personas in 'ojd status' and 'ojd diagnose': the folder is not read, because virtual device files live in VirtualDevices. %@ is the path of the VirtualDevices folder. OpenJoystickDriver is the product name. */
"status.virtualDeviceFolderNotRead" = "OpenJoystickDriver no lee esta carpeta. Mueve sus archivos a %@ y luego elimina la carpeta.";
/* Heading in the output of 'ojd status' above the list of skipped controller records. %lld is the number of records. */
"cli.status.group.labelSkippedRecords" = "Registros de control omitidos (%lld)";
/* One-line summary of 'ojd binding' in the command list and at the top of its help. */
"cli.binding.group.abstract" = "Lista, define y borra las asignaciones de un perfil de reasignación.";
/* Error of 'ojd binding set' when the JSON of --actions-json cannot be read. %@ is the description of the parse problem. --actions-json stays as written. */
"cli.binding.group.actionsInvalid" = "--actions-json no es una lista de acciones válida: %@";
/* Error of 'ojd binding set' when the JSON of --actions-json exceeds the size limit. --actions-json stays as written. */
"cli.binding.group.actionsTooLarge" = "--actions-json es demasiado grande.";
/* Error of 'ojd binding set' when the value of --long-hold does not have the form MS:TARGET. %@ is the option name. MS:TARGET and the example stay as written. */
"cli.binding.group.alternateFormat" = "%@ acepta MS:TARGET, como 500:key:key-b.";
/* Error of 'ojd binding set' when an axis option is used with a source that is not an axis. The option names stay as written. */
"cli.binding.group.axisOptionsSource" = "--deadzone, --gain, --invert, --response-curve y --digital-threshold necesitan un origen de eje.";
/* One-line summary of 'ojd binding clear' in the command list and at the top of its help. */
"cli.binding.clear.abstract" = "Elimina las asignaciones de los orígenes indicados, o todas.";
/* Help text of the --all flag of 'ojd binding clear'. */
"cli.binding.clear.all" = "Elimina todas las asignaciones, combinaciones, secuencias y capas.";
/* Warning of 'ojd binding clear' when removing the bindings leaves an active profile without any binding, so its controller sends no input. %@ is the profile name. The two commands in quotes stay as written. */
"cli.binding.clear.blocksInput" = "“%@” está activo en un control conectado y ahora bloquea toda su entrada. Añade una asignación con “ojd binding set” o detén el perfil con “ojd profile deactivate”.";
/* Yes or no question that 'ojd binding clear --all' asks on a terminal. %@ is the profile name. */
"cli.binding.clear.confirm" = "¿Eliminar todas las asignaciones, combinaciones, secuencias y capas de “%@”?";
/* Long description in the help of 'ojd binding clear'. --all and --force stay as written. */
"cli.binding.clear.discussion" = "--all también elimina las combinaciones, secuencias y capas del perfil, y pide confirmación en un terminal; sin terminal necesita --force. Se mantiene la configuración de palancas, gatillos, táctil, movimiento y salida.";
/* Message printed after 'ojd binding clear' removed bindings. %1$@ is the profile name and %2$lld is the number of removed bindings, shown after a colon. */
"cli.binding.clear.done" = "Asignaciones eliminadas de “%1$@”: %2$lld.";
/* Message printed by 'ojd binding clear --dry-run' instead of changing the profile. %1$@ is the profile name and %2$lld is the number of bindings that would be removed, shown after a colon. */
"cli.binding.clear.dryRun" = "Asignaciones que se eliminarían de “%1$@”: %2$lld.";
/* Message of 'ojd binding clear' when a source has no binding. %1$@ is the profile name and %2$@ is the source the user gave. */
"cli.binding.clear.missing" = "“%1$@” no tiene ninguna asignación para %2$@. No se ha cambiado nada.";
/* Help text of the SOURCES argument of 'ojd binding clear'. */
"cli.binding.clear.sources" = "Los orígenes cuyas asignaciones se eliminan.";
/* Error of 'ojd binding clear' when neither sources nor --all are given. --all stays as written. */
"cli.binding.clear.usage" = "Indica uno o más orígenes, o --all.";
/* Long description in the help of 'ojd binding'. It lists the SOURCE and TARGET forms. Words in capitals, forms such as button:NAME and all option names stay as written. */
"cli.binding.group.discussion" = "Una asignación envía un TARGET cuando se usa un SOURCE del control.\n\nSOURCE: button:NAME, dpad:DIRECTION, axis:NAME[:negative|positive], trigger:NAME:STAGE, motion:lean:DIRECTION, touch:SURFACE:contact, touch:SURFACE:grid:COLUMNS:ROWS:COLUMN:ROW o touch:SURFACE:swipe:DIRECTION:DISTANCE.\n\nTARGET: key:KEY[:mods=meta,control,alt,shift], mouse:BUTTON, move:x|y, scroll:x|y, gamepad:button:NAME, gamepad:dpad:DIRECTION, gamepad:axis:NAME o physical:... para vibración, luces y gatillos adaptativos.\n\n“ojd profile show” imprime las asignaciones con estas formas. Edita combinaciones, secuencias y capas con “ojd profile edit”.";
/* One-line summary of 'ojd binding list' in the command list and at the top of its help. */
"cli.binding.list.abstract" = "Lista las asignaciones de un perfil.";
/* Message of 'ojd binding list' when the profile has no bindings. %@ is the profile name. The command in quotes stays as written. */
"cli.binding.list.empty" = "“%@” no tiene asignaciones. Añade una con “ojd binding set”.";
/* Error of 'ojd binding set' when a value of --multi-tap does not have the form COUNT:MS:TARGET. COUNT:MS:TARGET and the example stay as written. */
"cli.binding.group.multiTapFormat" = "--multi-tap acepta COUNT:MS:TARGET, como 2:300:key:key-c.";
/* Help text of the --actions-json option of 'ojd binding set'. 'ojd profile export' stays as written. */
"cli.binding.group.optionActionsJson" = "Acciones adicionales como matriz JSON, con la forma que escribe “ojd profile export”.";
/* Help text of the --behavior option of 'ojd binding set'. The behavior hold is a value the user types. */
"cli.binding.group.optionBehavior" = "Cuándo se activa el destino. Predeterminado: el comportamiento de la asignación actual, o hold.";
/* Help text of the --deadzone option of 'ojd binding set'. The dead zone is the part of an axis travel that is ignored. */
"cli.binding.group.optionDeadzone" = "Orígenes de eje: la parte del recorrido que se ignora, de 0 a 0.95. Predeterminado: 0.1.";
/* Help text of the --digital-threshold option of 'ojd binding set'. It sets the axis travel that counts as a press. */
"cli.binding.group.optionDigitalThreshold" = "Orígenes de eje: el recorrido que cuenta como pulsación para destinos de botón. Predeterminado: 0.5.";
/* Help text of the --gain option of 'ojd binding set'. Gain scales the axis output. */
"cli.binding.group.optionGain" = "Orígenes de eje: la escala de salida, de 0.1 a 10. Predeterminado: 1.";
/* Help text of the --invert flag of 'ojd binding set'. */
"cli.binding.group.optionInvert" = "Orígenes de eje: invierte la dirección.";
/* Help text of the --long-hold option of 'ojd binding set'. The example 500:key:key-b stays as written. */
"cli.binding.group.optionLongHold" = "Envía otro destino cuando el origen se mantiene pulsado este tiempo, como 500:key:key-b.";
