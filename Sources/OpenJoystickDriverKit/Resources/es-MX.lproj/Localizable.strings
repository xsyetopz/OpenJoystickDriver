"ui.library.field.identity" = "Modelo de control";
/* Label of the field in the record detail that holds the protocol family. */
"ui.library.field.family" = "Familia";
/* Label of the field in the record detail that holds where the record comes from. */
"ui.library.field.source" = "Origen";
/* Label of the field in the record detail that holds the path of the record file. */
"ui.library.field.file" = "Ruta del archivo";
/* Label of the field in the record detail that holds how the controller connects, for example USB or Bluetooth. */
"ui.library.field.transport" = "Transporte";
/* Label of the field in the mod detail that holds the version. */
"ui.library.field.version" = "Versión";
/* Label of the field in the mod detail that holds the author. */
"ui.library.field.author" = "Autor";
/* Heading of the section in the record detail that lists the fields. */
"ui.library.section.fields" = "Campos";
/* Heading of the section in the mod detail that lists the files. */
"ui.library.section.files" = "Archivos";
/* Heading of the section in the record detail that shows the result of a test. */
"ui.library.section.testResult" = "Resultado de la prueba";
