/* Status line of a service that cannot be reached because its request listener stopped. %1$@ is the error code, %2$@ its explanation, %3$@ the error number of the failed call, %4$@ the time it stopped. */
"status.listenerFailure.detail" = "%1$@: %2$@ (número de error %3$@, %4$@)";
/* Reason the listener failure file cannot be used: its size exceeds what the service writes. Fills the reason in the error E2035 message. */
"status.listenerFailure.tooLarge" = "el archivo es demasiado grande";
/* Row label in the ojd status table that gives why the stopped service's request listener stopped. */
"cli.status.group.listenerFailureLabel" = "Escucha de solicitudes";
/* Label of the button in the problem banner that starts the service's stopped request listener again. */
"status.listenerFailure.restart" = "Reiniciar la escucha";
/* Status line when restarting the request listener failed. %@ is the error number of the failed call. */
"status.listenerFailure.restartFailed" = "No se pudo reiniciar la escucha de solicitudes (número de error %@). Cierra OpenJoystickDriver y ábrelo de nuevo.";
/* Status line of a service that is not running when its last request listener stopped with an error. %@ is the error code with its explanation, the error number and the time. */
"status.listenerFailure.earlier" = "El servicio no se está ejecutando. Su última escucha de solicitudes se detuvo: %@";
/* Status line when the request listener cannot be restarted because the service is stopping or has not started. */
"status.listenerFailure.restartUnavailable" = "El servicio se está deteniendo o aún no ha iniciado, así que no se puede reiniciar la escucha de solicitudes.";
/* Status line when restarting the request listener failed for a reason that is not an error number. %@ is the reason. */
"status.listenerFailure.restartFailedReason" = "No se pudo reiniciar la escucha de solicitudes: %@. Cierra OpenJoystickDriver y ábrelo de nuevo.";
/* Reason the listener failure file cannot be used: it is not a regular file. Fills the reason in the error E2035 message. */
"status.listenerFailure.notRegularFile" = "el archivo no es un archivo normal";
/* Reason the listener failure file cannot be used: another user owns it, so ojd must run as that user. Fills the reason in the error E2035 message. */
"status.listenerFailure.otherUser" = "el registro pertenece a otro usuario; ejecuta ojd como ese usuario";
/* Reason the listener failure file cannot be used: the system would not say whether the process that wrote it runs. %1$@ is the system's reason, %2$@ the error number. Fills the reason in the error E2035 message. */
"status.listenerFailure.processCheckFailed" = "no se pudo comprobar si el proceso del servicio se está ejecutando: %1$@ (número de error %2$@)";
/* One-line summary of 'ojd setting test-notification' in the command list and at the top of its help. The notification appears in the OpenJoystickDriver app. */
"cli.setting.testNotification.abstract" = "Muestra una notificación de prueba en la app.";
/* Long description in the help of 'ojd setting test-notification'. It says what the service is asked to do and when the command fails. --timeout stays as written and %@ is the default timeout in seconds. */
"cli.setting.testNotification.discussion" = "Pide al servicio que anuncie una notificación de prueba a la app OpenJoystickDriver abierta y espera a que la app la muestre. Falla con un error con nombre si las notificaciones están negadas, falla la entrega o ninguna app responde a tiempo. Valor predeterminado de --timeout aquí, en segundos: %@.";
/* Printed by ojd setting test-notification after the app reported that it showed the test notification. */
"cli.setting.testNotification.success" = "La app mostró la notificación de prueba.";
