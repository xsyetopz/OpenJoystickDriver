<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d control conectado</string>
			<key>zero</key>
			<string>%d controles conectados</string>
			<key>two</key>
			<string>%d controles conectados</string>
			<key>few</key>
			<string>%d controles conectados</string>
			<key>many</key>
			<string>%d de controles conectados</string>
			<key>other</key>
			<string>%d controles conectados</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d asignación</string>
			<key>zero</key>
			<string>%d asignaciones</string>
			<key>two</key>
			<string>%d asignaciones</string>
			<key>few</key>
			<string>%d asignaciones</string>
			<key>many</key>
			<string>%d de asignaciones</string>
			<key>other</key>
			<string>%d asignaciones</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Ningún dispositivo de salida de control detectado</string>
			<key>one</key>
			<string>%d dispositivo de salida de control detectado</string>
			<key>two</key>
			<string>%d dispositivos de salida de control detectados</string>
			<key>few</key>
			<string>%d dispositivos de salida de control detectados</string>
			<key>many</key>
			<string>%d de dispositivos de salida de control detectados</string>
			<key>other</key>
			<string>%d dispositivos de salida de control detectados</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>“%1$@” coincide con %2$lld control. Usa uno de estos ID:</string>
			<key>many</key>
			<string>“%1$@” coincide con %2$lld de controles. Usa uno de estos ID:</string>
			<key>other</key>
			<string>“%1$@” coincide con %2$lld controles. Usa uno de estos ID:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>“%1$@” nombra %2$lld perfil. Usa uno de estos ID:</string>
			<key>many</key>
			<string>“%1$@” nombra %2$lld de perfiles. Usa uno de estos ID:</string>
			<key>other</key>
			<string>“%1$@” nombra %2$lld perfiles. Usa uno de estos ID:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>--soak con este --interval-ms tomaría %lld muestra; aumenta --interval-ms.</string>
			<key>many</key>
			<string>--soak con este --interval-ms tomaría %lld de muestras; aumenta --interval-ms.</string>
			<key>other</key>
			<string>--soak con este --interval-ms tomaría %lld muestras; aumenta --interval-ms.</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>El muestreo tomaría %lld muestra. Aumente el intervalo de muestreo.</string>
			<key>many</key>
			<string>El muestreo tomaría %lld de muestras. Aumente el intervalo de muestreo.</string>
			<key>other</key>
			<string>El muestreo tomaría %lld muestras. Aumente el intervalo de muestreo.</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Esta ejecución tomaría %lld muestra. Aumente el intervalo de muestreo.</string>
			<key>many</key>
			<string>Esta ejecución tomaría %lld de muestras. Aumente el intervalo de muestreo.</string>
			<key>other</key>
			<string>Esta ejecución tomaría %lld muestras. Aumente el intervalo de muestreo.</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ coincide con el estado esperado: %2$lld reporte de entrada reproducido.</string>
			<key>many</key>
			<string>%1$@ coincide con el estado esperado: %2$lld de reportes de entrada reproducidos.</string>
			<key>other</key>
			<string>%1$@ coincide con el estado esperado: %2$lld reportes de entrada reproducidos.</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>El estado que produjo el analizador de %1$@ difiere de %2$@ en %3$lld campo.</string>
			<key>many</key>
			<string>El estado que produjo el analizador de %1$@ difiere de %2$@ en %3$lld de campos.</string>
			<key>other</key>
			<string>El estado que produjo el analizador de %1$@ difiere de %2$@ en %3$lld campos.</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld paquete inactivo oculto (se sigue incluyendo en la exportación).</string>
			<key>many</key>
			<string>%lld de paquetes inactivos ocultos (se siguen incluyendo en la exportación).</string>
			<key>other</key>
			<string>%lld paquetes inactivos ocultos (se siguen incluyendo en la exportación).</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Detenido · %lld paquete</string>
			<key>many</key>
			<string>Detenido · %lld de paquetes</string>
			<key>other</key>
			<string>Detenido · %lld paquetes</string>
		</dict>
	</dict>
	<!-- Choice of the idle disconnect picker in the General pane of the settings window. %d is a number of minutes, such as 15. -->
	<key>ui.settings.general.idleDisconnectMinutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d minutos</string>
			<key>one</key>
			<string>%d minuto</string>
			<key>two</key>
			<string>%d minutos</string>
			<key>few</key>
			<string>%d minutos</string>
			<key>many</key>
			<string>%d minutos</string>
			<key>other</key>
			<string>%d minutos</string>
		</dict>
	</dict>
	<!-- Row of the Simple interface in the controller detail and the profile editor: how many advanced settings that Simple hides hold a value other than their default. %d is the number of changed advanced settings. The Spanish (Mexico) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.interface.hiddenChanges</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d ajustes avanzados modificados</string>
			<key>one</key>
			<string>%d ajuste avanzado modificado</string>
			<key>two</key>
			<string>%d ajustes avanzados modificados</string>
			<key>few</key>
			<string>%d ajustes avanzados modificados</string>
			<key>many</key>
			<string>%d ajustes avanzados modificados</string>
			<key>other</key>
			<string>%d ajustes avanzados modificados</string>
		</dict>
	</dict>
</dict>
</plist>
