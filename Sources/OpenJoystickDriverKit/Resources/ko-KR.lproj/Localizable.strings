"cli.controller.watch.examples" = "예시:\n  # 10초 동안 입력 출력\n  ojd controller watch 045E:028E --duration 10\n  # 처음 누른 컨트롤을 JSON으로 출력\n  ojd controller watch 045E:028E --first-press --json\n  # 모든 컨트롤러와 해당 가상 게임패드가 보내는 내용을 관찰\n  ojd controller watch --all --output";
