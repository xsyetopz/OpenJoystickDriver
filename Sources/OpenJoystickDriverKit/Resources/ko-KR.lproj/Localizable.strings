"cli.controller.rumble.examples" = "예시:\n  # 주 모터 두 개를 세기 180으로 0.45초 동안 작동\n  ojd controller rumble 045E:028E\n  # 주 모터 두 개를 최대 세기로 2초 동안 작동\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
