"cli.profile.create.examples" = "예시:\n  # 컨트롤러 모델용 프로필 만들기\n  ojd profile create Racing --controller 045E:028E\n  # Safari가 맨 앞에 있을 때만 적용\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
