"cli.access.grant.abstract" = "Salli allekirjoitetun ohjelman tai uuden tokenin käyttää päätepistettä.";
"cli.access.grant.ad_hoc" = "%@ on allekirjoitettu ad hoc -tavalla tai allekirjoittamaton, joten mikä tahansa paikallinen ohjelma voi väittää sen allekirjoituksen omakseen. Allekirjoita se Developer ID- tai Apple Development -varmenteella ja myönnä sitten oikeus.";
"cli.access.grant.apple_warning" = "Apple on allekirjoittanut tämän ohjelman. Jos se suorittaa komentosarjoja, kuten python3 tai osascript, jokainen sen suorittama komentosarja saa tämän käyttöoikeuden.";
"cli.access.grant.client_or_token" = "Anna joko CLIENT tai --token NAME.";
"cli.access.grant.confirm" = "Sallitaanko ohjelman %@, allekirjoitettu %@, käyttää päätepistettä laajuudella %@?";
"cli.access.grant.control_warning" = "Laajuus control antaa ohjelman painaa virtuaalisen pelaimen painikkeita, joita pelit ja sovellukset pitävät sinun syötteenäsi.";
"cli.access.grant.discussion" = "CLIENT on ohjelman polku tai tunnus komennosta ”ojd access list”. Oikeus viittaa ohjelman allekirjoitukseen, joten se pysyy voimassa, kun ohjelma päivitetään tai siirretään. Ad hoc -allekirjoitetuille ja allekirjoittamattomille ohjelmille ei voi myöntää oikeutta. Kun CLIENTin sijaan käytetään asetusta --token, luodaan token, jolla asiakas allekirjoittaa palvelun haasteen hello-viestissään pistokkeen kautta, WebSocketin kautta sivulta, joka on jollakin --origin-arvoista, tai ilman --origin-arvoa olevan tokenin tapauksessa WebSocketin kautta ohjelmasta, joka ei lähetä Origin-otsaketta, kuten hiekkalaatikkosovelluksesta. Sivu ei voi käyttää laajuutta control. Token näytetään vain kerran. Pyytää ensin vahvistusta.";
"cli.access.grant.origin" = "Web-alkuperä, kuten http://127.0.0.1:8080, jonka sivut saavat käyttää tokenia WebSocketissa. Toista useammalle. WebSocketin tarjoamien peittosivujen alkuperä on http://127.0.0.1:PORT, ja portti on se, jonka ”ojd access status” näyttää.";
"cli.access.grant.origin_needs_token" = "Asetus --origin vaatii asetuksen --token.";
"cli.access.grant.scope" = "Myönnettävä laajuus: read tai control. Toista molemmille.";
"cli.access.grant.success" = "%@ myönnetty kohteelle %@ (tunnus %@).";
