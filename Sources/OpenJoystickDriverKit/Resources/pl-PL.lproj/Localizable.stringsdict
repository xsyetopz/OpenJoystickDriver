<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d kontroler podłączony</string>
			<key>zero</key>
			<string>%d kontrolerów podłączonych</string>
			<key>two</key>
			<string>%d kontrolery podłączone</string>
			<key>few</key>
			<string>%d kontrolery podłączone</string>
			<key>many</key>
			<string>%d kontrolerów podłączonych</string>
			<key>other</key>
			<string>%d kontrolera podłączonego</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d aktywny profil</string>
			<key>zero</key>
			<string>%d aktywnych profili</string>
			<key>two</key>
			<string>%d aktywne profile</string>
			<key>few</key>
			<string>%d aktywne profile</string>
			<key>many</key>
			<string>%d aktywnych profili</string>
			<key>other</key>
			<string>%d aktywnego profilu</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d przypisanie</string>
			<key>zero</key>
			<string>%d przypisań</string>
			<key>two</key>
			<string>%d przypisania</string>
			<key>few</key>
			<string>%d przypisania</string>
			<key>many</key>
			<string>%d przypisań</string>
			<key>other</key>
			<string>%d przypisania</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Nic nie wykryto</string>
			<key>one</key>
			<string>Wykryto %d</string>
			<key>two</key>
			<string>Wykryto %d</string>
			<key>few</key>
			<string>Wykryto %d</string>
			<key>many</key>
			<string>Wykryto %d</string>
			<key>other</key>
			<string>Wykryto %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Nie wykryto urządzeń wyjściowych kontrolera</string>
			<key>one</key>
			<string>Wykryto %d urządzenie wyjściowe kontrolera</string>
			<key>two</key>
			<string>Wykryto %d urządzenia wyjściowe kontrolera</string>
			<key>few</key>
			<string>Wykryto %d urządzenia wyjściowe kontrolera</string>
			<key>many</key>
			<string>Wykryto %d urządzeń wyjściowych kontrolera</string>
			<key>other</key>
			<string>Wykryto %d urządzenia wyjściowego kontrolera</string>
		</dict>
	</dict>
</dict>
</plist>
