"error.E3031.message" = "Hành động không chạy vì quyền truy cập Tự động hóa chưa được cấp. Hãy cấp quyền này cho OpenJoystickDriver rồi thử lại.";
/* Text of error E3032, returned when an action needs to send keys while Secure Input blocks them. */
"error.E3032.message" = "Hành động không chạy vì Secure Input đang bật. Hãy đóng ứng dụng đã bật nó, chẳng hạn ô mật khẩu, rồi thử lại.";
/* Text of error E3033, returned when a system action fails. The action name and the reason follow it. */
"error.E3033.message" = "Hành động đã thất bại.";
/* Text of error E3034, returned when the system refuses to create the MIDI source of a MIDI action. */
"error.E3034.message" = "Hành động MIDI không chạy vì hệ thống từ chối tạo nguồn MIDI OpenJoystickDriver. Hãy thử lại.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.plist stays as written. */
"error.E4001.message" = "Tệp kê khai gói mod.plist bị thiếu hoặc không hợp lệ. Hãy kiểm tra nó theo lược đồ mod-package rồi chạy lại lệnh.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "Gói yêu cầu phiên bản OpenJoystickDriver khác với phiên bản đang chạy. Hãy cài phiên bản gói hỗ trợ phiên bản này hoặc cập nhật OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.plist stays as written. */
"error.E4003.message" = "Một tệp của gói không hợp lệ, bị thiếu hoặc không được liệt kê trong mod.plist. Hãy sửa tệp mà lệnh nêu rồi chạy lại.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "Gói bao gồm một bộ điều khiển, persona hoặc cấu hình mà tệp của chính bạn hoặc một gói đã cài khác đã có. Hãy xóa tệp hoặc gói xung đột, hoặc sửa gói, rồi chạy lại lệnh.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Đã cài một gói có tên này. Hãy chạy lệnh với --force để thay thế.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Không có gói đã cài nào có tên này. Hãy chạy ojd mod list để xem các gói đã cài.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "Không thể thay đổi thư mục gói. Hãy kiểm tra dung lượng đĩa trống và quyền của thư mục.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Tài liệu không có apiVersion, hoặc apiVersion của tài liệu không được phiên bản OpenJoystickDriver này hỗ trợ. Hãy đổi tài liệu sang apiVersion được hỗ trợ mà thông báo nêu, rồi chạy lại lệnh.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Mô tả giao thức không hợp lệ. Kiểm tra tệp với lược đồ protocol-description và sửa trường mà thông báo nêu.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Mô tả giao thức nêu một họ khác với tên tệp. Đặt tên tệp theo họ của nó.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Mô tả giao thức liệt kê một biến thể mà họ của nó không có. Hãy dùng một trong các biến thể của họ.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.plist is a file name and stays as written. */
"error.E5005.message" = "Tệp truy cập AccessGrants.plist bị hỏng. Hãy sửa hoặc xóa tệp, rồi cấp quyền truy cập lại.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Không thể đọc tệp khóa của ID thiết bị, PortKeyInstallation.key, hoặc tệp không có kích thước 32 byte. Hãy khôi phục tệp từ bản sao lưu. Nếu bạn xóa tệp, OpenJoystickDriver sẽ tạo khóa mới và mọi ID thiết bị đều thay đổi.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Bản ghi bộ điều khiển hoặc patch không hợp lệ. Kiểm tra tệp với lược đồ của nó và sửa trường mà thông báo nêu.";
/* Error E5007, in place of a file path when the message does not know which file failed. */
"error.E5007.thisFile" = "tệp bản ghi này";
/* Error E5007, shown when the bundled controller catalog holds no record file. */
"error.E5007.record.catalogEmpty" = "Thư mục Controllers của danh mục đi kèm: danh mục không có tệp bản ghi nào. Quy tắc: danh mục có ít nhất một bản ghi tay cầm. Cách sửa: cài đặt lại OpenJoystickDriver.";
/* Error E5007, shown when a record file is not named after its own vendorID and productID. %1$@ is the file, %2$@ the name it must have. */
"error.E5007.record.fileName" = "%1$@, vendorID và productID: tên tệp phải là %2$@, tức hai ID ở dạng thập lục phân. Cách sửa: đổi tên tệp thành %2$@ hoặc sửa các ID trong tệp.";
/* Error E5007, shown when two record files give one controller model. %1$@ is the file, %2$@ the model, %3$@ the file that holds it first. */
"error.E5007.record.duplicateIdentity" = "%1$@, vendorID và productID: %2$@ đã là danh tính của bản ghi trong %3$@. Cách sửa: xóa một trong hai tệp hoặc đổi ID của tệp này.";
/* Error E5007, shown when a value of a record cannot be written as JSON. %1$@ is the file, %2$@ the reason. */
"error.E5007.record.unwritableValue" = "%1$@, document: không thể ghi một giá trị thành JSON (%2$@). Cách sửa: thay giá trị mà lý do nêu bằng chuỗi, số, boolean, danh sách hoặc từ điển.";
/* Error E5007, shown when the vendorID or productID of a record is out of range. %1$@ is the file. */
"error.E5007.record.idRange" = "%1$@, vendorID và productID: vendorID phải là 1...65535 và productID là 0...65535. Cách sửa: đặt mỗi giá trị thành một số nguyên trong khoảng của nó.";
/* Error E5007, shown when a patch file fails: the file is not a dictionary. %1$@ is the file. */
"error.E5007.patch.patchNotObject" = "%1$@, document: tệp không phải đối tượng JSON. Cách sửa: biến tệp thành từ điển có apiVersion, kind, selector và patch hoặc remove.";
/* Error E5007, shown when a patch file fails: the file lacks apiVersion, kind, selector, or patch and remove. %1$@ is the file. */
"error.E5007.patch.patchFields" = "%1$@, document: tệp phải có apiVersion, kind, selector và patch hoặc remove. Cách sửa: thêm thành phần còn thiếu.";
/* Error E5007, shown when a record or protocol description breaks a rule: HID startup writes are in a raw-USB mode or family. %1$@ is the file. */
"error.E5007.session.hidStartup" = "%1$@, session.startup: lệnh ghi khởi động HID chỉ áp dụng cho tay cầm HID, nên không áp dụng cho chế độ hay họ raw-USB. Cách sửa: bỏ các lệnh ghi khởi động HID, hoặc dùng gói raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode names a session keepAlive for a family that declares its own. %2$@ is the family. %1$@ is the file. */
"error.E5007.session.keepAliveFamily" = "%1$@, session.keepAlive: keepAlive của phiên cần một họ raw-USB mà mô tả không khai báo keepAlive, còn %2$@ lại khai báo một cái. Cách sửa: bỏ keepAlive của phiên, vì %2$@ đã chạy keepAlive riêng.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names a session key that only raw-USB modes take. %2$@ is the key. %1$@ is the file. */
"error.E5007.session.rawUSBOnly" = "%1$@, session.%2$@: session %2$@ chỉ áp dụng cho chế độ raw-USB. Cách sửa: bỏ %2$@ khỏi phiên, hoặc dùng giao thức raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: raw-USB startup writes are in a mode whose family does not read them or that lists initialization. %1$@ is the file. */
"error.E5007.session.usbStartup" = "%1$@, session.startup: lệnh ghi khởi động raw-USB cần một họ đọc chúng và một chế độ không có danh sách khởi tạo. Cách sửa: bỏ các lệnh ghi khởi động raw-USB, hoặc dùng họ đọc chúng và bỏ danh sách khởi tạo.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is not the kind of packet its protocol uses. %1$@ is the file. */
"error.E5007.rumble.templateKind" = "%1$@, session.rumble: mẫu rung là gói usb với giao thức raw-USB và báo cáo HID với giao thức HID. Cách sửa: viết mẫu theo loại gói mà giao thức dùng.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is in a family whose driver does not encode it. %1$@ is the file. */
"error.E5007.rumble.templateDriver" = "%1$@, session.rumble: mẫu rung cần một trình điều khiển mã hóa chúng. Cách sửa: bỏ mẫu rung, hoặc dùng họ có trình điều khiển mã hóa nó.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is beside a session keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: resendIntervalMilliseconds của rung không thể kết hợp với keepAlive của phiên. Cách sửa: bỏ resendIntervalMilliseconds, hoặc bỏ keepAlive của phiên.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is in a family that declares its own keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithFamilyKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: resendIntervalMilliseconds của rung cần một họ có mô tả không khai báo keepAlive. Cách sửa: bỏ resendIntervalMilliseconds, vì keep-alive của họ quyết định thời gian.";
/* Error E5007, shown when a record or protocol description breaks a rule: a record has no mode. %1$@ is the file. */
"error.E5007.modes.empty" = "%1$@, modes: modes phải có ít nhất một chế độ. Cách sửa: thêm một chế độ.";
/* Error E5007, shown when a record or protocol description breaks a rule: more than one mode has the id default. %1$@ is the file. */
