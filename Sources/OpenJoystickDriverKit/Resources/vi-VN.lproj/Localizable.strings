"error.E5007.protocolDescription.sessionKeyUnlisted" = "%1$@, defaults.session: giá trị mặc định đặt khóa phiên %2$@ mà sessionKeys không liệt kê. Cách sửa: thêm %2$@ vào sessionKeys, hoặc bỏ khỏi giá trị mặc định.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family that is always raw USB has a HID keep-alive write. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveHID" = "%1$@, defaults.session.keepAlive.writes: lệnh ghi keep-alive HID chỉ áp dụng cho tay cầm HID. Cách sửa: bỏ lệnh ghi HID, hoặc dùng lệnh ghi raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family without a raw-USB variant has a raw-USB keep-alive write. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveUSB" = "%1$@, defaults.session.keepAlive.writes: lệnh ghi keep-alive raw-USB chỉ áp dụng cho họ có biến thể raw-USB. Cách sửa: bỏ lệnh ghi raw-USB, hoặc dùng lệnh ghi HID.";
/* Error E5007, shown when a record or protocol description breaks a rule: a keep-alive write names a resendTuning that the family does not read or default. %2$@ is the key. %1$@ is the file. */
"error.E5007.protocolDescription.keepAliveResendTuning" = "%1$@, defaults.session.keepAlive.writes[].resendTuning: resendTuning của lệnh ghi keep-alive nêu %2$@, khóa mà họ phải đọc và có mặc định. Cách sửa: nêu một khóa tuning mà họ đọc và có mặc định, hoặc bỏ resendTuning.";
/* Error E5007, shown when a record or protocol description breaks a rule: activation or deactivation names a transport that writeTransports does not list. %1$@ is the file. */
"error.E5007.protocolDescription.activationTransport" = "%1$@, activation: activation và deactivation chỉ nêu truyền tải mà writeTransports liệt kê. Cách sửa: nêu một truyền tải trong writeTransports, hoặc thêm nó vào đó.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults leave out session fields that the family reads. %2$@ is the family and %3$@ are the fields. %1$@ is the file. */
"error.E5007.protocolDescription.sessionMissing" = "%1$@, defaults.session: %2$@ phải đặt các trường phiên %3$@. Cách sửa: đặt %3$@ trong giá trị mặc định.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults set session fields that the family does not read. %2$@ is the family and %3$@ are the fields. %1$@ is the file. */
"error.E5007.protocolDescription.sessionUnread" = "%1$@, defaults.session: %2$@ không đọc các trường phiên %3$@. Cách sửa: bỏ %3$@ khỏi giá trị mặc định.";
/* Error E5007, shown when a record or protocol description breaks a rule: a named packet id does not start with its family. %2$@ is the family. %1$@ is the file. */
"error.E5007.protocolDescription.namedPacketPrefix" = "%1$@, namedPackets: id của mỗi gói có tên bắt đầu bằng %2$@/. Cách sửa: đổi tên các gói để mỗi id bắt đầu bằng %2$@/.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family that is always raw USB lists tuningKeys. %1$@ is the file. */
"error.E5007.protocolDescription.tuningRawUSB" = "%1$@, tuningKeys: họ luôn dùng raw USB đọc tinh chỉnh qua rawUSBTuningKeys. Cách sửa: chuyển các khóa từ tuningKeys sang rawUSBTuningKeys.";
/* Error E5007, shown when a record or protocol description breaks a rule: a family without a raw-USB variant lists rawUSBTuningKeys. %1$@ is the file. */
"error.E5007.protocolDescription.rawUSBTuningKeys" = "%1$@, rawUSBTuningKeys: rawUSBTuningKeys chỉ áp dụng cho họ có biến thể raw-USB. Cách sửa: bỏ rawUSBTuningKeys, hoặc thêm biến thể raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: bytes are not uppercase hex pairs. %2$@ is the field and %3$@ is what the bytes belong to. %1$@ is the file. */
"error.E5007.record.hexBytes" = "%1$@, %2$@: các byte của %3$@ phải là cặp hex viết hoa, cách nhau một dấu cách. Cách sửa: viết %2$@ thành các cặp như 42 03 00, chữ hoa và một dấu cách giữa các cặp.";
