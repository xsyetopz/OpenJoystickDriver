"error.E2030.message" = "Đây không phải nguồn gốc web. Dùng scheme://host[:port] với http hoặc https, chẳng hạn `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Cổng này trên 127.0.0.1 đang được dùng hoặc không thể mở. Hãy chọn cổng khác bằng --port.";
