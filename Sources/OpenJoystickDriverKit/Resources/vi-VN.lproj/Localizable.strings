"cli.access.grant.controlWarning" = "Phạm vi control cho phép chương trình nhấn nút trên một tay cầm ảo, mà trò chơi và ứng dụng coi là đầu vào của bạn.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT là đường dẫn của chương trình hoặc một ID từ “ojd access list”. Quyền được cấp theo chữ ký của chương trình, nên vẫn hợp lệ khi chương trình được cập nhật hoặc di chuyển. Không thể cấp quyền cho chương trình ký ad-hoc hoặc chưa ký. Với --token thay cho CLIENT, lệnh tạo một token mà máy khách dùng để ký thử thách của dịch vụ trong hello: trên socket, trên WebSocket từ một trang ở một trong các giá trị --origin, hoặc, với token không có --origin, trên WebSocket từ chương trình không gửi tiêu đề Origin, chẳng hạn ứng dụng chạy trong hộp cát. Một trang không thể dùng phạm vi control. Token chỉ hiển thị một lần. Hỏi xác nhận trước.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Một origin web, như http://127.0.0.1:8080, có các trang được phép dùng token trên WebSocket. Lặp lại để thêm. Các trang lớp phủ mà WebSocket phục vụ có origin http://127.0.0.1:PORT, với cổng mà “ojd access status” hiển thị.";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin không thể kết hợp với phạm vi control. Một trang không bao giờ điều khiển tay cầm ảo; hãy cấp control cho token không có --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin cần --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Một phạm vi để cấp: read hoặc control. Lặp lại để cấp cả hai.";
