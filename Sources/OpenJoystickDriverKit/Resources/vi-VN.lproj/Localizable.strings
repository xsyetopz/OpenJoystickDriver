"error.E5007.modes.usageMapNotLayouts" = "%1$@, input: chế độ HIDDescriptor đọc bản đồ sử dụng, không đọc bố cục đầu vào. Cách sửa: thay các bố cục đầu vào bằng bản đồ sử dụng.";
