"cli.service.wait.abstract" = "Chờ đến khi dịch vụ nhận yêu cầu. --timeout giới hạn thời gian chờ (mặc định 5 giây).";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "Dịch vụ không nhận yêu cầu trong %@. Hãy khởi động bằng “ojd service start”, hoặc thử lại với --timeout lớn hơn.";
