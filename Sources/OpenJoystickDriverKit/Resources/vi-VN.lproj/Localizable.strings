"error.E2011" = "Tệp cấu hình hoặc bản ghi không hợp lệ. Hãy sửa theo lược đồ của nó và thử lại.";
"error.E2012" = "Không có bộ điều khiển, cấu hình, liên kết hoặc máy khách nào khớp, hoặc có nhiều hơn một. Hãy liệt kê chúng bằng lệnh “list” tương ứng và gọi tên chính xác một mục.";
"error.E2013" = "Bộ điều khiển không thể làm điều đó lúc này. Nó có thể không được hỗ trợ, chưa sẵn sàng hoặc đã ngắt kết nối. Hãy kiểm tra bằng “ojd controller list”.";
"error.E2014" = "OpenJoystickDriver chưa được cài đặt đầy đủ, hoặc chữ ký của nó không hợp lệ. Hãy cài đặt lại ứng dụng và chạy “ojd diagnose”.";
"error.E2015" = "macOS không hoàn tất hoặc không áp dụng yêu cầu. Hãy kiểm tra Cài đặt hệ thống và thử lại.";
