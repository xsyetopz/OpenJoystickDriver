"error.E2024.message" = "Không có ứng dụng khách hay mã thông báo endpoint nào có ID này. Chạy ojd access để liệt kê các ID, rồi dùng một ID trong đó.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "Không thể cấp quyền cho ứng dụng khách có loại chữ ký này, vì bất kỳ chương trình cục bộ nào cũng có thể mạo nhận chữ ký của nó.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Hãy chọn ít nhất một phạm vi để cấp.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "Dịch vụ đang dừng. Hãy khởi động dịch vụ, rồi thử lại.";
