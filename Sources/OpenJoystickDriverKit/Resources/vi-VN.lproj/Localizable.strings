"error.E5007.modes.endpointsHID" = "%1$@, modes[].match.interfaceSignature.endpoints: interfaceSignature của chế độ HID không có endpoints, vì chỉ trình quét raw-USB đọc tập điểm cuối. Cách sửa: bỏ endpoints khỏi interfaceSignature.";
