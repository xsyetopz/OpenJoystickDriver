"cli.option.timeout" = "Số giây chờ cho mỗi yêu cầu dịch vụ (mặc định: %g), hoặc để các lệnh “service”, “virtual set” và “virtual reset” hoàn tất (mặc định: %g).";
"cli.root.abstract" = "Cấu hình và kiểm tra OpenJoystickDriver, trình điều khiển tay cầm chơi game cho macOS.";
"cli.root.discussion" = "Bắt đầu tại đây:\n  ojd status             Kiểm tra dịch vụ, tiện ích mở rộng và quyền.\n  ojd diagnose           Chạy mọi kiểm tra và báo cáo điều gì đang sai.\n  ojd controller list    Liệt kê các tay cầm đang kết nối.\n\nVí dụ:\n  # In đầu vào của một tay cầm khi nó thay đổi\n  ojd controller watch 045E:028E\n  # Liệt kê các tay cầm đang kết nối dưới dạng JSON\n  ojd --json controller list\n\nMôi trường (cờ được ưu tiên hơn biến):\n  OJD_NO_INPUT=1         Giống --no-input.\n  OJD_TIMEOUT=SECONDS    Giống --timeout.\n  OJD_COLOR=WHEN         auto, always (có màu cả ngoài terminal) hoặc never.\n\nHoàn tất lệnh trong shell:\n  ojd --generate-completion-script zsh|bash|fish\n\nMã thoát:\n  0    Thành công.\n  1    Lệnh thất bại.\n  64   Lỗi cách dùng.\n  69   Dịch vụ chưa chạy. Hãy khởi động bằng “ojd service start”.\n  77   Thiếu quyền của macOS.\n  127  Bản build từ kho mã không thể chuyển lệnh cho ứng dụng đã cài.\n  130  Bị ngắt.";
"cli.help.global_options" = "Mọi lệnh đều nhận các tùy chọn chung; “ojd --help” liệt kê chúng.";
"cli.error.env_timeout" = "OJD_TIMEOUT cần một số giây lớn hơn 0.";
"cli.error.env_color" = "OJD_COLOR cần là auto, always hoặc never.";
"cli.error.env_no_input" = "OJD_NO_INPUT cần là 1, true, yes, 0, false hoặc no.";
"cli.virtual.feed.error.plain" = "--plain không áp dụng cho “virtual feed”, lệnh in các dòng JSON. Hãy bỏ --plain.";
"cli.controller.watch.examples" = "Ví dụ:\n  # In đầu vào trong 10 giây\n  ojd controller watch 045E:028E --duration 10\n  # In điều khiển đầu tiên được nhấn, dưới dạng JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Theo dõi mọi tay cầm và những gì tay cầm ảo của chúng gửi\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Ví dụ:\n  # Chạy cả hai động cơ chính ở mức 180 trong 0,45 giây\n  ojd controller rumble 045E:028E\n  # Chạy cả hai động cơ chính hết công suất trong 2 giây\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Ví dụ:\n  # Đặt thanh đèn sang màu cam\n  ojd controller light 054C:09CC --color FF8000\n  # Đặt màu và độ sáng thấp\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Ví dụ:\n  # Tạo hồ sơ cho một mẫu tay cầm\n  ojd profile create Racing --controller 045E:028E\n  # Chỉ áp dụng khi Safari đang ở phía trước\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Ví dụ:\n  # Đổi tên hồ sơ\n  ojd profile set Racing name Rally\n  # Đặt vùng chết bên trong của ánh xạ cần analog đầu tiên\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Ví dụ:\n  # Giữ Space trong khi nút phía nam đang được giữ\n  ojd binding set Racing button:south key:space\n  # Bật/tắt J mỗi lần nhấn\n  ojd binding set Racing button:west key:j --behavior toggle\n  # Lặp lại J 10 lần mỗi giây khi đang giữ\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Ví dụ:\n  # Cài đặt một tệp bản ghi\n  ojd record install 045E-028E.json\n  # Đọc bản ghi từ stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Ví dụ:\n  # Cho phép một chương trình dùng dịch vụ\n  ojd access grant /Applications/Example.app\n  # Tạo token cho các trang được phục vụ từ một origin\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
"cli.service.abstract" = "Khởi động hoặc dừng dịch vụ OpenJoystickDriver, hoặc chờ đến khi dịch vụ nhận yêu cầu.";
"cli.service.running" = "Dịch vụ đang chạy.";
"cli.service.start.abstract" = "Mở ứng dụng ở nền và chờ đến khi dịch vụ của nó nhận yêu cầu.";
"cli.service.start.no_bundle" = "ojd này không nằm trong OpenJoystickDriver.app nên không thể khởi động dịch vụ. Hãy mở ứng dụng đã cài đặt, hoặc chạy ojd bên trong nó.";
"cli.service.start.open_failed" = "macOS không thể mở %@. Hãy mở nó từ Finder để xem lý do.";
"cli.service.stop.abstract" = "Dừng dịch vụ và chờ đến khi nó thoát. Các bộ điều khiển đã kết nối được trả lại cho macOS.";
"cli.service.stop.signal_failed" = "Không thể dừng dịch vụ: %@. Hãy thoát OpenJoystickDriver từ menu của nó.";
"cli.service.stop.timeout" = "Dịch vụ không dừng trong %@. Hãy thử lại với --timeout lớn hơn.";
"cli.service.stopped" = "Dịch vụ đã dừng.";
"cli.service.wait.abstract" = "Chờ đến khi dịch vụ nhận yêu cầu. --timeout giới hạn thời gian chờ (mặc định 5 giây).";
"cli.service.wait.timeout" = "Dịch vụ không nhận yêu cầu trong %@. Hãy khởi động bằng “ojd service start”, hoặc thử lại với --timeout lớn hơn.";
"cli.status.abstract" = "Hiển thị dịch vụ, phần mở rộng, quyền và các bộ điều khiển đã kết nối.";
"cli.status.discussion" = "Hoạt động cả khi dịch vụ đã dừng: báo dịch vụ đã dừng và thoát với mã 0.";
