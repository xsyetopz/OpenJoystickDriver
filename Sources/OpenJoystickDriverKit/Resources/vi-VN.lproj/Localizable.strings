/* Long description in the help of 'ojd protocol'. The folder name Protocols, the path, and .plist stay as written. */
"cli.protocol.group.discussion" = "Mô tả giao thức là tệp .plist định nghĩa một họ tay cầm mà OJD không tích hợp sẵn. Mô tả đã cài nằm trong ~/Library/Application Support/OpenJoystickDriver/Protocols, và gói mod cũng có thể chứa chúng. Các lệnh này không cần dịch vụ.";
/* Help text of the FILE argument of 'ojd protocol validate' and 'ojd protocol install'. VendorAcmePad.plist is an example file name and stays as written. */
"cli.protocol.group.file" = "Tệp mô tả đặt tên theo họ của nó, ví dụ VendorAcmePad.plist.";
/* One-line summary of 'ojd protocol validate' in the command list and at the top of its help. */
"cli.protocol.validate.abstract" = "Kiểm tra tệp mô tả giao thức mà không cài đặt.";
/* Long description in the help of 'ojd protocol validate'. UpperCamelCase describes the spelling of a family name. E5xxx stays as written. */
"cli.protocol.validate.discussion" = "Kiểm tra tệp là mô tả hợp lệ, tên họ viết theo UpperCamelCase và khớp với tên tệp, không phải họ tích hợp sẵn, và có đặt tên hiển thị cùng bố cục đầu vào. Thoát với mã 1 kèm mã E5xxx khi tệp bị từ chối.";
/* Message printed by 'ojd protocol validate' for a valid file. %1$@ is the file, %2$@ is the family name and %3$@ is its display name. The command in quotes stays as written. */
"cli.protocol.validate.valid" = "%1$@ là mô tả hợp lệ của họ %2$@ (%3$@). Cài đặt bằng 'ojd protocol install'.";
/* One-line summary of 'ojd protocol install' in the command list and at the top of its help. */
"cli.protocol.install.abstract" = "Kiểm tra mô tả giao thức và cài đặt cho người dùng của bạn.";
/* Long description in the help of 'ojd protocol install'. Protocols/FAMILY.plist and --dry-run stay as written. */
"cli.protocol.install.discussion" = "Sao chép tệp vào Protocols/FAMILY.plist. Mô tả đã cài của cùng họ sẽ bị thay thế. --dry-run kiểm tra tệp và không ghi gì.";
/* Message printed after 'ojd protocol install' copied a description. %@ is the installed file. */
"cli.protocol.install.success" = "Đã cài đặt %@.";
/* One-line summary of 'ojd protocol list' in the command list and at the top of its help. */
"cli.protocol.list.abstract" = "Liệt kê các họ giao thức tích hợp sẵn và có tài liệu cùng nguồn của từng họ.";
/* Long description in the help of 'ojd protocol list'. */
"cli.protocol.list.discussion" = "Liệt kê từng họ cùng tên hiển thị và nguồn: tích hợp sẵn, thư mục Protocols của bạn hoặc gói mod. Mô tả bị từ chối không được liệt kê.";
/* Source shown by 'ojd protocol list' for a family that OJD builds in. */
"cli.protocol.list.builtIn" = "tích hợp sẵn";
/* Source shown by 'ojd protocol list' for a family from a description in the user's Protocols folder. Protocols stays as written. */
"cli.protocol.list.user" = "thư mục Protocols của bạn";
/* Source shown by 'ojd protocol list' for a family from a mod package. %@ is the package name. */
"cli.protocol.list.package" = "gói %@";
/* One-line summary of 'ojd mod remove' in the command list and at the top of its help. */
"cli.mod.remove.abstract" = "Gỡ một gói mod đã cài.";
/* Long description in the help of 'ojd mod remove'. Packages/NAME, --force, --dry-run and E4006 stay as written. */
"cli.mod.remove.discussion" = "Chỉ xóa Packages/NAME. Hỏi xác nhận trong terminal; nếu không thì cần --force. --dry-run kiểm tra gói đã được cài và không thay đổi gì. Thoát với mã 1 và E4006 nếu chưa cài.";
/* Yes or no question that 'ojd mod remove' asks on a terminal. %@ is the folder to delete. */
"cli.mod.remove.confirm" = "Xóa %@?";
/* Message printed by 'ojd mod remove --dry-run' instead of deleting. %@ is the folder. */
"cli.mod.remove.dryRun" = "Nếu chạy, sẽ xóa %@.";
/* Message printed after 'ojd mod remove'. %@ is the folder that is deleted. */
"cli.mod.remove.success" = "Đã xóa %@.";
/* Help text of the --dry-run flag of the commands that change data. */
"cli.shared.option.dryRun" = "In những gì sẽ thay đổi, và không thay đổi gì.";
/* Help text of the --force flag of the commands that ask for confirmation. */
"cli.shared.option.force" = "Không hỏi xác nhận.";
/* One-line summary of 'ojd virtual' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.virtual.group.abstract" = "Hiển thị và chọn tay cầm ảo mà OpenJoystickDriver cung cấp cho một bộ điều khiển.";
/* Message printed after 'ojd virtual set' or 'ojd virtual reset' changed the virtual gamepad. %1$@ is the controller name, %2$@ is the profile name and %3$@ is where the choice comes from. */
"cli.virtual.group.changed" = "%1$@ hiện cung cấp %2$@ (%3$@).";
/* Message printed after 'ojd virtual set' saved the choice while virtual output is off. %@ is the controller name. */
"cli.virtual.group.stored" = "Đã lưu lựa chọn cho %@. Lựa chọn áp dụng khi đầu ra ảo được bật.";
/* Help text of the --unit option of 'ojd virtual set' and 'ojd virtual reset'. A unit ID names one controller by model and USB port. */
"cli.virtual.group.unit" = "Chỉ áp dụng cho bộ điều khiển này, theo ID thiết bị của nó, thay vì cho cả kiểu máy.";
/* Long description in the help of 'ojd virtual'. reset stays as written because it is a command name. */
"cli.virtual.group.discussion" = "Một lựa chọn áp dụng cho mọi bộ điều khiển cùng kiểu máy. “reset” đưa một kiểu máy về lựa chọn tự động.";
/* Paragraph in the help of 'ojd virtual' about --unit. set and reset are command names and stay as written. */
"cli.virtual.group.discussionUnit" = "Với --unit, “set” áp dụng cho một bộ điều khiển theo ID thiết bị của nó, và “reset” đưa bộ điều khiển đó về lựa chọn của kiểu máy.";
/* Error of 'ojd virtual set' when the service could not apply the choice. %1$@ is the controller name and %2$@ is the reason. The command in quotes stays as written. */
"cli.virtual.group.errorFailed" = "Tay cầm ảo cho %1$@ không thay đổi (%2$@). Hãy kiểm tra bằng “ojd virtual show”.";
/* Error of 'ojd virtual' commands when --unit is used for a controller without a unit ID. %@ is the controller name. --unit stays as written. */
"cli.virtual.group.errorNoUnit" = "%@ không có ID thiết bị, nên một lựa chọn chỉ có thể áp dụng cho cả kiểu máy. Hãy chạy lệnh không có --unit.";
/* One-line summary of 'ojd virtual export-mapping' in the command list and at the top of its help. SDL is a game controller library and W3C names the web standard gamepad layout; both stay as written. */
"cli.virtual.exportMapping.abstract" = "In ánh xạ SDL hoặc mô tả W3C mà một hồ sơ tay cầm ảo suy ra.";
/* Long description in the help of 'ojd virtual export-mapping'. SDL, W3C and JSON stay as written. */
"cli.virtual.exportMapping.discussion" = "SDL in một dòng ánh xạ cho mỗi hồ sơ, đó là một tệp ánh xạ SDL hợp lệ. W3C in mô tả bố cục chuẩn dưới dạng JSON. Cả hai đều được suy ra từ bộ mô tả báo cáo của hồ sơ.";
/* Help text of the format option of 'ojd virtual export-mapping'. sdl and w3c are values the user types and stay as written. */
"cli.virtual.exportMapping.format" = "Định dạng cần in: sdl hoặc w3c.";
/* Help text of the profile argument of 'ojd virtual export-mapping'. */
"cli.virtual.exportMapping.profile" = "Hồ sơ tay cầm ảo cần in. Bỏ qua để in mọi hồ sơ.";
/* One-line summary of 'ojd virtual feed' in the command list and at the top of its help. Standard input is the input stream of the program. */
"cli.virtual.feed.abstract" = "Cung cấp một tay cầm ảo do đầu vào chuẩn điều khiển.";
/* Long description in the help of 'ojd virtual feed'. The JSON field names buttons, dpad and axes and the control names stay as written. */
"cli.virtual.feed.discussion" = "Đọc một đối tượng JSON mỗi dòng: “buttons” và “dpad” liệt kê các thành phần được nhấn, như South và DpadUp, và “axes” ánh xạ tên trục, như LeftStickX, tới giá trị. Thành phần bị thiếu ở trạng thái trung tính. Các cần chạy từ -1 đến 1 với Y hướng xuống; các cò chạy từ 0 đến 1. Các khung được phát theo thứ tự, mỗi khung ít nhất 8 ms; “holdMilliseconds” giữ một khung lâu hơn, tối đa 60000. In mỗi lệnh đầu ra mà trò chơi gửi đến tay cầm, như rung, thành một đối tượng JSON mỗi dòng. Dừng khi mọi khung đã phát xong sau khi đầu vào kết thúc.";
/* Error of 'ojd virtual feed' when the service closed the virtual gamepad. The command in quotes stays as written. */
"cli.virtual.feed.errorClosed" = "Dịch vụ đã đóng tay cầm ảo. Hãy kiểm tra bằng “ojd status”.";
/* Error from `ojd virtual feed` when the service connection broke while the virtual gamepad was closing. */
"cli.virtual.feed.errorCloseInterrupted" = "Việc đóng tay cầm ảo đã bị gián đoạn. Hãy kiểm tra bằng “ojd status”.";
/* Error of 'ojd virtual feed' for an input line that is not a valid frame. %@ is the line number. The command in quotes stays as written. */
"cli.virtual.feed.errorFrame" = "Dòng %@ không phải là khung hợp lệ. “ojd virtual feed --help” hiển thị định dạng.";
/* Help text of the profile argument of 'ojd virtual feed'. */
"cli.virtual.feed.profile" = "Cấu hình tay cầm ảo để cung cấp.";
/* First line of 'ojd virtual feed'. %@ is the profile name. Control-C is the key combination that stops a program in a terminal. */
"cli.virtual.feed.started" = "Đang cung cấp tay cầm ảo %@… Hãy ghi các khung vào đầu vào chuẩn; kết thúc đầu vào hoặc nhấn Control-C để dừng.";
/* One-line summary of 'ojd virtual launch' in the command list and at the top of its help. SDL is a game controller library and stays as written. */
"cli.virtual.launch.abstract" = "Chạy một chương trình với ánh xạ SDL của các tay cầm ảo đã kết nối.";
/* Help text of the program argument of 'ojd virtual launch'. PATH is the environment variable, .app is the app bundle extension, and -- stays as written. */
"cli.virtual.launch.command" = "Chương trình cần chạy và các đối số của nó. Chương trình là một đường dẫn, một tên mà PATH tìm thấy hoặc một .app. Đặt -- trước chương trình khi các đối số của nó cũng là tùy chọn của ojd.";
/* Long description in the help of 'ojd virtual launch'. SDL_GAMECONTROLLERCONFIG and .app stay as written. */
"cli.virtual.launch.discussion" = "Đặt SDL_GAMECONTROLLERCONFIG theo ánh xạ tay cầm ảo của từng bộ điều khiển đã kết nối, để SDL trong chương trình liệt kê chúng. Giá trị đã đặt sẵn vẫn đứng đầu và các ánh xạ nối theo sau. Một .app chạy tệp thực thi chính của nó. Chương trình giữ terminal này. Dừng ojd sẽ dừng chương trình, và ojd thoát với trạng thái của chương trình.";
/* Error of 'ojd virtual launch' when the program does not start. %1$@ is the program the user gave and %2$@ is the reason, one of the short reasons for a missing executable, a path without a file and a name not on PATH. */
"cli.virtual.launch.errorFailed" = "%1$@ không khởi động (%2$@). Hãy kiểm tra đó là tệp thực thi hoặc một ứng dụng và bạn có quyền chạy nó.";
/* Short reason inside the failure message of 'ojd virtual launch' when an app bundle holds no executable. It fills %2$@ of that message and starts in lowercase. */
"cli.virtual.launch.errorNoExecutable" = "ứng dụng không có tệp thực thi";
/* Error of 'ojd virtual launch' when no connected controller has a virtual gamepad. The command in quotes stays as written. */
"cli.virtual.launch.errorNoGamepad" = "Không có bộ điều khiển nào đã kết nối có tay cầm ảo, nên không có ánh xạ để đặt. Hãy kết nối một bộ điều khiển và kiểm tra “ojd virtual show”.";
/* Error of 'ojd virtual launch' when no program is given. The example command in quotes stays as written. */
"cli.virtual.launch.errorNoProgram" = "Hãy chỉ định một chương trình để chạy, ví dụ “ojd virtual launch ./game”.";
/* Short reason inside the failure message of 'ojd virtual launch' when the path holds no executable file. It fills %2$@ of that message and starts in lowercase. */
"cli.virtual.launch.errorNotExecutable" = "không có tệp thực thi ở đường dẫn đó";
/* Short reason inside the failure message of 'ojd virtual launch' when no program of the name is on PATH. It fills %2$@ of that message and starts in lowercase. PATH stays as written. */
"cli.virtual.launch.errorNotFound" = "không có chương trình nào tên đó trong PATH";
/* Error of 'ojd virtual launch' when --json or --plain is given. Both option names stay as written. */
"cli.virtual.launch.errorOutput" = "--json và --plain không áp dụng, vì chương trình ghi ra đầu ra chuẩn.";
/* Help text of the SDL backend flag of 'ojd virtual launch'. The SDL hint names and values stay as written. */
"platform.macos.cli.virtual.launch.sdlGamecontrollerBackend" = "Đồng thời đặt các gợi ý SDL khiến SDL chỉ đọc tay cầm qua khung GameController của Apple: SDL_JOYSTICK_MFI=1, SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, SDL_JOYSTICK_IOKIT=0, SDL_JOYSTICK_HIDAPI=0. Chúng chỉ áp dụng cho chương trình và thay thế các giá trị đã đặt.";
/* One-line summary of 'ojd virtual reset' in the command list and at the top of its help. */
"cli.virtual.reset.abstract" = "Đưa kiểu máy của một bộ điều khiển, hoặc mọi kiểu máy, về lựa chọn tay cầm ảo tự động.";
/* Help text of the --all flag of 'ojd virtual reset'. */
"cli.virtual.reset.all" = "Đặt lại mọi kiểu máy bộ điều khiển.";
/* Message printed after 'ojd virtual reset --all'. */
"cli.virtual.reset.allDone" = "Mọi kiểu máy bộ điều khiển giờ tự động chọn tay cầm ảo của nó.";
/* Message printed by 'ojd virtual reset --all --dry-run' instead of resetting. */
"cli.virtual.reset.allDryRun" = "Sẽ đưa mọi kiểu máy bộ điều khiển về lựa chọn tay cầm ảo tự động.";
