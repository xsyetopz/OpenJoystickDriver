/* Error E5007, shown when a record or protocol description breaks a rule: the defaults of a protocol description hold input layouts for a family that reads none. %1$@ is the file. */
"error.E5007.protocolDescription.inputLayout" = "%1$@, defaults.input: bố cục đầu vào chỉ áp dụng cho họ đọc nó. Cách sửa: bỏ bố cục đầu vào khỏi giá trị mặc định.";
/* Error E5007, shown when a record or protocol description breaks a rule: the defaults of a protocol description hold a usage map for a family that reads none. %1$@ is the file. */
"error.E5007.protocolDescription.usageMap" = "%1$@, defaults.input.usageMap: bản đồ sử dụng HID chỉ áp dụng cho họ đọc nó. Cách sửa: bỏ bản đồ sử dụng khỏi giá trị mặc định.";
/* Error E5007, shown when a record or protocol description breaks a rule: a protocol description sets receiverPowerOff for a family other than XboxXUSB. %1$@ is the file. */
"error.E5007.protocolDescription.receiverPowerOff" = "%1$@, defaults.receiverPowerOff: giá trị mặc định receiverPowerOff chỉ áp dụng cho XboxXUSB. Cách sửa: bỏ receiverPowerOff khỏi giá trị mặc định.";
/* Error E5007, shown when a record or protocol description breaks a rule: a protocol description lists session keys for a family that reads none. %2$@ is the family. %1$@ is the file. */
"error.E5007.protocolDescription.sessionKeysNone" = "%1$@, sessionKeys: %2$@ không đọc khóa phiên nào. Cách sửa: để sessionKeys trống.";
