"cli.runtime.heading" = "Soak d’execució del servei d’aplicació OpenJoystickDriver";
"cli.runtime.help" = "Ús: OpenJoystickDriver --headless diagnose runtime [--seconds 1...86400] [--interval-ms 100...60000] [--rss-limit-mib 0...65536] [--footprint-limit-mib 0...65536] [--json]\n\nMostreja el RSS, l’empremta física, la CPU, els descriptors de fitxer i els fils del servei d’aplicació.";
"cli.runtime.help_limits" = "Zero desactiva un límit de cresta; l’empremta val 512 MiB per defecte. Les finestres de menys de 60 segons són explícitament no concloents; fes servir un soak més llarg mentre reproduïu l’activitat.";
"cli.runtime.help_max_samples" = "Com a molt es poden sol·licitar 100000 mostres.";
"cli.runtime.inconclusive" = "Una observació més curta que %d s no és concloent; fes servir un soak més llarg amb un comandament actiu.";
