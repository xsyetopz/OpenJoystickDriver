<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>已連接 %d 個控制器</string>
			<key>zero</key>
			<string>已連接 %d 個控制器</string>
			<key>two</key>
			<string>已連接 %d 個控制器</string>
			<key>few</key>
			<string>已連接 %d 個控制器</string>
			<key>many</key>
			<string>已連接 %d 個控制器</string>
			<key>other</key>
			<string>已連接 %d 個控制器</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d 個對應</string>
			<key>zero</key>
			<string>%d 個對應</string>
			<key>two</key>
			<string>%d 個對應</string>
			<key>few</key>
			<string>%d 個對應</string>
			<key>many</key>
			<string>%d 個對應</string>
			<key>other</key>
			<string>%d 個對應</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>未偵測到控制器輸出裝置</string>
			<key>one</key>
			<string>已偵測到 %d 個控制器輸出裝置</string>
			<key>two</key>
			<string>已偵測到 %d 個控制器輸出裝置</string>
			<key>few</key>
			<string>已偵測到 %d 個控制器輸出裝置</string>
			<key>many</key>
			<string>已偵測到 %d 個控制器輸出裝置</string>
			<key>other</key>
			<string>已偵測到 %d 個控制器輸出裝置</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>「%1$@」符合 %2$lld 個控制器。請使用下列其中一個 ID：</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>「%1$@」對應 %2$lld 個設定檔。請使用以下其中一個 ID：</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>在此 --interval-ms 下使用 --soak 將取樣 %lld 次；請調大 --interval-ms。</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>取樣將需要 %lld 個樣本。請增加取樣間隔。</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>此次執行需要 %lld 個樣本。請增加取樣間隔。</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%1$@ 與預期狀態相符：已重播 %2$lld 個輸入報告。</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%1$@ 的解析器產生的狀態與 %2$@ 在 %3$lld 個欄位上不同。</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>已隱藏 %lld 個閒置封包（仍包含在匯出內）。</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Chinese (Traditional) plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>已停止 · %lld 個封包</string>
		</dict>
	</dict>
</dict>
</plist>
