<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d وحدة تحكم متصلة</string>
			<key>zero</key>
			<string>لا توجد وحدات تحكم متصلة (%d)</string>
			<key>two</key>
			<string>%d وحدتا تحكم متصلتان</string>
			<key>few</key>
			<string>%d وحدات تحكم متصلة</string>
			<key>many</key>
			<string>%d وحدة تحكم متصلة</string>
			<key>other</key>
			<string>%d وحدة تحكم متصلة</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d تعيين</string>
			<key>zero</key>
			<string>لا توجد تعيينات (%d)</string>
			<key>two</key>
			<string>%d تعيينان</string>
			<key>few</key>
			<string>%d تعيينات</string>
			<key>many</key>
			<string>%d تعيين</string>
			<key>other</key>
			<string>%d تعيين</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>لم يُكتشف أي جهاز إخراج لوحدة التحكم</string>
			<key>one</key>
			<string>اكتُشف %d جهاز إخراج لوحدة التحكم</string>
			<key>two</key>
			<string>اكتُشف جهازا إخراج لوحدة التحكم (%d)</string>
			<key>few</key>
			<string>اكتُشفت %d أجهزة إخراج لوحدة التحكم</string>
			<key>many</key>
			<string>اكتُشف %d جهاز إخراج لوحدة التحكم</string>
			<key>other</key>
			<string>اكتُشف %d جهاز إخراج لوحدة التحكم</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>«%1$@» يطابق %2$lld وحدة تحكم. استخدم أحد هذه المعرّفات:</string>
			<key>one</key>
			<string>«%1$@» يطابق وحدة تحكم واحدة. استخدم أحد هذه المعرّفات:</string>
			<key>two</key>
			<string>«%1$@» يطابق وحدتي تحكم. استخدم أحد هذه المعرّفات:</string>
			<key>few</key>
			<string>«%1$@» يطابق %2$lld وحدات تحكم. استخدم أحد هذه المعرّفات:</string>
			<key>many</key>
			<string>«%1$@» يطابق %2$lld وحدة تحكم. استخدم أحد هذه المعرّفات:</string>
			<key>other</key>
			<string>«%1$@» يطابق %2$lld وحدة تحكم. استخدم أحد هذه المعرّفات:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>«%1$@» هو اسم %2$lld ملف تعريف. استخدم أحد هذه المعرّفات:</string>
			<key>one</key>
			<string>«%1$@» هو اسم ملف تعريف واحد. استخدم أحد هذه المعرّفات:</string>
			<key>two</key>
			<string>«%1$@» هو اسم ملفَّي تعريف. استخدم أحد هذه المعرّفات:</string>
			<key>few</key>
			<string>«%1$@» هو اسم %2$lld ملفات تعريف. استخدم أحد هذه المعرّفات:</string>
			<key>many</key>
			<string>«%1$@» هو اسم %2$lld ملف تعريف. استخدم أحد هذه المعرّفات:</string>
			<key>other</key>
			<string>«%1$@» هو اسم %2$lld ملف تعريف. استخدم أحد هذه المعرّفات:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>سيأخذ --soak مع قيمة --interval-ms هذه %lld عينة؛ ارفع قيمة --interval-ms.</string>
			<key>one</key>
			<string>سيأخذ --soak مع قيمة --interval-ms هذه عينة واحدة؛ ارفع قيمة --interval-ms.</string>
			<key>two</key>
			<string>سيأخذ --soak مع قيمة --interval-ms هذه عينتين؛ ارفع قيمة --interval-ms.</string>
			<key>few</key>
			<string>سيأخذ --soak مع قيمة --interval-ms هذه %lld عينات؛ ارفع قيمة --interval-ms.</string>
			<key>many</key>
			<string>سيأخذ --soak مع قيمة --interval-ms هذه %lld عينة؛ ارفع قيمة --interval-ms.</string>
			<key>other</key>
			<string>سيأخذ --soak مع قيمة --interval-ms هذه %lld عينة؛ ارفع قيمة --interval-ms.</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>سيتطلب أخذ العينات %lld قياسًا. زد الفاصل بين القياسات.</string>
			<key>one</key>
			<string>سيتطلب أخذ العينات قياسًا واحدًا. زد الفاصل بين القياسات.</string>
			<key>two</key>
			<string>سيتطلب أخذ العينات قياسين. زد الفاصل بين القياسات.</string>
			<key>few</key>
			<string>سيتطلب أخذ العينات %lld قياسات. زد الفاصل بين القياسات.</string>
			<key>many</key>
			<string>سيتطلب أخذ العينات %lld قياسًا. زد الفاصل بين القياسات.</string>
			<key>other</key>
			<string>سيتطلب أخذ العينات %lld قياسًا. زد الفاصل بين القياسات.</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>سيتطلب هذا التشغيل %lld قياسًا. زد الفاصل بين القياسات.</string>
			<key>one</key>
			<string>سيتطلب هذا التشغيل قياسًا واحدًا. زد الفاصل بين القياسات.</string>
			<key>two</key>
			<string>سيتطلب هذا التشغيل قياسين. زد الفاصل بين القياسات.</string>
			<key>few</key>
			<string>سيتطلب هذا التشغيل %lld قياسات. زد الفاصل بين القياسات.</string>
			<key>many</key>
			<string>سيتطلب هذا التشغيل %lld قياسًا. زد الفاصل بين القياسات.</string>
			<key>other</key>
			<string>سيتطلب هذا التشغيل %lld قياسًا. زد الفاصل بين القياسات.</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>%1$@ يطابق الحالة المتوقعة: أُعيد تشغيل %2$lld تقرير إدخال.</string>
			<key>one</key>
			<string>%1$@ يطابق الحالة المتوقعة: أُعيد تشغيل تقرير إدخال واحد.</string>
			<key>two</key>
			<string>%1$@ يطابق الحالة المتوقعة: أُعيد تشغيل تقريري إدخال.</string>
			<key>few</key>
			<string>%1$@ يطابق الحالة المتوقعة: أُعيد تشغيل %2$lld تقارير إدخال.</string>
			<key>many</key>
			<string>%1$@ يطابق الحالة المتوقعة: أُعيد تشغيل %2$lld تقرير إدخال.</string>
			<key>other</key>
			<string>%1$@ يطابق الحالة المتوقعة: أُعيد تشغيل %2$lld تقرير إدخال.</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>الحالة التي أنتجها محلل %1$@ تختلف عن %2$@ في %3$lld حقل.</string>
			<key>one</key>
			<string>الحالة التي أنتجها محلل %1$@ تختلف عن %2$@ في حقل واحد.</string>
			<key>two</key>
			<string>الحالة التي أنتجها محلل %1$@ تختلف عن %2$@ في حقلين.</string>
			<key>few</key>
			<string>الحالة التي أنتجها محلل %1$@ تختلف عن %2$@ في %3$lld حقول.</string>
			<key>many</key>
			<string>الحالة التي أنتجها محلل %1$@ تختلف عن %2$@ في %3$lld حقلًا.</string>
			<key>other</key>
			<string>الحالة التي أنتجها محلل %1$@ تختلف عن %2$@ في %3$lld حقل.</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>تم إخفاء %lld حزمة خمول (ما زالت مضمّنة في التصدير).</string>
			<key>one</key>
			<string>تم إخفاء حزمة خمول واحدة (ما زالت مضمّنة في التصدير).</string>
			<key>two</key>
			<string>تم إخفاء حزمتي خمول (ما زالتا مضمّنتين في التصدير).</string>
			<key>few</key>
			<string>تم إخفاء %lld حزم خمول (ما زالت مضمّنة في التصدير).</string>
			<key>many</key>
			<string>تم إخفاء %lld حزمة خمول (ما زالت مضمّنة في التصدير).</string>
			<key>other</key>
			<string>تم إخفاء %lld حزمة خمول (ما زالت مضمّنة في التصدير).</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Arabic plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>zero</key>
			<string>متوقف · %lld حزمة</string>
			<key>one</key>
			<string>متوقف · حزمة واحدة</string>
			<key>two</key>
			<string>متوقف · حزمتان</string>
			<key>few</key>
			<string>متوقف · %lld حزم</string>
			<key>many</key>
			<string>متوقف · %lld حزمة</string>
			<key>other</key>
			<string>متوقف · %lld حزمة</string>
		</dict>
	</dict>
	<!-- Choice of the idle disconnect picker in the General pane of the settings window. %d is a number of minutes, such as 15. -->
	<key>ui.settings.general.idleDisconnectMinutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d دقيقة</string>
			<key>one</key>
			<string>%d دقيقة</string>
			<key>two</key>
			<string>%d دقيقتان</string>
			<key>few</key>
			<string>%d دقائق</string>
			<key>many</key>
			<string>%d دقيقة</string>
			<key>other</key>
			<string>%d دقيقة</string>
		</dict>
	</dict>
</dict>
</plist>
