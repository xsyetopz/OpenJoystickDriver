"cli.service.stop.timeout" = "لم تتوقف الخدمة خلال %@. أعد المحاولة مع قيمة --timeout أكبر.";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "الخدمة متوقفة.";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "انتظر حتى تقبل الخدمة الطلبات. يحدّد --timeout مدة الانتظار (الافتراضي 5 ثوانٍ).";
