"platform.macos.cli.service.start.openFailed" = "تعذّر على macOS فتح %@. افتحه من Finder لمعرفة السبب.";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "أوقف الخدمة وانتظر حتى تنتهي. تعود وحدات التحكم المتصلة إلى macOS.";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "تعذّر إيقاف الخدمة: %@. أنهِ OpenJoystickDriver من قائمته.";
