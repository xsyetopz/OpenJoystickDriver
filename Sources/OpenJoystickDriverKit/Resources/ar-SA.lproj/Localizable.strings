"error.E2021.message" = "تعذّر على إصدار مستودع ojd تسليم الأمر إلى التطبيق المثبّت. أعد تثبيت OpenJoystickDriver.app وشغّل الأمر مرة أخرى.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "وحدة التحكم غير متصلة أو غير جاهزة لإعادة التعيين. أعد توصيلها وحاول مرة أخرى.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "تعذّر إقران أذرع Joy-Con المحددة. حدّث وحدات التحكم المتصلة وحاول مرة أخرى.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "لا تبلّغ وحدة التحكم عن بيانات الحركة. اختر وحدة تحكم بها حسّاسات حركة أو اترك خيارات الحركة متوقفة.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "قيمة في الطلب أكبر مما تقبله الخدمة. أرسل قيمة أصغر.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "قائمة ملفات التعريف النشطة تالفة وتعذّر تحميلها. أصلح الملف التالف أو أزله ثم حاول مرة أخرى.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "يوجد ملف تعريف بهذا الاسم بالفعل. اختر اسمًا آخر؛ يعرض «ojd profile list» الأسماء المستخدمة.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "في الطلب وسائط ناقصة أو غير صالحة. افحص القيم وحاول مرة أخرى.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "ملف التعريف غير صالح. راجع التعيينات وحاول مرة أخرى.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "ستصبح مكتبة ملفات التعريف كبيرة جدًا. احذف ملفات التعريف التي لا تحتاجها وحاول مرة أخرى.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "يوجد ملف تعريف بهذا المعرّف بالفعل. استخدم معرّفًا جديدًا أو حدّث ملف التعريف الموجود.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "تغيّر ملف التعريف في مكان آخر بعد تحميله. أعد تحميله وأجرِ تغييرك مرة أخرى.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "تحتوي المكتبة بالفعل على أكبر عدد من ملفات التعريف تسمح به. احذف ملف تعريف لا تحتاجه وحاول مرة أخرى.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "لا يوجد ملف تعريف بهذا المعرّف. اعرض ملفات التعريف باستخدام «ojd profile list».";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "تعذّر على الخدمة ترميز ردّها. حاول مرة أخرى وأبلغ عن المشكلة إن استمرت.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "الرد أكبر مما تستطيع الخدمة إرساله. اطلب بيانات أقل وحاول مرة أخرى.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "محرك إعادة التعيين غير متاح. انتظر قليلًا وحاول مرة أخرى أو أعد تشغيل الخدمة.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "مكتبة ملفات التعريف ومحرك إعادة التعيين غير متاحين. انتظر قليلًا وحاول مرة أخرى أو أعد تشغيل الخدمة.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "مكتبة ملفات التعريف غير متاحة. انتظر قليلًا وحاول مرة أخرى أو أعد تشغيل الخدمة.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "أُغلق موجّه إعادة التعيين. أعد تشغيل الخدمة وحاول مرة أخرى.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "تعذّر على الخدمة التأكد مما إذا كان آخر تغيير في ملف التعريف قد حُفظ. أعد تحميل ملفات التعريف وافحصها قبل تغييرها مرة أخرى.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "تعذّرت قراءة ملف تعريف. تأكد من وجود الملف ومن أن الخدمة تستطيع قراءته.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "يجب إصلاح ملفات التعريف التالفة أو إزالتها قبل تغيير ملفات التعريف. أصلحها أو أزلها ثم حاول مرة أخرى.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "تعذّرت كتابة ملف تعريف. افحص مساحة القرص الحرة وأذونات المجلد.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "واجهت خدمة إعادة التعيين خطأً لا تتعرّف عليه. شغّل «ojd diagnose» وأبلغ عن المشكلة مع مخرجاتها.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "لا ينتج ملف التعريف أي مخرجات. أضف إليه تعيينًا أو لون إضاءة، أو فعّله باستخدام --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "يأخذ ملف تعريف زوج Joy-Con بيانات الجيروسكوب من وحدة Joy-Con الأخرى. عايِر حركة وحدة التحكم التي يحددها ملف التعريف للجيروسكوب.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "لا يوجد ملف تعريف نشط لوحدة التحكم، لذلك لا تعالج الحركة. فعّل ملف تعريف لها، وأحضر التطبيق الهدف إلى الواجهة، ثم حاول مرة أخرى.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "تغيّرت جلسة إعادة التعيين لوحدة التحكم أثناء تنفيذ الطلب. حاول مرة أخرى.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "لا يمكن تغيير ملف تعريف قادم من حزمة مثبتة. كرّر ملف التعريف وغيّر النسخة.";
/* Text of error E3030, returned when an action needs Post Event access and it is not granted. */
"error.E3030.message" = "لم يتم تنفيذ الإجراء لأن إذن Post Event غير ممنوح. امنحه لـ OpenJoystickDriver وحاول مرة أخرى.";
/* Text of error E3031, returned when an action needs Automation access and it is not granted. */
"error.E3031.message" = "لم يتم تنفيذ الإجراء لأن إذن الأتمتة غير ممنوح. امنحه لـ OpenJoystickDriver وحاول مرة أخرى.";
/* Text of error E3032, returned when an action needs to send keys while Secure Input blocks them. */
"error.E3032.message" = "لم يُكتب النص لأن Secure Input قيد التشغيل. أغلق التطبيق الذي شغّله، ثم حاول مرة أخرى.";
/* Text of error E3033, returned when a system action fails. The action name and the reason follow it. */
"error.E3033.message" = "فشل الإجراء. حاول مرة أخرى.";
/* Text of error E3034, returned when the system refuses to create the MIDI source of a MIDI action. */
"error.E3034.message" = "لم يتم تنفيذ إجراء MIDI لأن النظام رفض إنشاء مصدر MIDI باسم OpenJoystickDriver. حاول مرة أخرى.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.plist stays as written. */
"error.E4001.message" = "ملف بيان الحزمة mod.plist مفقود أو غير صالح. تحقق منه وفق مخطط mod-package ثم شغّل الأمر مرة أخرى.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "تتطلب الحزمة إصدارًا من OpenJoystickDriver يختلف عن الإصدار الذي يعمل. ثبّت إصدارًا من الحزمة يدعم هذا الإصدار، أو حدّث OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.plist stays as written. */
"error.E4003.message" = "ملف في الحزمة غير صالح أو مفقود أو غير مدرج في mod.plist. أصلح الملف الذي يذكره الأمر ثم شغّله مرة أخرى.";
/* Text of error E4004, printed when a mod package covers a controller, virtual gamepad or profile that the user's files or another package hold. */
"error.E4004.message" = "تغطي الحزمة وحدة تحكم أو وحدة تحكم افتراضية أو ملف تعريف موجودًا بالفعل في ملفاتك أو في حزمة مثبتة أخرى. أزل الملف أو الحزمة المتعارضة، أو غيّر الحزمة، ثم شغّل الأمر مرة أخرى.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "توجد حزمة مثبتة بهذا الاسم بالفعل. شغّل الأمر مع --force لاستبدالها.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "لا توجد حزمة مثبتة بهذا الاسم. شغّل ojd mod list لعرض الحزم المثبتة.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "تعذّر تغيير مجلد الحزم. افحص مساحة القرص الحرة وأذونات المجلد.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "المستند لا يحتوي على apiVersion، أو أن apiVersion غير مدعوم في هذا الإصدار من OpenJoystickDriver. غيّر المستند إلى apiVersion المدعوم الذي تذكره الرسالة، ثم شغّل الأمر مرة أخرى.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "وصف البروتوكول غير صالح. تحقق من الملف مقابل مخطط protocol-description وأصلح الحقل الذي تذكره الرسالة.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "يذكر وصف البروتوكول عائلة تختلف عن اسم ملفه. سمِّ الملف باسم عائلته.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "يدرج وصف البروتوكول متغيرًا لا توجد في عائلته. استخدم أحد متغيرات العائلة.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.plist is a file name and stays as written. */
"error.E5005.message" = "ملف الوصول AccessGrants.plist تالف. أصلح الملف أو احذفه، ثم امنح الوصول مرة أخرى.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "تعذرت قراءة ملف مفتاح معرّفات الأجهزة PortKeyInstallation.key، أو أن حجمه ليس 32 بايت. استعد الملف من نسخة احتياطية. إذا حذفته بدلاً من ذلك، فسينشئ OpenJoystickDriver مفتاحاً جديداً وسيتغير كل معرّف جهاز.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "سجل وحدة التحكم أو patch غير صالح. تحقق من الملف مقابل مخططه وأصلح الحقل الذي تذكره الرسالة.";
/* Error E5007, in place of a file path when the message does not know which file failed. */
"error.E5007.thisFile" = "ملف السجل هذا";
/* Error E5007, shown when the bundled controller catalog holds no record file. */
"error.E5007.record.catalogEmpty" = "مجلد Controllers في الفهرس المضمّن: لا يحتوي الفهرس على أي ملف سجل. القاعدة: يضم الفهرس سجل وحدة تحكم واحدًا على الأقل. الإصلاح: أعد تثبيت OpenJoystickDriver.";
/* Error E5007, shown when a record file is not named after its own vendorID and productID. %1$@ is the file, %2$@ the name it must have. */
"error.E5007.record.fileName" = "%1$@، vendorID وproductID: يجب أن يكون اسم الملف %2$@، أي المعرّفان بالنظام السداسي عشري. الإصلاح: أعد تسمية الملف إلى %2$@ أو صحّح المعرّفين فيه.";
/* Error E5007, shown when two record files give one controller model. %1$@ is the file, %2$@ the model, %3$@ the file that holds it first. */
"error.E5007.record.duplicateIdentity" = "%1$@، vendorID وproductID: %2$@ هو بالفعل هوية السجل في %3$@. الإصلاح: احذف أحد الملفين أو غيّر المعرّفين في هذا الملف.";
/* Error E5007, shown when a value of a record cannot be written as JSON. %1$@ is the file, %2$@ the reason. */
"error.E5007.record.unwritableValue" = "%1$@، document: تعذّرت كتابة قيمة بصيغة JSON (%2$@). الإصلاح: استبدل القيمة التي يذكرها السبب بنص أو رقم أو قيمة منطقية أو قائمة أو قاموس.";
/* Error E5007, shown when the vendorID or productID of a record is out of range. %1$@ is the file. */
"error.E5007.record.idRange" = "%1$@، vendorID وproductID: يجب أن يكون vendorID بين 1...65535 وproductID بين 0...65535. الإصلاح: اضبط كلًّا منهما على عدد صحيح ضمن نطاقه.";
/* Error E5007, shown when a patch file fails: the file is not a dictionary. %1$@ is the file. */
"error.E5007.patch.patchNotObject" = "%1$@, document: الملف ليس كائن JSON. الإصلاح: اجعل الملف قاموسًا فيه apiVersion وkind وselector وpatch أو remove.";
/* Error E5007, shown when a patch file fails: the file lacks apiVersion, kind, selector, or patch and remove. %1$@ is the file. */
"error.E5007.patch.patchFields" = "%1$@, document: يجب أن يحتوي الملف على apiVersion وkind وselector وpatch أو remove. الإصلاح: أضف العنصر الناقص.";
/* Error E5007, shown when a record or protocol description breaks a rule: HID startup writes are in a raw-USB mode or family. %1$@ is the file. */
"error.E5007.session.hidStartup" = "%1$@, session.startup: عمليات كتابة بدء التشغيل HID تنطبق على وحدات تحكم HID فقط، فلا تنطبق على وضع أو عائلة raw-USB. الإصلاح: احذف عمليات كتابة بدء التشغيل HID أو استخدم حزم raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode names a session keepAlive for a family that declares its own. %2$@ is the family. %1$@ is the file. */
"error.E5007.session.keepAliveFamily" = "%1$@, session.keepAlive: يتطلب keepAlive الجلسة عائلة raw-USB لا يعلن وصفها عن أي منها، بينما تعلن %2$@ عن واحد. الإصلاح: احذف keepAlive الجلسة لأن %2$@ تشغّل keepAlive الخاص بها بالفعل.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names a session key that only raw-USB modes take. %2$@ is the key. %1$@ is the file. */
"error.E5007.session.rawUSBOnly" = "%1$@, session.%2$@: session %2$@ ينطبق على أوضاع raw-USB فقط. الإصلاح: احذف %2$@ من الجلسة أو استخدم بروتوكول raw-USB.";
/* Error E5007, shown when a record or protocol description breaks a rule: raw-USB startup writes are in a mode whose family does not read them or that lists initialization. %1$@ is the file. */
"error.E5007.session.usbStartup" = "%1$@, session.startup: تتطلب عمليات كتابة بدء التشغيل raw-USB عائلة تقرأها ووضعًا بلا قائمة تهيئة. الإصلاح: احذف عمليات كتابة بدء التشغيل raw-USB أو استخدم عائلة تقرأها واحذف قائمة التهيئة.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is not the kind of packet its protocol uses. %1$@ is the file. */
"error.E5007.rumble.templateKind" = "%1$@, session.rumble: قالب الاهتزاز حزمة usb لبروتوكول raw-USB وتقرير HID لبروتوكول HID. الإصلاح: اكتب القالب بنوع الحزمة الذي يستخدمه البروتوكول.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is in a family whose driver does not encode it. %1$@ is the file. */
"error.E5007.rumble.templateDriver" = "%1$@, session.rumble: تتطلب قوالب الاهتزاز برنامج تشغيل يرمّزها. الإصلاح: احذف قالب الاهتزاز أو استخدم عائلة يرمّزه برنامج تشغيلها.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is beside a session keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: لا يمكن الجمع بين resendIntervalMilliseconds للاهتزاز وkeepAlive الجلسة. الإصلاح: احذف resendIntervalMilliseconds أو keepAlive الجلسة.";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble resend interval is in a family that declares its own keepAlive. %1$@ is the file. */
"error.E5007.rumble.resendWithFamilyKeepAlive" = "%1$@, session.rumble.resendIntervalMilliseconds: يتطلب resendIntervalMilliseconds للاهتزاز عائلة لا يعلن وصفها عن keepAlive. الإصلاح: احذف resendIntervalMilliseconds لأن keep-alive العائلة يحدد التوقيت.";
/* Error E5007, shown when a record or protocol description breaks a rule: a record has no mode. %1$@ is the file. */
"error.E5007.modes.empty" = "%1$@, modes: يجب أن يحتوي modes على وضع واحد على الأقل. الإصلاح: أضف وضعًا.";
/* Error E5007, shown when a record or protocol description breaks a rule: more than one mode has the id default. %1$@ is the file. */
"error.E5007.modes.defaultCount" = "%1$@, modes: وضع واحد على الأكثر يحمل المعرّف default. الإصلاح: امنح المعرّف default لوضع واحد فقط.";
/* Error E5007, shown when a record or protocol description breaks a rule: two modes share an id. %1$@ is the file. */
"error.E5007.modes.uniqueIDs" = "%1$@, modes: يجب أن يكون معرّف كل وضع فريدًا. الإصلاح: أعد تسمية الأوضاع التي تكرر معرّفًا.";
/* Error E5007, shown when a record or protocol description breaks a rule: a raw-USB mode names an interface. %1$@ is the file. */
"error.E5007.modes.interfaceRawUSB" = "%1$@, modes[].interface: وضع raw-USB لا يحتوي interface لأنه يحجز الواجهة التي يحددها نقل usb الخاص به. الإصلاح: احذف interface من الوضع.";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names endpoints in its interfaceSignature. %1$@ is the file. */
"error.E5007.modes.endpointsHID" = "%1$@, modes[].match.interfaceSignature.endpoints: لا تحتوي interfaceSignature لوضع HID على endpoints لأن ماسح raw-USB وحده يقرأ مجموعة نقاط النهاية. الإصلاح: احذف endpoints من interfaceSignature.";
