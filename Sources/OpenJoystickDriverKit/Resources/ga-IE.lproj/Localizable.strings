"cli.access.grant.apple_warning" = "Shínigh Apple an clár seo. Má ritheann sé scripteanna, amhail python3 nó osascript, faigheann gach script a ritheann sé an rochtain seo.";
"cli.access.grant.client_or_token" = "Tabhair CLIENT nó --token NAME.";
"cli.access.grant.confirm" = "An ligfidh tú do %@, sínithe %@, an críochphointe a úsáid le %@?";
"cli.access.grant.control_warning" = "Ligeann an scóp control don chlár cnaipí a bhrú ar bhrat cluiche fíorúil, agus caitheann cluichí agus aipeanna iad mar d’ionchur féin.";
"cli.access.grant.discussion" = "Is é CLIENT cosán an chláir nó ID ó «ojd access list». Ainmníonn an deonú síniú an chláir, mar sin fanann sé bailí nuair a nuashonraítear nó a aistrítear an clár. Ní féidir cláir shínithe ad-hoc ná cláir gan síniú a dheonú. Le --token in ionad CLIENT, cruthaítear token a shíníonn cliant dúshlán na seirbhíse leis ina hello, ar an soicéad, ar an WebSocket ó leathanach ag ceann de luachanna --origin nó, i gcás token gan --origin, ar an WebSocket ó chlár nach seolann ceanntásc Origin, amhail app i mbosca gainimh. Ní féidir le leathanach an scóp control a úsáid. Ní thaispeántar an token ach uair amháin. Iarrann sé deimhniú ar dtús.";
"cli.access.grant.origin" = "Bunús gréasáin, mar http://127.0.0.1:8080, a bhfuil cead ag a leathanaigh an token a úsáid ar an WebSocket. Athdhéan é le haghaidh tuilleadh. Tá bunús http://127.0.0.1:PORT ag na leathanaigh overlay a sheirbheálann an WebSocket, leis an gcalafort a thaispeánann «ojd access status».";
"cli.access.grant.origin_control" = "Ní féidir --origin a chomhcheangal leis an scóp control. Ní rialaíonn leathanach gamepad fíorúil riamh; deonaigh control do token gan --origin.";
