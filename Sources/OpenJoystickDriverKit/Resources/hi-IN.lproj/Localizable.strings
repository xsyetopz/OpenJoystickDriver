"error.E3013.message" = "किसी प्रोफ़ाइल का यह पहचानकर्ता नहीं है। प्रोफ़ाइलें “ojd profile list” से सूचीबद्ध करें।";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "सेवा अपना उत्तर एन्कोड नहीं कर सकी। फिर कोशिश करें और समस्या बनी रहे तो रिपोर्ट करें।";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "उत्तर उससे बड़ा है जितना सेवा भेज सकती है। कम डेटा माँगें और फिर कोशिश करें।";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "रीमैपिंग इंजन उपलब्ध नहीं है। थोड़ी देर प्रतीक्षा करें और फिर कोशिश करें, या सेवा को फिर शुरू करें।";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "प्रोफ़ाइल लाइब्रेरी और रीमैपिंग इंजन उपलब्ध नहीं हैं। थोड़ी देर प्रतीक्षा करें और फिर कोशिश करें, या सेवा को फिर शुरू करें।";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "प्रोफ़ाइल लाइब्रेरी उपलब्ध नहीं है। थोड़ी देर प्रतीक्षा करें और फिर कोशिश करें, या सेवा को फिर शुरू करें।";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "रीमैपिंग राउटर बंद हो चुका है। सेवा को फिर शुरू करें और फिर कोशिश करें।";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "सेवा पुष्टि नहीं कर सकी कि अंतिम प्रोफ़ाइल बदलाव सहेजा गया या नहीं। प्रोफ़ाइलें फिर लोड करें और उन्हें दोबारा बदलने से पहले जाँच लें।";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "कोई प्रोफ़ाइल फ़ाइल पढ़ी नहीं जा सकी। जाँचें कि फ़ाइल मौजूद है और सेवा उसे पढ़ सकती है।";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "प्रोफ़ाइलें बदलने से पहले क्षतिग्रस्त प्रोफ़ाइल फ़ाइलों की मरम्मत करनी या उन्हें हटाना होगा। उनकी मरम्मत करें या उन्हें हटाएँ और फिर कोशिश करें।";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "कोई प्रोफ़ाइल फ़ाइल लिखी नहीं जा सकी। डिस्क की खाली जगह और फ़ोल्डर की अनुमतियाँ जाँचें।";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "रीमैपिंग सेवा को एक ऐसी त्रुटि मिली जिसे वह पहचानती नहीं। “ojd diagnose” चलाएँ और उसके आउटपुट के साथ समस्या की रिपोर्ट करें।";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "यह प्रोफ़ाइल कोई आउटपुट नहीं देती। इसमें कोई असाइनमेंट या लाइट का रंग जोड़ें, या --allow-empty के साथ इसे सक्रिय करें।";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "Joy-Con जोड़ी की प्रोफ़ाइल जायरो दूसरे Joy-Con से लेती है। उस कंट्रोलर की गति कैलिब्रेट करें जिसे प्रोफ़ाइल जायरो के लिए चुनती है।";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "इस कंट्रोलर के लिए कोई प्रोफ़ाइल सक्रिय नहीं है, इसलिए वह गति को प्रोसेस नहीं करता। उसके लिए कोई प्रोफ़ाइल सक्रिय करें, लक्षित ऐप को सामने लाएँ और फिर कोशिश करें।";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "अनुरोध चलने के दौरान कंट्रोलर का रीमैपिंग सत्र बदल गया। फिर कोशिश करें।";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "इंस्टॉल किए गए पैकेज से आई प्रोफ़ाइल बदली नहीं जा सकती। प्रोफ़ाइल की प्रतिलिपि बनाएँ और प्रतिलिपि बदलें।";
/* Text of error E3030, returned when an action needs Post Event access and it is not granted. */
"error.E3030.message" = "क्रिया नहीं चली क्योंकि Post Event एक्सेस नहीं दिया गया है। इसे OpenJoystickDriver को दें और फिर कोशिश करें।";
/* Text of error E3031, returned when an action needs Automation access and it is not granted. */
"error.E3031.message" = "क्रिया नहीं चली क्योंकि ऑटोमेशन एक्सेस नहीं दिया गया है। इसे OpenJoystickDriver को दें और फिर कोशिश करें।";
/* Text of error E3032, returned when an action needs to send keys while Secure Input blocks them. */
"error.E3032.message" = "Secure Input चालू होने के कारण क्रिया नहीं चली। इसे चालू करने वाला ऐप, जैसे पासवर्ड फ़ील्ड, बंद करें और फिर से कोशिश करें।";
/* Text of error E3033, returned when a system action fails. The action name and the reason follow it. */
"error.E3033.message" = "क्रिया विफल रही।";
/* Text of error E3034, returned when the system refuses to create the MIDI source of a MIDI action. */
"error.E3034.message" = "MIDI क्रिया नहीं चली क्योंकि सिस्टम ने MIDI स्रोत OpenJoystickDriver बनाने से मना कर दिया। फिर कोशिश करें।";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.plist stays as written. */
"error.E4001.message" = "पैकेज मैनिफ़ेस्ट mod.plist मौजूद नहीं है या अमान्य है। इसे mod-package स्कीमा से जाँचें और कमांड दोबारा चलाएँ।";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "पैकेज को चल रहे संस्करण से अलग OpenJoystickDriver संस्करण चाहिए। ऐसा पैकेज संस्करण इंस्टॉल करें जो इस संस्करण को सपोर्ट करता हो, या OpenJoystickDriver अपडेट करें।";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.plist stays as written. */
"error.E4003.message" = "पैकेज की कोई फ़ाइल अमान्य है, गायब है, या mod.plist में सूचीबद्ध नहीं है। कमांड में बताई गई फ़ाइल ठीक करें और उसे दोबारा चलाएँ।";
/* Text of error E4004, printed when a mod package covers a controller, virtual gamepad or profile that the user's files or another package hold. */
"error.E4004.message" = "पैकेज ऐसे कंट्रोलर, वर्चुअल गेमपैड या प्रोफ़ाइल को कवर करता है जो आपकी अपनी फ़ाइलों या इंस्टॉल किए गए किसी दूसरे पैकेज में पहले से है। टकराने वाली फ़ाइल या पैकेज हटाएँ, या पैकेज बदलें, और कमांड दोबारा चलाएँ।";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "इस नाम का पैकेज पहले से इंस्टॉल है। उसे बदलने के लिए कमांड को --force के साथ चलाएँ।";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "इस नाम का कोई इंस्टॉल किया हुआ पैकेज नहीं है। इंस्टॉल किए गए पैकेज देखने के लिए ojd mod list चलाएँ।";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "पैकेज फ़ोल्डर बदला नहीं जा सका। डिस्क की खाली जगह और फ़ोल्डर की अनुमतियाँ जाँचें।";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "किसी दस्तावेज़ में apiVersion नहीं है, या उसका apiVersion OpenJoystickDriver के इस संस्करण में समर्थित नहीं है। दस्तावेज़ को संदेश में बताए गए समर्थित apiVersion पर बदलें और कमांड फिर से चलाएँ।";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "प्रोटोकॉल विवरण अमान्य है। फ़ाइल को protocol-description स्कीमा से जाँचें और संदेश में बताए गए फ़ील्ड को ठीक करें।";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "प्रोटोकॉल विवरण ऐसा परिवार बताता है जो उसकी फ़ाइल के नाम से अलग है। फ़ाइल का नाम उसके परिवार के नाम पर रखें।";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "प्रोटोकॉल विवरण ऐसा वेरिएंट सूचीबद्ध करता है जो उसके परिवार में नहीं है। परिवार के वेरिएंट में से एक चुनें।";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.plist is a file name and stays as written. */
"error.E5005.message" = "एक्सेस फ़ाइल AccessGrants.plist क्षतिग्रस्त है। फ़ाइल को ठीक करें या हटाएँ, फिर एक्सेस दोबारा दें।";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "यूनिट ID की कुंजी फ़ाइल PortKeyInstallation.key पढ़ी नहीं जा सकती, या वह 32 बाइट की नहीं है। फ़ाइल को बैकअप से वापस लाएँ। अगर आप इसे हटा देते हैं, तो OpenJoystickDriver एक नई कुंजी बनाता है और हर यूनिट ID बदल जाती है।";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "कंट्रोलर रिकॉर्ड या patch अमान्य है। फ़ाइल को उसके स्कीमा से जाँचें और संदेश में बताए गए फ़ील्ड को ठीक करें।";
/* Error E5007, in place of a file path when the message does not know which file failed. */
"error.E5007.thisFile" = "यह रिकॉर्ड फ़ाइल";
/* Error E5007, shown when the bundled controller catalog holds no record file. */
"error.E5007.record.catalogEmpty" = "बंडल कैटलॉग का Controllers फ़ोल्डर: कैटलॉग में कोई रिकॉर्ड फ़ाइल नहीं है। नियम: कैटलॉग में कम से कम एक कंट्रोलर रिकॉर्ड होता है। समाधान: OpenJoystickDriver को फिर से इंस्टॉल करें।";
/* Error E5007, shown when a record file is not named after its own vendorID and productID. %1$@ is the file, %2$@ the name it must have. */
"error.E5007.record.fileName" = "%1$@, vendorID और productID: फ़ाइल का नाम %2$@ होना चाहिए, यानी दोनों ID हेक्स में। समाधान: फ़ाइल का नाम बदलकर %2$@ करें, या उसके भीतर की ID सही करें।";
/* Error E5007, shown when two record files give one controller model. %1$@ is the file, %2$@ the model, %3$@ the file that holds it first. */
"error.E5007.record.duplicateIdentity" = "%1$@, vendorID और productID: %2$@ पहले से %3$@ के रिकॉर्ड की पहचान है। समाधान: दोनों में से एक फ़ाइल हटाएँ, या इस फ़ाइल की ID बदलें।";
/* Error E5007, shown when a value of a record cannot be written as JSON. %1$@ is the file, %2$@ the reason. */
"error.E5007.record.unwritableValue" = "%1$@, document: कोई मान JSON के रूप में नहीं लिखा जा सकता (%2$@)। समाधान: कारण में बताए गए मान को स्ट्रिंग, संख्या, बूलियन, सूची या डिक्शनरी से बदलें।";
/* Error E5007, shown when the vendorID or productID of a record is out of range. %1$@ is the file. */
"error.E5007.record.idRange" = "%1$@, vendorID और productID: vendorID 1...65535 और productID 0...65535 होना चाहिए। समाधान: दोनों को उनकी सीमा के भीतर का पूर्ण संख्या मान दें।";
/* Error E5007, shown when a patch file fails: the file is not a dictionary. %1$@ is the file. */
"error.E5007.patch.patchNotObject" = "%1$@, document: फ़ाइल JSON ऑब्जेक्ट नहीं है। समाधान: फ़ाइल को apiVersion, kind, selector और patch या remove वाली डिक्शनरी बनाएँ।";
/* Error E5007, shown when a patch file fails: the file lacks apiVersion, kind, selector, or patch and remove. %1$@ is the file. */
"error.E5007.patch.patchFields" = "%1$@, document: फ़ाइल में apiVersion, kind, selector और patch या remove होना चाहिए। समाधान: छूटा हुआ सदस्य जोड़ें।";
/* Error E5007, shown when a record or protocol description breaks a rule: HID startup writes are in a raw-USB mode or family. %1$@ is the file. */
"error.E5007.session.hidStartup" = "%1$@, session.startup: HID स्टार्टअप राइट केवल HID कंट्रोलर पर लागू होते हैं, raw-USB मोड या परिवार पर नहीं। समाधान: HID स्टार्टअप राइट हटाएँ, या raw-USB पैकेट इस्तेमाल करें।";
/* Error E5007, shown when a record or protocol description breaks a rule: a mode names a session keepAlive for a family that declares its own. %2$@ is the family. %1$@ is the file. */
"error.E5007.session.keepAliveFamily" = "%1$@, session.keepAlive: सेशन keepAlive के लिए ऐसा raw-USB परिवार चाहिए जिसका विवरण कोई keepAlive घोषित नहीं करता, जबकि %2$@ घोषित करता है। समाधान: सेशन keepAlive हटाएँ, क्योंकि %2$@ पहले से अपना keepAlive चलाता है।";
/* Error E5007, shown when a record or protocol description breaks a rule: a HID mode names a session key that only raw-USB modes take. %2$@ is the key. %1$@ is the file. */
"error.E5007.session.rawUSBOnly" = "%1$@, session.%2$@: session %2$@ केवल raw-USB मोड पर लागू होता है। समाधान: %2$@ को सेशन से हटाएँ, या raw-USB प्रोटोकॉल इस्तेमाल करें।";
/* Error E5007, shown when a record or protocol description breaks a rule: raw-USB startup writes are in a mode whose family does not read them or that lists initialization. %1$@ is the file. */
"error.E5007.session.usbStartup" = "%1$@, session.startup: raw-USB स्टार्टअप राइट के लिए उन्हें पढ़ने वाला परिवार और बिना इनिशियलाइज़ेशन सूची वाला मोड चाहिए। समाधान: raw-USB स्टार्टअप राइट हटाएँ, या उन्हें पढ़ने वाला परिवार इस्तेमाल करें और इनिशियलाइज़ेशन सूची हटाएँ।";
/* Error E5007, shown when a record or protocol description breaks a rule: a rumble template is not the kind of packet its protocol uses. %1$@ is the file. */
