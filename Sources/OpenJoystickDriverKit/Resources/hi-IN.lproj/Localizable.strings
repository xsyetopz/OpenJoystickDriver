"error.E5007.startupWrite.usbTimeout" = "%1$@, session.startup[].timeoutMilliseconds: USB स्टार्टअप टाइमआउट 1...60000 ms होना चाहिए। समाधान: timeoutMilliseconds को 1...60000 रखें, या उसे छोड़ दें।";
