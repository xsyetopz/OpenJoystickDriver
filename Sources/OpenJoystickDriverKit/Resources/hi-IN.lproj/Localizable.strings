"platform.macos.cli.root.group.abstract" = "macOS के गेमपैड ड्राइवर OpenJoystickDriver को कॉन्फ़िगर और जाँचें।";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "यहाँ से शुरू करें:\n  ojd status             सेवा, एक्सटेंशन और अनुमतियाँ जाँचें।\n  ojd diagnose           हर जाँच चलाएँ और गड़बड़ी बताएँ।\n  ojd controller list    जुड़े हुए कंट्रोलर सूचीबद्ध करें।\n\nउदाहरण:\n  # एक कंट्रोलर का इनपुट बदलते ही प्रिंट करें\n  ojd controller watch 045E:028E\n  # जुड़े हुए कंट्रोलर JSON में सूचीबद्ध करें\n  ojd --json controller list\n\nएनवायरनमेंट (फ़्लैग अपने वैरिएबल पर भारी पड़ता है):\n  OJD_NO_INPUT=1         --no-input के समान।\n  OJD_TIMEOUT=SECONDS    --timeout के समान।\n  OJD_COLOR=WHEN         auto, always (टर्मिनल के बाहर भी रंग) या never।\n\nशेल कंप्लीशन:\n  ojd --generate-completion-script zsh|bash|fish\n\nएग्ज़िट कोड:\n  0    सफलता।\n  1    कमांड विफल रही।\n  64   उपयोग त्रुटि।\n  69   सेवा चालू नहीं है। इसे “ojd service start” से शुरू करें।\n  77   macOS की कोई अनुमति नहीं मिली है।\n  127  रिपॉज़िटरी बिल्ड कमांड को इंस्टॉल किए गए ऐप तक नहीं पहुँचा सका।\n  130  बाधित।";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "हर कमांड ग्लोबल विकल्प भी लेती है; “ojd --help” उन्हें सूचीबद्ध करता है।";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT के लिए 0 से अधिक सेकंड की संख्या चाहिए।";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR के लिए auto, always या never चाहिए।";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT के लिए 1, true, yes, 0, false या no चाहिए।";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain “virtual feed” पर लागू नहीं होता, जो JSON लाइनें प्रिंट करता है। --plain हटा दें।";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "उदाहरण:\n  # 10 सेकंड तक इनपुट प्रिंट करें\n  ojd controller watch 045E:028E --duration 10\n  # सबसे पहले दबाया गया कंट्रोल JSON में प्रिंट करें\n  ojd controller watch 045E:028E --first-press --json\n  # हर कंट्रोलर और उसका वर्चुअल गेमपैड जो भेजता है, देखें\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "उदाहरण:\n  # दोनों मुख्य मोटर 0.45 सेकंड तक 180 पर चलाएँ\n  ojd controller rumble 045E:028E\n  # दोनों मुख्य मोटर 2 सेकंड तक पूरी ताकत से चलाएँ\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "उदाहरण:\n  # लाइटबार को नारंगी करें\n  ojd controller light 054C:09CC --color FF8000\n  # रंग और कम ब्राइटनेस सेट करें\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "उदाहरण:\n  # किसी कंट्रोलर मॉडल के लिए प्रोफ़ाइल बनाएँ\n  ojd profile create Racing --controller 045E:028E\n  # इसे केवल तब लागू करें जब Safari सबसे आगे हो\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "उदाहरण:\n  # प्रोफ़ाइल का नाम बदलें\n  ojd profile set Racing name Rally\n  # पहले स्टिक मैपिंग का आंतरिक डेडज़ोन सेट करें\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "उदाहरण:\n  # साउथ बटन दबाए रखने पर Space दबाए रखें\n  ojd binding set Racing button:south key:space\n  # हर प्रेस पर J टॉगल करें\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # दबाए रखने पर J को प्रति सेकंड 10 बार दोहराएँ\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "उदाहरण:\n  # रिकॉर्ड फ़ाइल इंस्टॉल करें\n  ojd record install 045e-028e.plist\n  # रिकॉर्ड stdin से पढ़ें\n  ojd record install - < 045e-028e.plist";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "उदाहरण:\n  # किसी प्रोग्राम को सेवा इस्तेमाल करने दें\n  ojd access grant /Applications/Example.app\n  # एक ऑरिजिन से परोसे गए पेजों के लिए टोकन बनाएँ\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "OpenJoystickDriver सेवा शुरू या बंद करें, या उसके अनुरोध स्वीकार करने तक प्रतीक्षा करें।";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "सेवा चालू है।";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "ऐप को बैकग्राउंड में खोलें और उसकी सेवा के अनुरोध स्वीकार करने तक प्रतीक्षा करें।";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "यह ojd OpenJoystickDriver.app के अंदर नहीं है, इसलिए यह सेवा शुरू नहीं कर सकता। इंस्टॉल किया गया ऐप खोलें, या उसके अंदर का ojd चलाएँ।";
/* Error of 'ojd service start' when macOS cannot open the app. %@ is the path of the app. Finder is the macOS file manager. */
"platform.macos.cli.service.start.openFailed" = "macOS %@ को नहीं खोल सका। कारण देखने के लिए इसे Finder से खोलें।";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "सेवा बंद करें और उसके समाप्त होने तक प्रतीक्षा करें। कनेक्ट किए गए कंट्रोलर macOS को लौट जाते हैं।";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "सेवा बंद नहीं की जा सकी: %@। OpenJoystickDriver को उसके मेनू से बंद करें।";
/* Error of 'ojd service stop' when the service keeps running. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.service.stop.timeout" = "सेवा %@ में बंद नहीं हुई। बड़े --timeout के साथ फिर से प्रयास करें।";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "सेवा बंद है।";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "सेवा के अनुरोध स्वीकार करने तक प्रतीक्षा करें। --timeout प्रतीक्षा की सीमा तय करता है (डिफ़ॉल्ट 5 सेकंड)।";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "सेवा ने %@ में अनुरोध स्वीकार नहीं किए। इसे “ojd service start” से शुरू करें, या बड़े --timeout के साथ फिर से प्रयास करें।";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "सेवा, एक्सटेंशन, अनुमतियाँ और कनेक्ट किए गए कंट्रोलर दिखाएँ।";
/* Long description in the help of 'ojd status'. It says that the command also works while the service is stopped. The exit status 0 stays as written. */
"cli.status.group.discussion" = "सेवा बंद होने पर भी काम करता है: यह सेवा को बंद बताता है और 0 के साथ बाहर निकलता है।";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "ऐक्सेसिबिलिटी";
/* Row label in the output of 'ojd status'. The version of this command line tool follows. */
"cli.status.group.labelCommandLineTool" = "कमांड-लाइन टूल";
/* Heading in the output of 'ojd status' above the list of connected controllers. %lld is the number of controllers. */
"cli.status.group.labelControllers" = "कंट्रोलर (%lld)";
/* Row label in the output of 'ojd status'. The state of the driver extension follows. */
"cli.status.group.labelTransportExtension" = "एक्सटेंशन";
/* Row label in the output of 'ojd status' for the Input Monitoring permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputRead" = "इनपुट मॉनिटरिंग";
/* Row label in the output of 'ojd status'. The reason why the stored profile overrides could not be read follows. */
"cli.status.group.labelOverrideError" = "ओवरराइड त्रुटि";
/* Heading in the output of 'ojd status' above the list of controllers that macOS handles natively. %lld is the number of controllers. */
"platform.macos.cli.status.group.labelPassThrough" = "macOS द्वारा संभाले जा रहे (%lld)";
/* Row label in the output of 'ojd status'. The state and version of the service follow. */
"cli.status.group.labelService" = "सेवा";
/* Heading in the output of 'ojd status' above the list of connected devices that the driver does not support. %lld is the number of devices. */
"cli.status.group.labelUnbound" = "असमर्थित डिवाइस (%lld)";
/* Row label in the output of 'ojd status'. The state of the virtual gamepad follows. */
"cli.status.group.labelVirtualDevice" = "वर्चुअल गेमपैड";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is turned off. */
"cli.status.group.virtualOff" = "बंद";
/* Value of the 'Virtual gamepad' row of 'ojd status' when the virtual gamepad reports an error. %@ is the error message of the system. */
"cli.status.group.virtualError" = "त्रुटि: %@";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on and no connected controller has a virtual gamepad. */
"cli.status.group.virtualNonePublished" = "चालू, कोई कंट्रोलर प्रकाशित नहीं";
/* Value of the 'Virtual gamepad' row of 'ojd status' when virtual output is on. %@ is the comma-separated list of the names of the controllers that a virtual gamepad stands for. */
"cli.status.group.virtualPublished" = "चालू, %@ प्रकाशित कर रहा है";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "सेवा चलने पर कंट्रोलर और अनुमतियाँ दिखती हैं: “ojd service start”।";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "एंडपॉइंट चालू करें और चुनें कि कौन-से प्रोग्राम इसके ज़रिए कंट्रोलर पढ़ सकते हैं।";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "प्रोग्राम का पथ, या क्लाइंट ID।";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "%@ पर कोई प्रोग्राम नहीं है और उस ID वाला कोई क्लाइंट भी नहीं है। ID देखने के लिए “ojd access list” चलाएँ।";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ में कोई हस्ताक्षरित प्रोग्राम नहीं है। प्रोग्राम के ऐप बंडल या निष्पादन योग्य फ़ाइल को अनुमति दें।";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "एंडपॉइंट बंद करें और उसके कनेक्शन बंद करें; दी गई अनुमतियाँ बनी रहती हैं।";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "एंडपॉइंट बंद है, और उसके कनेक्शन बंद कर दिए गए हैं।";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "एंडपॉइंट एक स्थानीय सॉकेट है, जिससे अनुमति पाए प्रोग्राम कंट्रोलर इवेंट पढ़ते हैं। यह तब तक बंद रहता है जब तक आप “ojd access enable” नहीं चलाते, और सेवा केवल उन्हीं प्रोग्राम को जवाब देती है जिनके हस्ताक्षर को आपने अनुमति दी है, या जो ऐसा टोकन भेजते हैं जिसे आपने अनुमति दी है। “ojd access web enable” ओवरले पेजों के लिए 127.0.0.1 पर एक WebSocket जोड़ता है।";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "एंडपॉइंट चालू करें।";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "क्या एंडपॉइंट चालू करना है, ताकि आपके द्वारा अनुमति दिए गए प्रोग्राम हर कंट्रोलर का इनपुट पढ़ सकें?";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "पहले पुष्टि माँगता है। केवल अनुमति पाए प्रोग्राम ही एंडपॉइंट का उपयोग कर सकते हैं; उन्हें “ojd access grant” से जोड़ें।";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "एंडपॉइंट %@ पर सुनता है।";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "किसी हस्ताक्षरित प्रोग्राम या नए टोकन को एंडपॉइंट का उपयोग करने दें।";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ ad-hoc हस्ताक्षरित है या हस्ताक्षरित नहीं है, इसलिए कोई भी स्थानीय प्रोग्राम उसके हस्ताक्षर का दावा कर सकता है। उसे Developer ID या Apple Development प्रमाणपत्र से हस्ताक्षरित करें, फिर अनुमति दें।";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "इस प्रोग्राम पर Apple ने हस्ताक्षर किए हैं। अगर यह python3 या osascript जैसी स्क्रिप्ट चलाता है, तो यह जो भी स्क्रिप्ट चलाता है उसे यह पहुँच मिल जाती है।";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "या तो CLIENT दें या --token NAME।";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "क्या %1$@ को, जिस पर %2$@ के रूप में हस्ताक्षर हैं, %3$@ के साथ एंडपॉइंट का उपयोग करने देना है?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
