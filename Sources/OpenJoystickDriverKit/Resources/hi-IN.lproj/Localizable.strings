"error.E5007.inputLayout.bigEndian" = "%1$@, input.layouts[]: BigEndian फ़ील्ड बाइट सीमा से शुरू होता है और 16, 24 या 32 बिट का होता है। समाधान: 8 के गुणज से शुरू करें और bitSize 16, 24 या 32 रखें, या LittleEndian इस्तेमाल करें।";
/* Error E5007, shown when an input layout of a record fails: a button names a control that is not a button. %1$@ is the file. */
"error.E5007.inputLayout.buttonControl" = "%1$@, input.layouts[].buttons: बटन एक डिजिटल कंट्रोल का नाम देता है, D-pad या स्टिक अक्ष का नहीं। समाधान: किसी बटन कंट्रोल का नाम दें, या प्रविष्टि को axes या hat में ले जाएँ।";
/* Error E5007, shown when an input layout of a record fails: axes repeat a control or name a control that is not a stick axis. %1$@ is the file. */
"error.E5007.inputLayout.axesDistinct" = "%1$@, input.layouts[].axes: axes में अलग-अलग स्टिक अक्षों के नाम होने चाहिए। समाधान: हर स्टिक अक्ष का नाम एक बार दें।";
/* Error E5007, shown when an input layout of a record fails: an axis has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.axisRange" = "%1$@, input.layouts[].axes: अक्ष में min, अपने आकार की सीमा के भीतर max से कम होता है। समाधान: min को max से कम रखें, दोनों bitSize की सीमा में।";
/* Error E5007, shown when an input layout of a record fails: a trigger value has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.triggerRange" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: ट्रिगर मान में min, अपने आकार की सीमा के भीतर max से कम होता है। समाधान: min को max से कम रखें, दोनों bitSize की सीमा में।";
/* Error E5007, shown when an input layout of a record fails: a symmetric axis is not signed around zero. %1$@ is the file. */
"error.E5007.inputLayout.axisSymmetric" = "%1$@, input.layouts[].axes: सममित अक्ष चिह्नित होता है, जिसमें min 0 से नीचे और max 0 से ऊपर होता है। समाधान: signed को true करें, min को 0 से नीचे और max को 0 से ऊपर रखें, या symmetric बंद करें।";
/* Error E5007, shown when an input layout of a record fails: a trigger has neither an analog value nor a button. %1$@ is the file. */
"error.E5007.inputLayout.triggerSources" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: ट्रिगर एनालॉग मान, बटन या दोनों का नाम देता है। समाधान: ट्रिगर को एनालॉग मान या बटन दें।";
/* Error E5007, shown when an input layout of a record fails: a layout decodes no control. %1$@ is the file. */
"error.E5007.inputLayout.noControls" = "%1$@, input.layouts[]: लेआउट को कम से कम एक कंट्रोल डिकोड करना चाहिए। समाधान: कोई बटन, अक्ष, hat या ट्रिगर जोड़ें।";
/* Error E5007, shown when the HID usage map of a record fails: a usage map lists no usage. %1$@ is the file. */
"error.E5007.usageMap.mapEmpty" = "%1$@, input.hidUsageMap.usages: यूसेज मैप में कम से कम एक यूसेज सूचीबद्ध होना चाहिए। समाधान: एक यूसेज जोड़ें या hidUsageMap हटा दें।";
