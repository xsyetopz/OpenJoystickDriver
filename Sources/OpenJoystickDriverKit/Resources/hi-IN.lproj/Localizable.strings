/* Error E5007, shown when a startup write of a record fails: a USB startup endpoint is outside 1...127. %1$@ is the file. */
"error.E5007.startupWrite.usbEndpoint" = "%1$@, session.startup[].endpoint: USB स्टार्टअप एंडपॉइंट 1...127 होना चाहिए। समाधान: endpoint को 1...127 रखें, या उसे छोड़ दें।";
