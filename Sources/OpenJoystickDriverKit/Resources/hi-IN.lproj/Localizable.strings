"error.E5007.startupWrite.delay" = "%1$@, session.startup[].delayMilliseconds: स्टार्टअप विलंब 0...1000 ms होना चाहिए। समाधान: delayMilliseconds को 0...1000 रखें, या उसे छोड़ दें।";
