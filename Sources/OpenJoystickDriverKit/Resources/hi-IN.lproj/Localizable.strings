"error.E5007.startupWrite.bytesCount" = "%1$@, session.startup[].bytes: स्टार्टअप राइट में %2$@ बाइट सूचीबद्ध होने चाहिए, यानी रिपोर्ट ID के बाद का हर बाइट। समाधान: bytes में ठीक %2$@ बाइट रखें।";
