"error.E5007.usageMap.threshold" = "%1$@, input.hidUsageMap.usages[].threshold: यूसेज %2$@ की threshold 0 से ऊपर और 1 से नीचे होनी चाहिए। समाधान: threshold को 0 से ऊपर और 1 से नीचे रखें।";
/* Error E5007, shown when a startup write of a record fails: a startup write names an input report. %1$@ is the file. */
"error.E5007.startupWrite.reportKind" = "%1$@, session.startup[].report: स्टार्टअप राइट इनपुट रिपोर्ट नहीं भेज सकता। समाधान: report को आउटपुट या फ़ीचर रिपोर्ट पर रखें।";
