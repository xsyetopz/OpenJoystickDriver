"error.E5007.startupWrite.reportLength" = "%1$@, session.startup[].report: स्टार्टअप रिपोर्ट 2...128 बाइट लंबी होनी चाहिए। समाधान: रिपोर्ट की लंबाई 2...128 बाइट रखें।";
