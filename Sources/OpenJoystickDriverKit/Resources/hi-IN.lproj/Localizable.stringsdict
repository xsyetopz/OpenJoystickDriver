<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Summary of how many controllers are connected, shown in the menu bar menu and in the main window summary. %d is the number of connected controllers. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d कंट्रोलर कनेक्ट है</string>
			<key>zero</key>
			<string>%d कंट्रोलर कनेक्ट हैं</string>
			<key>two</key>
			<string>%d कंट्रोलर कनेक्ट हैं</string>
			<key>few</key>
			<string>%d कंट्रोलर कनेक्ट हैं</string>
			<key>many</key>
			<string>%d कंट्रोलर कनेक्ट हैं</string>
			<key>other</key>
			<string>%d कंट्रोलर कनेक्ट हैं</string>
		</dict>
	</dict>
	<!-- Number of assignments (controller inputs mapped to actions) that a profile holds, shown in the profile list, the profile detail and the profile editor. %d is the number of assignments. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>ui.profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d असाइनमेंट</string>
			<key>zero</key>
			<string>%d असाइनमेंट</string>
			<key>two</key>
			<string>%d असाइनमेंट</string>
			<key>few</key>
			<string>%d असाइनमेंट</string>
			<key>many</key>
			<string>%d असाइनमेंट</string>
			<key>other</key>
			<string>%d असाइनमेंट</string>
		</dict>
	</dict>
	<!-- Summary in the support diagnostics of how many virtual gamepads OpenJoystickDriver publishes. %d is that number; the zero form says that none were detected. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>ui.debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>कोई कंट्रोलर आउटपुट डिवाइस नहीं मिला</string>
			<key>one</key>
			<string>%d कंट्रोलर आउटपुट डिवाइस पहचाना गया</string>
			<key>two</key>
			<string>%d कंट्रोलर आउटपुट डिवाइस पहचाने गए</string>
			<key>few</key>
			<string>%d कंट्रोलर आउटपुट डिवाइस पहचाने गए</string>
			<key>many</key>
			<string>%d कंट्रोलर आउटपुट डिवाइस पहचाने गए</string>
			<key>other</key>
			<string>%d कंट्रोलर आउटपुट डिवाइस पहचाने गए</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a controller selector matches more than one controller, and of the automation service when a request names such a selector; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching controllers. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>cli.controller.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>“%1$@” %2$lld कंट्रोलर से मेल खाता है। इनमें से कोई ID इस्तेमाल करें:</string>
			<key>other</key>
			<string>“%1$@” %2$lld कंट्रोलर से मेल खाता है। इनमें से कोई ID इस्तेमाल करें:</string>
		</dict>
	</dict>
	<!-- Error line of ojd when a profile name or ID matches more than one profile; the matching IDs follow on the next lines. %1$@ is the selector text that was given, %2$lld is the number of matching profiles. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>cli.profile.group.selectorAmbiguous</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>“%1$@” %2$lld प्रोफ़ाइल का नाम है। इनमें से कोई एक ID उपयोग करें:</string>
			<key>other</key>
			<string>“%1$@” %2$lld प्रोफ़ाइल का नाम है। इनमें से कोई एक ID उपयोग करें:</string>
		</dict>
	</dict>
	<!-- Validation error of ojd diagnose when the soak run with the given interval would take too many samples. %lld is the number of samples the run would take. The option names soak and interval-ms are written with two leading hyphens and stay as written. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.sampleLimit</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>इस --interval-ms के साथ --soak में %lld नमूना लगेगा; --interval-ms बढ़ाएँ।</string>
			<key>other</key>
			<string>इस --interval-ms के साथ --soak में %lld नमूने लगेंगे; --interval-ms बढ़ाएँ।</string>
		</dict>
	</dict>
	<!-- Error of the runtime sampling in ojd diagnose and in the app when the duration and sample interval would take too many samples. %lld is the number of samples. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>cli.diagnose.group.soakErrorTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>नमूना लेने में %lld नमूना लगेगा। नमूना अंतराल बढ़ाएँ।</string>
			<key>other</key>
			<string>नमूना लेने में %lld नमूने लगेंगे। नमूना अंतराल बढ़ाएँ।</string>
		</dict>
	</dict>
	<!-- Error in the soak test of the Developer settings when the chosen duration and sample interval would take too many samples. %lld is the number of samples. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.soakTooManySamples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>इस परीक्षण में %lld नमूना लगेगा। नमूना अंतराल बढ़ाएँ।</string>
			<key>other</key>
			<string>इस परीक्षण में %lld नमूने लगेंगे। नमूना अंतराल बढ़ाएँ।</string>
		</dict>
	</dict>
	<!-- Success line of ojd record test and of the test result in the Library when a controller record parses a packet capture to the expected state. %1$@ is the controller model, %2$lld is the number of input reports that were replayed. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.matched</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ अपेक्षित स्थिति से मेल खाता है: %2$lld इनपुट रिपोर्ट दोबारा चलाई गई।</string>
			<key>other</key>
			<string>%1$@ अपेक्षित स्थिति से मेल खाता है: %2$lld इनपुट रिपोर्ट दोबारा चलाई गईं।</string>
		</dict>
	</dict>
	<!-- Failure line of ojd record test and of the test result in the Library when the parsed state differs from the expected state. %1$@ is the controller model, %2$@ is the file with the expected state, %3$lld is the number of fields that differ. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>cli.record.test.mismatch</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ के पार्सर ने जो स्थिति बनाई, वह %2$@ से %3$lld फ़ील्ड में अलग है।</string>
			<key>other</key>
			<string>%1$@ के पार्सर ने जो स्थिति बनाई, वह %2$@ से %3$lld फ़ील्ड में अलग है।</string>
		</dict>
	</dict>
	<!-- Note in the packet capture of the Developer settings that idle packets are left out of the list. %lld is the number of hidden idle packets; Export still includes them. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.hiddenIdlePackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld निष्क्रिय पैकेट छिपाया गया (एक्सपोर्ट में अब भी शामिल)।</string>
			<key>other</key>
			<string>%lld निष्क्रिय पैकेट छिपाए गए (एक्सपोर्ट में अब भी शामिल)।</string>
		</dict>
	</dict>
	<!-- Status of the packet capture in the Developer settings after capture stopped. %lld is the number of packets that were captured. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>ui.developer.stoppedPackets</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>रुका · %lld पैकेट</string>
			<key>other</key>
			<string>रुका · %lld पैकेट</string>
		</dict>
	</dict>
	<!-- Choice of the idle disconnect picker in the General pane of the settings window. %d is a number of minutes, such as 15. -->
	<key>ui.settings.general.idleDisconnectMinutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d मिनट</string>
			<key>one</key>
			<string>%d मिनट</string>
			<key>two</key>
			<string>%d मिनट</string>
			<key>few</key>
			<string>%d मिनट</string>
			<key>many</key>
			<string>%d मिनट</string>
			<key>other</key>
			<string>%d मिनट</string>
		</dict>
	</dict>
	<!-- Row of the Simple interface in the controller detail and the profile editor: how many advanced settings that Simple hides hold a value other than their default. %d is the number of changed advanced settings. The Hindi plural forms are a first draft that a native speaker reviews. -->
	<key>ui.interface.hiddenChanges</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d उन्नत सेटिंग बदली गई हैं</string>
			<key>one</key>
			<string>%d उन्नत सेटिंग बदली गई है</string>
			<key>two</key>
			<string>%d उन्नत सेटिंग बदली गई हैं</string>
			<key>few</key>
			<string>%d उन्नत सेटिंग बदली गई हैं</string>
			<key>many</key>
			<string>%d उन्नत सेटिंग बदली गई हैं</string>
			<key>other</key>
			<string>%d उन्नत सेटिंग बदली गई हैं</string>
		</dict>
	</dict>
</dict>
</plist>
