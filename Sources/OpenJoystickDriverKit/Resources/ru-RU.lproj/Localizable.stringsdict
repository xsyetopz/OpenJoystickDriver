<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d контроллер подключён</string>
			<key>zero</key>
			<string>%d контроллеров подключено</string>
			<key>two</key>
			<string>%d контроллера подключено</string>
			<key>few</key>
			<string>%d контроллера подключено</string>
			<key>many</key>
			<string>%d контроллеров подключено</string>
			<key>other</key>
			<string>%d контроллера подключено</string>
		</dict>
	</dict>
	<key>status.activeProfilesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d активный профиль</string>
			<key>zero</key>
			<string>%d активных профилей</string>
			<key>two</key>
			<string>%d активных профиля</string>
			<key>few</key>
			<string>%d активных профиля</string>
			<key>many</key>
			<string>%d активных профилей</string>
			<key>other</key>
			<string>%d активного профиля</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d назначение</string>
			<key>zero</key>
			<string>%d назначений</string>
			<key>two</key>
			<string>%d назначения</string>
			<key>few</key>
			<string>%d назначения</string>
			<key>many</key>
			<string>%d назначений</string>
			<key>other</key>
			<string>%d назначения</string>
		</dict>
	</dict>
	<key>debug.devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Ничего не обнаружено</string>
			<key>one</key>
			<string>Обнаружено: %d</string>
			<key>two</key>
			<string>Обнаружено: %d</string>
			<key>few</key>
			<string>Обнаружено: %d</string>
			<key>many</key>
			<string>Обнаружено: %d</string>
			<key>other</key>
			<string>Обнаружено: %d</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>Устройства вывода контроллера не обнаружены</string>
			<key>one</key>
			<string>Обнаружено %d устройство вывода контроллера</string>
			<key>two</key>
			<string>Обнаружено %d устройства вывода контроллера</string>
			<key>few</key>
			<string>Обнаружено %d устройства вывода контроллера</string>
			<key>many</key>
			<string>Обнаружено %d устройств вывода контроллера</string>
			<key>other</key>
			<string>Обнаружено %d устройства вывода контроллера</string>
		</dict>
	</dict>
</dict>
</plist>
