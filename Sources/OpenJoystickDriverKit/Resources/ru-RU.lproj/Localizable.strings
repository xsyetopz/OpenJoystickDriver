"cli.controller.group.serverDryRun" = "Было бы задано: %1$@ = %2$@ в %3$@.";
/* Error when the record file of a controller cannot be changed. %1$@ is the path of the record file and %2$@ is the description of the problem. */
"cli.controller.group.serverInvalid" = "Не удалось изменить %1$@: %2$@";
