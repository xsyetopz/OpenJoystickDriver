"cli.access.web.abstract" = "Включает или выключает WebSocket для страниц оверлеев.";
/* One-line summary of 'ojd access web disable' in the command list and at the top of its help. */
"cli.access.web.disableAbstract" = "Выключает WebSocket и закрывает его соединения; токены сохраняются.";
