/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "Настройка и проверка OpenJoystickDriver, драйвера геймпадов для macOS.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "С чего начать:\n  ojd status             Проверить службу, расширение и разрешения.\n  ojd diagnose           Выполнить все проверки и показать, что не так.\n  ojd controller list    Показать подключённые контроллеры.\n\nПримеры:\n  # Выводить ввод одного контроллера по мере изменения\n  ojd controller watch 045E:028E\n  # Показать подключённые контроллеры в JSON\n  ojd --json controller list\n\nОкружение (параметр сильнее переменной):\n  OJD_NO_INPUT=1         То же, что --no-input.\n  OJD_TIMEOUT=SECONDS    То же, что --timeout.\n  OJD_COLOR=WHEN         auto, always (цвет и вне терминала) или never.\n\nАвтодополнение оболочки:\n  ojd --generate-completion-script zsh|bash|fish\n\nКоды завершения:\n  0    Успешно.\n  1    Команда завершилась с ошибкой.\n  64   Ошибка использования.\n  69   Служба не запущена. Запустите её командой «ojd service start».\n  77   Отсутствует разрешение macOS.\n  127  Сборка из репозитория не смогла передать команду приложению.\n  130  Прервано.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Каждая команда также принимает глобальные параметры; их перечисляет «ojd --help».";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT требует число секунд больше 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR требует auto, always или never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT требует 1, true, yes, 0, false или no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain не применяется к «virtual feed», которая выводит строки JSON. Уберите --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Примеры:\n  # Выводить ввод 10 секунд\n  ojd controller watch 045E:028E --duration 10\n  # Вывести первый нажатый элемент управления в JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Следить за всеми контроллерами и тем, что отправляет их виртуальный геймпад\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Примеры:\n  # Включить оба основных мотора на 180 на 0,45 секунды\n  ojd controller rumble 045E:028E\n  # Включить оба основных мотора на полную мощность на 2 секунды\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Примеры:\n  # Задать оранжевый цвет световой панели\n  ojd controller light 054C:09CC --color FF8000\n  # Задать цвет и низкую яркость\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Примеры:\n  # Создать профиль для модели контроллера\n  ojd profile create Racing --controller 045E:028E\n  # Применять его, только пока Safari на переднем плане\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Примеры:\n  # Переименовать профиль\n  ojd profile set Racing name Rally\n  # Задать внутреннюю мёртвую зону первого сопоставления стика\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Примеры:\n  # Удерживать пробел, пока удерживается южная кнопка\n  ojd binding set Racing button:south key:space\n  # Переключать J при каждом нажатии\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Повторять J 10 раз в секунду, пока кнопка удерживается\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
