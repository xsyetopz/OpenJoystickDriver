"cli.record.test.discussion" = "Воспроизводит принятые пакеты захвата через парсер записи, затем сравнивает состояние контроллера после последнего отчёта о вводе с ожидаемым состоянием. Захват — это строки JSON команды «ojd controller capture --json». Ожидаемое состояние — один объект JSON в форме строки команды «ojd controller watch --json». Команда перечисляет каждое отличающееся поле и завершается с кодом 1, если такие есть. Она сравнивает все поля, кроме connection, которое задаёт работающая служба. Работающая служба не нужна.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "Ожидаемое состояние контроллера в виде файла JSON.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ не является состоянием контроллера: %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "Ни один отчёт в %1$@ не содержал ввода для %2$@. Повторите захват, нажимая элементы управления.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "У семейства %@ нет парсера, работающего без контроллера.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "Захват пакетов в виде строк JSON команды «ojd controller capture --json».";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "Парсер %1$@ отклонил принятый пакет %2$lld из %3$@.";
/* Text of error E2022, printed when the controller state that a record parser produces from a capture differs from the expected state. */
"error.E2022.message" = "Состояние, которое парсер записи получил из записанных отчётов, отличается от ожидаемого. Прочитайте поля, которые перечисляет команда.";
/* Text of error E2023, printed when a controller cannot be claimed or released because its protocol family uses raw USB or the system does not serve it natively. The settings window shows it too. */
"error.E2023.message" = "Этот контроллер нельзя ни забрать, ни вернуть: его семейство протоколов использует USB напрямую, или система не поддерживает его нативно. Причина указана в сообщении.";
/* Text of error E2024, printed when no endpoint client or token has the given ID. ojd access is the command that lists the IDs and stays as written. */
"error.E2024.message" = "Нет клиента или токена конечной точки с этим ID. Выполните ojd access, чтобы вывести список ID, и используйте один из них.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "Клиенту с таким видом подписи нельзя предоставить доступ, потому что любая локальная программа может выдать себя за него.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Выберите хотя бы одну область для предоставления.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "Служба останавливается. Запустите её и повторите попытку.";
/* Text of error E2028, printed when a token with the chosen name exists. */
"error.E2028.message" = "Токен с таким именем уже существует. Сначала отзовите его или выберите другое имя.";
/* Text of error E2029, printed when a token name has characters that are not allowed. The limit of 64 characters is fixed. */
"error.E2029.message" = "Это не имя токена. Используйте от 1 до 64 букв, цифр, точек, дефисов или знаков подчёркивания.";
/* Text of error E2030, printed when a web origin is not valid. scheme://host[:port], http, https and the example in backticks stay as written. */
"error.E2030.message" = "Это не веб-источник. Используйте scheme://host[:port] с http или https, например `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Этот порт на 127.0.0.1 занят или не может быть открыт. Выберите другой с помощью --port.";
/* Text of error E2032, printed when the control scope is granted to a token that has origins. */
"error.E2032.message" = "Токен с источниками не может иметь область control, потому что страница не должна управлять виртуальным геймпадом. Предоставьте control токену без источников.";
/* Text of error E2033, printed when 'ojd virtual launch' cannot start the program. */
"error.E2033.message" = "Не удалось запустить программу. Проверьте, что путь указывает на исполняемый файл или приложение и что у вас есть право его запускать.";
/* Error E2034, shown in the app or the CLI when the service no longer accepts requests. */
"error.E2034.message" = "Служба перестала принимать запросы. Закройте OpenJoystickDriver, откройте его снова и повторите попытку.";
/* Error E2035, shown in the app or the CLI when the file that records why the request listener stopped is unusable. */
"error.E2035.message" = "Файл, в котором записано, почему остановился приём запросов, использовать нельзя. Удалите файл и снова откройте OpenJoystickDriver.";
/* Error E2036, shown by ojd and the app when no OpenJoystickDriver app took the test notification or reported on it before the deadline. */
"error.E2036.message" = "Ни одно приложение OpenJoystickDriver не ответило на тестовое уведомление вовремя. Убедитесь, что приложение запущено, и повторите попытку.";
/* Error E2037, shown by ojd and the app when notifications are not allowed for the app, so the test notification could not be shown. */
"error.E2037.message" = "Уведомления для OpenJoystickDriver не разрешены. Разрешите их в настройках уведомлений системы и повторите попытку.";
/* Error E2038, shown by ojd and the app when the selected controller has no speaker to play sound on. */
"error.E2038.message" = "У контроллера нет динамика. Выберите контроллер, который может воспроизводить звук, и повторите попытку.";
/* Error E2039, shown by ojd when the audio file given to the speaker command is not an uncompressed PCM WAV file. */
"error.E2039.message" = "Аудиофайл не поддерживается. Используйте несжатый файл PCM WAV и повторите попытку.";
/* Error E2040, shown by ojd and the app when the extension plugged into the controller did not answer its setup. */
"error.E2040.message" = "Расширение контроллера не ответило на настройку. Подключите расширение заново и повторите попытку.";
/* Note about a controller record whose raw USB family the USB extension cannot claim because Apple signs its product list. OJD is the short product name. */
"platform.macos.cli.record.group.usbNotClaimed" = "Семейство использует необработанный USB, а расширение USB не может захватить этот контроллер, потому что его список продуктов подписан Apple. OJD получает к нему доступ только напрямую через USB, если macOS это разрешает.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "Только USB: добавьте bluetoothLE.vibrationCharacteristic в эту запись Switch 2, чтобы подключать контроллер по Bluetooth LE.";
/* One-line summary of 'ojd record validate' in the command list and at the top of its help. */
"cli.record.validate.abstract" = "Проверяет запись контроллера без установки.";
/* Long description in the help of 'ojd record validate'. It lists what the check covers and says that the exit status is 1 for an invalid record. The USB extension is the driver extension that gives raw USB access; the exit status 1 stays as written. */
"cli.record.validate.discussion" = "Проверяет структуру записи, согласованность её полей и соответствие встроенному каталогу, а также сообщает, нужно ли контроллеру расширение USB. Завершается с кодом 1, если запись недопустима.";
/* Message printed by 'ojd record validate' for a correct record. %1$@ is the file path, %2$@ is the operation in kebab case such as install, %3$@ is the controller model and %4$@ is the protocol family. The command in quotes stays as written. */
"cli.record.validate.valid" = "%1$@ — допустимая запись %2$@ для %3$@ (%4$@). Установите её командой «ojd record install».";
/* Heading in the output of 'ojd status' above the defaults file that the driver ignores. */
"cli.status.group.labelIgnoredDefaults" = "Проигнорированный файл значений по умолчанию";
/* Heading in the output of 'ojd status' above the list of skipped virtual gamepad files. %lld is the number of entries. */
"cli.status.group.labelSkippedVirtualDevices" = "Пропущенные файлы виртуальных геймпадов (%lld)";
/* Reason beside a folder named Personas in 'ojd status' and 'ojd diagnose': the folder is not read, because virtual gamepad files live in VirtualDevices. %@ is the path of the VirtualDevices folder. OpenJoystickDriver is the product name. */
"status.virtualDeviceFolderNotRead" = "OpenJoystickDriver не читает эту папку. Переместите её файлы в %@, затем удалите папку.";
/* Heading in the output of 'ojd status' above the list of skipped controller records. %lld is the number of records. */
"cli.status.group.labelSkippedRecords" = "Пропущенные записи контроллеров (%lld)";
/* One-line summary of 'ojd binding' in the command list and at the top of its help. */
"cli.binding.group.abstract" = "Показывает, задаёт и очищает привязки профиля.";
/* Error of 'ojd binding set' when the JSON of --actions-json cannot be read. %@ is the description of the parse problem. --actions-json stays as written. */
"cli.binding.group.actionsInvalid" = "--actions-json не является допустимым списком действий: %@";
/* Error of 'ojd binding set' when the JSON of --actions-json exceeds the size limit. --actions-json stays as written. */
"cli.binding.group.actionsTooLarge" = "--actions-json слишком велик.";
/* Error of 'ojd binding set' when the value of --long-hold does not have the form MS:TARGET. %@ is the option name. MS:TARGET and the example stay as written. */
"cli.binding.group.alternateFormat" = "%@ принимает MS:TARGET, например 500:key:key-b.";
/* Error of 'ojd binding set' when an axis option is used with a source that is not an axis. The option names stay as written. */
"cli.binding.group.axisOptionsSource" = "--deadzone, --gain, --invert, --response-curve и --digital-threshold требуют, чтобы источником была ось.";
/* One-line summary of 'ojd binding clear' in the command list and at the top of its help. */
"cli.binding.clear.abstract" = "Удаляет привязки указанных источников или все привязки.";
/* Help text of the --all flag of 'ojd binding clear'. */
"cli.binding.clear.all" = "Удалить все привязки, аккорды, последовательности и слои.";
/* Warning of 'ojd binding clear' when removing the bindings leaves an active profile without any binding, so its controller sends no input. %@ is the profile name. The two commands in quotes stay as written. */
"cli.binding.clear.blocksInput" = "Профиль «%@» активен на подключённом контроллере и теперь блокирует весь его ввод. Добавьте привязку с помощью «ojd binding set» или остановите профиль с помощью «ojd profile deactivate».";
/* Yes or no question that 'ojd binding clear --all' asks on a terminal. %@ is the profile name. */
"cli.binding.clear.confirm" = "Удалить все привязки, аккорды, последовательности и слои из профиля «%@»?";
/* Long description in the help of 'ojd binding clear'. --all and --force stay as written. */
"cli.binding.clear.discussion" = "--all также удаляет аккорды, последовательности и слои профиля и запрашивает подтверждение в терминале; без терминала нужен --force. Настройки стиков, триггеров, касаний, датчика движения и вывода сохраняются.";
/* Message printed after 'ojd binding clear' removed bindings. %1$@ is the profile name and %2$lld is the number of removed bindings, shown after a colon. */
"cli.binding.clear.done" = "Привязки, удалённые из профиля «%1$@»: %2$lld.";
/* Message printed by 'ojd binding clear --dry-run' instead of changing the profile. %1$@ is the profile name and %2$lld is the number of bindings that would be removed, shown after a colon. */
"cli.binding.clear.dryRun" = "Привязки, которые были бы удалены из профиля «%1$@»: %2$lld.";
/* Message of 'ojd binding clear' when a source has no binding. %1$@ is the profile name and %2$@ is the source the user gave. */
"cli.binding.clear.missing" = "В профиле «%1$@» нет привязки для %2$@. Ничего не изменено.";
/* Help text of the SOURCES argument of 'ojd binding clear'. */
"cli.binding.clear.sources" = "Источники, привязки которых нужно удалить.";
/* Error of 'ojd binding clear' when neither sources nor --all are given. --all stays as written. */
"cli.binding.clear.usage" = "Укажите один или несколько источников либо --all.";
/* Long description in the help of 'ojd binding'. It lists the SOURCE and TARGET forms. Words in capitals, forms such as button:NAME and all option names stay as written. */
"cli.binding.group.discussion" = "Привязка отправляет TARGET, когда используется SOURCE контроллера.\n\nSOURCE: button:NAME, dpad:DIRECTION, axis:NAME[:negative|positive], trigger:NAME:STAGE, motion:lean:DIRECTION, touch:SURFACE:contact, touch:SURFACE:grid:COLUMNS:ROWS:COLUMN:ROW или touch:SURFACE:swipe:DIRECTION:DISTANCE.\n\nTARGET: key:KEY[:mods=meta,control,alt,shift], mouse:BUTTON, move:x|y, position:x|y, scroll:x|y, gamepad:button:NAME, gamepad:dpad:DIRECTION, gamepad:axis:NAME, midi-note:CHANNEL:NOTE[:VELOCITY], midi-cc:CHANNEL:CONTROLLER или physical:... для вибрации, подсветки и адаптивных триггеров.\n\n«ojd profile show» выводит привязки в этих формах. Аккорды, последовательности и слои меняются командой «ojd profile edit».";
/* One-line summary of 'ojd binding list' in the command list and at the top of its help. */
"cli.binding.list.abstract" = "Показывает привязки профиля.";
/* Message of 'ojd binding list' when the profile has no bindings. %@ is the profile name. The command in quotes stays as written. */
"cli.binding.list.empty" = "В профиле «%@» нет привязок. Добавьте привязку командой «ojd binding set».";
/* Error of 'ojd binding set' when a value of --multi-tap does not have the form COUNT:MS:TARGET. COUNT:MS:TARGET and the example stay as written. */
"cli.binding.group.multiTapFormat" = "--multi-tap принимает COUNT:MS:TARGET, например 2:300:key:key-c.";
/* Help text of the --actions-json option of 'ojd binding set'. 'ojd profile export' stays as written. */
"cli.binding.group.optionActionsJson" = "Дополнительные действия в виде массива JSON в том виде, в каком их записывает «ojd profile export».";
/* Help text of the --behavior option of 'ojd binding set'. The behavior hold is a value the user types. */
"cli.binding.group.optionBehavior" = "Когда срабатывает цель. По умолчанию: поведение текущей привязки или hold.";
/* Help text of the --deadzone option of 'ojd binding set'. The dead zone is the part of an axis travel that is ignored. */
"cli.binding.group.optionDeadzone" = "Для источников-осей: часть хода, которая игнорируется, от 0 до 0.95. По умолчанию: 0.1.";
/* Help text of the --digital-threshold option of 'ojd binding set'. It sets the axis travel that counts as a press. */
"cli.binding.group.optionDigitalThreshold" = "Для источников-осей: ход, который считается нажатием для целей-кнопок. По умолчанию: 0.5.";
/* Help text of the --gain option of 'ojd binding set'. Gain scales the axis output. */
"cli.binding.group.optionGain" = "Для источников-осей: масштаб вывода, от 0.1 до 10. По умолчанию: 1.";
/* Help text of the --invert flag of 'ojd binding set'. */
"cli.binding.group.optionInvert" = "Для источников-осей: инвертировать направление.";
/* Help text of the --long-hold option of 'ojd binding set'. The example 500:key:key-b stays as written. */
"cli.binding.group.optionLongHold" = "Отправить ещё одну цель, если источник удерживается столько времени, например 500:key:key-b.";
/* Help text of the --multi-tap option of 'ojd binding set'. COUNT is the number of taps, MS the milliseconds allowed after the last release. COUNT:MS:TARGET and the example stay as written. */
"cli.binding.group.optionMultiTap" = "Отправить ещё одну цель, если по источнику нажали COUNT раз, каждое нажатие в пределах MS после последнего отпускания, например 2:300:key:key-c. Повторите параметр для других количеств.";
/* Help text of the --pulse-ms option of 'ojd binding set'. ms means milliseconds. */
"cli.binding.group.optionPulseMs" = "Как долго импульс удерживает цель, от 1 до 5000 мс. По умолчанию: 100.";
/* Help text of the --voice option of 'ojd binding set'. The option name and speak:TEXT stay as written. */
"cli.binding.group.optionVoice" = "Идентификатор голоса для цели speak:TEXT. По умолчанию: системный голос.";
/* Error of 'ojd binding set' when --voice is given with a target that is not speak:TEXT. The option name and speak:TEXT stay as written. */
"cli.binding.group.voiceNeedsSpeak" = "Для --voice нужна цель speak:TEXT.";
/* Help text of the --response-curve option of 'ojd binding set'. linear is a value the user types. */
"cli.binding.group.optionResponseCurve" = "Для источников-осей: как вывод растёт с ходом. По умолчанию: linear.";
/* Help text of the --turbo-delay option of 'ojd binding set'. The delay is the time before the first repeat. ms means milliseconds. The option names stay as written. */
"cli.binding.group.optionTurboDelay" = "Ждать столько перед первым повтором, от 0 до 2500 мс. Требует --turbo-rate и --turbo-duty.";
/* Help text of the --turbo-duty option of 'ojd binding set'. The duty is the share of each turbo cycle in which the target is held. */
"cli.binding.group.optionTurboDuty" = "Доля каждого цикла турбо, в течение которой цель удерживается: больше 0 и меньше 1.";
/* Help text of the --turbo-max option of 'ojd binding set'. The option names stay as written. */
"cli.binding.group.optionTurboMax" = "Остановиться после стольких повторов, от 1 до 500. Требует --turbo-rate и --turbo-duty.";
/* Help text of the --turbo-rate option of 'ojd binding set'. --turbo-duty stays as written. */
"cli.binding.group.optionTurboRate" = "Повторять цель столько раз в секунду, пока источник удерживается. Требует --turbo-duty.";
/* One-line summary of 'ojd binding set' in the command list and at the top of its help. */
"cli.binding.set.abstract" = "Привязывает источник контроллера к цели, заменяя текущую привязку источника.";
/* Message printed after 'ojd binding set' stored a binding. %1$@ is the profile name and %2$@ describes the source bound to the target. */
"cli.binding.set.done" = "«%1$@» теперь привязан к %2$@.";
/* Help text of the SOURCE argument of 'ojd binding set'. button:south stays as written. */
"cli.binding.set.source" = "Элемент управления контроллера, например button:south.";
/* Help text of the TARGET argument of 'ojd binding set'. key:space stays as written. */
"cli.binding.set.target" = "Что он отправляет, например key:space.";
/* Error of 'ojd binding' commands when a source cannot be parsed. %@ is the text the user gave. The command in quotes stays as written. */
"cli.binding.group.sourceInvalid" = "«%@» не является источником. Формы источников перечислены в «ojd binding set --help».";
/* Error of 'ojd binding set' when the target cannot be parsed. %@ is the text the user gave. The command in quotes stays as written. */
"cli.binding.group.targetInvalid" = "«%@» не является целью. Формы целей перечислены в «ojd binding set --help».";
/* Error of 'ojd binding set' when the profile has no layer with the name in a layer:NAME:MODE target. %1$@ is the profile name and %2$@ is the layer name. */
"cli.binding.group.layerMissing" = "В профиле «%1$@» нет слоя «%2$@». Ничего не изменено.";
/* Error of 'ojd binding set' when only one of --turbo-rate and --turbo-duty is given, or --turbo-delay or --turbo-max is given without both. All four option names stay as written. */
"cli.binding.group.turboPair" = "--turbo-rate и --turbo-duty нужно указывать вместе, а --turbo-delay и --turbo-max требуют обоих.";
/* Error of 'ojd binding set' when turbo is requested for a pointer movement or scrolling target. */
"cli.binding.group.turboUnsupported" = "Турбо не работает с целями перемещения указателя и прокрутки.";
/* One-line summary of 'ojd controller calibrate' in the command list and at the top of its help. */
"cli.controller.calibrate.abstract" = "Показывает или изменяет калибровку датчика движения контроллера.";
/* Help text of the ACTION argument of 'ojd controller calibrate'. start, pause and reset are values the user types and stay as written. */
"cli.controller.calibrate.action" = "Что сделать: start, pause или reset. Без действия выводится калибровка.";
/* State word in the calibration line of 'ojd controller calibrate'. It fills %2$@ of the status line. */
"cli.controller.calibrate.calibrated" = "откалиброван";
/* State word in the calibration line of 'ojd controller calibrate'. It fills %2$@ of the status line. */
"cli.controller.calibrate.collecting" = "сбор данных";
/* Long description in the help of 'ojd controller calibrate'. start, pause and reset are values the user types and stay as written. Gyro drift is the constant rotation the motion sensor reports at rest. */
"cli.controller.calibrate.discussion" = "Без действия выводит калибровку. start собирает дрейф гироскопа, пока контроллер неподвижен, pause останавливает сбор, а reset сбрасывает калибровку. Калибровка используется привязками наклона и руления.";
/* Error of 'ojd controller calibrate' for a controller without a motion sensor. %@ is the controller name. */
"cli.controller.calibrate.noMotion" = "%@ не передаёт данные датчика движения.";
/* Calibration line of 'ojd controller calibrate'. %1$@ is the controller name, %2$@ is the state word, and %3$@, %4$@ and %5$@ are the X, Y and Z components of the gyro offset in degrees per second. */
"cli.controller.calibrate.status" = "%1$@: %2$@, смещение гироскопа x %3$@ y %4$@ z %5$@ градусов в секунду";
