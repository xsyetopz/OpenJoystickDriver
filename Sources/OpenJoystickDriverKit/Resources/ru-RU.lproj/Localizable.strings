"cli.root.abstract" = "Настройка и проверка OpenJoystickDriver, драйвера геймпадов для macOS.";
"cli.root.discussion" = "С чего начать:\n  ojd status             Проверить службу, расширение и разрешения.\n  ojd diagnose           Выполнить все проверки и показать, что не так.\n  ojd controller list    Показать подключённые контроллеры.\n\nПримеры:\n  # Выводить ввод одного контроллера по мере изменения\n  ojd controller watch 045E:028E\n  # Показать подключённые контроллеры в JSON\n  ojd --json controller list\n\nОкружение (параметр сильнее переменной):\n  OJD_NO_INPUT=1         То же, что --no-input.\n  OJD_TIMEOUT=SECONDS    То же, что --timeout.\n  OJD_COLOR=WHEN         auto, always (цвет и вне терминала) или never.\n\nАвтодополнение оболочки:\n  ojd --generate-completion-script zsh|bash|fish\n\nКоды завершения:\n  0    Успешно.\n  1    Команда завершилась с ошибкой.\n  64   Ошибка использования.\n  69   Служба не запущена. Запустите её командой «ojd service start».\n  77   Отсутствует разрешение macOS.\n  127  Сборка из репозитория не смогла передать команду приложению.\n  130  Прервано.";
"cli.help.global_options" = "Каждая команда также принимает глобальные параметры; их перечисляет «ojd --help».";
"cli.error.env_timeout" = "OJD_TIMEOUT требует число секунд больше 0.";
"cli.error.env_color" = "OJD_COLOR требует auto, always или never.";
"cli.error.env_no_input" = "OJD_NO_INPUT требует 1, true, yes, 0, false или no.";
"cli.virtual.feed.error.plain" = "--plain не применяется к «virtual feed», которая выводит строки JSON. Уберите --plain.";
"cli.controller.watch.examples" = "Примеры:\n  # Выводить ввод 10 секунд\n  ojd controller watch 045E:028E --duration 10\n  # Вывести первый нажатый элемент управления в JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Следить за всеми контроллерами и тем, что отправляет их виртуальный геймпад\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Примеры:\n  # Включить оба основных мотора на 180 на 0,45 секунды\n  ojd controller rumble 045E:028E\n  # Включить оба основных мотора на полную мощность на 2 секунды\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Примеры:\n  # Задать оранжевый цвет световой панели\n  ojd controller light 054C:09CC --color FF8000\n  # Задать цвет и низкую яркость\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Примеры:\n  # Создать профиль для модели контроллера\n  ojd profile create Racing --controller 045E:028E\n  # Применять его, только пока Safari на переднем плане\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Примеры:\n  # Переименовать профиль\n  ojd profile set Racing name Rally\n  # Задать внутреннюю мёртвую зону первого сопоставления стика\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Примеры:\n  # Удерживать пробел, пока удерживается южная кнопка\n  ojd binding set Racing button:south key:space\n  # Переключать J при каждом нажатии\n  ojd binding set Racing button:west key:j --behavior toggle\n  # Повторять J 10 раз в секунду, пока кнопка удерживается\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Примеры:\n  # Установить файл записи\n  ojd record install 045E-028E.json\n  # Прочитать запись из stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Примеры:\n  # Разрешить программе использовать службу\n  ojd access grant /Applications/Example.app\n  # Создать токен для страниц, отдаваемых с одного источника\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
