"cli.service.wait.timeout" = "Служба не начала принимать запросы в течение %@. Запустите её командой «ojd service start» или повторите с большим значением --timeout.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Показывает службу, расширение, разрешения и подключённые контроллеры.";
