"ui.settings.general.idleDisconnectDescription" = "Отключает контроллер классического Bluetooth, ввод которого не менялся в течение выбранного времени. Контроллеры Bluetooth Low Energy и контроллеры, подключённые кабелем или через приёмник, остаются подключёнными.";
/* Title of the choice that turns the idle disconnect off in the General pane of the settings window. */
"ui.settings.general.idleDisconnectOff" = "Выкл.";
/* Error of 'ojd setting set' when the value is not a number of minutes for the idle disconnect. %1$@ is the text the user gave; %2$@ and %3$@ are the smallest and largest number of minutes. The word off stays as written. */
"cli.setting.set.badIdleDisconnect" = "«%1$@» не является числом минут. Укажите целое число от %2$@ до %3$@ или off.";
/* Heading of the setup steps that the main window shows when the app starts with a step still open. */
"ui.setupSteps.title" = "Завершите настройку";
/* One sentence of the setup steps in the main window, beside the button that asks for the macOS Input Monitoring permission. OpenJoystickDriver is the product name. Input Monitoring is written as macOS names it in System Settings. */
"platform.macos.ui.setupSteps.inputRead" = "Разрешите «Мониторинг ввода», чтобы OpenJoystickDriver мог считывать ваши контроллеры.";
/* One sentence of the setup steps in the main window, beside the button that asks for the macOS Accessibility permission that publishes virtual controllers. OpenJoystickDriver is the product name. Accessibility is written as macOS names it in System Settings. */
"platform.macos.ui.setupSteps.inputInject" = "Разрешите «Универсальный доступ», чтобы OpenJoystickDriver мог передавать контроллеры в ваши игры.";
/* One sentence of the setup steps in the main window, beside the button that asks for the macOS Accessibility permission that sends keyboard and pointer events. OpenJoystickDriver is the product name. Accessibility is written as macOS names it in System Settings. */
"platform.macos.ui.setupSteps.postEvent" = "Разрешите «Универсальный доступ», чтобы OpenJoystickDriver мог отправлять события клавиатуры и указателя.";
/* One sentence of the setup steps in the main window, beside the button that asks for Bluetooth access or opens System Settings. OpenJoystickDriver is the product name; Switch 2 is a product name. */
"ui.setupSteps.bluetooth" = "Разрешите Bluetooth, чтобы OpenJoystickDriver мог подключать контроллеры Switch 2.";
/* Button of the Simple interface row that reports a changed or unavailable hidden setting; it switches the interface to All Controls. */
"ui.interface.showAdvanced" = "Показать все элементы управления";
/* Title of the placeholder that fills the Library and Activity areas in the Simple interface, which hides all their controls; a Show All Controls button sits under it. */
"ui.interface.areaNeedsAdvanced" = "Скрыто в интерфейсе уровня «Простой»";
