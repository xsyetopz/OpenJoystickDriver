"error.E5007.userFile.patchNoChange" = "%1$@, patch: патч ничего не меняет в записи. Исправление: удалите патч или задайте значение, отличное от значения записи.";
/* Error E5007, shown when an input layout of a record fails: input lists no layout. %1$@ is the file. */
"error.E5007.inputLayout.layoutsEmpty" = "%1$@, input.layouts: input должен перечислять хотя бы одну раскладку. Исправление: добавьте раскладку или удалите input.";
/* Error E5007, shown when an input layout of a record fails: two layouts select one report. %2$@ and %3$@ are the layouts. %1$@ is the file. */
"error.E5007.inputLayout.layoutsSameReport" = "%1$@, input.layouts: две раскладки выбирают один отчёт: %2$@ и %3$@. Исправление: задайте им разные идентификаторы или длины отчёта либо удалите одну.";
/* Error E5007, shown when an input layout of a record fails: a report ID is out of range. %1$@ is the file. */
"error.E5007.inputLayout.reportIdRange" = "%1$@, input.layouts[].report.id: идентификатор отчёта — от 1...255. Исправление: задайте целое число от 1 до 255 или опустите его.";
/* Error E5007, shown when an input layout of a record fails: a report length is out of range. %2$@ is the longest length. %1$@ is the file. */
"error.E5007.inputLayout.reportLength" = "%1$@, input.layouts[].report.length: отчёт имеет длину 1...%2$@ байт вместе с байтом идентификатора. Исправление: задайте длину в этом диапазоне.";
/* Error E5007, shown when an input layout of a record fails: an 8-way hat has a bad bit size. %1$@ is the file. */
"error.E5007.inputLayout.hatBits" = "%1$@, input.layouts[].hat: 8-позиционный hat занимает от 3 до 8 бит. Исправление: задайте bitSize от 3 до 8.";
/* Error E5007, shown when an input layout of a record fails: a table hat names bad directions. %1$@ is the file. */
"error.E5007.inputLayout.hatTable" = "%1$@, input.layouts[].hat: табличный hat называет направления только для значений, которые вмещают его биты, и не содержит записи neutral. Исправление: перечислите только значения, которые вмещают биты, и уберите neutral.";
/* Error E5007, shown when an input layout of a record fails: a field has a bad bit size. %2$@ is the largest bit size. %1$@ is the file. */
"error.E5007.inputLayout.fieldBits" = "%1$@, input.layouts[]: поле занимает от 1 до %2$@ бит. Исправление: задайте каждый bitSize в этом диапазоне.";
/* Error E5007, shown when an input layout of a record fails: a field lies outside the report. %1$@ is the file. */
"error.E5007.inputLayout.fieldOutside" = "%1$@, input.layouts[]: поля должны лежать после байта идентификатора отчёта и в пределах его длины. Исправление: переместите поле или увеличьте длину отчёта.";
/* Error E5007, shown when an input layout of a record fails: a BigEndian field is misplaced or has a bad size. %1$@ is the file. */
"error.E5007.inputLayout.bigEndian" = "%1$@, input.layouts[]: поле BigEndian начинается на границе байта и занимает 16, 24 или 32 бита. Исправление: начните с числа, кратного 8, с bitSize 16, 24 или 32 либо используйте LittleEndian.";
/* Error E5007, shown when an input layout of a record fails: a button names a control that is not a button. %1$@ is the file. */
"error.E5007.inputLayout.buttonControl" = "%1$@, input.layouts[].buttons: кнопка называет цифровой элемент, а не крестовину или ось стика. Исправление: назовите элемент-кнопку или перенесите запись в axes или hat.";
/* Error E5007, shown when an input layout of a record fails: axes repeat a control or name a control that is not a stick axis. %1$@ is the file. */
"error.E5007.inputLayout.axesDistinct" = "%1$@, input.layouts[].axes: axes должен называть разные оси стиков. Исправление: назовите каждую ось стика один раз.";
/* Error E5007, shown when an input layout of a record fails: an axis has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.axisRange" = "%1$@, input.layouts[].axes: у оси min меньше max в пределах диапазона её размера. Исправление: задайте min меньше max, оба в диапазоне bitSize.";
/* Error E5007, shown when an input layout of a record fails: a trigger value has min and max out of order or out of range. %1$@ is the file. */
"error.E5007.inputLayout.triggerRange" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: у значения триггера min меньше max в пределах диапазона его размера. Исправление: задайте min меньше max, оба в диапазоне bitSize.";
/* Error E5007, shown when an input layout of a record fails: a symmetric axis is not signed around zero. %1$@ is the file. */
"error.E5007.inputLayout.axisSymmetric" = "%1$@, input.layouts[].axes: симметричная ось знаковая, с min меньше 0 и max больше 0. Исправление: задайте signed значение true с min меньше 0 и max больше 0 или отключите symmetric.";
/* Error E5007, shown when an input layout of a record fails: a trigger has neither an analog value nor a button. %1$@ is the file. */
"error.E5007.inputLayout.triggerSources" = "%1$@, input.layouts[].leftTrigger, input.layouts[].rightTrigger: триггер называет аналоговое значение, кнопку или оба. Исправление: задайте триггеру аналоговое значение или кнопку.";
/* Error E5007, shown when an input layout of a record fails: a layout decodes no control. %1$@ is the file. */
"error.E5007.inputLayout.noControls" = "%1$@, input.layouts[]: раскладка должна декодировать хотя бы один элемент. Исправление: добавьте кнопку, ось, hat или триггер.";
/* Error E5007, shown when the HID usage map of a record fails: a usage map lists no usage. %1$@ is the file. */
"error.E5007.usageMap.mapEmpty" = "%1$@, input.hidUsageMap.usages: карта usage должна перечислять хотя бы один usage. Исправление: добавьте usage или удалите hidUsageMap.";
/* Error E5007, shown when the HID usage map of a record fails: two entries of one usage name the same half. %2$@ is the usage as page/usage, %3$@ the half. %1$@ is the file. */
"error.E5007.usageMap.halfTwice" = "%1$@, input.hidUsageMap.usages[].half: usage %2$@ дважды называет половину %3$@. Исправление: дайте каждой половине usage одну запись.";
/* Error E5007, shown when the HID usage map of a record fails: a usage is named twice. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.usageTwice" = "%1$@, input.hidUsageMap.usages[]: usage %2$@ назван дважды, а делить usage могут только записи двух его половин. Исправление: назовите каждый usage один раз или дайте записям половины Positive и Negative.";
/* Error E5007, shown when the HID usage map of a record fails: a Button entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonControl" = "%1$@, input.hidUsageMap.usages[].control: usage %2$@ — кнопка, а %3$@ не является элементом-кнопкой. Исправление: назовите элемент-кнопку или используйте другой вид записи.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis entry names a control that is not a stick axis or trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisControl" = "%1$@, input.hidUsageMap.usages[].control: usage %2$@ — ось, а %3$@ не является осью стика или триггером. Исправление: назовите ось стика или триггер либо используйте другой вид записи.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis range has min at or above max. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.rangeOrder" = "%1$@, input.hidUsageMap.usages[].range: диапазон usage %2$@ должен иметь min меньше max. Исправление: задайте min меньше max.";
/* Error E5007, shown when the HID usage map of a record fails: an Axis deadZone is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.deadZone" = "%1$@, input.hidUsageMap.usages[].deadZone: deadZone у usage %2$@ должен быть больше 0 и меньше 1. Исправление: задайте deadZone больше 0 и меньше 1.";
/* Error E5007, shown when the HID usage map of a record fails: a Hat range is not 0...7 or 1...8. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.hatRange" = "%1$@, input.hidUsageMap.usages[].range: диапазон hat у usage %2$@ должен быть 0...7 или 1...8. Исправление: задайте range 0...7 или 1...8 либо опустите его.";
/* Error E5007, shown when the HID usage map of a record fails: a HalfAxis entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.halfAxisControl" = "%1$@, input.hidUsageMap.usages[].control: usage %2$@ — полуось, а %3$@ не является триггером. Исправление: назовите LeftTrigger или RightTrigger.";
/* Error E5007, shown when the HID usage map of a record fails: a ButtonTrigger entry names a control that is not a trigger. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.buttonTriggerControl" = "%1$@, input.hidUsageMap.usages[].control: usage %2$@ — кнопочный триггер, а %3$@ не является триггером. Исправление: назовите LeftTrigger или RightTrigger либо используйте другой вид записи.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad entry names a control that is not a D-pad direction. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisDpadControl" = "%1$@, input.hidUsageMap.usages[].control: usage %2$@ — крестовина по оси, а %3$@ не является направлением крестовины. Исправление: назовите DpadUp, DpadDown, DpadLeft или DpadRight.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisButton entry names a control that is not a button. %2$@ is the usage as page/usage, %3$@ the control. %1$@ is the file. */
"error.E5007.usageMap.axisButtonControl" = "%1$@, input.hidUsageMap.usages[].control: usage %2$@ — кнопка по оси, а %3$@ не является элементом-кнопкой. Исправление: назовите элемент-кнопку или используйте другой вид записи для оси.";
/* Error E5007, shown when the HID usage map of a record fails: an AxisDpad or AxisButton threshold is outside 0 to 1. %2$@ is the usage as page/usage. %1$@ is the file. */
"error.E5007.usageMap.threshold" = "%1$@, input.hidUsageMap.usages[].threshold: threshold у usage %2$@ должен быть больше 0 и меньше 1. Исправление: задайте threshold больше 0 и меньше 1.";
/* Error E5007, shown when a startup write of a record fails: a startup write names an input report. %1$@ is the file. */
"error.E5007.startupWrite.reportKind" = "%1$@, session.startup[].report: запись запуска не может отправлять входной отчёт. Исправление: задайте report как выходной отчёт или отчёт функции.";
/* Error E5007, shown when a startup write of a record fails: a startup report is not 2...128 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.reportLength" = "%1$@, session.startup[].report: отчёт запуска должен быть длиной 2...128 байт. Исправление: задайте отчёту длину 2...128 байт.";
/* Error E5007, shown when a startup write of a record fails: a startup write lists the wrong number of bytes. %2$@ is the number of bytes the report takes after its ID. %1$@ is the file. */
"error.E5007.startupWrite.bytesCount" = "%1$@, session.startup[].bytes: запись запуска должна перечислять %2$@ байт, все байты после ID отчёта. Исправление: задайте для bytes ровно %2$@ байт.";
/* Error E5007, shown when a startup write of a record fails: a startup delay is outside 0...1000 ms. %1$@ is the file. */
"error.E5007.startupWrite.delay" = "%1$@, session.startup[].delayMilliseconds: задержка запуска должна быть 0...1000 мс. Исправление: задайте delayMilliseconds 0...1000 либо опустите его.";
/* Error E5007, shown when a startup write of a record fails: a startup transport is not USB, BluetoothClassic or BluetoothLE. %1$@ is the file. */
"error.E5007.startupWrite.transport" = "%1$@, session.startup[].transport: транспорт запуска должен быть USB, BluetoothClassic или BluetoothLE. Исправление: задайте transport одним из них либо опустите его.";
/* Error E5007, shown when a startup write of a record fails: a startup report with crc32Seed has no room for its 4-byte trailer. %1$@ is the file. */
"error.E5007.startupWrite.crcRoom" = "%1$@, session.startup[].crc32Seed: в отчёте запуска с crc32Seed должно быть место для 4-байтового завершения. Исправление: сделайте отчёт длиннее 4 байт либо удалите crc32Seed.";
/* Error E5007, shown when a startup write of a record fails: a USB startup packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.startupWrite.usbLength" = "%1$@, session.startup[].bytes: USB-пакет запуска должен быть длиной 1...64 байт. Исправление: задайте для bytes длину 1...64.";
/* Error E5007, shown when a startup write of a record fails: a USB startup endpoint is outside 1...127. %1$@ is the file. */
"error.E5007.startupWrite.usbEndpoint" = "%1$@, session.startup[].endpoint: USB-конечная точка запуска должна быть 1...127. Исправление: задайте endpoint 1...127 либо опустите его.";
/* Error E5007, shown when a startup write of a record fails: a USB startup timeout is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.startupWrite.usbTimeout" = "%1$@, session.startup[].timeoutMilliseconds: USB-тайм-аут запуска должен быть 1...60000 мс. Исправление: задайте timeoutMilliseconds 1...60000 либо опустите его.";
/* Error E5007, shown when a startup write of a record fails: a USB startup session byte does not index the packet. %1$@ is the file. */
"error.E5007.startupWrite.sessionByte" = "%1$@, session.startup[].sessionByte: байт сессии USB-запуска должен указывать на байт пакета. Исправление: задайте sessionByte позицию внутри bytes.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names an input report. %1$@ is the file. */
"error.E5007.rumble.reportKind" = "%1$@, session.rumble.report.kind: шаблон вибрации не может записывать входной отчёт. Исправление: задайте report как выходной отчёт или отчёт функции.";
/* Error E5007, shown when the rumble template of a record fails: a rumble HID report is not 2...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.reportLength" = "%1$@, session.rumble.report.length: HID-отчёт вибрации должен быть длиной 2...64 байт. Исправление: задайте отчёту длину 2...64 байт.";
/* Error E5007, shown when the rumble template of a record fails: a rumble USB packet is not 1...64 bytes long. %1$@ is the file. */
"error.E5007.rumble.packetLength" = "%1$@, session.rumble.report.length: USB-пакет вибрации должен быть длиной 1...64 байт. Исправление: задайте пакету длину 1...64 байт.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a rumble template do not cover the whole report. %1$@ is the file. */
"error.E5007.rumble.bytesCover" = "%1$@, session.rumble.bytes: байты шаблона вибрации должны покрывать весь отчёт. Исправление: перечислите каждый байт отчёта, включая ID отчёта.";
/* Error E5007, shown when the rumble template of a record fails: the bytes of a numbered rumble report do not start with its report ID. %1$@ is the file. */
"error.E5007.rumble.bytesReportId" = "%1$@, session.rumble.bytes: байты нумерованного отчёта вибрации должны начинаться с его ID отчёта. Исправление: начните bytes с ID отчёта.";
/* Error E5007, shown when the rumble template of a record fails: a rumble template names no motor it can drive. %1$@ is the file. */
"error.E5007.rumble.motors" = "%1$@, session.rumble: шаблон вибрации должен называть хотя бы один мотор, которым он может управлять. Исправление: добавьте lowFrequency, highFrequency, leftTrigger или rightTrigger.";
/* Error E5007, shown when the rumble template of a record fails: the motor and counter bytes of a rumble template overlap or fall outside the report. %1$@ is the file. */
"error.E5007.rumble.fields" = "%1$@, session.rumble: байты моторов и счётчика шаблона вибрации должны различаться и идти после ID отчёта внутри отчёта. Исправление: дайте каждому мотору и счётчику собственный байт после ID отчёта.";
/* Error E5007, shown when the rumble template of a record fails: a rumble resend interval is outside 1...60000 ms. %1$@ is the file. */
"error.E5007.rumble.resendInterval" = "%1$@, session.rumble.resendIntervalMilliseconds: интервал повторной отправки вибрации должен быть 1...60000 мс. Исправление: задайте resendIntervalMilliseconds 1...60000 либо опустите его.";
