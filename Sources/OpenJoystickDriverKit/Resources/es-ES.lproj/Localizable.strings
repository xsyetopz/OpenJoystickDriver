"cli.root.abstract" = "Configura e inspecciona OpenJoystickDriver, el controlador de gamepads para macOS.";
"cli.root.discussion" = "Empieza aquí:\n  ojd status             Comprueba el servicio, la extensión y los permisos.\n  ojd diagnose           Ejecuta todas las comprobaciones e informa de fallos.\n  ojd controller list    Lista los mandos conectados.\n\nEjemplos:\n  # Muestra la entrada de un mando cuando cambia\n  ojd controller watch 045E:028E\n  # Lista los mandos conectados como JSON\n  ojd --json controller list\n\nEntorno (una opción prevalece sobre su variable):\n  OJD_NO_INPUT=1         Igual que --no-input.\n  OJD_TIMEOUT=SECONDS    Igual que --timeout.\n  OJD_COLOR=WHEN         auto, always (color incluso sin terminal) o never.\n\nCompletado del shell:\n  ojd --generate-completion-script zsh|bash|fish\n\nCódigos de salida:\n  0    Correcto.\n  1    El comando falló.\n  64   Error de uso.\n  69   El servicio no se está ejecutando. Inícialo con «ojd service start».\n  77   Falta un permiso de macOS.\n  127  Una compilación del repositorio no pudo pasar el comando a la app instalada.\n  130  Interrumpido.";
"cli.help.global_options" = "Todos los comandos aceptan también las opciones globales; «ojd --help» las lista.";
"cli.error.env_timeout" = "OJD_TIMEOUT necesita un número de segundos mayor que 0.";
"cli.error.env_color" = "OJD_COLOR necesita auto, always o never.";
"cli.error.env_no_input" = "OJD_NO_INPUT necesita 1, true, yes, 0, false o no.";
"cli.virtual.feed.error.plain" = "--plain no se aplica a «virtual feed», que imprime líneas JSON. Omite --plain.";
"cli.controller.watch.examples" = "Ejemplos:\n  # Muestra la entrada durante 10 segundos\n  ojd controller watch 045E:028E --duration 10\n  # Muestra el primer control pulsado, como JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Observa todos los mandos y lo que envía su mando virtual\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Ejemplos:\n  # Activa los dos motores principales a 180 durante 0,45 segundos\n  ojd controller rumble 045E:028E\n  # Activa los dos motores principales a plena potencia durante 2 segundos\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Ejemplos:\n  # Pone la barra de luz en naranja\n  ojd controller light 054C:09CC --color FF8000\n  # Establece el color y un brillo bajo\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Ejemplos:\n  # Crea un perfil para un modelo de mando\n  ojd profile create Racing --controller 045E:028E\n  # Aplícalo solo mientras Safari está en primer plano\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Ejemplos:\n  # Cambia el nombre de un perfil\n  ojd profile set Racing name Rally\n  # Establece la zona muerta interior de la primera asignación de stick\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Ejemplos:\n  # Mantiene Espacio mientras se mantiene el botón sur\n  ojd binding set Racing button:south key:space\n  # Alterna J en cada pulsación\n  ojd binding set Racing button:west key:j --behavior toggle\n  # Repite J 10 veces por segundo mientras se mantiene\n  ojd binding set Racing button:west key:j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Ejemplos:\n  # Instala un archivo de registro\n  ojd record install 045E-028E.json\n  # Lee el registro desde stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Ejemplos:\n  # Permite que un programa use el servicio\n  ojd access grant /Applications/Example.app\n  # Crea un token para páginas servidas desde un origen\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
